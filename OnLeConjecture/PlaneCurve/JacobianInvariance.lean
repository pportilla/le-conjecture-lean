module

public import OnLeConjecture.Analytic.JacobianPullback
public import OnLeConjecture.PlaneCurve.Intersection

/-!
# Jacobian intersection ideals under analytic coordinates

This file proves that the ideal generated by a plane germ and its Jacobian
with a second germ is preserved by analytic source coordinates.
-/

public section

namespace OnLeConjecture.PlaneCurve

open OnLeConjecture.Analytic

/-- Multiplying the second generator by a unit does not change a pair ideal.
-/
theorem pairIdeal_mul_right_of_isUnit (g h u : Germ 2)
    (hu : IsUnit u) :
    pairIdeal g (h * u) = pairIdeal g h := by
  rw [pairIdeal, pairIdeal, Ideal.span_insert, Ideal.span_insert,
    Ideal.span_singleton_mul_right_unit hu]

/-- Multiplying the first generator by a unit does not change a pair ideal.
-/
theorem pairIdeal_mul_left_of_isUnit (g h u : Germ 2)
    (hu : IsUnit u) :
    pairIdeal (g * u) h = pairIdeal g h := by
  rw [pairIdeal_comm, pairIdeal_comm g h]
  exact pairIdeal_mul_right_of_isUnit h g u hu

/-- Pullback by a source equivalence carries the ideal generated by a germ
and a Jacobian to the corresponding transformed ideal. -/
theorem map_pairIdeal_jacobian_pullbackAlgEquiv
    (e : PointedEquivGerm 2) (g h : Germ 2) :
    Ideal.map e.pullbackAlgEquiv.toRingEquiv.toRingHom
        (pairIdeal g (Germ.jacobian g h)) =
      pairIdeal (e.pullbackAlgEquiv g)
        (Germ.jacobian (e.pullbackAlgEquiv g)
          (e.pullbackAlgEquiv h)) := by
  rw [map_pairIdeal_pullbackAlgEquiv]
  have hjac := Germ.jacobian_compPointed g h e.forward
  change Germ.jacobian (e.pullbackAlgEquiv g)
      (e.pullbackAlgEquiv h) = _ at hjac
  rw [hjac]
  symm
  exact pairIdeal_mul_right_of_isUnit
    (e.pullbackAlgEquiv g) (e.pullbackAlgEquiv (Germ.jacobian g h))
      (Germ.coordinateJacobian e.forward)
      (Germ.PointedEquivGerm.coordinateJacobian_isUnit e)

/-- Finiteness of a Jacobian intersection is preserved by an analytic source
equivalence. -/
theorem hasFiniteIntersection_jacobian_pullback_iff
    (e : PointedEquivGerm 2) (g h : Germ 2) :
    HasFiniteIntersection
        (e.pullbackAlgEquiv g)
        (Germ.jacobian (e.pullbackAlgEquiv g)
          (e.pullbackAlgEquiv h)) ↔
      HasFiniteIntersection g (Germ.jacobian g h) := by
  let sourceIdeal := pairIdeal g (Germ.jacobian g h)
  let targetIdeal := pairIdeal (e.pullbackAlgEquiv g)
    (Germ.jacobian (e.pullbackAlgEquiv g)
      (e.pullbackAlgEquiv h))
  have hmap :
      Ideal.map e.pullbackAlgEquiv.toRingEquiv.toRingHom sourceIdeal =
        targetIdeal :=
    map_pairIdeal_jacobian_pullbackAlgEquiv e g h
  constructor
  · intro hfinite
    let _ : Module.Finite ℂ (Germ 2 ⧸ targetIdeal) := hfinite
    let quotientEquiv : (Germ 2 ⧸ sourceIdeal) ≃ₐ[ℂ]
        Germ 2 ⧸ targetIdeal :=
      Ideal.quotientEquivAlg sourceIdeal targetIdeal
        e.pullbackAlgEquiv hmap.symm
    exact Module.Finite.equiv quotientEquiv.symm.toLinearEquiv
  · intro hfinite
    let _ : Module.Finite ℂ (Germ 2 ⧸ sourceIdeal) := hfinite
    let quotientEquiv : (Germ 2 ⧸ sourceIdeal) ≃ₐ[ℂ]
        Germ 2 ⧸ targetIdeal :=
      Ideal.quotientEquivAlg sourceIdeal targetIdeal
        e.pullbackAlgEquiv hmap.symm
    exact Module.Finite.equiv quotientEquiv.toLinearEquiv

/-- Analytic source coordinates preserve the intersection multiplicity of a
germ with the Jacobian formed with a second germ. -/
theorem intersectionMultiplicity_jacobian_pullback
    (e : PointedEquivGerm 2) (g h : Germ 2)
    (hfinite : HasFiniteIntersection g (Germ.jacobian g h)) :
    intersectionMultiplicity g (Germ.jacobian g h) hfinite =
      intersectionMultiplicity
        (e.pullbackAlgEquiv g)
        (Germ.jacobian (e.pullbackAlgEquiv g)
          (e.pullbackAlgEquiv h))
        ((hasFiniteIntersection_jacobian_pullback_iff e g h).mpr
          hfinite) := by
  let sourceIdeal := pairIdeal g (Germ.jacobian g h)
  let targetIdeal := pairIdeal (e.pullbackAlgEquiv g)
    (Germ.jacobian (e.pullbackAlgEquiv g)
      (e.pullbackAlgEquiv h))
  let _ : Module.Finite ℂ (Germ 2 ⧸ sourceIdeal) := hfinite
  let targetFinite :=
    (hasFiniteIntersection_jacobian_pullback_iff e g h).mpr hfinite
  let _ : Module.Finite ℂ (Germ 2 ⧸ targetIdeal) := targetFinite
  change Module.finrank ℂ (Germ 2 ⧸ sourceIdeal) =
    Module.finrank ℂ (Germ 2 ⧸ targetIdeal)
  exact Germ.quotient_finrank_eq_of_map_eq sourceIdeal targetIdeal
    e.pullbackAlgEquiv
      (map_pairIdeal_jacobian_pullbackAlgEquiv e g h)

end OnLeConjecture.PlaneCurve
