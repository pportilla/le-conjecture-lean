module

public import OnLeConjecture.Analytic.Hyperplane
public import OnLeConjecture.Analytic.Dimension
public import OnLeConjecture.Analytic.OneVariableColength
public import OnLeConjecture.PlaneCurve.Intersection

/-!
# Intersection with a smooth coordinate branch

This file compares the local algebra cut out by the first coordinate and a
second plane germ with the one variable local algebra obtained by restriction
to the first coordinate hyperplane.
-/

public section

namespace OnLeConjecture.PlaneCurve

open OnLeConjecture.Analytic

/-- Restriction maps the principal ideal generated by a plane germ onto the
principal ideal generated by its restriction. -/
theorem map_span_hyperplaneRestriction (h : Germ 2) :
    Ideal.map (Germ.hyperplaneRestriction 1) (Ideal.span {h}) =
      Ideal.span {Germ.hyperplaneRestriction 1 h} := by
  rw [Ideal.map_span]
  congr 1
  ext q
  simp

/-- The inverse image of the principal ideal generated by the restriction of
a germ is the pair ideal generated by the first coordinate and that germ. -/
theorem comap_span_hyperplaneRestriction_eq_pairIdeal (h : Germ 2) :
    Ideal.comap (Germ.hyperplaneRestriction 1)
        (Ideal.span {Germ.hyperplaneRestriction 1 h}) =
      pairIdeal (Germ.coordinate (0 : Fin 2)) h := by
  calc
    Ideal.comap (Germ.hyperplaneRestriction 1)
        (Ideal.span {Germ.hyperplaneRestriction 1 h}) =
        Ideal.comap (Germ.hyperplaneRestriction 1)
          (Ideal.map (Germ.hyperplaneRestriction 1) (Ideal.span {h})) := by
      rw [map_span_hyperplaneRestriction]
    _ = Ideal.span {h} ⊔
        Ideal.comap (Germ.hyperplaneRestriction 1) ⊥ :=
      Ideal.comap_map_of_surjective (Germ.hyperplaneRestriction 1)
        (Germ.hyperplaneRestriction_surjective 1) (Ideal.span {h})
    _ = Ideal.span {h} ⊔
        Ideal.span {Germ.coordinate (0 : Fin 2)} := by
      rw [← RingHom.ker_eq_comap_bot,
        Germ.ker_hyperplaneRestriction_eq_span_coordinate_zero]
    _ = pairIdeal (Germ.coordinate (0 : Fin 2)) h := by
      rw [pairIdeal_eq_span, Ideal.span_insert, sup_comm]

/-- The algebra homomorphism form of the inverse image identity. -/
theorem comap_span_hyperplaneRestrictionAlgHom_eq_pairIdeal (h : Germ 2) :
    Ideal.comap (Germ.hyperplaneRestrictionAlgHom 1)
        (Ideal.span {Germ.hyperplaneRestriction 1 h}) =
      pairIdeal (Germ.coordinate (0 : Fin 2)) h := by
  change Ideal.comap (Germ.hyperplaneRestriction 1)
      (Ideal.span {Germ.hyperplaneRestriction 1 h}) =
    pairIdeal (Germ.coordinate (0 : Fin 2)) h
  exact comap_span_hyperplaneRestriction_eq_pairIdeal h

/-- The local algebra cut out by the first coordinate and a second germ is
equivalent to the one variable quotient cut out by its restriction. -/
noncomputable def coordinateBranchQuotientAlgEquiv (h : Germ 2) :
    (Germ 2 ⧸ pairIdeal (Germ.coordinate (0 : Fin 2)) h) ≃ₐ[ℂ]
      Germ 1 ⧸ Ideal.span {Germ.hyperplaneRestriction 1 h} :=
  (Ideal.quotientEquivAlgOfEq ℂ
      (comap_span_hyperplaneRestrictionAlgHom_eq_pairIdeal h).symm).trans
    (AlgEquiv.ofBijective
      (Ideal.quotientMapₐ
        (Ideal.span {Germ.hyperplaneRestriction 1 h})
        (Germ.hyperplaneRestrictionAlgHom 1) le_rfl)
      ⟨Ideal.quotientMap_injective,
        by
          intro q
          rcases Ideal.Quotient.mk_surjective q with ⟨q, rfl⟩
          rcases Germ.hyperplaneRestrictionAlgHom_surjective 1 q with
            ⟨g, hg⟩
          refine ⟨Ideal.Quotient.mk _ g, ?_⟩
          rw [Ideal.quotient_map_mkₐ, hg]
          rfl⟩)

/-- A plane germ whose restriction to the first coordinate hyperplane is
nonzero meets that coordinate branch with finite multiplicity. -/
theorem hasFiniteIntersection_coordinate_of_restriction_ne_zero
    (h : Germ 2) (hne : Germ.hyperplaneRestriction 1 h ≠ 0) :
    HasFiniteIntersection (Germ.coordinate (0 : Fin 2)) h := by
  let _ : Module.Finite ℂ
      (Germ 1 ⧸ Ideal.span {Germ.hyperplaneRestriction 1 h}) :=
    Germ.quotient_span_moduleFinite hne
  rw [HasFiniteIntersection]
  exact Module.Finite.equiv
    (coordinateBranchQuotientAlgEquiv h).symm.toLinearEquiv

/-- If a plane germ restricts to zero on the first coordinate hyperplane, its
pair ideal with the first coordinate is generated by that coordinate alone.
-/
theorem pairIdeal_coordinate_eq_span_of_restriction_eq_zero
    (h : Germ 2) (hzero : Germ.hyperplaneRestriction 1 h = 0) :
    pairIdeal (Germ.coordinate (0 : Fin 2)) h =
      Ideal.span {Germ.coordinate (0 : Fin 2)} := by
  have hh : h ∈ Ideal.span {Germ.coordinate (0 : Fin 2)} := by
    rw [← Germ.ker_hyperplaneRestriction_eq_span_coordinate_zero,
      RingHom.mem_ker]
    exact hzero
  apply le_antisymm
  · rw [pairIdeal_eq_span, Ideal.span_le]
    intro q hq
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hq
    rcases hq with rfl | rfl
    · exact Ideal.subset_span (Set.mem_singleton _)
    · exact hh
  · rw [pairIdeal_eq_span]
    exact Ideal.span_mono (Set.singleton_subset_iff.mpr
      (Set.mem_insert _ _))

/-- Finite intersection with the first coordinate branch forces the
restriction to that branch to be nonzero. -/
theorem restriction_ne_zero_of_hasFiniteIntersection_coordinate
    (h : Germ 2)
    (hfinite : HasFiniteIntersection (Germ.coordinate (0 : Fin 2)) h) :
    Germ.hyperplaneRestriction 1 h ≠ 0 := by
  intro hzero
  have hhSpan : h ∈ Ideal.span {Germ.coordinate (0 : Fin 2)} := by
    rw [← Germ.ker_hyperplaneRestriction_eq_span_coordinate_zero,
      RingHom.mem_ker]
    exact hzero
  have hspanLe :
      Ideal.span {Germ.coordinate (0 : Fin 2)} ≤ Germ.maximalIdeal 2 := by
    rw [Ideal.span_singleton_le_iff_mem]
    exact Germ.coordinate_mem_maximalIdeal 0
  have hh : h ∈ Germ.maximalIdeal 2 := hspanLe hhSpan
  have hradical :=
    (hasFiniteIntersection_iff_radical_pairIdeal_eq_maximalIdeal
      (Germ.coordinate_mem_maximalIdeal 0) hh).mp hfinite
  have hpair :=
    pairIdeal_coordinate_eq_span_of_restriction_eq_zero h hzero
  rw [hpair, (Germ.span_coordinate_zero_isPrime 1).radical] at hradical
  have hy :
      Germ.coordinate (0 : Fin 1).succ ∈
        Ideal.span {Germ.coordinate (0 : Fin 2)} := by
    rw [hradical]
    exact Germ.coordinate_mem_maximalIdeal _
  have hyKernel :
      Germ.coordinate (0 : Fin 1).succ ∈
        RingHom.ker (Germ.hyperplaneRestriction 1) := by
    rw [Germ.ker_hyperplaneRestriction_eq_span_coordinate_zero]
    exact hy
  rw [RingHom.mem_ker, Germ.hyperplaneRestriction_coordinate_succ] at hyKernel
  exact Germ.coordinate_ne_zero (0 : Fin 1) hyKernel

/-- A plane germ meets the first coordinate branch with finite multiplicity
exactly when its restriction to that branch is nonzero. -/
theorem hasFiniteIntersection_coordinate_iff_restriction_ne_zero
    (h : Germ 2) :
    HasFiniteIntersection (Germ.coordinate (0 : Fin 2)) h ↔
      Germ.hyperplaneRestriction 1 h ≠ 0 :=
  ⟨restriction_ne_zero_of_hasFiniteIntersection_coordinate h,
    hasFiniteIntersection_coordinate_of_restriction_ne_zero h⟩

/-- Intersection with the first coordinate branch equals the vanishing order
of the restricted one variable germ. -/
theorem intersectionMultiplicity_coordinate_eq_restrictionOrder
    (h : Germ 2) (hne : Germ.hyperplaneRestriction 1 h ≠ 0) :
    intersectionMultiplicity (Germ.coordinate (0 : Fin 2)) h
        (hasFiniteIntersection_coordinate_of_restriction_ne_zero h hne) =
      (Germ.vanishingOrder (Germ.hyperplaneRestriction 1 h)).toNat := by
  let _ : Module.Finite ℂ
      (Germ 1 ⧸ Ideal.span {Germ.hyperplaneRestriction 1 h}) :=
    Germ.quotient_span_moduleFinite hne
  let _ : Module.Finite ℂ
      (Germ 2 ⧸ pairIdeal (Germ.coordinate (0 : Fin 2)) h) :=
    hasFiniteIntersection_coordinate_of_restriction_ne_zero h hne
  change Module.finrank ℂ
      (Germ 2 ⧸ pairIdeal (Germ.coordinate (0 : Fin 2)) h) =
    (Germ.vanishingOrder (Germ.hyperplaneRestriction 1 h)).toNat
  exact (coordinateBranchQuotientAlgEquiv h).toLinearEquiv.finrank_eq.trans
    (Germ.quotient_span_finrank_eq_vanishingOrder_toNat hne)

/-- The two coordinate axes meet with multiplicity one. -/
theorem intersectionMultiplicity_coordinates :
    intersectionMultiplicity (Germ.coordinate (0 : Fin 2))
        (Germ.coordinate (0 : Fin 1).succ)
        (hasFiniteIntersection_coordinate_of_restriction_ne_zero
          (Germ.coordinate (0 : Fin 1).succ)
          (by
            rw [Germ.hyperplaneRestriction_coordinate_succ]
            exact Germ.coordinate_ne_zero (0 : Fin 1))) = 1 := by
  have hne :
      Germ.hyperplaneRestriction 1 (Germ.coordinate (0 : Fin 1).succ) ≠ 0 := by
    rw [Germ.hyperplaneRestriction_coordinate_succ]
    exact Germ.coordinate_ne_zero (0 : Fin 1)
  calc
    intersectionMultiplicity (Germ.coordinate (0 : Fin 2))
        (Germ.coordinate (0 : Fin 1).succ)
        (hasFiniteIntersection_coordinate_of_restriction_ne_zero
          (Germ.coordinate (0 : Fin 1).succ) hne) =
        (Germ.vanishingOrder
          (Germ.hyperplaneRestriction 1
            (Germ.coordinate (0 : Fin 1).succ))).toNat :=
      intersectionMultiplicity_coordinate_eq_restrictionOrder
        (Germ.coordinate (0 : Fin 1).succ) hne
    _ = 1 := by
      rw [Germ.hyperplaneRestriction_coordinate_succ,
        Germ.vanishingOrder_coordinate]
      rfl

/-- Intersection multiplicity with the first coordinate branch is additive
under products. -/
theorem intersectionMultiplicity_coordinate_mul
    (g h : Germ 2)
    (hg : Germ.hyperplaneRestriction 1 g ≠ 0)
    (hh : Germ.hyperplaneRestriction 1 h ≠ 0) :
    intersectionMultiplicity (Germ.coordinate (0 : Fin 2)) (g * h)
        (hasFiniteIntersection_coordinate_of_restriction_ne_zero (g * h)
          (by
            rw [map_mul]
            exact mul_ne_zero hg hh)) =
      intersectionMultiplicity (Germ.coordinate (0 : Fin 2)) g
          (hasFiniteIntersection_coordinate_of_restriction_ne_zero g hg) +
        intersectionMultiplicity (Germ.coordinate (0 : Fin 2)) h
          (hasFiniteIntersection_coordinate_of_restriction_ne_zero h hh) := by
  have hmul : Germ.hyperplaneRestriction 1 (g * h) ≠ 0 := by
    rw [map_mul]
    exact mul_ne_zero hg hh
  have hgOrder :
      Germ.vanishingOrder (Germ.hyperplaneRestriction 1 g) ≠ ⊤ := by
    rw [ne_eq, Germ.vanishingOrder_eq_top_iff]
    exact hg
  have hhOrder :
      Germ.vanishingOrder (Germ.hyperplaneRestriction 1 h) ≠ ⊤ := by
    rw [ne_eq, Germ.vanishingOrder_eq_top_iff]
    exact hh
  calc
    intersectionMultiplicity (Germ.coordinate (0 : Fin 2)) (g * h)
        (hasFiniteIntersection_coordinate_of_restriction_ne_zero (g * h)
          hmul) =
        (Germ.vanishingOrder
          (Germ.hyperplaneRestriction 1 (g * h))).toNat :=
      intersectionMultiplicity_coordinate_eq_restrictionOrder (g * h) hmul
    _ = (Germ.vanishingOrder
          (Germ.hyperplaneRestriction 1 g)).toNat +
        (Germ.vanishingOrder
          (Germ.hyperplaneRestriction 1 h)).toNat := by
      rw [map_mul, Germ.vanishingOrder_mul,
        ENat.toNat_add hgOrder hhOrder]
    _ = intersectionMultiplicity (Germ.coordinate (0 : Fin 2)) g
          (hasFiniteIntersection_coordinate_of_restriction_ne_zero g hg) +
        intersectionMultiplicity (Germ.coordinate (0 : Fin 2)) h
          (hasFiniteIntersection_coordinate_of_restriction_ne_zero h hh) := by
      rw [intersectionMultiplicity_coordinate_eq_restrictionOrder g hg,
        intersectionMultiplicity_coordinate_eq_restrictionOrder h hh]

end OnLeConjecture.PlaneCurve
