module

public import OnLeConjecture.PlaneCurve.Milnor
public import OnLeConjecture.PlaneCurve.SmoothBranch
public import OnLeConjecture.PlaneCurve.JacobianInvariance

/-!
# The plane curve `x² + yᵏ`

This file computes the Jacobian algebra and Milnor number of the plane curve
used in the quadratic normal form.
-/

public section

namespace OnLeConjecture.PlaneCurve

open OnLeConjecture.Analytic

/-- The plane function germ `x² + yᵏ`. -/
@[expose] noncomputable def morseCurve (k : ℕ) : Germ 2 :=
  Germ.coordinate (0 : Fin 2) ^ 2 +
    Germ.coordinate (1 : Fin 2) ^ k

theorem partialDerivative_zero_morseCurve (k : ℕ) :
    Germ.partialDerivative (0 : Fin 2) (morseCurve k) =
      2 • Germ.coordinate (0 : Fin 2) := by
  rw [morseCurve, Germ.partialDerivative_add,
    Germ.partialDerivative_pow, Germ.partialDerivative_pow,
    Germ.partialDerivative_coordinate_same,
    Germ.partialDerivative_coordinate_ne (by decide)]
  simp

theorem partialDerivative_one_morseCurve (k : ℕ) :
    Germ.partialDerivative (1 : Fin 2) (morseCurve k) =
      k • Germ.coordinate (1 : Fin 2) ^ (k - 1) := by
  rw [morseCurve, Germ.partialDerivative_add,
    Germ.partialDerivative_pow, Germ.partialDerivative_pow,
    Germ.partialDerivative_coordinate_same,
    Germ.partialDerivative_coordinate_ne (by decide)]
  simp

/-- For `k ≥ 2`, the Jacobian ideal of `x² + yᵏ` is generated by
`x` and `yᵏ⁻¹`. -/
theorem jacobianIdeal_morseCurve (k : ℕ) (hk : 2 ≤ k) :
    jacobianIdeal (morseCurve k) =
      pairIdeal (Germ.coordinate (0 : Fin 2))
        (Germ.coordinate (1 : Fin 2) ^ (k - 1)) := by
  rw [jacobianIdeal, partialDerivative_zero_morseCurve,
    partialDerivative_one_morseCurve]
  simp only [nsmul_eq_mul]
  rw [mul_comm ((2 : ℕ) : Germ 2) (Germ.coordinate (0 : Fin 2)),
    mul_comm ((k : ℕ) : Germ 2)
      (Germ.coordinate (1 : Fin 2) ^ (k - 1))]
  rw [pairIdeal_mul_left_of_isUnit, pairIdeal_mul_right_of_isUnit]
  · apply Germ.isUnit_iff_valueRingHom_ne_zero.mpr
    rw [map_natCast]
    exact_mod_cast (show k ≠ 0 by omega)
  · apply Germ.isUnit_iff_valueRingHom_ne_zero.mpr
    rw [map_natCast]
    norm_num

theorem morseCurve_restriction_power_ne_zero (k : ℕ) :
    Germ.hyperplaneRestriction 1
        (Germ.coordinate (1 : Fin 2) ^ k) ≠ 0 := by
  rw [map_pow]
  change Germ.hyperplaneRestriction 1
      (Germ.coordinate (0 : Fin 1).succ) ^ k ≠ 0
  rw [Germ.hyperplaneRestriction_coordinate_succ]
  exact pow_ne_zero k (Germ.coordinate_ne_zero (0 : Fin 1))

@[simp]
theorem hyperplaneRestriction_morseCurve (k : ℕ) :
    Germ.hyperplaneRestriction 1 (morseCurve k) =
      Germ.coordinate (0 : Fin 1) ^ k := by
  rw [morseCurve, map_add, map_pow, map_pow,
    Germ.hyperplaneRestriction_coordinate_zero]
  change 0 ^ 2 + Germ.hyperplaneRestriction 1
      (Germ.coordinate (0 : Fin 1).succ) ^ k = _
  rw [Germ.hyperplaneRestriction_coordinate_succ]
  simp

/-- The germ `x² + yᵏ` has an isolated critical point for `k ≥ 2`. -/
theorem morseCurve_hasIsolatedCriticalPoint (k : ℕ) (hk : 2 ≤ k) :
    HasIsolatedCriticalPoint (morseCurve k) := by
  have hexponent : 1 ≤ k - 1 := by omega
  have hfinite : HasFiniteIntersection
      (Germ.coordinate (0 : Fin 2))
      (Germ.coordinate (1 : Fin 2) ^ (k - 1)) :=
    hasFiniteIntersection_coordinate_of_restriction_ne_zero _
      (morseCurve_restriction_power_ne_zero (k - 1))
  refine ⟨?_, ?_⟩
  · rw [isCriticalAtOrigin_iff_partialDerivatives_mem_maximalIdeal,
      partialDerivative_zero_morseCurve,
      partialDerivative_one_morseCurve]
    constructor
    · exact (Germ.maximalIdeal 2).nsmul_mem
        (Germ.coordinate_mem_maximalIdeal 0) 2
    · exact (Germ.maximalIdeal 2).nsmul_mem
        ((Germ.maximalIdeal 2).pow_mem_of_mem
          (Germ.coordinate_mem_maximalIdeal 1) (k - 1) hexponent) k
  · rw [HasFiniteJacobianAlgebra, jacobianIdeal_morseCurve k hk]
    exact hfinite

/-- The Milnor number of `x² + yᵏ` is `k - 1`. -/
theorem milnorNumber_morseCurve (k : ℕ) (hk : 2 ≤ k) :
    milnorNumber (morseCurve k)
        (morseCurve_hasIsolatedCriticalPoint k hk) = k - 1 := by
  let hcritical := morseCurve_hasIsolatedCriticalPoint k hk
  have hfinite : HasFiniteIntersection
      (Germ.coordinate (0 : Fin 2))
      (Germ.coordinate (1 : Fin 2) ^ (k - 1)) :=
    hasFiniteIntersection_coordinate_of_restriction_ne_zero _
      (morseCurve_restriction_power_ne_zero (k - 1))
  change Module.finrank ℂ
      (Germ 2 ⧸ jacobianIdeal (morseCurve k)) = k - 1
  rw [jacobianIdeal_morseCurve k hk]
  change intersectionMultiplicity
      (Germ.coordinate (0 : Fin 2))
      (Germ.coordinate (1 : Fin 2) ^ (k - 1)) hfinite = k - 1
  have hne := morseCurve_restriction_power_ne_zero (k - 1)
  calc
    intersectionMultiplicity
        (Germ.coordinate (0 : Fin 2))
        (Germ.coordinate (1 : Fin 2) ^ (k - 1)) hfinite =
        (Germ.vanishingOrder
          (Germ.hyperplaneRestriction 1
            (Germ.coordinate (1 : Fin 2) ^ (k - 1)))).toNat := by
      simpa using intersectionMultiplicity_coordinate_eq_restrictionOrder
        (Germ.coordinate (1 : Fin 2) ^ (k - 1)) hne
    _ = k - 1 := by
      rw [map_pow]
      change (Germ.vanishingOrder
          (Germ.hyperplaneRestriction 1
            (Germ.coordinate (0 : Fin 1).succ) ^ (k - 1))).toNat = k - 1
      rw [Germ.hyperplaneRestriction_coordinate_succ,
        Germ.vanishingOrder_coordinate_pow]
      rfl

/-- The polar ideal with respect to the second coordinate is generated by
`x² + yᵏ` and `x`. -/
theorem polarIdeal_morseCurve_coordinate_one (k : ℕ) :
    polarIdeal (morseCurve k) (Germ.coordinate (1 : Fin 2)) =
      pairIdeal (morseCurve k) (Germ.coordinate (0 : Fin 2)) := by
  rw [polarIdeal, Germ.jacobian_coordinate_one_right,
    partialDerivative_zero_morseCurve]
  simp only [nsmul_eq_mul]
  rw [mul_comm ((2 : ℕ) : Germ 2)
    (Germ.coordinate (0 : Fin 2))]
  apply pairIdeal_mul_right_of_isUnit
  apply Germ.isUnit_iff_valueRingHom_ne_zero.mpr
  rw [map_natCast]
  norm_num

/-- The polar intersection of `x² + yᵏ` with respect to `y` is finite
when `k` is positive. -/
theorem morseCurve_hasFinitePolarIntersection_coordinate_one
    (k : ℕ) :
    HasFinitePolarIntersection (morseCurve k)
      (Germ.coordinate (1 : Fin 2)) := by
  rw [HasFinitePolarIntersection,
    polarIdeal_morseCurve_coordinate_one, pairIdeal_comm]
  exact hasFiniteIntersection_coordinate_of_restriction_ne_zero _
    (by
      rw [hyperplaneRestriction_morseCurve]
      exact pow_ne_zero k (Germ.coordinate_ne_zero (0 : Fin 1)))

/-- The polar intersection multiplicity of `x² + yᵏ` with respect to
`y` is `k`. -/
theorem polarIntersectionMultiplicity_morseCurve_coordinate_one
    (k : ℕ) :
    polarIntersectionMultiplicity (morseCurve k)
        (Germ.coordinate (1 : Fin 2))
        (morseCurve_hasFinitePolarIntersection_coordinate_one k) = k := by
  have hne : Germ.hyperplaneRestriction 1 (morseCurve k) ≠ 0 := by
    rw [hyperplaneRestriction_morseCurve]
    exact pow_ne_zero k (Germ.coordinate_ne_zero (0 : Fin 1))
  change Module.finrank ℂ
      (Germ 2 ⧸ polarIdeal (morseCurve k)
        (Germ.coordinate (1 : Fin 2))) = k
  rw [polarIdeal_morseCurve_coordinate_one, pairIdeal_comm]
  change intersectionMultiplicity
      (Germ.coordinate (0 : Fin 2)) (morseCurve k)
      (hasFiniteIntersection_coordinate_of_restriction_ne_zero _ hne) = k
  calc
    intersectionMultiplicity (Germ.coordinate (0 : Fin 2))
        (morseCurve k)
        (hasFiniteIntersection_coordinate_of_restriction_ne_zero _ hne) =
        (Germ.vanishingOrder
          (Germ.hyperplaneRestriction 1 (morseCurve k))).toNat :=
      intersectionMultiplicity_coordinate_eq_restrictionOrder _ hne
    _ = k := by
      rw [hyperplaneRestriction_morseCurve,
        Germ.vanishingOrder_coordinate_pow]
      rfl

end OnLeConjecture.PlaneCurve
