module

public import OnLeConjecture.Analytic.CoordinateColength
public import Mathlib.Tactic.FinCases

/-!
# Intersection multiplicity of two plane curve germs

This file defines intersection multiplicity as the complex dimension of the
corresponding local algebra. It proves symmetry, positivity, and invariance
under analytic changes of source coordinates.
-/

public section

namespace OnLeConjecture.PlaneCurve

open OnLeConjecture.Analytic

/-- The ideal generated by two plane analytic function germs. -/
@[expose] noncomputable def pairIdeal (g h : Germ 2) : Ideal (Germ 2) :=
  Ideal.span {g, h}

theorem pairIdeal_eq_span (g h : Germ 2) :
    pairIdeal g h = Ideal.span {g, h} :=
  rfl

theorem pairIdeal_comm (g h : Germ 2) :
    pairIdeal g h = pairIdeal h g := by
  exact Ideal.span_pair_comm

theorem pairIdeal_le_maximalIdeal {g h : Germ 2}
    (hg : g ∈ Germ.maximalIdeal 2) (hh : h ∈ Germ.maximalIdeal 2) :
    pairIdeal g h ≤ Germ.maximalIdeal 2 := by
  rw [pairIdeal, Ideal.span_le]
  intro q hq
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hq
  rcases hq with rfl | rfl
  · exact hg
  · exact hh

/-- Two plane analytic function germs have finite intersection when their
local intersection algebra is finite dimensional over `ℂ`. -/
@[expose] def HasFiniteIntersection (g h : Germ 2) : Prop :=
  Module.Finite ℂ (Germ 2 ⧸ pairIdeal g h)

theorem hasFiniteIntersection_comm (g h : Germ 2) :
    HasFiniteIntersection g h ↔ HasFiniteIntersection h g := by
  rw [HasFiniteIntersection, HasFiniteIntersection, pairIdeal_comm]

theorem hasFiniteIntersection_iff_exists_maximalIdeal_pow_le
    (g h : Germ 2) :
    HasFiniteIntersection g h ↔
      ∃ N : ℕ, Germ.maximalIdeal 2 ^ N ≤ pairIdeal g h := by
  exact Germ.quotient_moduleFinite_iff_exists_maximalIdeal_pow_le
    (pairIdeal g h)

/-- For germs vanishing at the origin, finite intersection is equivalent to
the pair ideal being primary up to radical for the maximal ideal. -/
theorem hasFiniteIntersection_iff_radical_pairIdeal_eq_maximalIdeal
    {g h : Germ 2} (hg : g ∈ Germ.maximalIdeal 2)
    (hh : h ∈ Germ.maximalIdeal 2) :
    HasFiniteIntersection g h ↔
      (pairIdeal g h).radical = Germ.maximalIdeal 2 := by
  constructor
  · intro hfinite
    rcases (hasFiniteIntersection_iff_exists_maximalIdeal_pow_le g h).mp
      hfinite with ⟨N, hN⟩
    apply le_antisymm
    · rw [← (Germ.maximalIdeal_isMaximal 2).isPrime.radical]
      exact Ideal.radical_mono (pairIdeal_le_maximalIdeal hg hh)
    · intro q hq
      rw [Ideal.mem_radical_iff]
      exact ⟨N, hN (Ideal.pow_mem_pow hq N)⟩
  · intro hradical
    apply (hasFiniteIntersection_iff_exists_maximalIdeal_pow_le g h).mpr
    apply Ideal.exists_pow_le_of_le_radical_of_fg
    · rw [hradical]
    · exact Germ.maximalIdeal_fg 2

/-- The local intersection multiplicity of two plane analytic function
germs. -/
@[expose] noncomputable def intersectionMultiplicity (g h : Germ 2)
    (hfinite : HasFiniteIntersection g h) : ℕ := by
  let _ : Module.Finite ℂ (Germ 2 ⧸ pairIdeal g h) := hfinite
  exact Module.finrank ℂ (Germ 2 ⧸ pairIdeal g h)

theorem intersectionMultiplicity_comm (g h : Germ 2)
    (hfinite : HasFiniteIntersection g h) :
    intersectionMultiplicity g h hfinite =
      intersectionMultiplicity h g
        ((hasFiniteIntersection_comm g h).mp hfinite) := by
  let _ : Module.Finite ℂ (Germ 2 ⧸ pairIdeal g h) := hfinite
  let _ : Module.Finite ℂ (Germ 2 ⧸ pairIdeal h g) :=
    (hasFiniteIntersection_comm g h).mp hfinite
  change Module.finrank ℂ (Germ 2 ⧸ pairIdeal g h) =
    Module.finrank ℂ (Germ 2 ⧸ pairIdeal h g)
  rw [pairIdeal_comm]

/-- The intersection multiplicity is positive when both germs vanish at the
origin. -/
theorem intersectionMultiplicity_pos {g h : Germ 2}
    (hg : g ∈ Germ.maximalIdeal 2) (hh : h ∈ Germ.maximalIdeal 2)
    (hfinite : HasFiniteIntersection g h) :
    0 < intersectionMultiplicity g h hfinite := by
  let _ : Module.Finite ℂ (Germ 2 ⧸ pairIdeal g h) := hfinite
  have hle : pairIdeal g h ≤ Germ.maximalIdeal 2 :=
    pairIdeal_le_maximalIdeal hg hh
  have hproper : pairIdeal g h ≠ ⊤ := by
    intro htop
    have hmax : Germ.maximalIdeal 2 = ⊤ := by
      apply le_antisymm le_top
      rw [← htop]
      exact hle
    exact (Germ.maximalIdeal_isMaximal 2).ne_top hmax
  let _ : Nontrivial (Germ 2 ⧸ pairIdeal g h) :=
    Ideal.Quotient.nontrivial_iff.mpr hproper
  exact Module.finrank_pos

/-- Pullback by an analytic source equivalence carries a pair ideal to the
pair ideal generated by the pullbacks. -/
theorem map_pairIdeal_pullbackAlgEquiv (e : PointedEquivGerm 2)
    (g h : Germ 2) :
    Ideal.map e.pullbackAlgEquiv.toRingEquiv.toRingHom (pairIdeal g h) =
      pairIdeal (e.pullbackAlgEquiv g) (e.pullbackAlgEquiv h) := by
  rw [pairIdeal, pairIdeal, Ideal.map_span]
  congr 1
  ext q
  simp only [Set.mem_image, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨r, rfl | rfl, rfl⟩
    · exact Or.inl rfl
    · exact Or.inr rfl
  · rintro (rfl | rfl)
    · exact ⟨g, Or.inl rfl, rfl⟩
    · exact ⟨h, Or.inr rfl, rfl⟩

/-- Finite intersection is preserved by an analytic source equivalence. -/
theorem HasFiniteIntersection.pullback (e : PointedEquivGerm 2)
    {g h : Germ 2} (hfinite : HasFiniteIntersection g h) :
    HasFiniteIntersection (e.pullbackAlgEquiv g)
      (e.pullbackAlgEquiv h) := by
  let _ : Module.Finite ℂ (Germ 2 ⧸ pairIdeal g h) := hfinite
  let quotientEquiv : (Germ 2 ⧸ pairIdeal g h) ≃ₐ[ℂ]
      Germ 2 ⧸ pairIdeal (e.pullbackAlgEquiv g)
        (e.pullbackAlgEquiv h) :=
    Ideal.quotientEquivAlg (pairIdeal g h)
      (pairIdeal (e.pullbackAlgEquiv g) (e.pullbackAlgEquiv h))
      e.pullbackAlgEquiv (map_pairIdeal_pullbackAlgEquiv e g h).symm
  exact Module.Finite.equiv quotientEquiv.toLinearEquiv

/-- Analytic source coordinate changes preserve local intersection
multiplicity. -/
theorem intersectionMultiplicity_pullback (e : PointedEquivGerm 2)
    {g h : Germ 2} (hfinite : HasFiniteIntersection g h) :
    intersectionMultiplicity g h hfinite =
      intersectionMultiplicity (e.pullbackAlgEquiv g)
        (e.pullbackAlgEquiv h) (hfinite.pullback e) := by
  let _ : Module.Finite ℂ (Germ 2 ⧸ pairIdeal g h) := hfinite
  let _ : Module.Finite ℂ
      (Germ 2 ⧸ pairIdeal (e.pullbackAlgEquiv g)
        (e.pullbackAlgEquiv h)) := hfinite.pullback e
  change Module.finrank ℂ (Germ 2 ⧸ pairIdeal g h) =
    Module.finrank ℂ
      (Germ 2 ⧸ pairIdeal (e.pullbackAlgEquiv g)
        (e.pullbackAlgEquiv h))
  exact Germ.quotient_finrank_eq_of_map_eq
    (pairIdeal g h)
    (pairIdeal (e.pullbackAlgEquiv g) (e.pullbackAlgEquiv h))
    e.pullbackAlgEquiv (map_pairIdeal_pullbackAlgEquiv e g h)

/-- The coordinate ideal of a map from the plane to the plane is the pair
ideal of its two scalar components. -/
theorem coordinateIdeal_eq_pairIdeal (f : PointedMapGerm 2 2) :
    f.1.coordinateIdeal =
      pairIdeal (f.1.component 0) (f.1.component 1) := by
  apply le_antisymm
  · rw [MapGerm.coordinateIdeal_le]
    intro i
    fin_cases i
    · exact Ideal.subset_span (Set.mem_insert _ _)
    · exact Ideal.subset_span
        (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  · rw [pairIdeal, Ideal.span_le]
    intro q hq
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hq
    rcases hq with rfl | rfl
    · exact f.1.component_mem_coordinateIdeal 0
    · exact f.1.component_mem_coordinateIdeal 1

/-- The two components of a finite plane map germ have finite local
intersection. -/
theorem PointedMapGerm.components_haveFiniteIntersection
    (f : PointedMapGerm 2 2) (hfinite : f.IsFiniteAtOrigin) :
    HasFiniteIntersection (f.1.component 0) (f.1.component 1) := by
  rw [HasFiniteIntersection, ← coordinateIdeal_eq_pairIdeal f]
  exact f.coordinateQuotient_moduleFinite hfinite

/-- For a finite plane map germ, its coordinate colength is the local
intersection multiplicity of its two components. -/
theorem PointedMapGerm.coordinateColength_eq_intersectionMultiplicity
    (f : PointedMapGerm 2 2) (hfinite : f.IsFiniteAtOrigin) :
    f.coordinateColength hfinite =
      intersectionMultiplicity (f.1.component 0) (f.1.component 1)
        (PointedMapGerm.components_haveFiniteIntersection f hfinite) := by
  let _ : Module.Finite ℂ (Germ 2 ⧸ f.1.coordinateIdeal) :=
    f.coordinateQuotient_moduleFinite hfinite
  let _ : Module.Finite ℂ
      (Germ 2 ⧸ pairIdeal (f.1.component 0) (f.1.component 1)) :=
    PointedMapGerm.components_haveFiniteIntersection f hfinite
  change Module.finrank ℂ (Germ 2 ⧸ f.1.coordinateIdeal) =
    Module.finrank ℂ
      (Germ 2 ⧸ pairIdeal (f.1.component 0) (f.1.component 1))
  rw [coordinateIdeal_eq_pairIdeal]

end OnLeConjecture.PlaneCurve
