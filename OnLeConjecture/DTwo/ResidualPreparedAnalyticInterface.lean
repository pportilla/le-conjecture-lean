module

public import OnLeConjecture.DTwo.HomogeneousEqualizerDescent
public import OnLeConjecture.DTwo.ResidualWeightedOrderExpansion

/-!
# Analytic interface for the prepared residual form

This file records the remaining interface between the prepared analytic
normal form in the order two argument and the residual weighted collision.
The primitive character determines the subgroup arithmetic. The coefficient
formula determines the bivariate polynomial model. Coefficient divisibility
of the three analytic corrections gives membership in the finite two weight
order ideals.
-/

public section

namespace OnLeConjecture.DTwo

open OnLeConjecture.Analytic
open OnLeConjecture.DThree

namespace Germ

/-- Coefficient divisibility expressing two weight order at least `D`.
For every first coordinate exponent below `D`, the corresponding one
variable coefficient is divisible by a power whose two weight reaches
`D`. -/
def TwoWeightCoefficientDivisibility
    (a b D : ℕ) (f : Germ 2) : Prop :=
  ∀ u < D, ∃ v : ℕ,
    D ≤ a * u + b * v ∧
      Germ.coordinate (0 : Fin 1) ^ v ∣
        Germ.firstCoordinateTaylorCoefficient u f

private theorem hyperplaneExtension_coordinate_one_residualInterface :
    Germ.hyperplaneExtension 1 (Germ.coordinate (0 : Fin 1)) =
      Germ.coordinate (1 : Fin 2) := by
  rw [Germ.hyperplaneExtension, PointedMapGerm.pullback_coordinate]
  apply Subtype.ext
  change
    ((MapGerm.ofFunction (Germ.hyperplaneTail 1)
      ((Germ.hyperplaneTail 1).analyticAt 0)).component 0).1 =
      (Germ.coordinate (1 : Fin 2)).1
  rw [MapGerm.component_ofFunction]
  rfl

/-- The coefficient divisibility condition implies membership in the
finite ideal generated by monomials of two weight at least `D`. -/
theorem mem_twoWeightOrderIdeal_of_twoWeightCoefficientDivisibility
    (a b D : ℕ) (ha : 0 < a) (hb : 0 < b) (f : Germ 2)
    (hdiv : Germ.TwoWeightCoefficientDivisibility a b D f) :
    f ∈ Germ.twoWeightOrderIdeal a b D := by
  rw [Germ.firstCoordinate_finite_expansion (d := D) f]
  apply Ideal.add_mem
  · apply Ideal.sum_mem
    intro u hu
    have huD : u < D := Finset.mem_range.mp hu
    obtain ⟨v, hweight, q, hq⟩ := hdiv u huD
    rw [hq, map_mul, map_pow,
      hyperplaneExtension_coordinate_one_residualInterface]
    have hmonomial :=
      Germ.monomial_mem_twoWeightOrderIdeal_of_threshold
        a b D u v ha hb hweight
    have hproduct :=
      Ideal.mul_mem_left (Germ.twoWeightOrderIdeal a b D)
        (Germ.hyperplaneExtension 1 q) hmonomial
    simpa [mul_assoc, mul_comm, mul_left_comm] using hproduct
  · have hweight : D ≤ a * D + b * 0 := by
      simpa using Nat.mul_le_mul_right D ha
    have hmonomial :=
      Germ.monomial_mem_twoWeightOrderIdeal_of_threshold
        a b D D 0 ha hb hweight
    have hproduct :=
      Ideal.mul_mem_left (Germ.twoWeightOrderIdeal a b D)
        (Germ.firstCoordinateTailIterate D f) hmonomial
    simpa [mul_comm] using hproduct

end Germ

/-- The polynomial initial map written directly from the coefficient
formula for the prepared odd family. -/
@[expose]
noncomputable def residualPreparedInitialPolynomials
    (k L N : ℕ) (c T : ℂ) (alpha : ℕ → ℂ) :
    Fin 3 → MvPolynomial (Fin 2) ℂ :=
  ![MvPolynomial.X 1 ^ k,
    MvPolynomial.C (-c) *
      (MvPolynomial.X 0 ^ 2 +
        MvPolynomial.C T * MvPolynomial.X 1 ^ L),
    MvPolynomial.bind₁
      (residualParameterPolynomialSubstitution L T)
      (preparedOddBivariatePolynomial N alpha)]

/-- The conclusions of the prepared analytic normal form needed by the
residual weighted collision. -/
structure ResidualPreparedAnalyticData
    (a k j L N : ℕ) (ζ c T : ℂ) (Psi : PreparedOddFamily N)
    (alpha : ℕ → ℂ) (representative : ℂ × ℂ → Fin 3 → ℂ) :
    Prop where
  two_le_a : 2 ≤ a
  k_eq_two_mul_a : k = 2 * a
  L_eq_k_add_j : L = k + j
  primitive_root : IsPrimitiveRoot ζ k
  primitive_character : ζ ^ j = -1
  three_le_N : 3 ≤ N
  c_ne_zero : c ≠ 0
  T_ne_zero : T ≠ 0
  coefficient_formula : ∀ parameter,
    Psi.polynomial parameter =
      ∑ h ∈ Finset.range (N / 2 + 1),
        _root_.Polynomial.C (alpha h * parameter ^ h) *
          _root_.Polynomial.X ^ (N - 2 * h)
  representative_analytic : AnalyticAt ℂ representative 0
  representative_zero : representative 0 = 0
  correction_coefficient_divisibility : ∀ i,
    Germ.TwoWeightCoefficientDivisibility L 2
      (residualWeightedDegrees k L N i + 1)
      (pairRepresentativeComponentGerm representative
          representative_analytic i -
        Germ.coordinatePolynomialAlgHom 2
          (residualPreparedInitialPolynomials k L N c T alpha i))

namespace ResidualPreparedAnalyticData

variable {a k j L N : ℕ} {ζ c T : ℂ} {Psi : PreparedOddFamily N}
  {alpha : ℕ → ℂ} {representative : ℂ × ℂ → Fin 3 → ℂ}

/-- The primitive character equation implies divisibility of its exponent
by the half order subgroup. -/
theorem a_dvd_j
    (data : ResidualPreparedAnalyticData
      a k j L N ζ c T Psi alpha representative) :
    a ∣ j := by
  have hpower : ζ ^ (j * 2) = 1 := by
    rw [pow_mul, data.primitive_character, neg_one_sq]
  have hdiv : k ∣ 2 * j := by
    apply data.primitive_root.dvd_of_pow_eq_one (2 * j)
    simpa [mul_comm] using hpower
  rw [data.k_eq_two_mul_a] at hdiv
  obtain ⟨q, hq⟩ := hdiv
  refine ⟨q, ?_⟩
  have hq' : 2 * j = 2 * (a * q) := by
    simpa [mul_assoc] using hq
  exact mul_left_cancel₀ (by norm_num : (2 : ℕ) ≠ 0) hq'

/-- The half order subgroup fixes the residual parameter exponent `L`. -/
theorem a_dvd_L
    (data : ResidualPreparedAnalyticData
      a k j L N ζ c T Psi alpha representative) :
    a ∣ L := by
  rw [data.L_eq_k_add_j]
  apply dvd_add
  · rw [data.k_eq_two_mul_a]
    exact ⟨2, by omega⟩
  · exact data.a_dvd_j

/-- The residual first source weight is positive. -/
theorem L_pos
    (data : ResidualPreparedAnalyticData
      a k j L N ζ c T Psi alpha representative) :
    0 < L := by
  have ha := data.two_le_a
  rw [data.L_eq_k_add_j, data.k_eq_two_mul_a]
  omega

/-- The coefficient formula supplies the bivariate model used by residual
weighted rescaling. -/
@[expose]
noncomputable def bivariateModel
    (data : ResidualPreparedAnalyticData
      a k j L N ζ c T Psi alpha representative) :
    Psi.BivariateModel where
  polynomial := preparedOddBivariatePolynomial N alpha
  specialization parameter := by
    rw [data.coefficient_formula parameter,
      parameterSpecialization_preparedOddBivariatePolynomial]
  weightedHomogeneous :=
    preparedOddBivariatePolynomial_isWeightedHomogeneous N alpha

/-- The model obtained from the coefficient formula has the displayed
prepared initial polynomials. -/
theorem residualWeightedInitialPolynomials_eq_prepared
    (data : ResidualPreparedAnalyticData
      a k j L N ζ c T Psi alpha representative) :
    residualWeightedInitialPolynomials k L c T Psi data.bivariateModel =
      residualPreparedInitialPolynomials k L N c T alpha := by
  funext i
  fin_cases i <;> rfl

/-- The subgroup arithmetic and the prepared odd family supply the initial
collision certificate. -/
theorem exists_collisionCertificate
    (data : ResidualPreparedAnalyticData
      a k j L N ζ c T Psi alpha representative) :
    Nonempty (InitialCollisionCertificate k L N c T Psi) :=
  exists_initialCollisionCertificate a k L N c T Psi
    data.two_le_a data.k_eq_two_mul_a data.a_dvd_L data.three_le_N
      data.c_ne_zero data.T_ne_zero

/-- A chosen initial collision certificate associated with the prepared
analytic data. -/
@[expose]
noncomputable def collisionCertificate
    (data : ResidualPreparedAnalyticData
      a k j L N ζ c T Psi alpha representative) :
    InitialCollisionCertificate k L N c T Psi :=
  Classical.choice data.exists_collisionCertificate

/-- Each analytic correction belongs to the required next two weight
order ideal. -/
theorem correction_mem_twoWeightOrderIdeal
    (data : ResidualPreparedAnalyticData
      a k j L N ζ c T Psi alpha representative) (i : Fin 3) :
    pairRepresentativeComponentGerm representative
          data.representative_analytic i -
        Germ.coordinatePolynomialAlgHom 2
          (residualWeightedInitialPolynomials k L c T Psi
            data.bivariateModel i) ∈
      Germ.twoWeightOrderIdeal L 2
        (residualWeightedDegrees k L N i + 1) := by
  rw [data.residualWeightedInitialPolynomials_eq_prepared]
  exact
    Germ.mem_twoWeightOrderIdeal_of_twoWeightCoefficientDivisibility
      L 2 (residualWeightedDegrees k L N i + 1) data.L_pos
        (by norm_num) _ (data.correction_coefficient_divisibility i)

/-- The prepared analytic data is incompatible with an injective
representative. -/
theorem not_hasInjectiveRepresentative
    (data : ResidualPreparedAnalyticData
      a k j L N ζ c T Psi alpha representative) :
    ¬ (PointedMapGerm.ofPairFunction representative
      data.representative_analytic
        data.representative_zero).HasInjectiveRepresentative := by
  exact residualWeightedModelOrderTails_not_hasInjectiveRepresentative
    data.bivariateModel data.collisionCertificate representative
      data.representative_analytic data.representative_zero
        data.correction_mem_twoWeightOrderIdeal data.L_pos

end ResidualPreparedAnalyticData

end OnLeConjecture.DTwo
