module

public import OnLeConjecture.Analytic.UnitCoordinateScaling
public import OnLeConjecture.Analytic.ParametricNodalLevelGraph
public import Mathlib.Algebra.Ring.GeomSum

/-!
# The coordinate substitution preserving a cyclic quadratic polynomial

The root used in the second coordinate is an analytic unit. Its constant
term need not be chosen in advance. The resulting substitution is
invertible and preserves the principal ideal generated by `y^k`.
-/

public section

open scoped BigOperators

namespace OnLeConjecture.DTwo.CyclicNormalization

open OnLeConjecture.Analytic OnLeConjecture.Analytic.Germ

/-- The analytic quotient of `(x+y^k T)^p-x^p` by `y^k`. -/
@[expose] noncomputable def powerQuotient {R : Type*} [CommRing R]
    (p k : ℕ) (x y T : R) : R :=
  T * ∑ i ∈ Finset.range p, (x + y ^ k * T) ^ i * x ^ (p - 1 - i)

theorem powerQuotient_identity {R : Type*} [CommRing R]
    (p k : ℕ) (x y T : R) :
    (x + y ^ k * T) ^ p = x ^ p + y ^ k * powerQuotient p k x y T := by
  have h := geom_sum₂_mul (x + y ^ k * T) x p
  simp only [add_sub_cancel_left] at h
  dsimp only [powerQuotient]
  linear_combination -h

theorem powerQuotient_zero {R : Type*} [CommRing R]
    (p k : ℕ) (hk : 0 < k) (x T : R) :
    powerQuotient p k x 0 T = T * (p * x ^ (p - 1)) := by
  simp only [powerQuotient, zero_pow hk.ne', zero_mul, add_zero, geom_sum₂_self]

theorem map_powerQuotient {R S : Type*} [CommRing R] [CommRing S]
    (f : R →+* S) (p k : ℕ) (x y T : R) :
    f (powerQuotient p k x y T) = powerQuotient p k (f x) (f y) (f T) := by
  simp only [powerQuotient, map_mul, map_sum, map_pow, map_add]

/-- The coordinate expression is an analytic equivalence whenever the
second-coordinate factor is a unit and `k≥2`. -/
theorem exists_substitution_equiv (k : ℕ) (hk : 2 ≤ k) (T v : Germ 2) (hv : IsUnit v) :
    ∃ e : PointedEquivGerm 2,
      e.forward.1.component 0 = coordinate 0 + coordinate 1 ^ k * T ∧
      e.forward.1.component 1 = coordinate 1 * v := by
  have htail : differential (coordinate (1 : Fin 2) ^ k * T) = 0 := by
    rw [differential_eq_zero_iff_partialDerivatives_vanish]
    intro i
    rw [partialDerivative_mul, partialDerivative_pow, map_add, map_mul]
    simp [nsmul_eq_mul, zero_pow (by omega : k - 1 ≠ 0), zero_pow (by omega : k ≠ 0)]
  let a : Fin 2 → ℂ := ![1, valueRingHom 2 v]
  have ha : ∀ i, a i ≠ 0 := by
    intro i
    fin_cases i
    · exact one_ne_zero
    · exact valueRingHom_ne_zero_of_isUnit hv
  obtain ⟨e, he⟩ := PointedMapGerm.exists_equiv_with_coordinate_pullbacks
    (![coordinate 0 + coordinate 1 ^ k * T, coordinate 1 * v] : Fin 2 → Germ 2)
    (by
      intro i
      fin_cases i
      · apply (maximalIdeal 2).add_mem (coordinate_mem_maximalIdeal 0)
        apply (maximalIdeal 2).mul_mem_right T
        exact Ideal.pow_mem_of_mem (maximalIdeal 2) (coordinate_mem_maximalIdeal 1) k (by omega)
      · exact (maximalIdeal 2).mul_mem_right v (coordinate_mem_maximalIdeal 1))
    (diagonalContinuousLinearEquiv a ha)
    (by
      intro i z
      fin_cases i
      · change differential (coordinate 0 + coordinate 1 ^ k * T) z = _
        rw [differential_add, htail]
        simp [diagonalContinuousLinearEquiv_apply, a, differential_coordinate_apply]
      · change differential (coordinate 1 * v) z = _
        rw [differential_mul]
        simp [diagonalContinuousLinearEquiv_apply, a, differential_coordinate_apply])
  refine ⟨e, ?_, ?_⟩
  · have hzero := he 0
    rw [PointedMapGerm.pullback_coordinate] at hzero
    exact hzero
  · have hone := he 1
    rw [PointedMapGerm.pullback_coordinate] at hone
    exact hone

/-- The root equation proves exact preservation of `x²+y^k`. -/
theorem substitution_preserves_quadratic (k : ℕ) (T v : Germ 2)
    (hroot : v ^ k = 1 - 2 * coordinate 0 * T - coordinate 1 ^ k * T ^ 2)
    (e : PointedEquivGerm 2)
    (he0 : e.forward.1.component 0 = coordinate 0 + coordinate 1 ^ k * T)
    (he1 : e.forward.1.component 1 = coordinate 1 * v) :
    e.pullbackAlgEquiv (coordinate 0 ^ 2 + coordinate 1 ^ k) =
      coordinate 0 ^ 2 + coordinate 1 ^ k := by
  change e.forward.pullbackRingHom _ = _
  rw [map_add, map_pow, map_pow, PointedMapGerm.pullback_coordinate,
    PointedMapGerm.pullback_coordinate, he0, he1, mul_pow, hroot]
  ring

/-- The principal ideal `(y^k)` is preserved, in both directions. -/
theorem substitution_preserves_coordinate_ideal (k : ℕ) (v : Germ 2) (hv : IsUnit v)
    (e : PointedEquivGerm 2)
    (he1 : e.forward.1.component 1 = coordinate 1 * v) :
    Ideal.map e.forward.pullbackRingHom (Ideal.span {coordinate (1 : Fin 2) ^ k}) =
      Ideal.span {coordinate (1 : Fin 2) ^ k} := by
  rw [Ideal.map_span, Set.image_singleton, map_pow,
    PointedMapGerm.pullback_coordinate, he1, mul_pow]
  exact Ideal.span_singleton_mul_right_unit (hv.pow k) _

end OnLeConjecture.DTwo.CyclicNormalization
