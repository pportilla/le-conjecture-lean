module

public import OnLeConjecture.Analytic.MapInitialForms
public import OnLeConjecture.DTwo.QuadraticJetAlgebra

/-!
# Boundary for the classification of quadratic jets

The algebraic part of the classification is complete in this module. Once
geometric arguments exclude a pair of nonproportional quadratic initial
forms and exclude a line generated by a quadratic with nonzero discriminant,
the whole quadratic jet is generated by the square of a linear form.

The two exclusion properties below isolate the missing geometric input. They
are propositions, not axioms. In the article, the first combines polar and
point basis arguments with the semicontinuity argument for a basepoint free
pencil. The second uses the extremal polar calculation before the orbit
collision argument.
-/

public section

namespace OnLeConjecture.DTwo

open OnLeConjecture.Analytic

/-- A family contains two nonzero forms that are not scalar multiples of
one another. Both nonzero conditions are needed when some jets vanish. -/
def ContainsNonproportionalQuadraticPair
    {m : ℕ} (P : Fin m → OrbitSourceForm) : Prop :=
  ∃ i j, P i ≠ 0 ∧ P j ≠ 0 ∧
    ¬ ∃ coefficient : ℂ, P i = MvPolynomial.C coefficient * P j

theorem containsNonproportionalQuadraticPair_iff
    {m : ℕ} (P : Fin m → OrbitSourceForm) :
    ContainsNonproportionalQuadraticPair P ↔
      ∃ i j, P i ≠ 0 ∧ P j ≠ 0 ∧
        ¬ ∃ coefficient : ℂ, P i = MvPolynomial.C coefficient * P j := by rfl

/-- A single nonzero square jet accompanied by zero jets is not a
higher-rank quadratic family. -/
theorem not_containsNonproportionalQuadraticPair_square_zero_zero :
    ¬ ContainsNonproportionalQuadraticPair
      (![MvPolynomial.X 0 ^ 2, 0, 0] : Fin 3 → OrbitSourceForm) := by
  rintro ⟨i, j, hi, hj, hij⟩
  fin_cases i <;> fin_cases j <;> simp at hi hj
  exact hij ⟨1, by simp⟩

/-- A family is generated by a homogeneous quadratic with nonzero
discriminant. -/
@[expose]
def IsGeneratedByNonsquareQuadratic
    {m : ℕ} (P : Fin m → OrbitSourceForm) : Prop :=
  ∃ Q : OrbitSourceForm,
    Q.IsHomogeneous 2 ∧ Q ≠ 0 ∧
      binaryQuadraticDiscriminant Q ≠ 0 ∧
      ∀ i, ∃ coefficient : ℂ,
        P i = MvPolynomial.C coefficient * Q

/-- A family is generated by the square of a nonzero homogeneous linear
form. -/
def IsGeneratedByLinearSquare
    {m : ℕ} (P : Fin m → OrbitSourceForm) : Prop :=
  ∃ u v : ℂ, (u ≠ 0 ∨ v ≠ 0) ∧
      ∀ i, ∃ coefficient : ℂ,
        P i = MvPolynomial.C coefficient * binaryLinearForm u v ^ 2

/-- A nonzero family of homogeneous quadratics with no nonproportional pair
is generated either by a linear square or by a quadratic with nonzero
discriminant. -/
theorem generatedByLinearSquare_or_generatedByNonsquareQuadratic
    {m : ℕ} {P : Fin m → OrbitSourceForm}
    (hP : ∀ i, (P i).IsHomogeneous 2)
    (hnonzero : ∃ i, P i ≠ 0)
    (hpair : ¬ ContainsNonproportionalQuadraticPair P) :
    IsGeneratedByLinearSquare P ∨
      IsGeneratedByNonsquareQuadratic P := by
  classical
  obtain ⟨j, hj⟩ := hnonzero
  have hmultiple : ∀ i, ∃ coefficient : ℂ,
      P i = MvPolynomial.C coefficient * P j := by
    intro i
    by_contra hi
    have hine : P i ≠ 0 := by
      intro hzero
      exact hi ⟨0, by simp [hzero]⟩
    exact hpair ⟨i, j, hine, hj, hi⟩
  by_cases hdiscriminant : binaryQuadraticDiscriminant (P j) = 0
  · obtain ⟨scalar, u, v, hscalar, huv, hjSquare⟩ :=
      exists_scalar_mul_linear_sq_of_discriminant_eq_zero
        (hP j) hj hdiscriminant
    refine Or.inl ⟨u, v, huv, ?_⟩
    intro i
    obtain ⟨coefficient, hi⟩ := hmultiple i
    refine ⟨coefficient * scalar, ?_⟩
    rw [hi, hjSquare, map_mul]
    ring
  · exact Or.inr ⟨P j, hP j, hj, hdiscriminant, hmultiple⟩

/-- Excluding the nonsquare alternative turns the one dimensional
classification into the square conclusion. -/
theorem generatedByLinearSquare_of_quadratic_exclusions
    {m : ℕ} {P : Fin m → OrbitSourceForm}
    (hP : ∀ i, (P i).IsHomogeneous 2)
    (hnonzero : ∃ i, P i ≠ 0)
    (hpair : ¬ ContainsNonproportionalQuadraticPair P)
    (hnonsquare : ¬ IsGeneratedByNonsquareQuadratic P) :
    IsGeneratedByLinearSquare P := by
  exact (generatedByLinearSquare_or_generatedByNonsquareQuadratic
    hP hnonzero hpair).resolve_right hnonsquare

/-- The geometric assertion needed to reduce the quadratic initial forms of
one analytic map to a one dimensional family. -/
def QuadraticJetHigherRankExcluded
    {m : ℕ} (f : PointedMapGerm 2 m) : Prop :=
  ∀ P : Fin m → OrbitSourceForm,
    (∀ i, (P i).IsHomogeneous 2) →
    (∀ i, f.1.component i - Germ.coordinatePolynomialAlgHom 2 (P i) ∈
      Germ.maximalIdeal 2 ^ 3) →
    (∃ i, P i ≠ 0) →
    ¬ ContainsNonproportionalQuadraticPair P

theorem quadraticJetHigherRankExcluded_iff
    {m : ℕ} (f : PointedMapGerm 2 m) :
    QuadraticJetHigherRankExcluded f ↔
      ∀ P : Fin m → OrbitSourceForm,
        (∀ i, (P i).IsHomogeneous 2) →
        (∀ i, f.1.component i - Germ.coordinatePolynomialAlgHom 2 (P i) ∈
          Germ.maximalIdeal 2 ^ 3) →
        (∃ i, P i ≠ 0) → ¬ ContainsNonproportionalQuadraticPair P := by rfl

/-- The geometric assertion needed to exclude a one dimensional quadratic
jet generated by a form with nonzero discriminant. -/
@[expose]
def QuadraticJetNonsquareLineExcluded
    {m : ℕ} (f : PointedMapGerm 2 m) : Prop :=
  ∀ P : Fin m → OrbitSourceForm,
    (∀ i, (P i).IsHomogeneous 2) →
    (∀ i, f.1.component i - Germ.coordinatePolynomialAlgHom 2 (P i) ∈
      Germ.maximalIdeal 2 ^ 3) →
    (∃ i, P i ≠ 0) →
    ¬ IsGeneratedByNonsquareQuadratic P

/-- The two geometric exclusions imply that all quadratic initial forms of
an order two finite map are multiples of one linear square. -/
theorem exists_linearSquare_coordinateInitialForms_of_exclusions
    {m : ℕ} (f : PointedMapGerm 2 m) (hfinite : f.IsFiniteAtOrigin)
    (horder : f.coordinateOrder (by omega) hfinite = 2)
    (hhigher : QuadraticJetHigherRankExcluded f)
    (hnonsquare : QuadraticJetNonsquareLineExcluded f) :
    ∃ u v : ℂ, ∃ coefficients : Fin m → ℂ,
      (u ≠ 0 ∨ v ≠ 0) ∧ (∃ i, coefficients i ≠ 0) ∧
      ∀ i, f.1.component i - Germ.coordinatePolynomialAlgHom 2
          (MvPolynomial.C (coefficients i) *
            binaryLinearForm u v ^ 2) ∈
        Germ.maximalIdeal 2 ^ 3 := by
  classical
  obtain ⟨P, hP, htail, hnonzero⟩ :=
    f.exists_coordinateInitialForms (by omega) hfinite
  have hPhomogeneous : ∀ i, (P i).IsHomogeneous 2 := by
    intro i
    simpa only [horder] using hP i
  have hPtail : ∀ i,
      f.1.component i - Germ.coordinatePolynomialAlgHom 2 (P i) ∈
        Germ.maximalIdeal 2 ^ 3 := by
    intro i
    simpa only [horder, Nat.reduceAdd] using htail i
  have hsquare : IsGeneratedByLinearSquare P :=
    generatedByLinearSquare_of_quadratic_exclusions
      hPhomogeneous hnonzero
        (hhigher P hPhomogeneous hPtail hnonzero)
        (hnonsquare P hPhomogeneous hPtail hnonzero)
  obtain ⟨u, v, huv, hmultiple⟩ := hsquare
  choose coefficients hcoefficients using hmultiple
  have hcoefficientNonzero : ∃ i, coefficients i ≠ 0 := by
    obtain ⟨i, hi⟩ := hnonzero
    refine ⟨i, ?_⟩
    intro hzero
    apply hi
    rw [hcoefficients i, hzero, map_zero, zero_mul]
  refine ⟨u, v, coefficients, huv, hcoefficientNonzero, ?_⟩
  intro i
  rw [← hcoefficients i]
  exact hPtail i

/-- If injectivity supplies the two geometric exclusions, then the quadratic
jet is generated by one linear square. -/
theorem exists_linearSquare_coordinateInitialForms_of_injective_boundary
    {m : ℕ} (f : PointedMapGerm 2 m) (hfinite : f.IsFiniteAtOrigin)
    (hinjective : f.HasInjectiveRepresentative)
    (horder : f.coordinateOrder (by omega) hfinite = 2)
    (hgeometric : f.HasInjectiveRepresentative →
      QuadraticJetHigherRankExcluded f ∧
        QuadraticJetNonsquareLineExcluded f) :
    ∃ u v : ℂ, ∃ coefficients : Fin m → ℂ,
      (u ≠ 0 ∨ v ≠ 0) ∧ (∃ i, coefficients i ≠ 0) ∧
      ∀ i, f.1.component i - Germ.coordinatePolynomialAlgHom 2
          (MvPolynomial.C (coefficients i) *
            binaryLinearForm u v ^ 2) ∈
        Germ.maximalIdeal 2 ^ 3 := by
  obtain ⟨hhigher, hnonsquare⟩ := hgeometric hinjective
  exact exists_linearSquare_coordinateInitialForms_of_exclusions
    f hfinite horder hhigher hnonsquare

end OnLeConjecture.DTwo
