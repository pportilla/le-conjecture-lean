module

public import OnLeConjecture.DTwo.HomogeneousEqualizerQuotient
public import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# Comparison with the quotient in four variables

This file identifies the iterated `AdjoinRoot` construction used for the
homogeneous equalizer with one quotient of the polynomial ring in the four
variables `x`, `T`, `X`, and `y`.
-/

public section

namespace OnLeConjecture.DTwo

open _root_.Polynomial

/-- The four coordinates in the quotient presentation. -/
inductive EqualizerCoordinate where
  | source
  | parameter
  | component
  | sector
  deriving DecidableEq

/-- The polynomial ring `ℂ[x,T,X,y]`. -/
abbrev EqualizerOneShotPolynomial :=
  MvPolynomial EqualizerCoordinate ℂ

/-- The equation `X² - x² - (1 - χ)T`. -/
noncomputable def oneShotComponentRelation (χ : ℂ) :
    EqualizerOneShotPolynomial :=
  MvPolynomial.X EqualizerCoordinate.component ^ 2 -
    MvPolynomial.X EqualizerCoordinate.source ^ 2 -
      MvPolynomial.C (1 - χ) * MvPolynomial.X EqualizerCoordinate.parameter

/-- The equation `y^L - τ⁻¹T`. -/
noncomputable def oneShotSectorRelation (τ : ℂ) (L : ℕ) :
    EqualizerOneShotPolynomial :=
  MvPolynomial.X EqualizerCoordinate.sector ^ L -
    MvPolynomial.C τ⁻¹ * MvPolynomial.X EqualizerCoordinate.parameter

/-- The ideal generated by the component and sector equations. -/
noncomputable def equalizerOneShotIdeal (τ χ : ℂ) (L : ℕ) :
    Ideal EqualizerOneShotPolynomial :=
  Ideal.span {oneShotComponentRelation χ, oneShotSectorRelation τ L}

/-- The coordinate ring defined by both equations at once. -/
abbrev EqualizerOneShotRing (τ χ : ℂ) (L : ℕ) :=
  EqualizerOneShotPolynomial ⧸ equalizerOneShotIdeal τ χ L

/-- The class of a coordinate in the one quotient presentation. -/
noncomputable def oneShotCoordinate (τ χ : ℂ) (L : ℕ)
    (v : EqualizerCoordinate) : EqualizerOneShotRing τ χ L :=
  Ideal.Quotient.mk (equalizerOneShotIdeal τ χ L) (MvPolynomial.X v)

theorem oneShotCoordinate_eq (τ χ : ℂ) (L : ℕ)
    (v : EqualizerCoordinate) :
    oneShotCoordinate τ χ L v =
      Ideal.Quotient.mk (equalizerOneShotIdeal τ χ L)
        (MvPolynomial.X v) := by
  rfl

theorem oneShotComponentRelation_eq_zero (τ χ : ℂ) (L : ℕ) :
    Ideal.Quotient.mk (equalizerOneShotIdeal τ χ L)
        (oneShotComponentRelation χ) = 0 := by
  rw [Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span (Set.mem_insert _ _)

theorem oneShotSectorRelation_eq_zero (τ χ : ℂ) (L : ℕ) :
    Ideal.Quotient.mk (equalizerOneShotIdeal τ χ L)
        (oneShotSectorRelation τ L) = 0 := by
  rw [Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))

/-- The component equation in the one quotient presentation. -/
theorem oneShotComponentCoordinate_sq (τ χ : ℂ) (L : ℕ) :
    oneShotCoordinate τ χ L EqualizerCoordinate.component ^ 2 =
      oneShotCoordinate τ χ L EqualizerCoordinate.source ^ 2 +
        algebraMap ℂ (EqualizerOneShotRing τ χ L) (1 - χ) *
          oneShotCoordinate τ χ L EqualizerCoordinate.parameter := by
  have h := oneShotComponentRelation_eq_zero τ χ L
  simp only [oneShotComponentRelation, map_sub, map_pow, map_mul,
    sub_eq_zero] at h
  change oneShotCoordinate τ χ L EqualizerCoordinate.component ^ 2 -
      oneShotCoordinate τ χ L EqualizerCoordinate.source ^ 2 =
    (1 - algebraMap ℂ (EqualizerOneShotRing τ χ L) χ) *
      oneShotCoordinate τ χ L EqualizerCoordinate.parameter at h
  rw [map_sub, map_one]
  linear_combination h

/-- The sector equation in the one quotient presentation. -/
theorem oneShotSectorCoordinate_pow (τ χ : ℂ) (L : ℕ) :
    oneShotCoordinate τ χ L EqualizerCoordinate.sector ^ L =
      algebraMap ℂ (EqualizerOneShotRing τ χ L) τ⁻¹ *
        oneShotCoordinate τ χ L EqualizerCoordinate.parameter := by
  have h := oneShotSectorRelation_eq_zero τ χ L
  simp only [oneShotSectorRelation, map_sub, map_pow, map_mul,
    sub_eq_zero] at h
  change oneShotCoordinate τ χ L EqualizerCoordinate.sector ^ L =
    algebraMap ℂ (EqualizerOneShotRing τ χ L) τ⁻¹ *
      oneShotCoordinate τ χ L EqualizerCoordinate.parameter at h
  exact h

/-- The images of the four coordinates in the iterated presentation. -/
noncomputable def iteratedCoordinate (τ χ : ℂ) (L : ℕ) :
    EqualizerCoordinate → EqualizerSectorRing τ χ L
  | .source =>
      algebraMap (EqualizerComponentRing χ) (EqualizerSectorRing τ χ L)
        (algebraMap EqualizerBaseRing (EqualizerComponentRing χ) X)
  | .parameter =>
      algebraMap (EqualizerComponentRing χ) (EqualizerSectorRing τ χ L)
        (algebraMap EqualizerBaseRing (EqualizerComponentRing χ) (C X))
  | .component =>
      algebraMap (EqualizerComponentRing χ) (EqualizerSectorRing τ χ L)
        (AdjoinRoot.root (componentPolynomial χ))
  | .sector => AdjoinRoot.root (sectorPolynomial τ χ L)

/-- The component coordinate in the iterated presentation. -/
theorem iteratedCoordinate_component_eq (τ χ : ℂ) (L : ℕ) :
    iteratedCoordinate τ χ L .component =
      algebraMap (EqualizerComponentRing χ) (EqualizerSectorRing τ χ L)
        (AdjoinRoot.root (componentPolynomial χ)) := by rfl

theorem iteratedCoordinate_sector_eq (τ χ : ℂ) (L : ℕ) :
    iteratedCoordinate τ χ L .sector = AdjoinRoot.root (sectorPolynomial τ χ L) := by rfl

/-- The defining equation for the second adjoined root. -/
theorem sectorRoot_pow (τ χ : ℂ) (L : ℕ) :
    AdjoinRoot.root (sectorPolynomial τ χ L) ^ L =
      algebraMap (EqualizerComponentRing χ) (EqualizerSectorRing τ χ L)
        (scaledParameterInComponent τ χ) := by
  have hroot := AdjoinRoot.eval₂_root (sectorPolynomial τ χ L)
  rw [sectorPolynomial_eq, _root_.Polynomial.eval₂_sub,
    _root_.Polynomial.eval₂_pow, _root_.Polynomial.eval₂_X,
    _root_.Polynomial.eval₂_C, sub_eq_zero] at hroot
  rw [← sectorPolynomial_eq τ χ L] at hroot
  exact hroot

theorem iterated_algebraMap_complex (τ χ : ℂ) (L : ℕ) (c : ℂ) :
    algebraMap (EqualizerComponentRing χ) (EqualizerSectorRing τ χ L)
        (algebraMap EqualizerBaseRing (EqualizerComponentRing χ)
          (C (C c))) =
      algebraMap ℂ (EqualizerSectorRing τ χ L) c := by
  have hbase : (C (C c) : EqualizerBaseRing) =
      algebraMap ℂ EqualizerBaseRing c := by
    simp only [Polynomial.algebraMap_apply, Algebra.algebraMap_self,
      RingHom.id_apply]
  rw [hbase,
    ← IsScalarTower.algebraMap_apply ℂ EqualizerBaseRing
      (EqualizerComponentRing χ),
    ← IsScalarTower.algebraMap_apply ℂ (EqualizerComponentRing χ)
      (EqualizerSectorRing τ χ L)]

theorem iteratedComponentCoordinate_sq (τ χ : ℂ) (L : ℕ) :
    iteratedCoordinate τ χ L EqualizerCoordinate.component ^ 2 =
      iteratedCoordinate τ χ L EqualizerCoordinate.source ^ 2 +
        algebraMap ℂ (EqualizerSectorRing τ χ L) (1 - χ) *
          iteratedCoordinate τ χ L EqualizerCoordinate.parameter := by
  change
    (algebraMap (EqualizerComponentRing χ) (EqualizerSectorRing τ χ L)
      (AdjoinRoot.root (componentPolynomial χ))) ^ 2 = _
  rw [← map_pow, componentRoot_sq]
  rw [componentSquare_eq]
  simp only [map_add, map_pow, map_mul, map_one, map_sub,
    AdjoinRoot.algebraMap_eq, iteratedCoordinate]
  change _ + (1 -
      algebraMap (EqualizerComponentRing χ) (EqualizerSectorRing τ χ L)
        (algebraMap EqualizerBaseRing (EqualizerComponentRing χ) (C (C χ)))) * _ =
    _ + (1 - algebraMap ℂ (EqualizerSectorRing τ χ L) χ) * _
  rw [iterated_algebraMap_complex]

theorem iteratedSectorCoordinate_pow (τ χ : ℂ) (L : ℕ) :
    iteratedCoordinate τ χ L EqualizerCoordinate.sector ^ L =
      algebraMap ℂ (EqualizerSectorRing τ χ L) τ⁻¹ *
        iteratedCoordinate τ χ L EqualizerCoordinate.parameter := by
  change AdjoinRoot.root (sectorPolynomial τ χ L) ^ L = _
  rw [sectorRoot_pow, scaledParameterInComponent_eq]
  simp only [map_mul, AdjoinRoot.algebraMap_eq, iteratedCoordinate]
  change
    algebraMap (EqualizerComponentRing χ) (EqualizerSectorRing τ χ L)
        (algebraMap EqualizerBaseRing (EqualizerComponentRing χ) (C (C τ⁻¹))) * _ =
      algebraMap ℂ (EqualizerSectorRing τ χ L) τ⁻¹ * _
  rw [iterated_algebraMap_complex]

/-- Evaluation of the four variable polynomial ring in the iterated
presentation. -/
noncomputable def oneShotEvaluation (τ χ : ℂ) (L : ℕ) :
    EqualizerOneShotPolynomial →ₐ[ℂ] EqualizerSectorRing τ χ L :=
  MvPolynomial.aeval (iteratedCoordinate τ χ L)

theorem oneShotEvaluation_eq (τ χ : ℂ) (L : ℕ) :
    oneShotEvaluation τ χ L =
      MvPolynomial.aeval (iteratedCoordinate τ χ L) := by
  rfl

theorem oneShotEvaluation_componentRelation (τ χ : ℂ) (L : ℕ) :
    oneShotEvaluation τ χ L (oneShotComponentRelation χ) = 0 := by
  rw [oneShotComponentRelation]
  rw [oneShotEvaluation_eq]
  simp only [map_sub, map_pow, map_mul, MvPolynomial.aeval_X,
    MvPolynomial.aeval_C]
  rw [iteratedComponentCoordinate_sq]
  rw [map_sub, map_one]
  ring

theorem oneShotEvaluation_sectorRelation (τ χ : ℂ) (L : ℕ) :
    oneShotEvaluation τ χ L (oneShotSectorRelation τ L) = 0 := by
  rw [oneShotSectorRelation]
  rw [oneShotEvaluation_eq]
  simp only [map_sub, map_pow, map_mul, MvPolynomial.aeval_X,
    MvPolynomial.aeval_C]
  exact sub_eq_zero.mpr (iteratedSectorCoordinate_pow τ χ L)

theorem equalizerOneShotIdeal_le_evaluation_ker (τ χ : ℂ) (L : ℕ) :
    equalizerOneShotIdeal τ χ L ≤
      RingHom.ker (oneShotEvaluation τ χ L).toRingHom := by
  rw [equalizerOneShotIdeal]
  apply Ideal.span_le.2
  intro p hp
  rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hp
  rcases hp with rfl | rfl
  · exact (RingHom.mem_ker).2
      (oneShotEvaluation_componentRelation τ χ L)
  · exact (RingHom.mem_ker).2
      (oneShotEvaluation_sectorRelation τ χ L)

/-- The map from the one quotient presentation to the iterated
`AdjoinRoot` presentation. -/
noncomputable def oneShotToIterated (τ χ : ℂ) (L : ℕ) :
    EqualizerOneShotRing τ χ L →ₐ[ℂ] EqualizerSectorRing τ χ L :=
  Ideal.Quotient.liftₐ (equalizerOneShotIdeal τ χ L)
    (oneShotEvaluation τ χ L) fun _p hp ↦
      (RingHom.mem_ker).1 (equalizerOneShotIdeal_le_evaluation_ker τ χ L hp)

theorem oneShotToIterated_eq (τ χ : ℂ) (L : ℕ) :
    oneShotToIterated τ χ L =
      Ideal.Quotient.liftₐ (equalizerOneShotIdeal τ χ L)
        (oneShotEvaluation τ χ L) fun _p hp ↦
          (RingHom.mem_ker).1
            (equalizerOneShotIdeal_le_evaluation_ker τ χ L hp) := by
  rfl

@[simp]
theorem oneShotToIterated_mk
    (τ χ : ℂ) (L : ℕ) (p : EqualizerOneShotPolynomial) :
    oneShotToIterated τ χ L
        (Ideal.Quotient.mk (equalizerOneShotIdeal τ χ L) p) =
      oneShotEvaluation τ χ L p := by
  rfl

@[simp]
theorem oneShotToIterated_coordinate
    (τ χ : ℂ) (L : ℕ) (v : EqualizerCoordinate) :
    oneShotToIterated τ χ L (oneShotCoordinate τ χ L v) =
      iteratedCoordinate τ χ L v := by
  rw [oneShotCoordinate_eq, oneShotToIterated_mk,
    oneShotEvaluation_eq, MvPolynomial.aeval_X]

/-- Evaluation of `ℂ[T]` at the class of `T` in the one quotient
presentation. -/
noncomputable def parameterToOneShot (τ χ : ℂ) (L : ℕ) :
    EqualizerParameterRing →ₐ[ℂ] EqualizerOneShotRing τ χ L :=
  _root_.Polynomial.aeval
    (oneShotCoordinate τ χ L EqualizerCoordinate.parameter)

theorem parameterToOneShot_eq (τ χ : ℂ) (L : ℕ) :
    parameterToOneShot τ χ L =
      _root_.Polynomial.aeval
        (oneShotCoordinate τ χ L EqualizerCoordinate.parameter) := by
  rfl

@[simp]
theorem parameterToOneShot_X (τ χ : ℂ) (L : ℕ) :
    parameterToOneShot τ χ L X =
      oneShotCoordinate τ χ L EqualizerCoordinate.parameter := by
  rw [parameterToOneShot_eq, _root_.Polynomial.aeval_X]

/-- Evaluation of `ℂ[T][x]` at the classes of `T` and `x`. -/
noncomputable def baseToOneShot (τ χ : ℂ) (L : ℕ) :
    EqualizerBaseRing →ₐ[ℂ] EqualizerOneShotRing τ χ L :=
  _root_.Polynomial.eval₂AlgHom (parameterToOneShot τ χ L)
    (oneShotCoordinate τ χ L EqualizerCoordinate.source)
    fun _ ↦ Commute.all _ _

theorem baseToOneShot_eq (τ χ : ℂ) (L : ℕ) :
    baseToOneShot τ χ L =
      _root_.Polynomial.eval₂AlgHom (parameterToOneShot τ χ L)
        (oneShotCoordinate τ χ L EqualizerCoordinate.source)
        (fun _ ↦ Commute.all _ _) := by
  rfl

@[simp]
theorem baseToOneShot_X (τ χ : ℂ) (L : ℕ) :
    baseToOneShot τ χ L X =
      oneShotCoordinate τ χ L EqualizerCoordinate.source := by
  rw [baseToOneShot_eq, _root_.Polynomial.eval₂AlgHom_apply,
    _root_.Polynomial.eval₂_X]

@[simp]
theorem baseToOneShot_C_X (τ χ : ℂ) (L : ℕ) :
    baseToOneShot τ χ L (C X) =
      oneShotCoordinate τ χ L EqualizerCoordinate.parameter := by
  rw [baseToOneShot_eq, _root_.Polynomial.eval₂AlgHom_apply,
    _root_.Polynomial.eval₂_C]
  change parameterToOneShot τ χ L X = _
  rw [parameterToOneShot_X]

theorem baseToOneShot_componentSquare (τ χ : ℂ) (L : ℕ) :
    baseToOneShot τ χ L (componentSquare χ) =
      oneShotCoordinate τ χ L EqualizerCoordinate.source ^ 2 +
        algebraMap ℂ (EqualizerOneShotRing τ χ L) (1 - χ) *
          oneShotCoordinate τ χ L EqualizerCoordinate.parameter := by
  rw [componentSquare_eq, map_add, map_pow, baseToOneShot_X,
    baseToOneShot_eq, _root_.Polynomial.eval₂AlgHom_apply,
    _root_.Polynomial.eval₂_C, map_mul]
  change _ + parameterToOneShot τ χ L (C (1 - χ)) *
      parameterToOneShot τ χ L X = _
  rw [parameterToOneShot_X]
  rw [parameterToOneShot_eq, _root_.Polynomial.aeval_C]

theorem componentPolynomial_eval₂_baseToOneShot_eq_zero
    (τ χ : ℂ) (L : ℕ) :
    (componentPolynomial χ).eval₂ (baseToOneShot τ χ L)
        (oneShotCoordinate τ χ L EqualizerCoordinate.component) = 0 := by
  rw [componentPolynomial_eq, _root_.Polynomial.eval₂_sub,
    _root_.Polynomial.eval₂_pow, _root_.Polynomial.eval₂_X,
    _root_.Polynomial.eval₂_C]
  change oneShotCoordinate τ χ L EqualizerCoordinate.component ^ 2 -
    baseToOneShot τ χ L (componentSquare χ) = 0
  rw [baseToOneShot_componentSquare]
  exact sub_eq_zero.mpr (oneShotComponentCoordinate_sq τ χ L)

theorem baseToOneShot_C_parameter_mul
    (τ χ c : ℂ) (L : ℕ) :
    baseToOneShot τ χ L (C (C c * X)) =
      algebraMap ℂ (EqualizerOneShotRing τ χ L) c *
        oneShotCoordinate τ χ L EqualizerCoordinate.parameter := by
  rw [baseToOneShot_eq, _root_.Polynomial.eval₂AlgHom_apply,
    _root_.Polynomial.eval₂_C]
  change parameterToOneShot τ χ L (C c * X) = _
  rw [map_mul, parameterToOneShot_X, parameterToOneShot_eq,
    _root_.Polynomial.aeval_C]

/-- The map from the quadratic component to the one quotient
presentation. -/
noncomputable def componentToOneShot (τ χ : ℂ) (L : ℕ) :
    EqualizerComponentRing χ →ₐ[ℂ] EqualizerOneShotRing τ χ L :=
  AdjoinRoot.liftAlgHom (componentPolynomial χ) (baseToOneShot τ χ L)
    (oneShotCoordinate τ χ L EqualizerCoordinate.component)
    (componentPolynomial_eval₂_baseToOneShot_eq_zero τ χ L)

theorem componentToOneShot_eq (τ χ : ℂ) (L : ℕ) :
    componentToOneShot τ χ L =
      AdjoinRoot.liftAlgHom (componentPolynomial χ) (baseToOneShot τ χ L)
        (oneShotCoordinate τ χ L EqualizerCoordinate.component)
        (componentPolynomial_eval₂_baseToOneShot_eq_zero τ χ L) := by
  rfl

@[simp]
theorem componentToOneShot_root (τ χ : ℂ) (L : ℕ) :
    componentToOneShot τ χ L
        (AdjoinRoot.root (componentPolynomial χ)) =
      oneShotCoordinate τ χ L EqualizerCoordinate.component := by
  rw [componentToOneShot_eq, AdjoinRoot.liftAlgHom_root]

@[simp]
theorem componentToOneShot_algebraMap
    (τ χ : ℂ) (L : ℕ) (p : EqualizerBaseRing) :
    componentToOneShot τ χ L
        (algebraMap EqualizerBaseRing (EqualizerComponentRing χ) p) =
      baseToOneShot τ χ L p := by
  change componentToOneShot τ χ L (AdjoinRoot.of (componentPolynomial χ) p) = _
  rw [componentToOneShot_eq, AdjoinRoot.liftAlgHom_of]

theorem componentToOneShot_scaledParameter
    (τ χ : ℂ) (L : ℕ) :
    componentToOneShot τ χ L (scaledParameterInComponent τ χ) =
      algebraMap ℂ (EqualizerOneShotRing τ χ L) τ⁻¹ *
        oneShotCoordinate τ χ L EqualizerCoordinate.parameter := by
  rw [scaledParameterInComponent_eq, componentToOneShot_algebraMap,
    baseToOneShot_C_parameter_mul]

theorem sectorPolynomial_eval₂_componentToOneShot_eq_zero
    (τ χ : ℂ) (L : ℕ) :
    (sectorPolynomial τ χ L).eval₂ (componentToOneShot τ χ L)
        (oneShotCoordinate τ χ L EqualizerCoordinate.sector) = 0 := by
  rw [sectorPolynomial_eq, _root_.Polynomial.eval₂_sub,
    _root_.Polynomial.eval₂_pow, _root_.Polynomial.eval₂_X,
    _root_.Polynomial.eval₂_C]
  change oneShotCoordinate τ χ L EqualizerCoordinate.sector ^ L -
    componentToOneShot τ χ L (scaledParameterInComponent τ χ) = 0
  rw [componentToOneShot_scaledParameter]
  exact sub_eq_zero.mpr (oneShotSectorCoordinate_pow τ χ L)

/-- The map from the iterated `AdjoinRoot` presentation to the one quotient
presentation. -/
noncomputable def iteratedToOneShot (τ χ : ℂ) (L : ℕ) :
    EqualizerSectorRing τ χ L →ₐ[ℂ] EqualizerOneShotRing τ χ L :=
  AdjoinRoot.liftAlgHom (sectorPolynomial τ χ L)
    (componentToOneShot τ χ L)
    (oneShotCoordinate τ χ L EqualizerCoordinate.sector)
    (sectorPolynomial_eval₂_componentToOneShot_eq_zero τ χ L)

theorem iteratedToOneShot_eq (τ χ : ℂ) (L : ℕ) :
    iteratedToOneShot τ χ L =
      AdjoinRoot.liftAlgHom (sectorPolynomial τ χ L)
        (componentToOneShot τ χ L)
        (oneShotCoordinate τ χ L EqualizerCoordinate.sector)
        (sectorPolynomial_eval₂_componentToOneShot_eq_zero τ χ L) := by
  rfl

@[simp]
theorem iteratedToOneShot_root (τ χ : ℂ) (L : ℕ) :
    iteratedToOneShot τ χ L
        (AdjoinRoot.root (sectorPolynomial τ χ L)) =
      oneShotCoordinate τ χ L EqualizerCoordinate.sector := by
  rw [iteratedToOneShot_eq, AdjoinRoot.liftAlgHom_root]

@[simp]
theorem iteratedToOneShot_algebraMap
    (τ χ : ℂ) (L : ℕ) (z : EqualizerComponentRing χ) :
    iteratedToOneShot τ χ L
        (algebraMap (EqualizerComponentRing χ) (EqualizerSectorRing τ χ L) z) =
      componentToOneShot τ χ L z := by
  change iteratedToOneShot τ χ L
    (AdjoinRoot.of (sectorPolynomial τ χ L) z) = _
  rw [iteratedToOneShot_eq, AdjoinRoot.liftAlgHom_of]

@[simp]
theorem iteratedToOneShot_iteratedCoordinate
    (τ χ : ℂ) (L : ℕ) (v : EqualizerCoordinate) :
    iteratedToOneShot τ χ L (iteratedCoordinate τ χ L v) =
      oneShotCoordinate τ χ L v := by
  cases v with
  | source =>
      change iteratedToOneShot τ χ L
        (algebraMap (EqualizerComponentRing χ) (EqualizerSectorRing τ χ L)
          (algebraMap EqualizerBaseRing (EqualizerComponentRing χ) X)) = _
      rw [iteratedToOneShot_algebraMap, componentToOneShot_algebraMap,
        baseToOneShot_X]
  | parameter =>
      change iteratedToOneShot τ χ L
        (algebraMap (EqualizerComponentRing χ) (EqualizerSectorRing τ χ L)
          (algebraMap EqualizerBaseRing (EqualizerComponentRing χ) (C X))) = _
      rw [iteratedToOneShot_algebraMap, componentToOneShot_algebraMap,
        baseToOneShot_C_X]
  | component =>
      change iteratedToOneShot τ χ L
        (algebraMap (EqualizerComponentRing χ) (EqualizerSectorRing τ χ L)
          (AdjoinRoot.root (componentPolynomial χ))) = _
      rw [iteratedToOneShot_algebraMap, componentToOneShot_root]
  | sector =>
      change iteratedToOneShot τ χ L
        (AdjoinRoot.root (sectorPolynomial τ χ L)) = _
      rw [iteratedToOneShot_root]

theorem iteratedCoordinate_source_eq_algebraMap
    (τ χ : ℂ) (L : ℕ) :
    iteratedCoordinate τ χ L EqualizerCoordinate.source =
      algebraMap EqualizerBaseRing (EqualizerSectorRing τ χ L) X := by
  change algebraMap (EqualizerComponentRing χ) (EqualizerSectorRing τ χ L)
      (algebraMap EqualizerBaseRing (EqualizerComponentRing χ) X) = _
  rw [← IsScalarTower.algebraMap_apply EqualizerBaseRing
    (EqualizerComponentRing χ) (EqualizerSectorRing τ χ L)]

theorem iteratedCoordinate_parameter_eq_algebraMap
    (τ χ : ℂ) (L : ℕ) :
    iteratedCoordinate τ χ L EqualizerCoordinate.parameter =
      algebraMap EqualizerParameterRing (EqualizerSectorRing τ χ L) X := by
  have hbase : (C X : EqualizerBaseRing) =
      algebraMap EqualizerParameterRing EqualizerBaseRing X := by
    simp only [Polynomial.algebraMap_apply, Algebra.algebraMap_self,
      RingHom.id_apply]
  change algebraMap (EqualizerComponentRing χ) (EqualizerSectorRing τ χ L)
      (algebraMap EqualizerBaseRing (EqualizerComponentRing χ) (C X)) = _
  rw [hbase,
    ← IsScalarTower.algebraMap_apply EqualizerParameterRing EqualizerBaseRing
      (EqualizerComponentRing χ),
    ← IsScalarTower.algebraMap_apply EqualizerParameterRing
      (EqualizerComponentRing χ) (EqualizerSectorRing τ χ L)]

theorem iteratedToOneShot_comp_oneShotToIterated
    (τ χ : ℂ) (L : ℕ) :
    (iteratedToOneShot τ χ L).comp (oneShotToIterated τ χ L) =
      AlgHom.id ℂ (EqualizerOneShotRing τ χ L) := by
  apply Ideal.Quotient.algHom_ext ℂ
  apply MvPolynomial.algHom_ext
  intro v
  simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, AlgHom.id_apply]
  rw [← oneShotCoordinate_eq τ χ L v]
  change iteratedToOneShot τ χ L
      (oneShotToIterated τ χ L (oneShotCoordinate τ χ L v)) =
    oneShotCoordinate τ χ L v
  rw [oneShotToIterated_coordinate,
    iteratedToOneShot_iteratedCoordinate]

theorem oneShotToIterated_comp_parameterToOneShot
    (τ χ : ℂ) (L : ℕ) :
    (oneShotToIterated τ χ L).comp (parameterToOneShot τ χ L) =
      IsScalarTower.toAlgHom ℂ EqualizerParameterRing
        (EqualizerSectorRing τ χ L) := by
  apply _root_.Polynomial.algHom_ext
  simp only [AlgHom.comp_apply, IsScalarTower.toAlgHom_apply]
  rw [parameterToOneShot_X, oneShotToIterated_coordinate,
    iteratedCoordinate_parameter_eq_algebraMap]

theorem oneShotToIterated_comp_baseToOneShot
    (τ χ : ℂ) (L : ℕ) :
    (oneShotToIterated τ χ L).comp (baseToOneShot τ χ L) =
      IsScalarTower.toAlgHom ℂ EqualizerBaseRing
        (EqualizerSectorRing τ χ L) := by
  apply _root_.Polynomial.algHom_ext'
  · apply _root_.Polynomial.algHom_ext
    simp only [AlgHom.comp_apply, _root_.Polynomial.CAlgHom_apply,
      IsScalarTower.toAlgHom_apply]
    rw [baseToOneShot_C_X, oneShotToIterated_coordinate,
      iteratedCoordinate_parameter_eq_algebraMap]
    have hbase : (C X : EqualizerBaseRing) =
        algebraMap EqualizerParameterRing EqualizerBaseRing X := by
      simp only [Polynomial.algebraMap_apply, Algebra.algebraMap_self,
        RingHom.id_apply]
    rw [hbase,
      ← IsScalarTower.algebraMap_apply EqualizerParameterRing EqualizerBaseRing
        (EqualizerSectorRing τ χ L)]
  · simp only [AlgHom.comp_apply, IsScalarTower.toAlgHom_apply]
    rw [baseToOneShot_X, oneShotToIterated_coordinate,
      iteratedCoordinate_source_eq_algebraMap]

theorem oneShotToIterated_comp_componentToOneShot
    (τ χ : ℂ) (L : ℕ) :
    (oneShotToIterated τ χ L).comp (componentToOneShot τ χ L) =
      IsScalarTower.toAlgHom ℂ (EqualizerComponentRing χ)
        (EqualizerSectorRing τ χ L) := by
  apply AdjoinRoot.algHom_ext'
  · apply AlgHom.ext
    intro p
    simp only [AlgHom.comp_apply, AdjoinRoot.coe_ofAlgHom,
      IsScalarTower.toAlgHom_apply]
    change oneShotToIterated τ χ L
        (componentToOneShot τ χ L
          (algebraMap EqualizerBaseRing (EqualizerComponentRing χ) p)) =
      algebraMap (EqualizerComponentRing χ) (EqualizerSectorRing τ χ L)
        (algebraMap EqualizerBaseRing (EqualizerComponentRing χ) p)
    rw [componentToOneShot_algebraMap]
    have h := AlgHom.congr_fun (oneShotToIterated_comp_baseToOneShot τ χ L) p
    simp only [AlgHom.comp_apply, IsScalarTower.toAlgHom_apply] at h
    rw [h]
    rw [← IsScalarTower.algebraMap_apply EqualizerBaseRing
      (EqualizerComponentRing χ) (EqualizerSectorRing τ χ L)]
  · simp only [AlgHom.comp_apply, IsScalarTower.toAlgHom_apply]
    rw [componentToOneShot_root, oneShotToIterated_coordinate]
    rfl

theorem oneShotToIterated_comp_iteratedToOneShot
    (τ χ : ℂ) (L : ℕ) :
    (oneShotToIterated τ χ L).comp (iteratedToOneShot τ χ L) =
      AlgHom.id ℂ (EqualizerSectorRing τ χ L) := by
  apply AdjoinRoot.algHom_ext'
  · apply AlgHom.ext
    intro z
    simp only [AlgHom.comp_apply, AdjoinRoot.coe_ofAlgHom, AlgHom.id_apply]
    change oneShotToIterated τ χ L
        (iteratedToOneShot τ χ L
          (algebraMap (EqualizerComponentRing χ)
            (EqualizerSectorRing τ χ L) z)) =
      algebraMap (EqualizerComponentRing χ)
        (EqualizerSectorRing τ χ L) z
    rw [iteratedToOneShot_algebraMap]
    have h := AlgHom.congr_fun
      (oneShotToIterated_comp_componentToOneShot τ χ L) z
    simpa only [AlgHom.comp_apply, IsScalarTower.toAlgHom_apply] using h
  · simp only [AlgHom.comp_apply, AlgHom.id_apply]
    rw [iteratedToOneShot_root, oneShotToIterated_coordinate]
    rfl

/-- The explicit equivalence between the quotient of `ℂ[x,T,X,y]` by the
two equations and the iterated `AdjoinRoot` presentation. -/
noncomputable def equalizerOneShotEquivIterated (τ χ : ℂ) (L : ℕ) :
    EqualizerOneShotRing τ χ L ≃ₐ[ℂ] EqualizerSectorRing τ χ L where
  __ := oneShotToIterated τ χ L
  invFun := iteratedToOneShot τ χ L
  left_inv q := by
    change iteratedToOneShot τ χ L (oneShotToIterated τ χ L q) = q
    have h := AlgHom.congr_fun
      (iteratedToOneShot_comp_oneShotToIterated τ χ L) q
    simpa only [AlgHom.comp_apply, AlgHom.id_apply] using h
  right_inv z := by
    change oneShotToIterated τ χ L (iteratedToOneShot τ χ L z) = z
    have h := AlgHom.congr_fun
      (oneShotToIterated_comp_iteratedToOneShot τ χ L) z
    simpa only [AlgHom.comp_apply, AlgHom.id_apply] using h

theorem equalizerOneShotEquivIterated_apply
    (τ χ : ℂ) (L : ℕ) (q : EqualizerOneShotRing τ χ L) :
    equalizerOneShotEquivIterated τ χ L q = oneShotToIterated τ χ L q := by
  rfl

theorem equalizerOneShotEquivIterated_symm_apply
    (τ χ : ℂ) (L : ℕ) (z : EqualizerSectorRing τ χ L) :
    (equalizerOneShotEquivIterated τ χ L).symm z = iteratedToOneShot τ χ L z := by
  rfl

@[simp]
theorem equalizerOneShotEquivIterated_coordinate
    (τ χ : ℂ) (L : ℕ) (v : EqualizerCoordinate) :
    equalizerOneShotEquivIterated τ χ L (oneShotCoordinate τ χ L v) =
      iteratedCoordinate τ χ L v := by
  rw [equalizerOneShotEquivIterated_apply, oneShotToIterated_coordinate]

end OnLeConjecture.DTwo
