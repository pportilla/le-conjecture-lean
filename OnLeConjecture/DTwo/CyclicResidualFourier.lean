/-!
# The polynomial rotation argument for a cyclic residual term

For a polynomial homogeneous for two weights with positive second weight,
the first exponent determines the second exponent. A primitive root of
order `k` detects every monomial whose second exponent is not divisible
by `k`. If its rotation difference has at most one monomial, there is at
most one such noninvariant term in the original polynomial.

The second exponent is its original natural-number exponent, not a chosen
representative modulo `k`. No analytic collision assertion is made here.
-/

public section

namespace OnLeConjecture.DTwo

open scoped BigOperators

/-- The polynomial algebra generated by `x` and `yᵏ`. -/
@[expose] noncomputable def cyclicInvariantAlgebra (k : ℕ) :
    Subalgebra ℂ (MvPolynomial (Fin 2) ℂ) :=
  (MvPolynomial.aeval
    (![MvPolynomial.X 0, MvPolynomial.X 1 ^ k] : Fin 2 → MvPolynomial (Fin 2) ℂ)).range

/-- Difference of the restrictions at second coordinates `1` and `ζ`. -/
@[expose] noncomputable def cyclicRotationDifference
    (Λ : MvPolynomial (Fin 2) ℂ) (ζ : ℂ) : _root_.Polynomial ℂ :=
  MvPolynomial.aeval ![_root_.Polynomial.X, 1] Λ -
    MvPolynomial.aeval ![_root_.Polynomial.X, _root_.Polynomial.C ζ] Λ

/-- Divisibility of every second exponent gives a polynomial expression
in `x` and `yᵏ`. -/
theorem mem_cyclicInvariantAlgebra_of_support_dvd (k : ℕ)
    (Λ : MvPolynomial (Fin 2) ℂ)
    (hdiv : ∀ d ∈ Λ.support, k ∣ d (1 : Fin 2)) :
    Λ ∈ cyclicInvariantAlgebra k := by
  classical
  rw [Λ.as_sum]
  apply Subalgebra.sum_mem
  intro d hd
  obtain ⟨j, hj⟩ := hdiv d hd
  refine ⟨MvPolynomial.C (MvPolynomial.coeff d Λ) * MvPolynomial.X 0 ^ d 0 *
    MvPolynomial.X 1 ^ j, ?_⟩
  simp [MvPolynomial.monomial_fin_two, hj, ← pow_mul]

private theorem homogeneous_exponents_eq_of_first_eq
    (a b D : ℕ) (hb : 0 < b) (Λ : MvPolynomial (Fin 2) ℂ)
    (hΛ : Λ.IsWeightedHomogeneous ![a, b] D)
    (d e : Fin 2 →₀ ℕ) (hd : MvPolynomial.coeff d Λ ≠ 0)
    (he : MvPolynomial.coeff e Λ ≠ 0) (hfirst : d 0 = e 0) : d = e := by
  have hdweight : a * d 0 + b * d 1 = D := by
    simpa [Finsupp.weight_apply, Finsupp.sum_fintype, mul_comm] using hΛ hd
  have heweight : a * e 0 + b * e 1 = D := by
    simpa [Finsupp.weight_apply, Finsupp.sum_fintype, mul_comm] using hΛ he
  have hsecond : d 1 = e 1 := by
    apply Nat.eq_of_mul_eq_mul_left hb
    rw [hfirst] at hdweight
    omega
  ext i
  fin_cases i
  · exact hfirst
  · exact hsecond

private theorem restriction_monomial (d : Fin 2 →₀ ℕ) (c ζ : ℂ) :
    MvPolynomial.aeval ![_root_.Polynomial.X, _root_.Polynomial.C ζ]
        (MvPolynomial.monomial d c) =
      _root_.Polynomial.C (c * ζ ^ d 1) * _root_.Polynomial.X ^ d 0 := by
  simp only [MvPolynomial.monomial_fin_two, map_mul, map_pow, MvPolynomial.aeval_C,
    MvPolynomial.aeval_X, Matrix.cons_val_zero, Matrix.cons_val_one]
  change _root_.Polynomial.C c * _root_.Polynomial.X ^ d 0 *
    _root_.Polynomial.C ζ ^ d 1 =
      _root_.Polynomial.C c * _root_.Polynomial.C ζ ^ d 1 * _root_.Polynomial.X ^ d 0
  ring

/-- Restriction to `(s,ζ)` recovers each coefficient of a two-weight
homogeneous polynomial at its first exponent. -/
theorem twoWeight_restriction_coeff (a b D : ℕ) (hb : 0 < b)
    (Λ : MvPolynomial (Fin 2) ℂ) (hΛ : Λ.IsWeightedHomogeneous ![a, b] D)
    (d : Fin 2 →₀ ℕ) (hd : MvPolynomial.coeff d Λ ≠ 0) (ζ : ℂ) :
    (MvPolynomial.aeval ![_root_.Polynomial.X, _root_.Polynomial.C ζ] Λ).coeff (d 0) =
      MvPolynomial.coeff d Λ * ζ ^ d 1 := by
  classical
  conv_lhs => rw [Λ.as_sum, map_sum, _root_.Polynomial.finsetSum_coeff]
  rw [Finset.sum_eq_single d]
  · rw [restriction_monomial, _root_.Polynomial.coeff_C_mul, _root_.Polynomial.coeff_X_pow]
    simp
  · intro e he hne
    have hfirst : e 0 ≠ d 0 := by
      intro hsame
      exact hne (homogeneous_exponents_eq_of_first_eq a b D hb Λ hΛ e d
        (MvPolynomial.mem_support_iff.mp he) hd hsame)
    rw [restriction_monomial, _root_.Polynomial.coeff_C_mul, _root_.Polynomial.coeff_X_pow]
    simp [Ne.symm hfirst]
  · intro hnot
    exact (hnot (MvPolynomial.mem_support_iff.mpr hd)).elim

/-- The coefficient of a rotation difference is multiplied by precisely
`1-ζʲ`, with the original second exponent `j`. -/
theorem cyclicRotationDifference_coeff (a b D : ℕ) (hb : 0 < b)
    (Λ : MvPolynomial (Fin 2) ℂ) (hΛ : Λ.IsWeightedHomogeneous ![a, b] D)
    (d : Fin 2 →₀ ℕ) (hd : MvPolynomial.coeff d Λ ≠ 0) (ζ : ℂ) :
    (cyclicRotationDifference Λ ζ).coeff (d 0) =
      MvPolynomial.coeff d Λ * (1 - ζ ^ d 1) := by
  rw [cyclicRotationDifference, _root_.Polynomial.coeff_sub]
  have hone := twoWeight_restriction_coeff a b D hb Λ hΛ d hd 1
  simp only [_root_.Polynomial.C_1, one_pow, mul_one] at hone
  rw [hone, twoWeight_restriction_coeff a b D hb Λ hΛ d hd ζ]
  ring

/-- A primitive rotation with at most one monomial detects at most one
noninvariant coefficient of the homogeneous polynomial. -/
theorem cyclic_noninvariant_exponents_unique (a b k D : ℕ) (hb : 0 < b)
    (ζ : ℂ) (hζ : IsPrimitiveRoot ζ k)
    (Λ : MvPolynomial (Fin 2) ℂ) (hΛ : Λ.IsWeightedHomogeneous ![a, b] D)
    (hmono : ∃ n : ℕ, ∃ c : ℂ,
      cyclicRotationDifference Λ ζ = _root_.Polynomial.monomial n c)
    (d e : Fin 2 →₀ ℕ) (hd : MvPolynomial.coeff d Λ ≠ 0)
    (he : MvPolynomial.coeff e Λ ≠ 0) (hdk : ¬ k ∣ d 1) (hek : ¬ k ∣ e 1) :
    d = e := by
  obtain ⟨n, c, hmono⟩ := hmono
  have hindex (v : Fin 2 →₀ ℕ) (hv : MvPolynomial.coeff v Λ ≠ 0)
      (hvk : ¬ k ∣ v 1) : v 0 = n := by
    have hchar : 1 - ζ ^ v 1 ≠ 0 := sub_ne_zero.mpr
      (Ne.symm ((hζ.pow_eq_one_iff_dvd (v 1)).not.mpr hvk))
    have hcoeff : (cyclicRotationDifference Λ ζ).coeff (v 0) ≠ 0 := by
      rw [cyclicRotationDifference_coeff a b D hb Λ hΛ v hv ζ]
      exact mul_ne_zero hv hchar
    rw [hmono, _root_.Polynomial.coeff_monomial] at hcoeff
    by_contra hne
    exact hcoeff (if_neg (Ne.symm hne))
  exact homogeneous_exponents_eq_of_first_eq a b D hb Λ hΛ d e hd he
    ((hindex d hd hdk).trans (hindex e he hek).symm)

/-- A noninvariant homogeneous polynomial whose difference for one
primitive rotation is zero or a monomial has precisely one noninvariant
monomial, in addition to a homogeneous polynomial in `x` and `yᵏ`. -/
theorem cyclic_residual_single_monomial_of_primitive_difference
    (a b k D : ℕ) (hb : 0 < b) (ζ : ℂ) (hζ : IsPrimitiveRoot ζ k)
    (Λ : MvPolynomial (Fin 2) ℂ) (hΛ : Λ.IsWeightedHomogeneous ![a, b] D)
    (hnot : Λ ∉ cyclicInvariantAlgebra k)
    (hmono : ∃ n : ℕ, ∃ c : ℂ,
      cyclicRotationDifference Λ ζ = _root_.Polynomial.monomial n c) :
    ∃ Λinv : MvPolynomial (Fin 2) ℂ, ∃ i j : ℕ, ∃ γ : ℂ,
      Λinv ∈ cyclicInvariantAlgebra k ∧ Λinv.IsWeightedHomogeneous ![a, b] D ∧
      γ ≠ 0 ∧ ¬ k ∣ j ∧ a * i + b * j = D ∧
      Λ = Λinv + MvPolynomial.C γ * MvPolynomial.X 0 ^ i * MvPolynomial.X 1 ^ j := by
  classical
  have hex : ∃ d ∈ Λ.support, ¬ k ∣ d (1 : Fin 2) := by
    by_contra hnone
    apply hnot
    apply mem_cyclicInvariantAlgebra_of_support_dvd
    intro d hd
    by_contra hndiv
    exact hnone ⟨d, hd, hndiv⟩
  obtain ⟨d, hd, hdk⟩ := hex
  have hdne := MvPolynomial.mem_support_iff.mp hd
  let γ : ℂ := MvPolynomial.coeff d Λ
  let Λinv := Λ - MvPolynomial.monomial d γ
  have hinv : Λinv ∈ cyclicInvariantAlgebra k := by
    apply mem_cyclicInvariantAlgebra_of_support_dvd
    intro e he
    have heinv := MvPolynomial.mem_support_iff.mp he
    have hed : e ≠ d := by
      intro heq
      subst e
      simp [Λinv, γ] at heinv
    have hene : MvPolynomial.coeff e Λ ≠ 0 := by
      simpa only [Λinv, MvPolynomial.coeff_sub, MvPolynomial.coeff_monomial,
        if_neg hed.symm, sub_zero] using heinv
    by_contra hek
    exact hed (cyclic_noninvariant_exponents_unique a b k D hb ζ hζ Λ hΛ hmono
      e d hene hdne hek hdk)
  have hmonomial : (MvPolynomial.monomial d γ).IsWeightedHomogeneous ![a, b] D :=
    MvPolynomial.isWeightedHomogeneous_monomial ![a, b] d γ (hΛ hdne)
  refine ⟨Λinv, d 0, d 1, γ, hinv, hΛ.sub hmonomial, hdne, hdk, ?_, ?_⟩
  · simpa [Finsupp.weight_apply, Finsupp.sum_fintype, mul_comm] using hΛ hdne
  · rw [← MvPolynomial.monomial_fin_two]
    exact (sub_add_cancel Λ (MvPolynomial.monomial d γ)).symm

/-- It suffices that every root-of-unity rotation difference be zero or
a monomial. The hypothesis allows the zero polynomial by taking `c = 0`.
The exponent `j` is not reduced modulo `k`. -/
theorem cyclic_residual_fourier_classification
    (a b k D : ℕ) (hb : 0 < b) (hk : 0 < k)
    (Λ : MvPolynomial (Fin 2) ℂ) (hΛ : Λ.IsWeightedHomogeneous ![a, b] D)
    (hnot : Λ ∉ cyclicInvariantAlgebra k)
    (hrotations : ∀ ζ : ℂ, ζ ^ k = 1 → ∃ n : ℕ, ∃ c : ℂ,
      cyclicRotationDifference Λ ζ = _root_.Polynomial.monomial n c) :
    ∃ Λinv : MvPolynomial (Fin 2) ℂ, ∃ i j : ℕ, ∃ γ : ℂ,
      Λinv ∈ cyclicInvariantAlgebra k ∧ Λinv.IsWeightedHomogeneous ![a, b] D ∧
      γ ≠ 0 ∧ ¬ k ∣ j ∧ a * i + b * j = D ∧
      Λ = Λinv + MvPolynomial.C γ * MvPolynomial.X 0 ^ i * MvPolynomial.X 1 ^ j := by
  let ζ : ℂ := Complex.exp (2 * Real.pi * Complex.I / k)
  have hζ : IsPrimitiveRoot ζ k := Complex.isPrimitiveRoot_exp k hk.ne'
  exact cyclic_residual_single_monomial_of_primitive_difference a b k D hb ζ hζ Λ hΛ hnot
    (hrotations ζ hζ.pow_eq_one)

/-- Without a noninvariance assumption, the same rotation hypothesis
gives the invariant alternative or the single noninvariant term. -/
theorem cyclic_residual_fourier_dichotomy
    (a b k D : ℕ) (hb : 0 < b) (hk : 0 < k)
    (Λ : MvPolynomial (Fin 2) ℂ) (hΛ : Λ.IsWeightedHomogeneous ![a, b] D)
    (hrotations : ∀ ζ : ℂ, ζ ^ k = 1 → ∃ n : ℕ, ∃ c : ℂ,
      cyclicRotationDifference Λ ζ = _root_.Polynomial.monomial n c) :
    Λ ∈ cyclicInvariantAlgebra k ∨
      ∃ Λinv : MvPolynomial (Fin 2) ℂ, ∃ i j : ℕ, ∃ γ : ℂ,
        Λinv ∈ cyclicInvariantAlgebra k ∧ Λinv.IsWeightedHomogeneous ![a, b] D ∧
        γ ≠ 0 ∧ ¬ k ∣ j ∧ a * i + b * j = D ∧
        Λ = Λinv + MvPolynomial.C γ * MvPolynomial.X 0 ^ i * MvPolynomial.X 1 ^ j := by
  by_cases hmem : Λ ∈ cyclicInvariantAlgebra k
  · exact Or.inl hmem
  · exact Or.inr (cyclic_residual_fourier_classification a b k D hb hk Λ hΛ hmem hrotations)

/-- A nonzero complex polynomial with no root outside zero is a monomial. -/
theorem polynomial_eq_monomial_of_no_nonzero_root (P : _root_.Polynomial ℂ)
    (hP : P ≠ 0) (hroots : ∀ z : ℂ, P.eval z = 0 → z = 0) :
    P = _root_.Polynomial.monomial (P.rootMultiplicity 0) P.leadingCoeff := by
  have hmultiset : P.roots = Multiset.replicate (P.rootMultiplicity 0) 0 := by
    ext z
    by_cases hz : z = 0
    · subst z
      simp [_root_.Polynomial.count_roots]
    · have hnot : z ∉ P.roots := by
        intro hmem
        exact hz (hroots z ((_root_.Polynomial.mem_roots hP).mp hmem))
      rw [Multiset.count_eq_zero.mpr hnot, Multiset.count_replicate, if_neg (Ne.symm hz)]
  calc
    P = _root_.Polynomial.C P.leadingCoeff *
        (P.roots.map (_root_.Polynomial.X - _root_.Polynomial.C ·)).prod :=
      (IsAlgClosed.splits P).eq_prod_roots
    _ = _root_.Polynomial.monomial (P.rootMultiplicity 0) P.leadingCoeff := by
      rw [hmultiset, Multiset.map_replicate, Multiset.prod_replicate]
      simp [_root_.Polynomial.C_mul_X_pow_eq_monomial]

/-- The rotation hypothesis follows purely algebraically if each
nonzero difference has no nonzero root. -/
theorem cyclic_residual_fourier_classification_of_no_nonzero_roots
    (a b k D : ℕ) (hb : 0 < b) (hk : 0 < k)
    (Λ : MvPolynomial (Fin 2) ℂ) (hΛ : Λ.IsWeightedHomogeneous ![a, b] D)
    (hnot : Λ ∉ cyclicInvariantAlgebra k)
    (hroots : ∀ ζ : ℂ, ζ ^ k = 1 → cyclicRotationDifference Λ ζ ≠ 0 →
      ∀ s : ℂ, (cyclicRotationDifference Λ ζ).eval s = 0 → s = 0) :
    ∃ Λinv : MvPolynomial (Fin 2) ℂ, ∃ i j : ℕ, ∃ γ : ℂ,
      Λinv ∈ cyclicInvariantAlgebra k ∧ Λinv.IsWeightedHomogeneous ![a, b] D ∧
      γ ≠ 0 ∧ ¬ k ∣ j ∧ a * i + b * j = D ∧
      Λ = Λinv + MvPolynomial.C γ * MvPolynomial.X 0 ^ i * MvPolynomial.X 1 ^ j := by
  apply cyclic_residual_fourier_classification a b k D hb hk Λ hΛ hnot
  intro ζ hζ
  by_cases hzero : cyclicRotationDifference Λ ζ = 0
  · exact ⟨0, 0, by simp [hzero]⟩
  · exact ⟨_, _, polynomial_eq_monomial_of_no_nonzero_root
      (cyclicRotationDifference Λ ζ) hzero (hroots ζ hζ hzero)⟩

end OnLeConjecture.DTwo
