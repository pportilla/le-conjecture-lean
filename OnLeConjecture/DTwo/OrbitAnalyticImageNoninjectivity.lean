module

public import OnLeConjecture.Analytic.CoordinatePermutation
public import OnLeConjecture.Analytic.InjectivityFactor
public import OnLeConjecture.Analytic.MonicTriangularFinite
public import OnLeConjecture.DTwo.OrbitAnalyticJacobianInitialForm
public import OnLeConjecture.DTwo.OrbitPlaneNoninjectivity

/-!
# The analytic image branch in the quadratic orbit case

If the third coordinate belongs to the analytic image generated by the first
two coordinates, the three coordinate germ factors through the corresponding
plane germ. Local injectivity would then descend to the plane germ. The orbit
plane collision excludes that possibility.
-/

public section

namespace OnLeConjecture.DTwo

open OnLeConjecture.Analytic

/-- In the analytic image branch, the quadratic orbit initial forms exclude
an injective representative of the three coordinate germ. -/
theorem orbitAnalyticImage_not_hasInjectiveRepresentative
    (F : PointedMapGerm 2 3) (g : PointedMapGerm 2 2) (f : Germ 2)
    (hcomponentZero : F.1.component 0 = g.1.component 0)
    (hcomponentOne : F.1.component 1 = g.1.component 1)
    (hcomponentTwo : F.1.component 2 = f)
    (hphi : g.1.component 0 -
        Germ.coordinatePolynomialAlgHom 2 (orbitPolynomialPhi ℂ) ∈
      Germ.maximalIdeal 2 ^ 3)
    (hpsi : g.1.component 1 -
        Germ.coordinatePolynomialAlgHom 2 (orbitPolynomialPsi ℂ) ∈
      Germ.maximalIdeal 2 ^ 4)
    (himage : ∃ q : Germ 2, g.pullbackRingHom q = f) :
    ¬ F.HasInjectiveRepresentative := by
  have hgNoninjective :=
    orbitPlane_not_hasInjectiveRepresentative g hphi hpsi
  obtain ⟨q, hq⟩ := himage
  have hqValue : Germ.valueRingHom 2 q = 0 := by
    rw [← g.valueRingHom_pullback q, hq, ← hcomponentTwo,
      MapGerm.valueRingHom_component, F.2]
    rfl
  obtain ⟨Q, hQ, hqRepresentative⟩ := Germ.exists_ofFunction q
  have hQZero : Q 0 = 0 := by
    rw [hqRepresentative, Germ.valueRingHom_ofFunction] at hqValue
    exact hqValue
  let graph : Source 2 → Source 3 := fun z ↦ ![z 0, z 1, Q z]
  have hgraphAnalytic : AnalyticAt ℂ graph 0 := by
    rw [analyticAt_pi_iff]
    intro i
    fin_cases i
    · exact (ContinuousLinearMap.proj (R := ℂ) (0 : Fin 2)).analyticAt
        (0 : Source 2)
    · exact (ContinuousLinearMap.proj (R := ℂ) (1 : Fin 2)).analyticAt
        (0 : Source 2)
    · exact hQ
  have hgraphZero : graph 0 = 0 := by
    funext i
    fin_cases i
    all_goals simp [graph, hQZero]
  let outer : PointedMapGerm 2 3 :=
    PointedMapGerm.ofFunction graph hgraphAnalytic hgraphZero
  have houterZero : outer.1.component 0 = Germ.coordinate 0 := by
    apply Subtype.ext
    dsimp only [outer]
    change ((MapGerm.ofFunction graph hgraphAnalytic).component 0).1 =
      (Germ.coordinate 0).1
    rw [MapGerm.component_ofFunction]
    change ((fun z : Source 2 ↦ graph z 0) : FunctionGerm 2) =
      ((fun z : Source 2 ↦ z 0) : FunctionGerm 2)
    rfl
  have houterOne : outer.1.component 1 = Germ.coordinate 1 := by
    apply Subtype.ext
    dsimp only [outer]
    change ((MapGerm.ofFunction graph hgraphAnalytic).component 1).1 =
      (Germ.coordinate 1).1
    rw [MapGerm.component_ofFunction]
    change ((fun z : Source 2 ↦ graph z 1) : FunctionGerm 2) =
      ((fun z : Source 2 ↦ z 1) : FunctionGerm 2)
    rfl
  have houterTwo : outer.1.component 2 = q := by
    rw [hqRepresentative]
    apply Subtype.ext
    dsimp only [outer]
    change ((MapGerm.ofFunction graph hgraphAnalytic).component 2).1 =
      (Germ.ofFunction Q hQ).1
    rw [MapGerm.component_ofFunction]
    change ((fun z : Source 2 ↦ graph z 2) : FunctionGerm 2) =
      ((Q : Source 2 → ℂ) : FunctionGerm 2)
    rfl
  have hfactor : F = outer.comp g := by
    apply PointedMapGerm.ext_components
    intro i
    fin_cases i
    · change F.1.component 0 = (outer.comp g).1.component 0
      rw [PointedMapGerm.component_comp_general, houterZero,
        g.pullback_coordinate, hcomponentZero]
    · change F.1.component 1 = (outer.comp g).1.component 1
      rw [PointedMapGerm.component_comp_general, houterOne,
        g.pullback_coordinate, hcomponentOne]
    · change F.1.component 2 = (outer.comp g).1.component 2
      rw [PointedMapGerm.component_comp_general, houterTwo,
        hq, hcomponentTwo]
  intro hFInjective
  apply hgNoninjective
  apply PointedMapGerm.hasInjectiveRepresentative_of_comp outer g
  rw [← hfactor]
  exact hFInjective

/-- For an injective three coordinate germ, the analytic normalization
dichotomy cannot end in the analytic image branch. -/
theorem orbitFirstNonbaseLambdaFourInitialForm_of_injective_minors
    (F : PointedMapGerm 2 3) (g : PointedMapGerm 2 2)
    (hfinite : g.IsFiniteAtOrigin)
    (hcomponentZero : F.1.component 0 = g.1.component 0)
    (hcomponentOne : F.1.component 1 = g.1.component 1)
    (hphi : g.1.component 0 -
        Germ.coordinatePolynomialAlgHom 2 (orbitPolynomialPhi ℂ) ∈
      Germ.maximalIdeal 2 ^ 3)
    (hpsi : g.1.component 1 -
        Germ.coordinatePolynomialAlgHom 2 (orbitPolynomialPsi ℂ) ∈
      Germ.maximalIdeal 2 ^ 4)
    (horder : F.1.component 2 ∈ Germ.maximalIdeal 2 ^ 4)
    (hminorTwelve : Germ.coordinate (1 : Fin 2) ^ 3 ∣
      Germ.jacobian (g.1.component 0) (g.1.component 1))
    (hminorThirteen : Germ.coordinate (1 : Fin 2) ^ 3 ∣
      Germ.jacobian (g.1.component 0) (F.1.component 2))
    (hinjective : F.HasInjectiveRepresentative) :
    ∃ k : ℕ, ∃ Q : OrbitBaseRing ℂ, ∃ R : OrbitSourceForm,
      (∀ j < k, OrbitStageRemovable g (F.1.component 2) j) ∧
      ¬ OrbitStageRemovable g (F.1.component 2) k ∧
      R.IsHomogeneous (4 + k) ∧
      R ≠ 0 ∧
      orbitPolynomialLambda ℂ ^ 4 ∣ R ∧
      R ∉ Set.range (orbitBaseToSource ℂ) ∧
      ((F.1.component 2 - orbitAnalyticEvaluationAlgHom g Q) -
          Germ.coordinatePolynomialAlgHom 2 R ∈
        Germ.maximalIdeal 2 ^ (5 + k)) := by
  rcases orbitAnalyticImage_or_first_nonbaseLambdaFour_initialForm_of_minors
      g hfinite hphi hpsi (F.1.component 2) horder
        hminorTwelve hminorThirteen with himage | hnonbase
  · exact False.elim
      (orbitAnalyticImage_not_hasInjectiveRepresentative
        F g (F.1.component 2) hcomponentZero hcomponentOne rfl
          hphi hpsi himage hinjective)
  · exact hnonbase

end OnLeConjecture.DTwo
