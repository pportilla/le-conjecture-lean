module

public import OnLeConjecture.DThree.HLocalOrders
public import Mathlib.FieldTheory.RatFunc.AsPolynomial
public import Mathlib.RingTheory.DedekindDomain.Dvr

/-!
# Local rings and orders for the rational `H` conic

This file uses a rational parameter `m` on the conic

`theta^2 + 2 * (X^2 + 4 * X + 1) = 0`.

For a finite parameter value `a`, the local ring is the localization of
`K[m]` at the prime ideal generated by `m - a`.  This localization is a
discrete valuation ring.  The inverse of its adic valuation is used as the
order on `K(m)`, so a uniformizer has value `WithZero.exp 1`.
-/

public section

namespace OnLeConjecture.DThree

open scoped nonZeroDivisors Polynomial WithZero

open IsDedekindDomain

variable {K : Type*} [Field K]

/-! ## The local ring of the parameter line -/

/-- The prime ideal of `K[m]` corresponding to `m = a`. -/
@[expose]
noncomputable def hParameterPrime (K : Type*) [Field K] (a : K) :
    IsDedekindDomain.HeightOneSpectrum K[X] where
  asIdeal := Ideal.span {Polynomial.X - Polynomial.C a}
  isPrime := by
    exact (Ideal.span_singleton_prime
      (Polynomial.X_sub_C_ne_zero a)).mpr (Polynomial.prime_X_sub_C a)
  ne_bot := by
    rw [ne_eq, Ideal.span_singleton_eq_bot]
    exact Polynomial.X_sub_C_ne_zero a

/-- The localization of `K[m]` at `m = a`. -/
abbrev HParameterLocalRing (K : Type*) [Field K] (a : K) :=
  Localization.AtPrime (hParameterPrime K a).asIdeal

noncomputable instance hParameterLocalRing.instIsDiscreteValuationRing
    (a : K) : IsDiscreteValuationRing (HParameterLocalRing K a) :=
  IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain K[X]
    (hParameterPrime K a).ne_bot (HParameterLocalRing K a)

/-- The local ring of the parameter line is a discrete valuation ring. -/
theorem h_parameter_local_ring_isDiscreteValuationRing (a : K) :
    IsDiscreteValuationRing (HParameterLocalRing K a) := by
  infer_instance

/-- The image of `m - a` is a uniformizer in the parameter local ring. -/
theorem h_parameter_local_ring_parameter_irreducible (a : K) :
    Irreducible
      (algebraMap K[X] (HParameterLocalRing K a)
        (Polynomial.X - Polynomial.C a)) := by
  rw [IsDiscreteValuationRing.irreducible_iff_uniformizer]
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal
    (hParameterPrime K a).asIdeal (HParameterLocalRing K a)]
  simp only [hParameterPrime, Ideal.map_span, Set.image_singleton,
    map_sub]

/-- A polynomial that does not vanish at `a` maps to a unit in the local
ring at `m = a`. -/
theorem h_parameter_local_ring_isUnit_of_eval_ne_zero
    (a : K) (p : K[X]) (hp : p.eval a ≠ 0) :
    IsUnit (algebraMap K[X] (HParameterLocalRing K a) p) := by
  rw [IsLocalization.AtPrime.isUnit_to_map_iff
    (HParameterLocalRing K a) (hParameterPrime K a).asIdeal]
  change p ∉ Ideal.span {Polynomial.X - Polynomial.C a}
  rw [← Polynomial.ker_evalRingHom]
  simpa [RingHom.mem_ker] using hp

/-- The usual signed order at `m = a`.  The adic valuation used by Mathlib
sends a uniformizer to `exp (-1)`, so its inverse has the conventional order
sign. -/
@[expose]
noncomputable def hFiniteOrderAt (a : K) : RatFunc K →*₀ ℤᵐ⁰ :=
  MonoidWithZeroHom.comp MonoidWithZero.inverse
    ((hParameterPrime K a).valuation (RatFunc K)).toMonoidWithZeroHom

/-- The parameter `m - a` has order one at `a`. -/
theorem h_finite_order_parameter (a : K) :
    hFiniteOrderAt a
        (algebraMap K[X] (RatFunc K)
          (Polynomial.X - Polynomial.C a)) =
      WithZero.exp (1 : ℤ) := by
  simp only [hFiniteOrderAt, MonoidWithZeroHom.comp_apply,
    MonoidWithZero.inverse_apply, Ring.inverse_eq_inv]
  change (((hParameterPrime K a).valuation (RatFunc K))
    (algebraMap K[X] (RatFunc K)
      (Polynomial.X - Polynomial.C a)))⁻¹ = WithZero.exp (1 : ℤ)
  rw [IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap]
  rw [(hParameterPrime K a).intValuation_singleton
    (Polynomial.X_sub_C_ne_zero a) rfl]
  exact (WithZero.exp_neg (-1 : ℤ)).symm

/-- A polynomial that does not vanish at `a` has order zero at `a`. -/
theorem h_finite_order_polynomial_of_eval_ne_zero
    (a : K) (p : K[X]) (hp : p.eval a ≠ 0) :
    hFiniteOrderAt a (algebraMap K[X] (RatFunc K) p) = 1 := by
  simp only [hFiniteOrderAt, MonoidWithZeroHom.comp_apply,
    MonoidWithZero.inverse_apply, Ring.inverse_eq_inv]
  change (((hParameterPrime K a).valuation (RatFunc K))
    (algebraMap K[X] (RatFunc K) p))⁻¹ = 1
  have hnot : p ∉ (hParameterPrime K a).asIdeal := by
    change p ∉ Ideal.span {Polynomial.X - Polynomial.C a}
    rw [← Polynomial.ker_evalRingHom]
    simpa [RingHom.mem_ker] using hp
  rw [((hParameterPrime K a).valuation_eq_one_iff_notMem
    (K := RatFunc K)).mpr hnot]
  exact inv_one

/-- A quotient of two polynomials nonzero at `a` has order zero at `a`. -/
theorem h_finite_order_fraction_of_eval_ne_zero
    (a : K) (p q : K[X]) (hp : p.eval a ≠ 0) (hq : q.eval a ≠ 0) :
    hFiniteOrderAt a
        (algebraMap K[X] (RatFunc K) p /
          algebraMap K[X] (RatFunc K) q) = 1 := by
  rw [map_div₀, h_finite_order_polynomial_of_eval_ne_zero a p hp,
    h_finite_order_polynomial_of_eval_ne_zero a q hq]
  exact div_one 1

/-- A polynomial that is `m - a` times a factor nonzero at `a` has order
one. -/
theorem h_finite_order_polynomial_factor_parameter
    (a : K) (p u : K[X])
    (hfactor : p = (Polynomial.X - Polynomial.C a) * u)
    (hu : u.eval a ≠ 0) :
    hFiniteOrderAt a (algebraMap K[X] (RatFunc K) p) =
      WithZero.exp (1 : ℤ) := by
  rw [hfactor, map_mul, map_mul, h_finite_order_parameter,
    h_finite_order_polynomial_of_eval_ne_zero a u hu]
  exact mul_one _

/-! ## A rational parameter on the conic -/

variable [CharZero K]

/-- The common denominator in the rational parametrization based at
`(-1, 2)`. -/
@[expose]
noncomputable def hConicParamDenominator : K[X] :=
  Polynomial.X ^ 2 + 2

/-- The numerator of the conic coordinate `X` in the parameter `m`. -/
@[expose]
noncomputable def hConicParamXNumerator : K[X] :=
  -(Polynomial.X ^ 2 + 4 * Polynomial.X + 6)

/-- The numerator of the conic coordinate `theta` in the parameter `m`. -/
@[expose]
noncomputable def hConicParamThetaNumerator : K[X] :=
  -2 * (Polynomial.X ^ 2 + 2 * Polynomial.X - 2)

/-- The pullback of the conic coordinate `X` to `K(m)`. -/
@[expose]
noncomputable def hConicParamX : RatFunc K :=
  algebraMap K[X] (RatFunc K) hConicParamXNumerator /
    algebraMap K[X] (RatFunc K) hConicParamDenominator

/-- The pullback of the conic coordinate `theta` to `K(m)`. -/
@[expose]
noncomputable def hConicParamTheta : RatFunc K :=
  algebraMap K[X] (RatFunc K) hConicParamThetaNumerator /
    algebraMap K[X] (RatFunc K) hConicParamDenominator

/-- The quadratic whose roots are the two points above `X = 1`. -/
@[expose]
noncomputable def hConicParamOneFactor : K[X] :=
  Polynomial.X ^ 2 + 2 * Polynomial.X + 4

/-- The remaining numerator factor of `w` in the parameter `m`. -/
@[expose]
noncomputable def hConicParamWFactor : K[X] :=
  Polynomial.X ^ 3 + 6 * Polynomial.X + 16

/-- The remaining numerator factor of `W` in the parameter `m`. -/
@[expose]
noncomputable def hConicParamCapitalWFactor : K[X] :=
  Polynomial.X ^ 3 + 6 * Polynomial.X ^ 2 + 18 * Polynomial.X + 4

/-- The denominator of both conic functions in the parameter `m`. -/
@[expose]
noncomputable def hConicParamFunctionDenominator : K[X] :=
  3 * (Polynomial.X + 1) * hConicParamDenominator ^ 2

/-- The pullback of `w` to `K(m)`, in reduced factored form. -/
@[expose]
noncomputable def hConicParamW : RatFunc K :=
  algebraMap K[X] (RatFunc K)
      (-hConicParamOneFactor * hConicParamWFactor) /
    algebraMap K[X] (RatFunc K) hConicParamFunctionDenominator

/-- The pullback of `W` to `K(m)`, in reduced factored form. -/
@[expose]
noncomputable def hConicParamCapitalW : RatFunc K :=
  algebraMap K[X] (RatFunc K)
      (-hConicParamOneFactor * hConicParamCapitalWFactor) /
    algebraMap K[X] (RatFunc K) hConicParamFunctionDenominator

/-- The denominator of the rational parametrization is a nonzero
polynomial. -/
theorem h_conic_param_denominator_ne_zero :
    hConicParamDenominator (K := K) ≠ 0 := by
  intro h
  have hcoeff := congrArg (fun p : K[X] => p.coeff 2) h
  simp [hConicParamDenominator] at hcoeff

omit [CharZero K] in
/-- The factor `m + 1` is a nonzero polynomial. -/
theorem h_conic_param_linear_ne_zero :
    (Polynomial.X + 1 : K[X]) ≠ 0 := by
  simpa using Polynomial.X_add_C_ne_zero (1 : K)

/-- The common denominator of the two pulled back conic functions is
nonzero. -/
theorem h_conic_param_function_denominator_ne_zero :
    hConicParamFunctionDenominator (K := K) ≠ 0 := by
  simp only [hConicParamFunctionDenominator]
  exact mul_ne_zero
    (mul_ne_zero (by norm_num) h_conic_param_linear_ne_zero)
    (pow_ne_zero 2 h_conic_param_denominator_ne_zero)

/-- The rational parametrization satisfies the affine conic equation. -/
theorem h_conic_param_equation :
    hConicEquation (hConicParamX (K := K)) hConicParamTheta = 0 := by
  have hd : algebraMap K[X] (RatFunc K)
      hConicParamDenominator ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr
      h_conic_param_denominator_ne_zero
  simp only [hConicEquation, hConicParamX, hConicParamTheta,
    hConicParamXNumerator, hConicParamThetaNumerator,
    hConicParamDenominator]
  simp [hConicParamDenominator, RatFunc.algebraMap_X, map_ofNat] at hd ⊢
  field_simp [hConicParamDenominator, hd]
  ring

/-- In the function field, `X - 1` has the factor corresponding to the two
points above `X = 1`. -/
theorem h_conic_param_x_sub_one :
    hConicParamX (K := K) - 1 =
      algebraMap K[X] (RatFunc K) (-2 * hConicParamOneFactor) /
        algebraMap K[X] (RatFunc K) hConicParamDenominator := by
  have hd : algebraMap K[X] (RatFunc K)
      hConicParamDenominator ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr
      h_conic_param_denominator_ne_zero
  simp only [hConicParamX, hConicParamXNumerator,
    hConicParamOneFactor, hConicParamDenominator]
  simp [hConicParamDenominator, RatFunc.algebraMap_X, map_ofNat] at hd ⊢
  field_simp [hConicParamDenominator, hd]
  ring

/-- In the function field, `X + 1` is a scalar times `m + 1` divided by the
parametrization denominator. -/
theorem h_conic_param_x_add_one :
    hConicParamX (K := K) + 1 =
      algebraMap K[X] (RatFunc K) (-4 * (Polynomial.X + 1)) /
        algebraMap K[X] (RatFunc K) hConicParamDenominator := by
  have hd : algebraMap K[X] (RatFunc K)
      hConicParamDenominator ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr
      h_conic_param_denominator_ne_zero
  simp only [hConicParamX, hConicParamXNumerator,
    hConicParamDenominator]
  simp [hConicParamDenominator, RatFunc.algebraMap_X, map_ofNat] at hd ⊢
  field_simp [hConicParamDenominator, hd]
  ring

set_option linter.flexible false in
/-- The factored formula for `w` is the pullback of the conic function. -/
theorem h_conic_param_w_eq :
    hConicParamW (K := K) =
      hConicW hConicParamX hConicParamTheta := by
  have hd : algebraMap K[X] (RatFunc K)
      hConicParamDenominator ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr
      h_conic_param_denominator_ne_zero
  have hfden : algebraMap K[X] (RatFunc K)
      hConicParamFunctionDenominator ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr
      h_conic_param_function_denominator_ne_zero
  have hlinear : algebraMap K[X] (RatFunc K)
      (Polynomial.X + 1) ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr
      h_conic_param_linear_ne_zero
  have hplus : hConicParamX (K := K) + 1 ≠ 0 := by
    rw [h_conic_param_x_add_one]
    apply div_ne_zero _ hd
    rw [map_mul]
    exact mul_ne_zero (by norm_num) hlinear
  simp only [hConicParamW, hConicParamOneFactor, hConicParamWFactor,
    hConicParamFunctionDenominator, hConicParamX, hConicParamTheta,
    hConicParamXNumerator, hConicParamThetaNumerator,
    hConicParamDenominator, hConicW]
  simp [hConicParamDenominator, hConicParamFunctionDenominator,
    hConicParamX, hConicParamXNumerator, RatFunc.algebraMap_X, map_ofNat]
      at hd hfden hlinear hplus ⊢
  have hfourlinear :
      (-4 - RatFunc.X * 4 : RatFunc K) ≠ 0 := by
    have hproduct := mul_ne_zero (show (-4 : RatFunc K) ≠ 0 by norm_num)
      hlinear
    convert hproduct using 1
    all_goals ring
  have hneglinear : (-1 - RatFunc.X : RatFunc K) ≠ 0 := by
    have hnegative := neg_ne_zero.mpr hlinear
    convert hnegative using 1
    all_goals ring
  have hdenexpr :
      (-6 + RatFunc.X * (-4 + -RatFunc.X) +
          (RatFunc.X ^ 2 + 2) : RatFunc K) ≠ 0 := by
    convert hfourlinear using 1
    all_goals ring
  field_simp [hConicParamDenominator,
    hConicParamFunctionDenominator, hd, hfden, hplus, hfourlinear,
    hneglinear, hdenexpr]
  ring

set_option linter.flexible false in
/-- The factored formula for `W` is the pullback of the conic function. -/
theorem h_conic_param_capitalW_eq :
    hConicParamCapitalW (K := K) =
      hConicCapitalW hConicParamX hConicParamTheta := by
  have hd : algebraMap K[X] (RatFunc K)
      hConicParamDenominator ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr
      h_conic_param_denominator_ne_zero
  have hfden : algebraMap K[X] (RatFunc K)
      hConicParamFunctionDenominator ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr
      h_conic_param_function_denominator_ne_zero
  have hlinear : algebraMap K[X] (RatFunc K)
      (Polynomial.X + 1) ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr
      h_conic_param_linear_ne_zero
  have hplus : hConicParamX (K := K) + 1 ≠ 0 := by
    rw [h_conic_param_x_add_one]
    apply div_ne_zero _ hd
    rw [map_mul]
    exact mul_ne_zero (by norm_num) hlinear
  simp only [hConicParamCapitalW, hConicParamOneFactor,
    hConicParamCapitalWFactor, hConicParamFunctionDenominator,
    hConicParamX, hConicParamTheta, hConicParamXNumerator,
    hConicParamThetaNumerator, hConicParamDenominator,
    hConicCapitalW]
  simp [hConicParamDenominator, hConicParamFunctionDenominator,
    hConicParamX, hConicParamXNumerator, RatFunc.algebraMap_X, map_ofNat]
      at hd hfden hlinear hplus ⊢
  have hfourlinear :
      (-4 - RatFunc.X * 4 : RatFunc K) ≠ 0 := by
    have hproduct := mul_ne_zero (show (-4 : RatFunc K) ≠ 0 by norm_num)
      hlinear
    convert hproduct using 1
    all_goals ring
  have hneglinear : (-1 - RatFunc.X : RatFunc K) ≠ 0 := by
    have hnegative := neg_ne_zero.mpr hlinear
    convert hnegative using 1
    all_goals ring
  have hdenexpr :
      (-6 + RatFunc.X * (-4 + -RatFunc.X) +
          (RatFunc.X ^ 2 + 2) : RatFunc K) ≠ 0 := by
    convert hfourlinear using 1
    all_goals ring
  field_simp [hConicParamDenominator,
    hConicParamFunctionDenominator, hd, hfden, hplus, hfourlinear,
    hneglinear, hdenexpr]
  ring

/-! ## Orders at the two points above `X = 1` -/

/-- A root of the parameter polynomial for `X = 1` is not `-1`. -/
theorem h_conic_param_one_root_add_one_ne_zero
    {a : K} (ha : a ^ 2 + 2 * a + 4 = 0) : a + 1 ≠ 0 := by
  intro h
  have haeq : a = -1 := by linear_combination h
  rw [haeq] at ha
  norm_num at ha

/-- The denominator of the rational parametrization is nonzero at a point
above `X = 1`. -/
theorem h_conic_param_denominator_at_one_root_ne_zero
    {a : K} (ha : a ^ 2 + 2 * a + 4 = 0) : a ^ 2 + 2 ≠ 0 := by
  intro hd
  have hlinear : 2 * a + 2 = 0 := by linear_combination ha - hd
  have haeq : a = -1 := by linear_combination (1 / 2) * hlinear
  rw [haeq] at ha
  norm_num at ha

/-- The remaining numerator factor of `w` is nonzero at a point above
`X = 1`. -/
theorem h_conic_param_w_factor_at_one_root_ne_zero
    {a : K} (ha : a ^ 2 + 2 * a + 4 = 0) :
    a ^ 3 + 6 * a + 16 ≠ 0 := by
  intro hw
  have hlinear : 6 * a + 24 = 0 := by
    linear_combination hw - (a - 2) * ha
  have haeq : a = -4 := by linear_combination (1 / 6) * hlinear
  rw [haeq] at ha
  norm_num at ha

/-- The remaining numerator factor of `W` is nonzero at a point above
`X = 1`. -/
theorem h_conic_param_capitalW_factor_at_one_root_ne_zero
    {a : K} (ha : a ^ 2 + 2 * a + 4 = 0) :
    a ^ 3 + 6 * a ^ 2 + 18 * a + 4 ≠ 0 := by
  intro hW
  have hlinear : 6 * a - 12 = 0 := by
    linear_combination hW - (a + 4) * ha
  have haeq : a = 2 := by linear_combination (1 / 6) * hlinear
  rw [haeq] at ha
  norm_num at ha

/-- The parameter polynomial for `X = 1` has order one at each of its
roots. -/
theorem h_conic_param_one_factor_order
    {a : K} (ha : a ^ 2 + 2 * a + 4 = 0) :
    hFiniteOrderAt a
        (algebraMap K[X] (RatFunc K) hConicParamOneFactor) =
      WithZero.exp (1 : ℤ) := by
  apply h_finite_order_polynomial_factor_parameter a _
      (Polynomial.X + Polynomial.C (a + 2))
  · have hc : (Polynomial.C a) ^ 2 + 2 * Polynomial.C a + 4 =
        (0 : K[X]) := by
      simpa [← Polynomial.C_ofNat] using
        congrArg (Polynomial.C : K → K[X]) ha
    simp only [hConicParamOneFactor, map_add, map_ofNat]
    linear_combination hc
  · have hcofactor := mul_ne_zero (show (2 : K) ≠ 0 by norm_num)
      (h_conic_param_one_root_add_one_ne_zero ha)
    convert hcofactor using 1
    simp only [Polynomial.eval_add, Polynomial.eval_X, Polynomial.eval_C]
    ring

/-- The pullback of `X - 1` has order one at either point above `X = 1`. -/
theorem h_conic_param_x_sub_one_order
    {a : K} (ha : a ^ 2 + 2 * a + 4 = 0) :
    hFiniteOrderAt a (hConicParamX (K := K) - 1) =
      WithZero.exp (1 : ℤ) := by
  rw [h_conic_param_x_sub_one, map_div₀]
  have hnum : hFiniteOrderAt a
      (algebraMap K[X] (RatFunc K) (-2 * hConicParamOneFactor)) =
      WithZero.exp (1 : ℤ) := by
    rw [map_mul, map_mul,
      h_finite_order_polynomial_of_eval_ne_zero a (-2) (by norm_num),
      h_conic_param_one_factor_order ha]
    exact one_mul _
  have hden : hFiniteOrderAt a
      (algebraMap K[X] (RatFunc K) hConicParamDenominator) = 1 := by
    apply h_finite_order_polynomial_of_eval_ne_zero
    simpa [hConicParamDenominator] using
      h_conic_param_denominator_at_one_root_ne_zero ha
  rw [hnum, hden]
  exact div_one _

/-- The pullback of `w` has order one at either point above `X = 1`. -/
theorem h_conic_param_w_order_at_one
    {a : K} (ha : a ^ 2 + 2 * a + 4 = 0) :
    hFiniteOrderAt a (hConicParamW (K := K)) =
      WithZero.exp (1 : ℤ) := by
  simp only [hConicParamW, map_div₀]
  have hq := h_conic_param_one_factor_order (K := K) ha
  have hr : hFiniteOrderAt a
      (algebraMap K[X] (RatFunc K) hConicParamWFactor) = 1 := by
    apply h_finite_order_polynomial_of_eval_ne_zero
    simpa [hConicParamWFactor] using
      h_conic_param_w_factor_at_one_root_ne_zero ha
  have hnegq : hFiniteOrderAt a
      (algebraMap K[X] (RatFunc K) (-hConicParamOneFactor)) =
      WithZero.exp (1 : ℤ) := by
    rw [show -hConicParamOneFactor = (-1 : K[X]) *
        hConicParamOneFactor by ring, map_mul, map_mul,
      h_finite_order_polynomial_of_eval_ne_zero a (-1) (by norm_num), hq]
    exact one_mul _
  have hnum : hFiniteOrderAt a
      (algebraMap K[X] (RatFunc K)
        (-hConicParamOneFactor * hConicParamWFactor)) =
      WithZero.exp (1 : ℤ) := by
    rw [map_mul, map_mul, hnegq, hr]
    exact mul_one _
  have hden : hFiniteOrderAt a
      (algebraMap K[X] (RatFunc K) hConicParamFunctionDenominator) = 1 := by
    apply h_finite_order_polynomial_of_eval_ne_zero
    simp only [hConicParamFunctionDenominator, Polynomial.eval_mul,
      Polynomial.eval_pow, Polynomial.eval_add, Polynomial.eval_X,
      Polynomial.eval_one, Polynomial.eval_ofNat, hConicParamDenominator]
    exact mul_ne_zero
      (mul_ne_zero (by norm_num)
        (h_conic_param_one_root_add_one_ne_zero ha))
      (pow_ne_zero 2 (h_conic_param_denominator_at_one_root_ne_zero ha))
  rw [hnum, hden]
  exact div_one _

/-- The pullback of `W` has order one at either point above `X = 1`. -/
theorem h_conic_param_capitalW_order_at_one
    {a : K} (ha : a ^ 2 + 2 * a + 4 = 0) :
    hFiniteOrderAt a (hConicParamCapitalW (K := K)) =
      WithZero.exp (1 : ℤ) := by
  simp only [hConicParamCapitalW, map_div₀]
  have hq := h_conic_param_one_factor_order (K := K) ha
  have hr : hFiniteOrderAt a
      (algebraMap K[X] (RatFunc K) hConicParamCapitalWFactor) = 1 := by
    apply h_finite_order_polynomial_of_eval_ne_zero
    simpa [hConicParamCapitalWFactor] using
      h_conic_param_capitalW_factor_at_one_root_ne_zero ha
  have hnegq : hFiniteOrderAt a
      (algebraMap K[X] (RatFunc K) (-hConicParamOneFactor)) =
      WithZero.exp (1 : ℤ) := by
    rw [show -hConicParamOneFactor = (-1 : K[X]) *
        hConicParamOneFactor by ring, map_mul, map_mul,
      h_finite_order_polynomial_of_eval_ne_zero a (-1) (by norm_num), hq]
    exact one_mul _
  have hnum : hFiniteOrderAt a
      (algebraMap K[X] (RatFunc K)
        (-hConicParamOneFactor * hConicParamCapitalWFactor)) =
      WithZero.exp (1 : ℤ) := by
    rw [map_mul, map_mul, hnegq, hr]
    exact mul_one _
  have hden : hFiniteOrderAt a
      (algebraMap K[X] (RatFunc K) hConicParamFunctionDenominator) = 1 := by
    apply h_finite_order_polynomial_of_eval_ne_zero
    simp only [hConicParamFunctionDenominator, Polynomial.eval_mul,
      Polynomial.eval_pow, Polynomial.eval_add, Polynomial.eval_X,
      Polynomial.eval_one, Polynomial.eval_ofNat, hConicParamDenominator]
    exact mul_ne_zero
      (mul_ne_zero (by norm_num)
        (h_conic_param_one_root_add_one_ne_zero ha))
      (pow_ne_zero 2 (h_conic_param_denominator_at_one_root_ne_zero ha))
  rw [hnum, hden]
  exact div_one _

/-! ## Orders at `(-1, 2)` -/

/-- The pullback of `X + 1` has order one at the parameter value `m = -1`,
which represents `(-1, 2)`. -/
theorem h_conic_param_x_add_one_order_at_pole :
    hFiniteOrderAt (-1 : K) (hConicParamX (K := K) + 1) =
      WithZero.exp (1 : ℤ) := by
  rw [h_conic_param_x_add_one, map_div₀]
  have hnum : hFiniteOrderAt (-1 : K)
      (algebraMap K[X] (RatFunc K) (-4 * (Polynomial.X + 1))) =
      WithZero.exp (1 : ℤ) := by
    apply h_finite_order_polynomial_factor_parameter (-1 : K) _ (-4)
    · norm_num [← Polynomial.C_ofNat]
      ring
    · norm_num
  have hden : hFiniteOrderAt (-1 : K)
      (algebraMap K[X] (RatFunc K) hConicParamDenominator) = 1 := by
    apply h_finite_order_polynomial_of_eval_ne_zero
    norm_num [hConicParamDenominator]
  rw [hnum, hden]
  exact div_one _

/-- The common function denominator has order one at `m = -1`. -/
theorem h_conic_param_function_denominator_order_at_pole :
    hFiniteOrderAt (-1 : K)
        (algebraMap K[X] (RatFunc K) hConicParamFunctionDenominator) =
      WithZero.exp (1 : ℤ) := by
  apply h_finite_order_polynomial_factor_parameter (-1 : K) _
      (3 * hConicParamDenominator ^ 2)
  · simp only [hConicParamFunctionDenominator]
    norm_num [← Polynomial.C_ofNat]
    ring
  · norm_num [hConicParamDenominator]

/-- The pullback of `w` has a simple pole at `(-1, 2)`. -/
theorem h_conic_param_w_order_at_pole :
    hFiniteOrderAt (-1 : K) (hConicParamW (K := K)) =
      WithZero.exp (-1 : ℤ) := by
  simp only [hConicParamW, map_div₀]
  have hnum : hFiniteOrderAt (-1 : K)
      (algebraMap K[X] (RatFunc K)
        (-hConicParamOneFactor * hConicParamWFactor)) = 1 := by
    apply h_finite_order_polynomial_of_eval_ne_zero
    norm_num [hConicParamOneFactor, hConicParamWFactor]
  rw [hnum, h_conic_param_function_denominator_order_at_pole]
  simp [div_eq_mul_inv, ← WithZero.exp_neg]

/-- The pullback of `W` has a simple pole at `(-1, 2)`. -/
theorem h_conic_param_capitalW_order_at_pole :
    hFiniteOrderAt (-1 : K) (hConicParamCapitalW (K := K)) =
      WithZero.exp (-1 : ℤ) := by
  simp only [hConicParamCapitalW, map_div₀]
  have hnum : hFiniteOrderAt (-1 : K)
      (algebraMap K[X] (RatFunc K)
        (-hConicParamOneFactor * hConicParamCapitalWFactor)) = 1 := by
    apply h_finite_order_polynomial_of_eval_ne_zero
    norm_num [hConicParamOneFactor, hConicParamCapitalWFactor]
  rw [hnum, h_conic_param_function_denominator_order_at_pole]
  simp [div_eq_mul_inv, ← WithZero.exp_neg]

/-! ## The chart at `(-1, -2)` -/

/-- The parametrization denominator in the chart `n = 1 / m`. -/
@[expose]
noncomputable def hMinusParamDenominator : K[X] :=
  2 * Polynomial.X ^ 2 + 1

/-- The numerator of `X` in the chart `n = 1 / m`. -/
@[expose]
noncomputable def hMinusParamXNumerator : K[X] :=
  -(6 * Polynomial.X ^ 2 + 4 * Polynomial.X + 1)

/-- The numerator of `theta` in the chart `n = 1 / m`. -/
@[expose]
noncomputable def hMinusParamThetaNumerator : K[X] :=
  2 * (2 * Polynomial.X ^ 2 - 2 * Polynomial.X - 1)

/-- The conic coordinate `X` in the chart `n = 1 / m`. -/
@[expose]
noncomputable def hMinusParamX : RatFunc K :=
  algebraMap K[X] (RatFunc K) hMinusParamXNumerator /
    algebraMap K[X] (RatFunc K) hMinusParamDenominator

/-- The conic coordinate `theta` in the chart `n = 1 / m`. -/
@[expose]
noncomputable def hMinusParamTheta : RatFunc K :=
  algebraMap K[X] (RatFunc K) hMinusParamThetaNumerator /
    algebraMap K[X] (RatFunc K) hMinusParamDenominator

/-- The numerator of `w` in the chart at `(-1, -2)`. -/
@[expose]
noncomputable def hMinusParamWNumerator : K[X] :=
  -(4 * Polynomial.X ^ 2 + 2 * Polynomial.X + 1) *
    (16 * Polynomial.X ^ 3 + 6 * Polynomial.X ^ 2 + 1)

/-- The numerator of `W` in the chart at `(-1, -2)`. -/
@[expose]
noncomputable def hMinusParamCapitalWNumerator : K[X] :=
  -(4 * Polynomial.X ^ 2 + 2 * Polynomial.X + 1) *
    (4 * Polynomial.X ^ 3 + 18 * Polynomial.X ^ 2 +
      6 * Polynomial.X + 1)

/-- The common function denominator in the chart at `(-1, -2)`. -/
@[expose]
noncomputable def hMinusParamFunctionDenominator : K[X] :=
  3 * (Polynomial.X + 1) * hMinusParamDenominator ^ 2

/-- The regular pullback of `w` in the chart at `(-1, -2)`. -/
@[expose]
noncomputable def hMinusParamW : RatFunc K :=
  algebraMap K[X] (RatFunc K) hMinusParamWNumerator /
    algebraMap K[X] (RatFunc K) hMinusParamFunctionDenominator

/-- The regular pullback of `W` in the chart at `(-1, -2)`. -/
@[expose]
noncomputable def hMinusParamCapitalW : RatFunc K :=
  algebraMap K[X] (RatFunc K) hMinusParamCapitalWNumerator /
    algebraMap K[X] (RatFunc K) hMinusParamFunctionDenominator

/-- The reciprocal parameter chart satisfies the conic equation. -/
theorem h_minus_param_equation :
    hConicEquation (hMinusParamX (K := K)) hMinusParamTheta = 0 := by
  have hdpoly : hMinusParamDenominator (K := K) ≠ 0 := by
    intro h
    have hcoeff := congrArg (fun p : K[X] => p.coeff 0) h
    simp [hMinusParamDenominator] at hcoeff
  have hd : algebraMap K[X] (RatFunc K) hMinusParamDenominator ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr hdpoly
  simp only [hConicEquation, hMinusParamX, hMinusParamTheta,
    hMinusParamXNumerator, hMinusParamThetaNumerator,
    hMinusParamDenominator]
  simp [hMinusParamDenominator, RatFunc.algebraMap_X, map_ofNat] at hd ⊢
  field_simp [hd]
  ring

/-- In the reciprocal parameter chart, `X + 1` has a factor `n`. -/
theorem h_minus_param_x_add_one :
    hMinusParamX (K := K) + 1 =
      algebraMap K[X] (RatFunc K)
          (-4 * Polynomial.X * (Polynomial.X + 1)) /
        algebraMap K[X] (RatFunc K) hMinusParamDenominator := by
  have hdpoly : hMinusParamDenominator (K := K) ≠ 0 := by
    intro h
    have hcoeff := congrArg (fun p : K[X] => p.coeff 0) h
    simp [hMinusParamDenominator] at hcoeff
  have hd : algebraMap K[X] (RatFunc K) hMinusParamDenominator ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr hdpoly
  simp only [hMinusParamX, hMinusParamXNumerator,
    hMinusParamDenominator]
  simp only [hMinusParamDenominator, map_add, map_mul, map_pow,
    map_one, map_ofNat, RatFunc.algebraMap_X] at hd
  simp only [map_neg, map_add, map_mul, map_pow, map_one, map_ofNat,
    RatFunc.algebraMap_X]
  rw [div_add_one hd]
  apply (div_eq_div_iff hd hd).mpr
  ring

/-- In the reciprocal parameter chart, `theta - 2` is a unit times
`n + 1`. -/
theorem h_minus_param_theta_sub_two :
    hMinusParamTheta (K := K) - 2 =
      algebraMap K[X] (RatFunc K) (-4 * (Polynomial.X + 1)) /
        algebraMap K[X] (RatFunc K) hMinusParamDenominator := by
  have hdpoly : hMinusParamDenominator (K := K) ≠ 0 := by
    intro h
    have hcoeff := congrArg (fun p : K[X] => p.coeff 0) h
    simp [hMinusParamDenominator] at hcoeff
  have hd : algebraMap K[X] (RatFunc K) hMinusParamDenominator ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr hdpoly
  simp only [hMinusParamTheta, hMinusParamThetaNumerator,
    hMinusParamDenominator]
  simp [hMinusParamDenominator, RatFunc.algebraMap_X, map_ofNat] at hd ⊢
  field_simp [hd]
  ring

/-- The regular formula for `w` pulls back to `hMinusParamW`. -/
theorem h_minus_param_w_eq_regular :
    hMinusParamW (K := K) =
      hConicWRegularAtMinusBranch hMinusParamX hMinusParamTheta := by
  have hdpoly : hMinusParamDenominator (K := K) ≠ 0 := by
    intro h
    have hcoeff := congrArg (fun p : K[X] => p.coeff 0) h
    simp [hMinusParamDenominator] at hcoeff
  have hd : algebraMap K[X] (RatFunc K) hMinusParamDenominator ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr hdpoly
  have hlinear : algebraMap K[X] (RatFunc K)
      (Polynomial.X + 1) ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr
      h_conic_param_linear_ne_zero
  rw [hConicWRegularAtMinusBranch]
  rw [h_minus_param_theta_sub_two]
  simp only [hMinusParamW, hMinusParamWNumerator,
    hMinusParamFunctionDenominator, hMinusParamX,
    hMinusParamXNumerator, hMinusParamDenominator]
  simp [hMinusParamDenominator, RatFunc.algebraMap_X, map_ofNat]
      at hd hlinear ⊢
  field_simp [hd, hlinear]
  ring

/-- The regular formula for `W` pulls back to `hMinusParamCapitalW`. -/
theorem h_minus_param_capitalW_eq_regular :
    hMinusParamCapitalW (K := K) =
      hConicCapitalWRegularAtMinusBranch hMinusParamX hMinusParamTheta := by
  have hdpoly : hMinusParamDenominator (K := K) ≠ 0 := by
    intro h
    have hcoeff := congrArg (fun p : K[X] => p.coeff 0) h
    simp [hMinusParamDenominator] at hcoeff
  have hd : algebraMap K[X] (RatFunc K) hMinusParamDenominator ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr hdpoly
  have hlinear : algebraMap K[X] (RatFunc K)
      (Polynomial.X + 1) ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr
      h_conic_param_linear_ne_zero
  rw [hConicCapitalWRegularAtMinusBranch]
  rw [h_minus_param_theta_sub_two]
  simp only [hMinusParamCapitalW, hMinusParamCapitalWNumerator,
    hMinusParamFunctionDenominator, hMinusParamX,
    hMinusParamXNumerator, hMinusParamDenominator]
  simp [hMinusParamDenominator, RatFunc.algebraMap_X, map_ofNat]
      at hd hlinear ⊢
  field_simp [hd, hlinear]
  ring

/-- The regular reciprocal chart is the pullback of the original conic
function `w`. -/
theorem h_minus_param_w_eq_conic :
    hMinusParamW (K := K) =
      hConicW hMinusParamX hMinusParamTheta := by
  have hdpoly : hMinusParamDenominator (K := K) ≠ 0 := by
    intro h
    have hcoeff := congrArg (fun p : K[X] => p.coeff 0) h
    simp [hMinusParamDenominator] at hcoeff
  have hd : algebraMap K[X] (RatFunc K) hMinusParamDenominator ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr hdpoly
  have hparameter : (RatFunc.X : RatFunc K) ≠ 0 := RatFunc.X_ne_zero
  have hlinear : algebraMap K[X] (RatFunc K)
      (Polynomial.X + 1) ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr
      h_conic_param_linear_ne_zero
  have hxplus : hMinusParamX (K := K) + 1 ≠ 0 := by
    rw [h_minus_param_x_add_one]
    apply div_ne_zero _ hd
    rw [map_mul, map_mul]
    exact mul_ne_zero (mul_ne_zero (by norm_num) hparameter) hlinear
  have htheta : hMinusParamTheta (K := K) - 2 ≠ 0 := by
    rw [h_minus_param_theta_sub_two]
    apply div_ne_zero _ hd
    rw [map_mul]
    exact mul_ne_zero (by norm_num) hlinear
  rw [h_minus_param_w_eq_regular]
  exact (h_conic_w_eq_regular_at_minus_branch hxplus htheta
    h_minus_param_equation).symm

/-- The regular reciprocal chart is the pullback of the original conic
function `W`. -/
theorem h_minus_param_capitalW_eq_conic :
    hMinusParamCapitalW (K := K) =
      hConicCapitalW hMinusParamX hMinusParamTheta := by
  have hdpoly : hMinusParamDenominator (K := K) ≠ 0 := by
    intro h
    have hcoeff := congrArg (fun p : K[X] => p.coeff 0) h
    simp [hMinusParamDenominator] at hcoeff
  have hd : algebraMap K[X] (RatFunc K) hMinusParamDenominator ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr hdpoly
  have hparameter : (RatFunc.X : RatFunc K) ≠ 0 := RatFunc.X_ne_zero
  have hlinear : algebraMap K[X] (RatFunc K)
      (Polynomial.X + 1) ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr
      h_conic_param_linear_ne_zero
  have hxplus : hMinusParamX (K := K) + 1 ≠ 0 := by
    rw [h_minus_param_x_add_one]
    apply div_ne_zero _ hd
    rw [map_mul, map_mul]
    exact mul_ne_zero (mul_ne_zero (by norm_num) hparameter) hlinear
  have htheta : hMinusParamTheta (K := K) - 2 ≠ 0 := by
    rw [h_minus_param_theta_sub_two]
    apply div_ne_zero _ hd
    rw [map_mul]
    exact mul_ne_zero (by norm_num) hlinear
  rw [h_minus_param_capitalW_eq_regular]
  exact (h_conic_capitalW_eq_regular_at_minus_branch hxplus htheta
    h_minus_param_equation).symm

/-- The coordinate `X + 1` is a uniformizer at `(-1, -2)`. -/
theorem h_minus_param_x_add_one_order :
    hFiniteOrderAt (0 : K) (hMinusParamX (K := K) + 1) =
      WithZero.exp (1 : ℤ) := by
  rw [h_minus_param_x_add_one, map_div₀]
  have hnum : hFiniteOrderAt (0 : K)
      (algebraMap K[X] (RatFunc K)
        (-4 * Polynomial.X * (Polynomial.X + 1))) =
      WithZero.exp (1 : ℤ) := by
    apply h_finite_order_polynomial_factor_parameter (0 : K) _
      (-4 * (Polynomial.X + 1))
    · norm_num [← Polynomial.C_ofNat]
      ring
    · norm_num
  have hden : hFiniteOrderAt (0 : K)
      (algebraMap K[X] (RatFunc K) hMinusParamDenominator) = 1 := by
    apply h_finite_order_polynomial_of_eval_ne_zero
    norm_num [hMinusParamDenominator]
  rw [hnum, hden]
  exact div_one _

/-- The regular pullback of `w` is a unit at `(-1, -2)`. -/
theorem h_minus_param_w_order :
    hFiniteOrderAt (0 : K) (hMinusParamW (K := K)) = 1 := by
  apply h_finite_order_fraction_of_eval_ne_zero
  · norm_num [hMinusParamWNumerator]
  · norm_num [hMinusParamFunctionDenominator, hMinusParamDenominator]

/-- The regular pullback of `W` is a unit at `(-1, -2)`. -/
theorem h_minus_param_capitalW_order :
    hFiniteOrderAt (0 : K) (hMinusParamCapitalW (K := K)) = 1 := by
  apply h_finite_order_fraction_of_eval_ne_zero
  · norm_num [hMinusParamCapitalWNumerator]
  · norm_num [hMinusParamFunctionDenominator, hMinusParamDenominator]

/-! ## The two points at infinity -/

/-- The pullback of the infinity coordinate `u = 1 / X`. -/
@[expose]
noncomputable def hConicParamU : RatFunc K :=
  algebraMap K[X] (RatFunc K) hConicParamDenominator /
    algebraMap K[X] (RatFunc K) hConicParamXNumerator

/-- The pullback of the infinity coordinate `eta = theta / X`. -/
@[expose]
noncomputable def hConicParamEta : RatFunc K :=
  algebraMap K[X] (RatFunc K) hConicParamThetaNumerator /
    algebraMap K[X] (RatFunc K) hConicParamXNumerator

/-- The displayed infinity coordinate is the reciprocal of the conic
coordinate `X`. -/
theorem h_conic_param_u_eq :
    hConicParamU (K := K) = 1 / hConicParamX := by
  have hd : algebraMap K[X] (RatFunc K) hConicParamDenominator ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr
      h_conic_param_denominator_ne_zero
  have hxpoly : hConicParamXNumerator (K := K) ≠ 0 := by
    intro h
    have hcoeff := congrArg (fun p : K[X] => p.coeff 0) h
    norm_num [hConicParamXNumerator] at hcoeff
  have hx : algebraMap K[X] (RatFunc K) hConicParamXNumerator ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr hxpoly
  simp only [hConicParamU, hConicParamX]
  field_simp [hd, hx]

/-- The displayed infinity coordinate `eta` is `theta / X`. -/
theorem h_conic_param_eta_eq :
    hConicParamEta (K := K) = hConicParamTheta / hConicParamX := by
  have hd : algebraMap K[X] (RatFunc K) hConicParamDenominator ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr
      h_conic_param_denominator_ne_zero
  have hxpoly : hConicParamXNumerator (K := K) ≠ 0 := by
    intro h
    have hcoeff := congrArg (fun p : K[X] => p.coeff 0) h
    norm_num [hConicParamXNumerator] at hcoeff
  have hx : algebraMap K[X] (RatFunc K) hConicParamXNumerator ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr hxpoly
  simp only [hConicParamEta, hConicParamTheta, hConicParamX]
  field_simp [hd, hx]

/-- A root of `m^2 + 2` is nonzero. -/
theorem h_conic_param_infinity_root_ne_zero
    {a : K} (ha : a ^ 2 + 2 = 0) : a ≠ 0 := by
  intro h
  rw [h] at ha
  norm_num at ha

/-- A root of `m^2 + 2` is not `-1`. -/
theorem h_conic_param_infinity_root_add_one_ne_zero
    {a : K} (ha : a ^ 2 + 2 = 0) : a + 1 ≠ 0 := by
  intro h
  have haeq : a = -1 := by linear_combination h
  rw [haeq] at ha
  norm_num at ha

/-- The numerator of the conic coordinate `X` is nonzero at a point at
infinity. -/
theorem h_conic_param_x_numerator_at_infinity_ne_zero
    {a : K} (ha : a ^ 2 + 2 = 0) :
    -(a ^ 2 + 4 * a + 6) ≠ 0 := by
  have hplus := h_conic_param_infinity_root_add_one_ne_zero ha
  intro hx
  apply hplus
  linear_combination (-1 / 4) * hx - (1 / 4) * ha

/-- The numerator of `w` is nonzero at a point at infinity. -/
theorem h_conic_param_w_numerator_at_infinity_ne_zero
    {a : K} (ha : a ^ 2 + 2 = 0) :
    -(a ^ 2 + 2 * a + 4) * (a ^ 3 + 6 * a + 16) ≠ 0 := by
  have hplus := h_conic_param_infinity_root_add_one_ne_zero ha
  have hfirst : a ^ 2 + 2 * a + 4 ≠ 0 := by
    intro h
    apply hplus
    linear_combination (1 / 2) * (h - ha)
  have hsecond : a ^ 3 + 6 * a + 16 ≠ 0 := by
    intro h
    have hlinear : 4 * a + 16 = 0 := by
      linear_combination h - a * ha
    have haeq : a = -4 := by linear_combination (1 / 4) * hlinear
    rw [haeq] at ha
    norm_num at ha
  exact mul_ne_zero (neg_ne_zero.mpr hfirst) hsecond

/-- The numerator of `W` is nonzero at a point at infinity. -/
theorem h_conic_param_capitalW_numerator_at_infinity_ne_zero
    {a : K} (ha : a ^ 2 + 2 = 0) :
    -(a ^ 2 + 2 * a + 4) *
      (a ^ 3 + 6 * a ^ 2 + 18 * a + 4) ≠ 0 := by
  have hplus := h_conic_param_infinity_root_add_one_ne_zero ha
  have hfirst : a ^ 2 + 2 * a + 4 ≠ 0 := by
    intro h
    apply hplus
    linear_combination (1 / 2) * (h - ha)
  have hsecond : a ^ 3 + 6 * a ^ 2 + 18 * a + 4 ≠ 0 := by
    intro h
    have hlinear : 16 * a - 8 = 0 := by
      linear_combination h - (a + 6) * ha
    have haeq : a = 1 / 2 := by
      linear_combination (1 / 16) * hlinear
    rw [haeq] at ha
    norm_num at ha
  exact mul_ne_zero (neg_ne_zero.mpr hfirst) hsecond

/-- The parametrization denominator `m^2 + 2` has order one at either point
at infinity. -/
theorem h_conic_param_denominator_order_at_infinity
    {a : K} (ha : a ^ 2 + 2 = 0) :
    hFiniteOrderAt a
        (algebraMap K[X] (RatFunc K) hConicParamDenominator) =
      WithZero.exp (1 : ℤ) := by
  apply h_finite_order_polynomial_factor_parameter a _
      (Polynomial.X + Polynomial.C a)
  · have hc : (Polynomial.C a) ^ 2 + 2 = (0 : K[X]) := by
      simpa [← Polynomial.C_ofNat] using
        congrArg (Polynomial.C : K → K[X]) ha
    simp only [hConicParamDenominator]
    linear_combination hc
  · have htwice := mul_ne_zero (show (2 : K) ≠ 0 by norm_num)
      (h_conic_param_infinity_root_ne_zero ha)
    convert htwice using 1
    simp only [Polynomial.eval_add, Polynomial.eval_X, Polynomial.eval_C]
    ring

/-- The coordinate `u = 1 / X` is a uniformizer at either point at
infinity. -/
theorem h_conic_param_u_order_at_infinity
    {a : K} (ha : a ^ 2 + 2 = 0) :
    hFiniteOrderAt a (hConicParamU (K := K)) =
      WithZero.exp (1 : ℤ) := by
  simp only [hConicParamU, map_div₀]
  have hden : hFiniteOrderAt a
      (algebraMap K[X] (RatFunc K) hConicParamXNumerator) = 1 := by
    apply h_finite_order_polynomial_of_eval_ne_zero
    simpa [hConicParamXNumerator] using
      h_conic_param_x_numerator_at_infinity_ne_zero ha
  rw [h_conic_param_denominator_order_at_infinity ha, hden]
  exact div_one _

/-- The common function denominator has order two at either point at
infinity. -/
theorem h_conic_param_function_denominator_order_at_infinity
    {a : K} (ha : a ^ 2 + 2 = 0) :
    hFiniteOrderAt a
        (algebraMap K[X] (RatFunc K) hConicParamFunctionDenominator) =
      WithZero.exp (2 : ℤ) := by
  have hlinear : hFiniteOrderAt a
      (algebraMap K[X] (RatFunc K) (3 * (Polynomial.X + 1))) = 1 := by
    apply h_finite_order_polynomial_of_eval_ne_zero
    norm_num
    exact h_conic_param_infinity_root_add_one_ne_zero ha
  simp only [hConicParamFunctionDenominator]
  rw [map_mul, map_mul, hlinear, map_pow, map_pow,
    h_conic_param_denominator_order_at_infinity ha, one_mul]
  rw [pow_two, ← WithZero.exp_add]
  norm_num

/-- The function `w` has order `-2` at either point at infinity. -/
theorem h_conic_param_w_order_at_infinity
    {a : K} (ha : a ^ 2 + 2 = 0) :
    hFiniteOrderAt a (hConicParamW (K := K)) =
      WithZero.exp (-2 : ℤ) := by
  simp only [hConicParamW, map_div₀]
  have hnum : hFiniteOrderAt a
      (algebraMap K[X] (RatFunc K)
        (-hConicParamOneFactor * hConicParamWFactor)) = 1 := by
    apply h_finite_order_polynomial_of_eval_ne_zero
    simpa [hConicParamOneFactor, hConicParamWFactor] using
      h_conic_param_w_numerator_at_infinity_ne_zero ha
  rw [hnum, h_conic_param_function_denominator_order_at_infinity ha]
  simp [div_eq_mul_inv, ← WithZero.exp_neg]

/-- The function `W` has order `-2` at either point at infinity. -/
theorem h_conic_param_capitalW_order_at_infinity
    {a : K} (ha : a ^ 2 + 2 = 0) :
    hFiniteOrderAt a (hConicParamCapitalW (K := K)) =
      WithZero.exp (-2 : ℤ) := by
  simp only [hConicParamCapitalW, map_div₀]
  have hnum : hFiniteOrderAt a
      (algebraMap K[X] (RatFunc K)
        (-hConicParamOneFactor * hConicParamCapitalWFactor)) = 1 := by
    apply h_finite_order_polynomial_of_eval_ne_zero
    simpa [hConicParamOneFactor, hConicParamCapitalWFactor] using
      h_conic_param_capitalW_numerator_at_infinity_ne_zero ha
  rw [hnum, h_conic_param_function_denominator_order_at_infinity ha]
  simp [div_eq_mul_inv, ← WithZero.exp_neg]

/-! ## Identification with the points in the conic charts -/

/-- The parameter value corresponding to `(X, theta) = (1, theta)`. -/
@[expose]
noncomputable def hConicParameterAtOne (theta : K) : K :=
  (theta - 2) / 2

/-- A point with `theta^2 = -12` above `X = 1` corresponds to a root of the
parameter polynomial `m^2 + 2m + 4`. -/
theorem h_conic_parameter_at_one_is_root
    {theta : K} (htheta : theta ^ 2 = -12) :
    hConicParameterAtOne theta ^ 2 +
        2 * hConicParameterAtOne theta + 4 = 0 := by
  simp only [hConicParameterAtOne]
  field_simp
  linear_combination htheta

/-- The three orders above `X = 1`, stated using the conic coordinate
`theta`. -/
theorem h_conic_orders_above_one
    {theta : K} (htheta : theta ^ 2 = -12) :
    hFiniteOrderAt (hConicParameterAtOne theta)
        (hConicParamX (K := K) - 1) = WithZero.exp (1 : ℤ) ∧
      hFiniteOrderAt (hConicParameterAtOne theta) hConicParamW =
        WithZero.exp (1 : ℤ) ∧
      hFiniteOrderAt (hConicParameterAtOne theta) hConicParamCapitalW =
        WithZero.exp (1 : ℤ) := by
  have ha := h_conic_parameter_at_one_is_root htheta
  exact ⟨h_conic_param_x_sub_one_order ha,
    h_conic_param_w_order_at_one ha,
    h_conic_param_capitalW_order_at_one ha⟩

/-- The parameter value corresponding to the point `(u, eta) = (0, eta)`
in the infinity chart. -/
@[expose]
noncomputable def hConicParameterAtInfinity (eta : K) : K :=
  (eta + 2) / (1 - eta)

/-- The denominator in `hConicParameterAtInfinity` is nonzero at a point of
the infinity conic. -/
theorem h_conic_parameter_at_infinity_denominator_ne_zero
    {eta : K} (heta : eta ^ 2 = -2) : 1 - eta ≠ 0 := by
  intro h
  have hetaone : eta = 1 := by linear_combination -h
  rw [hetaone] at heta
  norm_num at heta

/-- A point with `eta^2 = -2` at infinity corresponds to a root of
`m^2 + 2`. -/
theorem h_conic_parameter_at_infinity_is_root
    {eta : K} (heta : eta ^ 2 = -2) :
    hConicParameterAtInfinity eta ^ 2 + 2 = 0 := by
  have hden := h_conic_parameter_at_infinity_denominator_ne_zero heta
  simp only [hConicParameterAtInfinity]
  field_simp [hden]
  linear_combination 3 * heta

/-- The specialization of the pulled back coordinate `eta` at the stated
parameter value is the original infinity coordinate. -/
theorem h_conic_parameter_at_infinity_eta_value
    {eta : K} (heta : eta ^ 2 = -2) :
    hConicParamThetaNumerator.eval (hConicParameterAtInfinity eta) /
        hConicParamXNumerator.eval (hConicParameterAtInfinity eta) = eta := by
  have hden := h_conic_parameter_at_infinity_denominator_ne_zero heta
  have ha := h_conic_parameter_at_infinity_is_root heta
  have hx : hConicParamXNumerator.eval
      (hConicParameterAtInfinity eta) ≠ 0 := by
    simpa [hConicParamXNumerator] using
      h_conic_param_x_numerator_at_infinity_ne_zero ha
  apply (div_eq_iff hx).mpr
  simp only [hConicParameterAtInfinity, hConicParamThetaNumerator,
    hConicParamXNumerator]
  simp only [Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_add,
    Polynomial.eval_pow, Polynomial.eval_neg, Polynomial.eval_X,
    Polynomial.eval_ofNat]
  field_simp [hden]
  have hz : eta ^ 2 + 2 = 0 := by linear_combination heta
  linear_combination (-6 + 3 * eta) * hz

/-- The orders at either point at infinity, stated using the coordinate
`eta`. -/
theorem h_conic_orders_at_infinity
    {eta : K} (heta : eta ^ 2 = -2) :
    hFiniteOrderAt (hConicParameterAtInfinity eta)
        (hConicParamU (K := K)) = WithZero.exp (1 : ℤ) ∧
      hFiniteOrderAt (hConicParameterAtInfinity eta) hConicParamW =
        WithZero.exp (-2 : ℤ) ∧
      hFiniteOrderAt (hConicParameterAtInfinity eta) hConicParamCapitalW =
        WithZero.exp (-2 : ℤ) := by
  have ha := h_conic_parameter_at_infinity_is_root heta
  exact ⟨h_conic_param_u_order_at_infinity ha,
    h_conic_param_w_order_at_infinity ha,
    h_conic_param_capitalW_order_at_infinity ha⟩

/-! ## Local unit statements for the specialized factors -/

/-- The factors used after removing `X - 1` are units in the local ring at
either point above `X = 1`. -/
theorem h_conic_local_units_above_one
    {a : K} (ha : a ^ 2 + 2 * a + 4 = 0) :
    IsUnit (algebraMap K[X] (HParameterLocalRing K a)
      hConicParamDenominator) ∧
      IsUnit (algebraMap K[X] (HParameterLocalRing K a)
        hConicParamWFactor) ∧
      IsUnit (algebraMap K[X] (HParameterLocalRing K a)
        hConicParamCapitalWFactor) := by
  refine ⟨h_parameter_local_ring_isUnit_of_eval_ne_zero a _ ?_,
    h_parameter_local_ring_isUnit_of_eval_ne_zero a _ ?_,
    h_parameter_local_ring_isUnit_of_eval_ne_zero a _ ?_⟩
  · simpa [hConicParamDenominator] using
      h_conic_param_denominator_at_one_root_ne_zero ha
  · simpa [hConicParamWFactor] using
      h_conic_param_w_factor_at_one_root_ne_zero ha
  · simpa [hConicParamCapitalWFactor] using
      h_conic_param_capitalW_factor_at_one_root_ne_zero ha

/-- The numerators of `w` and `W` and the factors other than `m + 1` in
their denominator are units at `m = -1`. -/
theorem h_conic_local_units_at_pole :
    IsUnit (algebraMap K[X] (HParameterLocalRing K (-1))
      (-hConicParamOneFactor * hConicParamWFactor)) ∧
      IsUnit (algebraMap K[X] (HParameterLocalRing K (-1))
        (-hConicParamOneFactor * hConicParamCapitalWFactor)) ∧
      IsUnit (algebraMap K[X] (HParameterLocalRing K (-1))
        (3 * hConicParamDenominator ^ 2)) := by
  refine ⟨h_parameter_local_ring_isUnit_of_eval_ne_zero (-1) _ ?_,
    h_parameter_local_ring_isUnit_of_eval_ne_zero (-1) _ ?_,
    h_parameter_local_ring_isUnit_of_eval_ne_zero (-1) _ ?_⟩
  · norm_num [hConicParamOneFactor, hConicParamWFactor]
  · norm_num [hConicParamOneFactor, hConicParamCapitalWFactor]
  · norm_num [hConicParamDenominator]

/-- The two regular function numerators and their denominator are units in
the reciprocal local ring at `n = 0`. -/
theorem h_conic_local_units_at_regular_branch :
    IsUnit (algebraMap K[X] (HParameterLocalRing K 0)
      hMinusParamWNumerator) ∧
      IsUnit (algebraMap K[X] (HParameterLocalRing K 0)
        hMinusParamCapitalWNumerator) ∧
      IsUnit (algebraMap K[X] (HParameterLocalRing K 0)
        hMinusParamFunctionDenominator) := by
  refine ⟨h_parameter_local_ring_isUnit_of_eval_ne_zero 0 _ ?_,
    h_parameter_local_ring_isUnit_of_eval_ne_zero 0 _ ?_,
    h_parameter_local_ring_isUnit_of_eval_ne_zero 0 _ ?_⟩
  · norm_num [hMinusParamWNumerator]
  · norm_num [hMinusParamCapitalWNumerator]
  · norm_num [hMinusParamFunctionDenominator, hMinusParamDenominator]

/-- The factors remaining after removing the square of `m - a` are units
at either point at infinity. -/
theorem h_conic_local_units_at_infinity
    {a : K} (ha : a ^ 2 + 2 = 0) :
    IsUnit (algebraMap K[X] (HParameterLocalRing K a)
      hConicParamXNumerator) ∧
      IsUnit (algebraMap K[X] (HParameterLocalRing K a)
        (-hConicParamOneFactor * hConicParamWFactor)) ∧
      IsUnit (algebraMap K[X] (HParameterLocalRing K a)
        (-hConicParamOneFactor * hConicParamCapitalWFactor)) := by
  refine ⟨h_parameter_local_ring_isUnit_of_eval_ne_zero a _ ?_,
    h_parameter_local_ring_isUnit_of_eval_ne_zero a _ ?_,
    h_parameter_local_ring_isUnit_of_eval_ne_zero a _ ?_⟩
  · simpa [hConicParamXNumerator] using
      h_conic_param_x_numerator_at_infinity_ne_zero ha
  · simpa [hConicParamOneFactor, hConicParamWFactor] using
      h_conic_param_w_numerator_at_infinity_ne_zero ha
  · simpa [hConicParamOneFactor, hConicParamCapitalWFactor] using
      h_conic_param_capitalW_numerator_at_infinity_ne_zero ha

end OnLeConjecture.DThree
