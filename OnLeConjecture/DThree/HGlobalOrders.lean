/-!
# The function field and global orders of the `H` conic

The two coordinate functions from `HConicLocalRing` generate the full rational
function field `K(m)`.  The inverse parameter is

`m = (theta - 2) / (X + 1)`.

This file also represents the finite zero and pole divisors of a rational
function by the roots of its reduced numerator and denominator.  The missing
point of the projective parameter line is accounted for by the difference of
their degrees.  Over an algebraically closed field, the resulting projective
zero and pole degrees agree.

The final theorem converts two distinct local orders into the branch order
inequality used in Lemma `dthree-Horders`.  Its remaining input is a bound for
the pole degree of the derivative rational function.
-/

public section

namespace OnLeConjecture.DThree

open Polynomial
open scoped WithZero

/-! ## The rational function field of the conic -/

variable {K : Type*} [Field K] [CharZero K]

set_option linter.flexible false in
/-- The rational parameter is recovered from the two conic coordinate
functions. -/
theorem h_conic_param_parameter_identity :
    (hConicParamTheta (K := K) - 2) /
        (hConicParamX (K := K) + 1) = RatFunc.X := by
  have hd : algebraMap K[X] (RatFunc K)
      hConicParamDenominator ≠ 0 :=
    IsFractionRing.to_map_eq_zero_iff.not.mpr
      h_conic_param_denominator_ne_zero
  have hlinear : (RatFunc.X + 1 : RatFunc K) ≠ 0 := by
    have hp : (Polynomial.X + 1 : K[X]) ≠ 0 := by
      simpa using Polynomial.X_sub_C_ne_zero (-1 : K)
    simpa only [map_add, RatFunc.algebraMap_X, map_one] using
      RatFunc.algebraMap_ne_zero hp
  have hfourlinear : (-4 - RatFunc.X * 4 : RatFunc K) ≠ 0 := by
    have hproduct := mul_ne_zero
      (show (-4 : RatFunc K) ≠ 0 by norm_num) hlinear
    convert hproduct using 1
    all_goals ring
  have hneglinear : (-1 - RatFunc.X : RatFunc K) ≠ 0 := by
    have hnegative := neg_ne_zero.mpr hlinear
    convert hnegative using 1
    all_goals ring
  have hdenexpr :
      (-6 + RatFunc.X * (-4 + -RatFunc.X) +
          (RatFunc.X ^ 2 + 2) : RatFunc K) ≠ 0 := by
    convert hfourlinear using 1
    all_goals ring
  simp only [hConicParamTheta, hConicParamX,
    hConicParamThetaNumerator, hConicParamXNumerator,
    hConicParamDenominator]
  simp [hConicParamDenominator, RatFunc.algebraMap_X, map_ofNat]
    at hd hlinear hfourlinear hneglinear hdenexpr ⊢
  field_simp [hd, hfourlinear, hneglinear, hdenexpr]
  ring

/-- The subfield generated by the two coordinate functions in the rational
parametrization of the conic. -/
@[expose]
noncomputable def hConicParamField : IntermediateField K (RatFunc K) :=
  IntermediateField.adjoin K
    {hConicParamX (K := K), hConicParamTheta (K := K)}

/-- The conic coordinate functions generate `K(m)`. -/
theorem h_conic_param_field_eq_top : hConicParamField (K := K) = ⊤ := by
  apply top_unique
  rw [← RatFunc.adjoin_X (K := K), IntermediateField.adjoin_le_iff]
  intro y hy
  rw [Set.mem_singleton_iff] at hy
  subst y
  rw [← h_conic_param_parameter_identity (K := K)]
  apply IntermediateField.div_mem
  · apply IntermediateField.sub_mem
    · exact IntermediateField.mem_adjoin_pair_right K _ _
    · exact IntermediateField.natCast_mem _ 2
  · apply IntermediateField.add_mem
    · exact IntermediateField.mem_adjoin_pair_left K _ _
    · exact IntermediateField.one_mem _

/-- The coordinate image ring generated by the two rational functions on
the conic. -/
noncomputable abbrev HConicCoordinateImageRing :=
  Algebra.adjoin K
    ({hConicParamX (K := K), hConicParamTheta (K := K)} :
      Set (RatFunc K))

/-- The rational function field is a fraction field of the coordinate image
ring. -/
noncomputable instance hConicCoordinateImageRing.instIsFractionRing :
    IsFractionRing (HConicCoordinateImageRing (K := K)) (RatFunc K) := by
  apply IsFractionRing.of_field _ _
  intro z
  have hz : z ∈ hConicParamField (K := K) := by
    rw [h_conic_param_field_eq_top]
    trivial
  obtain ⟨r, hr, s, hs, hrs⟩ :=
    IntermediateField.mem_adjoin_iff_div.mp hz
  exact ⟨⟨r, hr⟩, ⟨s, hs⟩, by simpa using hrs⟩

/-- The fraction field of the coordinate image ring is equivalent over `K`
to the rational function field of the parameter line. -/
@[expose]
noncomputable def hConicCoordinateFractionFieldEquiv :
    FractionRing (HConicCoordinateImageRing (K := K)) ≃ₐ[K] RatFunc K :=
  (FractionRing.algEquiv
    (HConicCoordinateImageRing (K := K)) (RatFunc K)).restrictScalars K

/-- The field generated by the conic coordinates is equivalent to the
rational function field of the parameter line. -/
@[expose]
noncomputable def hConicParamFieldEquiv :
    hConicParamField (K := K) ≃ₐ[K] RatFunc K :=
  (IntermediateField.equivOfEq
    (h_conic_param_field_eq_top (K := K))).trans
      IntermediateField.topEquiv

/-! ## Finite effective divisors of a rational function -/

section Divisors

variable {F : Type*} [Field F]

/-- The finite zero divisor of a rational function.  Its coefficient at `a`
is the multiplicity of `a` as a root of the reduced numerator. -/
@[expose]
noncomputable def hFiniteZeroDivisor (f : RatFunc F) : F →₀ ℕ := by
  classical
  exact f.num.roots.toFinsupp

/-- The finite pole divisor of a rational function.  Its coefficient at `a`
is the multiplicity of `a` as a root of the reduced denominator. -/
@[expose]
noncomputable def hFinitePoleDivisor (f : RatFunc F) : F →₀ ℕ := by
  classical
  exact f.denom.roots.toFinsupp

/-- The degree of a finite effective divisor. -/
@[expose]
def hEffectiveDivisorDegree (D : F →₀ ℕ) : ℕ :=
  D.sum (fun _ => id)

/-- The coefficient of the finite zero divisor is a root multiplicity. -/
theorem h_finite_zero_divisor_apply (f : RatFunc F) (a : F) :
    hFiniteZeroDivisor f a = f.num.rootMultiplicity a := by
  classical
  simp [hFiniteZeroDivisor]

/-- The coefficient of the finite pole divisor is a root multiplicity. -/
theorem h_finite_pole_divisor_apply (f : RatFunc F) (a : F) :
    hFinitePoleDivisor f a = f.denom.rootMultiplicity a := by
  classical
  simp [hFinitePoleDivisor]

/-- Over an algebraically closed field, the finite zero divisor has degree
equal to the degree of the reduced numerator. -/
theorem h_finite_zero_divisor_degree [IsAlgClosed F] (f : RatFunc F) :
    hEffectiveDivisorDegree (hFiniteZeroDivisor f) = f.num.natDegree := by
  classical
  rw [hEffectiveDivisorDegree, hFiniteZeroDivisor,
    Multiset.toFinsupp_sum_eq, IsAlgClosed.card_roots_eq_natDegree]

/-- Over an algebraically closed field, the finite pole divisor has degree
equal to the degree of the reduced denominator. -/
theorem h_finite_pole_divisor_degree [IsAlgClosed F] (f : RatFunc F) :
    hEffectiveDivisorDegree (hFinitePoleDivisor f) =
      f.denom.natDegree := by
  classical
  rw [hEffectiveDivisorDegree, hFinitePoleDivisor,
    Multiset.toFinsupp_sum_eq, IsAlgClosed.card_roots_eq_natDegree]

/-- The finite support containing every zero and pole of a reduced rational
function. -/
@[expose]
noncomputable def hFiniteDivisorSupport (f : RatFunc F) : Finset F := by
  classical
  exact f.num.roots.toFinset ∪ f.denom.roots.toFinset

/-- The zero multiplicity at the missing point of the affine parameter
line. -/
@[expose]
noncomputable def hInfinityZeroMultiplicity (f : RatFunc F) : ℕ :=
  f.denom.natDegree - f.num.natDegree

/-- The pole multiplicity at the missing point of the affine parameter
line. -/
@[expose]
noncomputable def hInfinityPoleMultiplicity (f : RatFunc F) : ℕ :=
  f.num.natDegree - f.denom.natDegree

/-- The conventional order at infinity.  It is the inverse of Mathlib's
valuation at infinity, so the uniformizer `1 / m` has order one. -/
@[expose]
noncomputable def hOrderAtInfinity : RatFunc F →*₀ ℤᵐ⁰ := by
  classical
  exact MonoidWithZeroHom.comp MonoidWithZero.inverse
    (RatFunc.inftyValuation F).toMonoidWithZeroHom

/-- The order at infinity is the denominator degree minus the numerator
degree. -/
theorem h_order_at_infinity_eq_natDegree_sub
    (f : RatFunc F) (hf : f ≠ 0) :
    hOrderAtInfinity f =
      WithZero.exp ((f.denom.natDegree : ℤ) - f.num.natDegree) := by
  classical
  simp only [hOrderAtInfinity, MonoidWithZeroHom.comp_apply,
    MonoidWithZero.inverse_apply, Ring.inverse_eq_inv]
  change ((RatFunc.inftyValuation F) f)⁻¹ = _
  rw [RatFunc.inftyValuation_apply,
    RatFunc.inftyValuation_of_nonzero F hf, RatFunc.intDegree,
    ← WithZero.exp_neg]
  congr
  omega

/-- A nonnegative order at infinity is the infinity zero multiplicity, and
the infinity pole multiplicity vanishes. -/
theorem h_infinity_divisor_coefficients_of_order
    {f : RatFunc F} (hf : f ≠ 0) (k : ℕ)
    (horder : hOrderAtInfinity f = WithZero.exp (k : ℤ)) :
    hInfinityZeroMultiplicity f = k ∧
      hInfinityPoleMultiplicity f = 0 := by
  have hformula := h_order_at_infinity_eq_natDegree_sub f hf
  have hexponent :
      (f.denom.natDegree : ℤ) - f.num.natDegree = (k : ℤ) :=
    WithZero.exp_injective (hformula.symm.trans horder)
  simp only [hInfinityZeroMultiplicity, hInfinityPoleMultiplicity]
  omega

/-- A nonpositive order at infinity is the infinity pole multiplicity, and
the infinity zero multiplicity vanishes. -/
theorem h_infinity_divisor_coefficients_of_pole_order
    {f : RatFunc F} (hf : f ≠ 0) (k : ℕ)
    (horder : hOrderAtInfinity f = WithZero.exp (-(k : ℤ))) :
    hInfinityZeroMultiplicity f = 0 ∧
      hInfinityPoleMultiplicity f = k := by
  have hformula := h_order_at_infinity_eq_natDegree_sub f hf
  have hexponent :
      (f.denom.natDegree : ℤ) - f.num.natDegree = -(k : ℤ) :=
    WithZero.exp_injective (hformula.symm.trans horder)
  simp only [hInfinityZeroMultiplicity, hInfinityPoleMultiplicity]
  omega

/-- The degree of the projective zero divisor represented by the reduced
fraction and its order at infinity. -/
@[expose]
noncomputable def hProjectiveZeroDivisorDegree (f : RatFunc F) : ℕ :=
  hEffectiveDivisorDegree (hFiniteZeroDivisor f) +
    hInfinityZeroMultiplicity f

/-- The degree of the projective pole divisor represented by the reduced
fraction and its order at infinity. -/
@[expose]
noncomputable def hProjectivePoleDivisorDegree (f : RatFunc F) : ℕ :=
  hEffectiveDivisorDegree (hFinitePoleDivisor f) +
    hInfinityPoleMultiplicity f

/-- The projective zero divisor degree is the maximum of the numerator and
denominator degrees. -/
theorem h_projective_zero_divisor_degree_eq_max [IsAlgClosed F]
    (f : RatFunc F) :
    hProjectiveZeroDivisorDegree f =
      max f.num.natDegree f.denom.natDegree := by
  rw [hProjectiveZeroDivisorDegree, h_finite_zero_divisor_degree,
    hInfinityZeroMultiplicity]
  omega

/-- The projective pole divisor degree is the maximum of the numerator and
denominator degrees. -/
theorem h_projective_pole_divisor_degree_eq_max [IsAlgClosed F]
    (f : RatFunc F) :
    hProjectivePoleDivisorDegree f =
      max f.num.natDegree f.denom.natDegree := by
  rw [hProjectivePoleDivisorDegree, h_finite_pole_divisor_degree,
    hInfinityPoleMultiplicity]
  omega

/-- A principal rational function has equal projective zero and pole
degrees. -/
theorem h_projective_zero_degree_eq_pole_degree [IsAlgClosed F]
    (f : RatFunc F) :
    hProjectiveZeroDivisorDegree f = hProjectivePoleDivisorDegree f := by
  rw [h_projective_zero_divisor_degree_eq_max,
    h_projective_pole_divisor_degree_eq_max]

/-! ## Local orders and divisor coefficients -/

/-- The finite order of a polynomial is the multiplicity of the
corresponding root. -/
theorem h_finite_order_polynomial_eq_rootMultiplicity
    (a : F) (p : F[X]) (hp : p ≠ 0) :
    hFiniteOrderAt a (algebraMap F[X] (RatFunc F) p) =
      WithZero.exp (p.rootMultiplicity a : ℤ) := by
  let q : F[X] :=
    p /ₘ (Polynomial.X - Polynomial.C a) ^ p.rootMultiplicity a
  have hfactor :
      (Polynomial.X - Polynomial.C a) ^ p.rootMultiplicity a * q = p :=
    Polynomial.pow_mul_divByMonic_rootMultiplicity_eq p a
  have hq : q.eval a ≠ 0 :=
    Polynomial.eval_divByMonic_pow_rootMultiplicity_ne_zero a hp
  conv_lhs => rw [← hfactor]
  rw [map_mul, map_mul, map_pow, map_pow,
    h_finite_order_parameter,
    h_finite_order_polynomial_of_eval_ne_zero a q hq]
  simp

/-- The finite order of a nonzero rational function is the numerator root
multiplicity minus the denominator root multiplicity. -/
theorem h_finite_order_eq_rootMultiplicity_sub
    (a : F) (f : RatFunc F) (hf : f ≠ 0) :
    hFiniteOrderAt a f =
      WithZero.exp ((f.num.rootMultiplicity a : ℤ) -
        (f.denom.rootMultiplicity a : ℤ)) := by
  conv_lhs => rw [← RatFunc.num_div_denom f]
  rw [map_div₀,
    h_finite_order_polynomial_eq_rootMultiplicity a f.num
      (RatFunc.num_ne_zero hf),
    h_finite_order_polynomial_eq_rootMultiplicity a f.denom
      f.denom_ne_zero]
  exact (WithZero.exp_sub _ _).symm

/-- The sum of all finite orders and the order at infinity of a nonzero
rational function is zero. -/
theorem h_principal_order_sum_zero [IsAlgClosed F]
    (f : RatFunc F) (hf : f ≠ 0) :
    (∑ a ∈ hFiniteDivisorSupport f, (hFiniteOrderAt a f).log) +
      (hOrderAtInfinity f).log = 0 := by
  classical
  simp_rw [h_finite_order_eq_rootMultiplicity_sub
    (f := f) (hf := hf), WithZero.log_exp]
  rw [h_order_at_infinity_eq_natDegree_sub f hf, WithZero.log_exp]
  have hnumCount :
      ∑ a ∈ hFiniteDivisorSupport f, f.num.roots.count a =
        f.num.roots.card := by
    apply Multiset.sum_count_eq_card
    intro a ha
    exact Finset.mem_union_left _ (Multiset.mem_toFinset.mpr ha)
  have hdenomCount :
      ∑ a ∈ hFiniteDivisorSupport f, f.denom.roots.count a =
        f.denom.roots.card := by
    apply Multiset.sum_count_eq_card
    intro a ha
    exact Finset.mem_union_right _ (Multiset.mem_toFinset.mpr ha)
  simp_rw [← Polynomial.count_roots] at ⊢
  rw [Finset.sum_sub_distrib, ← Nat.cast_sum, ← Nat.cast_sum,
    hnumCount, hdenomCount, IsAlgClosed.card_roots_eq_natDegree,
    IsAlgClosed.card_roots_eq_natDegree]
  omega

/-- A nonnegative local order is exactly the corresponding zero divisor
coefficient, and the pole coefficient vanishes. -/
theorem h_divisor_coefficients_of_finite_order
    {f : RatFunc F} (hf : f ≠ 0) (a : F) (k : ℕ)
    (horder : hFiniteOrderAt a f = WithZero.exp (k : ℤ)) :
    hFiniteZeroDivisor f a = k ∧ hFinitePoleDivisor f a = 0 := by
  rw [h_finite_zero_divisor_apply, h_finite_pole_divisor_apply]
  have hformula := h_finite_order_eq_rootMultiplicity_sub a f hf
  have hexponent :
      (f.num.rootMultiplicity a : ℤ) -
          (f.denom.rootMultiplicity a : ℤ) = (k : ℤ) := by
    exact WithZero.exp_injective (hformula.symm.trans horder)
  have hcoprime := Polynomial.aeval_ne_zero_of_isCoprime
    (RatFunc.isCoprime_num_denom f) a
  rcases hcoprime with hnum | hden
  · have hnumEval : f.num.eval a ≠ 0 := by
      simpa [Polynomial.aeval_def] using hnum
    have hnumMultiplicity : f.num.rootMultiplicity a = 0 :=
      Polynomial.rootMultiplicity_eq_zero
        (by simpa [Polynomial.IsRoot] using hnumEval)
    rw [hnumMultiplicity] at hexponent
    have hk : k = 0 := by omega
    have hdenMultiplicity : f.denom.rootMultiplicity a = 0 := by omega
    exact ⟨hnumMultiplicity.trans hk.symm, hdenMultiplicity⟩
  · have hdenEval : f.denom.eval a ≠ 0 := by
      simpa [Polynomial.aeval_def] using hden
    have hdenMultiplicity : f.denom.rootMultiplicity a = 0 :=
      Polynomial.rootMultiplicity_eq_zero
        (by simpa [Polynomial.IsRoot] using hdenEval)
    rw [hdenMultiplicity] at hexponent
    have hnumMultiplicity : f.num.rootMultiplicity a = k := by omega
    exact ⟨hnumMultiplicity, hdenMultiplicity⟩

/-- A nonpositive local order is exactly the corresponding pole divisor
coefficient, and the zero coefficient vanishes. -/
theorem h_divisor_coefficients_of_finite_pole_order
    {f : RatFunc F} (hf : f ≠ 0) (a : F) (k : ℕ)
    (horder : hFiniteOrderAt a f = WithZero.exp (-(k : ℤ))) :
    hFiniteZeroDivisor f a = 0 ∧ hFinitePoleDivisor f a = k := by
  rw [h_finite_zero_divisor_apply, h_finite_pole_divisor_apply]
  have hformula := h_finite_order_eq_rootMultiplicity_sub a f hf
  have hexponent :
      (f.num.rootMultiplicity a : ℤ) -
          (f.denom.rootMultiplicity a : ℤ) = -(k : ℤ) := by
    exact WithZero.exp_injective (hformula.symm.trans horder)
  have hcoprime := Polynomial.aeval_ne_zero_of_isCoprime
    (RatFunc.isCoprime_num_denom f) a
  rcases hcoprime with hnum | hden
  · have hnumEval : f.num.eval a ≠ 0 := by
      simpa [Polynomial.aeval_def] using hnum
    have hnumMultiplicity : f.num.rootMultiplicity a = 0 :=
      Polynomial.rootMultiplicity_eq_zero
        (by simpa [Polynomial.IsRoot] using hnumEval)
    rw [hnumMultiplicity] at hexponent
    have hdenMultiplicity : f.denom.rootMultiplicity a = k := by omega
    exact ⟨hnumMultiplicity, hdenMultiplicity⟩
  · have hdenEval : f.denom.eval a ≠ 0 := by
      simpa [Polynomial.aeval_def] using hden
    have hdenMultiplicity : f.denom.rootMultiplicity a = 0 :=
      Polynomial.rootMultiplicity_eq_zero
        (by simpa [Polynomial.IsRoot] using hdenEval)
    rw [hdenMultiplicity] at hexponent
    have hk : k = 0 := by omega
    have hnumMultiplicity : f.num.rootMultiplicity a = 0 := by omega
    exact ⟨hnumMultiplicity, hdenMultiplicity.trans hk.symm⟩

omit [Field F] in
/-- The multiplicities of two distinct elements of a multiset add to at
most its cardinality. -/
theorem h_multiset_count_add_count_le_card
    [DecidableEq F] {a b : F} (hab : a ≠ b) (s : Multiset F) :
    s.count a + s.count b ≤ s.card := by
  classical
  induction s using Multiset.induction_on with
  | empty => simp
  | @cons x s ih =>
      by_cases hxa : x = a
      · subst x
        have hba : b ≠ a := Ne.symm hab
        simp [hba]
        omega
      · by_cases hxb : x = b
        · subst x
          simp [hab]
          omega
        · have hax : a ≠ x := Ne.symm hxa
          have hbx : b ≠ x := Ne.symm hxb
          simp [hax, hbx]
          omega

/-- The zero divisor coefficients at two distinct finite points are bounded
by the degree of the projective pole divisor. -/
theorem h_two_finite_zero_coefficients_le_pole_degree [IsAlgClosed F]
    (f : RatFunc F) {a b : F} (hab : a ≠ b) :
    hFiniteZeroDivisor f a + hFiniteZeroDivisor f b ≤
      hProjectivePoleDivisorDegree f := by
  classical
  have hcount :
      f.num.roots.count a + f.num.roots.count b ≤ f.num.roots.card :=
    h_multiset_count_add_count_le_card hab f.num.roots
  calc
    hFiniteZeroDivisor f a + hFiniteZeroDivisor f b =
        f.num.roots.count a + f.num.roots.count b := by
      rw [h_finite_zero_divisor_apply, h_finite_zero_divisor_apply,
        Polynomial.count_roots, Polynomial.count_roots]
    _ ≤ f.num.roots.card := hcount
    _ = f.num.natDegree := IsAlgClosed.card_roots_eq_natDegree
    _ ≤ hProjectiveZeroDivisorDegree f := by
      rw [h_projective_zero_divisor_degree_eq_max]
      exact le_max_left _ _
    _ = hProjectivePoleDivisorDegree f :=
      h_projective_zero_degree_eq_pole_degree f

/-- Two distinct finite zero orders are bounded by the degree of the
projective pole divisor. -/
theorem h_two_finite_orders_le_pole_degree [IsAlgClosed F]
    {f : RatFunc F} (hf : f ≠ 0) {a b : F} (hab : a ≠ b)
    {r s : ℕ}
    (ha : hFiniteOrderAt a f = WithZero.exp (r : ℤ))
    (hb : hFiniteOrderAt b f = WithZero.exp (s : ℤ)) :
    r + s ≤ hProjectivePoleDivisorDegree f := by
  have hra := h_divisor_coefficients_of_finite_order hf a r ha
  have hsb := h_divisor_coefficients_of_finite_order hf b s hb
  rw [← hra.1, ← hsb.1]
  exact h_two_finite_zero_coefficients_le_pole_degree f hab

/-- The global divisor comparison gives the branch order bound from exact
local derivative orders and a pole degree bound. -/
theorem h_branch_order_sum_le_of_ratFunc
    [IsAlgClosed F]
    (N kOne kTwo : ℕ) (hN : 2 ≤ N)
    (hkOne : 1 ≤ kOne) (hkTwo : 1 ≤ kTwo)
    {f : RatFunc F} (hf : f ≠ 0) {a b : F} (hab : a ≠ b)
    (ha : hFiniteOrderAt a f =
      WithZero.exp ((kOne - 1 : ℕ) : ℤ))
    (hb : hFiniteOrderAt b f =
      WithZero.exp ((kTwo - 1 : ℕ) : ℤ))
    (hpole : hProjectivePoleDivisorDegree f ≤
      hDerivativePoleDegreeBound N) :
    kOne + kTwo ≤ hBranchOrderSumBound N := by
  have hzeroPole :
      (kOne - 1) + (kTwo - 1) ≤ hDerivativePoleDegreeBound N :=
    (h_two_finite_orders_le_pole_degree hf hab ha hb).trans hpole
  exact h_branch_order_sum_le N kOne kTwo hN hkOne hkTwo hzeroPole

/-- Under the degree bound from Lemma `dthree-Horders`, the branch order
sum satisfies the strict rational inequality in the article. -/
theorem h_branch_order_sum_lt_five_halves_of_ratFunc
    [IsAlgClosed F]
    (N kOne kTwo : ℕ) (hN : 5 ≤ N)
    (hkOne : 1 ≤ kOne) (hkTwo : 1 ≤ kTwo)
    {f : RatFunc F} (hf : f ≠ 0) {a b : F} (hab : a ≠ b)
    (ha : hFiniteOrderAt a f =
      WithZero.exp ((kOne - 1 : ℕ) : ℤ))
    (hb : hFiniteOrderAt b f =
      WithZero.exp ((kTwo - 1 : ℕ) : ℤ))
    (hpole : hProjectivePoleDivisorDegree f ≤
      hDerivativePoleDegreeBound N) :
    (kOne + kTwo : ℚ) < 5 * (N : ℚ) / 2 := by
  have hle := h_branch_order_sum_le_of_ratFunc N kOne kTwo
    (by omega) hkOne hkTwo hf hab ha hb hpole
  have hlt := h_branch_order_sum_bound_lt_five_halves N hN
  exact_mod_cast lt_of_le_of_lt (show (kOne + kTwo : ℚ) ≤
    hBranchOrderSumBound N by exact_mod_cast hle) hlt

end Divisors

end OnLeConjecture.DThree
