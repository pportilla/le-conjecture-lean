module

public import OnLeConjecture.DThree.EPointedMapAssembly
public import OnLeConjecture.DThree.HPointedMapInterfaces
public import OnLeConjecture.DThree.AnalyticRescaling

/-!
# Base ring exclusion for the normalized degree three pairs

The base rings used after cubic and quadratic descent map canonically to the
ordinary homogeneous source ring. Exclusion from the image of these maps
implies the descended exclusion hypotheses used by the normalized collision
theorems.
-/

public section

namespace OnLeConjecture.DThree

open OnLeConjecture.Analytic

/-- Evaluation of an ordinary polynomial in two abstract base variables at
two homogeneous forms. -/
noncomputable def pairBaseToForm (P Q : Form ℂ) :
    Form ℂ →ₐ[ℂ] Form ℂ :=
  MvPolynomial.aeval fun i => if i = 0 then P else Q

/-- Evaluation of an abstract `E` base polynomial at two homogeneous forms. -/
noncomputable def ePairBaseToForm (P Q : Form ℂ) :
    EBaseRing ℂ →ₐ[ℂ] Form ℂ :=
  MvPolynomial.aeval fun
    | EBaseCoordinate.p => P
    | EBaseCoordinate.q => Q

/-- Rename the two `E` base coordinates as the ordinary variables `0` and
`1`. -/
noncomputable def eBasePolynomialToForm :
    EBaseRing ℂ →ₐ[ℂ] Form ℂ :=
  MvPolynomial.aeval fun
    | EBaseCoordinate.p => formX
    | EBaseCoordinate.q => formT

/-- Evaluation is unchanged after renaming the two `E` base variables. -/
theorem pairBaseToForm_eBasePolynomialToForm
    (P Q : Form ℂ) (S : EBaseRing ℂ) :
    pairBaseToForm P Q (eBasePolynomialToForm S) =
      ePairBaseToForm P Q S := by
  let left : EBaseRing ℂ →ₐ[ℂ] Form ℂ :=
    (pairBaseToForm P Q).comp eBasePolynomialToForm
  have hequality : left = ePairBaseToForm P Q := by
    apply MvPolynomial.algHom_ext
    intro i
    cases i with
    | p => simp [left, pairBaseToForm, eBasePolynomialToForm,
        ePairBaseToForm, formX]
    | q => simp [left, pairBaseToForm, eBasePolynomialToForm,
        ePairBaseToForm, formT]
  exact AlgHom.congr_fun hequality S

/-- Exclusion from the algebra generated by a pair implies the same
exclusion when the abstract `E` coordinates are used. -/
theorem not_mem_ePairBase_of_not_mem_pairBase
    {P Q R : Form ℂ}
    (hnotbase : R ∉ Set.range (pairBaseToForm P Q)) :
    R ∉ Set.range (ePairBaseToForm P Q) := by
  intro hmembership
  obtain ⟨S, hS⟩ := hmembership
  apply hnotbase
  refine ⟨eBasePolynomialToForm S, ?_⟩
  rw [pairBaseToForm_eBasePolynomialToForm, hS]

/-- Scale the two abstract `E` base coordinates. -/
noncomputable def eScaleBaseCoordinates (u v : ℂ) :
    EBaseRing ℂ →ₐ[ℂ] EBaseRing ℂ :=
  MvPolynomial.aeval fun
    | EBaseCoordinate.p => MvPolynomial.C u * eBaseP ℂ
    | EBaseCoordinate.q => MvPolynomial.C v * eBaseQ ℂ

/-- Evaluation at two rescaled forms commutes with source substitution after
scaling the abstract base coordinates. -/
theorem ePairBaseToForm_rescale
    (P Q : Form ℂ) (s u v : ℂ) (S : EBaseRing ℂ) :
    ePairBaseToForm (rescaleForm s u P) (rescaleForm s v Q) S =
      diagonalPolynomialSubstitution (sourceRescaleVector s)
        (ePairBaseToForm P Q (eScaleBaseCoordinates u v S)) := by
  let left : EBaseRing ℂ →ₐ[ℂ] Form ℂ :=
    ePairBaseToForm (rescaleForm s u P) (rescaleForm s v Q)
  let right : EBaseRing ℂ →ₐ[ℂ] Form ℂ :=
    (diagonalPolynomialSubstitutionAlgHom
      (sourceRescaleVector s)).comp
      ((ePairBaseToForm P Q).comp (eScaleBaseCoordinates u v))
  have hequality : left = right := by
    apply MvPolynomial.algHom_ext
    intro i
    cases i with
    | p =>
        simp only [left, right, ePairBaseToForm, eScaleBaseCoordinates,
          AlgHom.comp_apply, MvPolynomial.aeval_X, map_mul,
          MvPolynomial.aeval_C, eBaseP]
        rw [AlgHom.commutes,
          diagonalPolynomialSubstitutionAlgHom_apply]
        change rescaleForm s u P = MvPolynomial.C u *
          diagonalPolynomialSubstitution (sourceRescaleVector s) P
        rw [rescaleForm,
          ← diagonalPolynomialSubstitution_sourceRescale]
    | q =>
        simp only [left, right, ePairBaseToForm, eScaleBaseCoordinates,
          AlgHom.comp_apply, MvPolynomial.aeval_X, map_mul,
          MvPolynomial.aeval_C, eBaseQ]
        rw [AlgHom.commutes,
          diagonalPolynomialSubstitutionAlgHom_apply]
        change rescaleForm s v Q = MvPolynomial.C v *
          diagonalPolynomialSubstitution (sourceRescaleVector s) Q
        rw [rescaleForm,
          ← diagonalPolynomialSubstitution_sourceRescale]
  exact AlgHom.congr_fun hequality S

/-- The normalized `E` image coordinate ring mapped to ordinary homogeneous
forms. -/
noncomputable def eNormalizedBaseToForm :
    EBaseRing ℂ →ₐ[ℂ] Form ℂ :=
  eSourceCubeSubstitutionForm.comp (eBaseToSource ℂ)

@[simp]
theorem eNormalizedBaseToForm_p :
    eNormalizedBaseToForm (eBaseP ℂ) = cubicForm 0 3 := by
  rw [eNormalizedBaseToForm, AlgHom.comp_apply, eBaseToSource_p,
    eSourceCubeSubstitutionForm_sourceP]

@[simp]
theorem eNormalizedBaseToForm_q :
    eNormalizedBaseToForm (eBaseQ ℂ) = quarticForm 1 0 0 4 0 := by
  rw [eNormalizedBaseToForm, AlgHom.comp_apply, eBaseToSource_q,
    eSourceCubeSubstitutionForm_sourceQ]

/-- The normalized `E` base map is evaluation at its cubic and quartic
forms. -/
theorem eNormalizedBaseToForm_eq_pairBaseToForm :
    eNormalizedBaseToForm =
      ePairBaseToForm (cubicForm 0 3) (quarticForm 1 0 0 4 0) := by
  apply MvPolynomial.algHom_ext
  intro i
  cases i with
  | p =>
      change eNormalizedBaseToForm (eBaseP ℂ) =
        ePairBaseToForm (cubicForm 0 3) (quarticForm 1 0 0 4 0)
          (eBaseP ℂ)
      rw [eNormalizedBaseToForm_p]
      simp [ePairBaseToForm, eBaseP]
  | q =>
      change eNormalizedBaseToForm (eBaseQ ℂ) =
        ePairBaseToForm (cubicForm 0 3) (quarticForm 1 0 0 4 0)
          (eBaseQ ℂ)
      rw [eNormalizedBaseToForm_q]
      simp [ePairBaseToForm, eBaseQ]

/-- Exclusion from the normalized `E` base ring descends to every cubic
descent of the third form. -/
theorem eSource_not_mem_base_of_form_not_mem_base
    {R : Form ℂ}
    (hnotbase : R ∉ Set.range eNormalizedBaseToForm)
    {Rzero : ESourceRing ℂ}
    (hdescent : eSourceCubeSubstitutionForm Rzero = R) :
    Rzero ∉ Set.range (eBaseToSource ℂ) := by
  intro hmembership
  obtain ⟨S, hS⟩ := hmembership
  apply hnotbase
  refine ⟨S, ?_⟩
  rw [eNormalizedBaseToForm, AlgHom.comp_apply, hS, hdescent]

/-- Exclusion from the algebra generated by an unnormalized pair is
preserved by the source and target rescalings that produce the `E` pair. -/
theorem rescaleForm_not_mem_eNormalizedBase_of_not_mem_ePairBase
    (P Q R : Form ℂ) (s u v : ℂ) (hs : s ≠ 0)
    (hP : rescaleForm s u P = cubicForm 0 3)
    (hQ : rescaleForm s v Q = quarticForm 1 0 0 4 0)
    (hnotbase : R ∉ Set.range (ePairBaseToForm P Q)) :
    rescaleForm s 1 R ∉ Set.range eNormalizedBaseToForm := by
  intro hmembership
  obtain ⟨S, hS⟩ := hmembership
  apply hnotbase
  refine ⟨eScaleBaseCoordinates u v S, ?_⟩
  apply diagonalPolynomialSubstitution_injective
    (sourceRescaleVector s) (sourceRescaleVector_ne_zero hs)
  rw [← ePairBaseToForm_rescale]
  rw [eNormalizedBaseToForm_eq_pairBaseToForm] at hS
  rw [← hP, ← hQ] at hS
  rw [hS]
  rw [rescaleForm, ← diagonalPolynomialSubstitution_sourceRescale]
  simp

/-- The ordinary pair base exclusion is preserved by a rescaling to the
normalized `E` pair. -/
theorem rescaleForm_not_mem_eNormalizedBase_of_not_mem_pairBase
    (P Q R : Form ℂ) (s u v : ℂ) (hs : s ≠ 0)
    (hP : rescaleForm s u P = cubicForm 0 3)
    (hQ : rescaleForm s v Q = quarticForm 1 0 0 4 0)
    (hnotbase : R ∉ Set.range (pairBaseToForm P Q)) :
    rescaleForm s 1 R ∉ Set.range eNormalizedBaseToForm := by
  exact rescaleForm_not_mem_eNormalizedBase_of_not_mem_ePairBase
    P Q R s u v hs hP hQ
      (not_mem_ePairBase_of_not_mem_pairBase hnotbase)

/-- The normalized `E` exclusion theorem may be stated using the image of the
ordinary homogeneous base map. -/
theorem eNormalizedPointedMap_not_hasInjectiveRepresentative_of_not_mem_base
    {omega : ℂ} (g : PointedMapGerm 2 3) (R : Form ℂ) (N : ℕ)
    (homega : IsPrimitiveRoot omega 3)
    (hR : R.IsHomogeneous N)
    (hdiv : formT ^ 5 ∣
      OnLeConjecture.Polynomial.jacobian (cubicForm 0 3) R)
    (hnotbase : R ∉ Set.range eNormalizedBaseToForm)
    (htail : ∀ i,
      g.1.component i - Germ.coordinatePolynomialAlgHom 2
          (eInvariantPolynomialMap R i) ∈
        Germ.maximalIdeal 2 ^ (eInvariantDegrees N i + 1)) :
    ¬ g.HasInjectiveRepresentative := by
  apply eNormalizedPointedMap_not_hasInjectiveRepresentative
    g R N homega hR hdiv
  · intro Rzero hdescent
    exact eSource_not_mem_base_of_form_not_mem_base hnotbase hdescent
  · exact htail

/-- Evaluation of an abstract `H` base polynomial at two homogeneous forms. -/
noncomputable def hPairBaseToForm (P Q : Form ℂ) :
    HBaseRing ℂ →ₐ[ℂ] Form ℂ :=
  MvPolynomial.aeval fun
    | HBaseCoordinate.p => P
    | HBaseCoordinate.q => Q

/-- Rename the two `H` base coordinates as the ordinary variables `0` and
`1`. -/
noncomputable def hBasePolynomialToForm :
    HBaseRing ℂ →ₐ[ℂ] Form ℂ :=
  MvPolynomial.aeval fun
    | HBaseCoordinate.p => formX
    | HBaseCoordinate.q => formT

/-- Evaluation is unchanged after renaming the two `H` base variables. -/
theorem pairBaseToForm_hBasePolynomialToForm
    (P Q : Form ℂ) (S : HBaseRing ℂ) :
    pairBaseToForm P Q (hBasePolynomialToForm S) =
      hPairBaseToForm P Q S := by
  let left : HBaseRing ℂ →ₐ[ℂ] Form ℂ :=
    (pairBaseToForm P Q).comp hBasePolynomialToForm
  have hequality : left = hPairBaseToForm P Q := by
    apply MvPolynomial.algHom_ext
    intro i
    cases i with
    | p => simp [left, pairBaseToForm, hBasePolynomialToForm,
        hPairBaseToForm, formX]
    | q => simp [left, pairBaseToForm, hBasePolynomialToForm,
        hPairBaseToForm, formT]
  exact AlgHom.congr_fun hequality S

/-- Exclusion from the algebra generated by a pair implies the same
exclusion when the abstract `H` coordinates are used. -/
theorem not_mem_hPairBase_of_not_mem_pairBase
    {P Q R : Form ℂ}
    (hnotbase : R ∉ Set.range (pairBaseToForm P Q)) :
    R ∉ Set.range (hPairBaseToForm P Q) := by
  intro hmembership
  obtain ⟨S, hS⟩ := hmembership
  apply hnotbase
  refine ⟨hBasePolynomialToForm S, ?_⟩
  rw [pairBaseToForm_hBasePolynomialToForm, hS]

/-- Scale the two abstract `H` base coordinates. -/
noncomputable def hScaleBaseCoordinates (u v : ℂ) :
    HBaseRing ℂ →ₐ[ℂ] HBaseRing ℂ :=
  MvPolynomial.aeval fun
    | HBaseCoordinate.p => MvPolynomial.C u * hBaseP ℂ
    | HBaseCoordinate.q => MvPolynomial.C v * hBaseQ ℂ

/-- Evaluation at two rescaled forms commutes with source substitution after
scaling the abstract `H` base coordinates. -/
theorem hPairBaseToForm_rescale
    (P Q : Form ℂ) (s u v : ℂ) (S : HBaseRing ℂ) :
    hPairBaseToForm (rescaleForm s u P) (rescaleForm s v Q) S =
      diagonalPolynomialSubstitution (sourceRescaleVector s)
        (hPairBaseToForm P Q (hScaleBaseCoordinates u v S)) := by
  let left : HBaseRing ℂ →ₐ[ℂ] Form ℂ :=
    hPairBaseToForm (rescaleForm s u P) (rescaleForm s v Q)
  let right : HBaseRing ℂ →ₐ[ℂ] Form ℂ :=
    (diagonalPolynomialSubstitutionAlgHom
      (sourceRescaleVector s)).comp
      ((hPairBaseToForm P Q).comp (hScaleBaseCoordinates u v))
  have hequality : left = right := by
    apply MvPolynomial.algHom_ext
    intro i
    cases i with
    | p =>
        simp only [left, right, hPairBaseToForm, hScaleBaseCoordinates,
          AlgHom.comp_apply, MvPolynomial.aeval_X, map_mul,
          MvPolynomial.aeval_C, hBaseP]
        rw [AlgHom.commutes,
          diagonalPolynomialSubstitutionAlgHom_apply]
        change rescaleForm s u P = MvPolynomial.C u *
          diagonalPolynomialSubstitution (sourceRescaleVector s) P
        rw [rescaleForm,
          ← diagonalPolynomialSubstitution_sourceRescale]
    | q =>
        simp only [left, right, hPairBaseToForm, hScaleBaseCoordinates,
          AlgHom.comp_apply, MvPolynomial.aeval_X, map_mul,
          MvPolynomial.aeval_C, hBaseQ]
        rw [AlgHom.commutes,
          diagonalPolynomialSubstitutionAlgHom_apply]
        change rescaleForm s v Q = MvPolynomial.C v *
          diagonalPolynomialSubstitution (sourceRescaleVector s) Q
        rw [rescaleForm,
          ← diagonalPolynomialSubstitution_sourceRescale]
  exact AlgHom.congr_fun hequality S

/-- The normalized `H` image coordinate ring mapped to ordinary homogeneous
forms. -/
noncomputable def hNormalizedBaseToForm :
    HBaseRing ℂ →ₐ[ℂ] Form ℂ :=
  (hQuadraticSubstitutionForm (K := ℂ)).comp
    (hBaseToWeightedForm ℂ)

@[simp]
theorem hNormalizedBaseToForm_p :
    hNormalizedBaseToForm (hBaseP ℂ) = cubicForm 3 0 := by
  rw [hNormalizedBaseToForm, AlgHom.comp_apply, hBaseToWeightedForm_p,
    hQuadraticSubstitutionForm_hPForm]

@[simp]
theorem hNormalizedBaseToForm_q :
    hNormalizedBaseToForm (hBaseQ ℂ) = quarticForm 1 0 4 0 2 := by
  rw [hNormalizedBaseToForm, AlgHom.comp_apply, hBaseToWeightedForm_q,
    hQuadraticSubstitutionForm_hQForm]

/-- The normalized `H` base map is evaluation at its cubic and quartic
forms. -/
theorem hNormalizedBaseToForm_eq_pairBaseToForm :
    hNormalizedBaseToForm =
      hPairBaseToForm (cubicForm 3 0) (quarticForm 1 0 4 0 2) := by
  apply MvPolynomial.algHom_ext
  intro i
  cases i with
  | p =>
      change hNormalizedBaseToForm (hBaseP ℂ) =
        hPairBaseToForm (cubicForm 3 0) (quarticForm 1 0 4 0 2)
          (hBaseP ℂ)
      rw [hNormalizedBaseToForm_p]
      simp [hPairBaseToForm, hBaseP]
  | q =>
      change hNormalizedBaseToForm (hBaseQ ℂ) =
        hPairBaseToForm (cubicForm 3 0) (quarticForm 1 0 4 0 2)
          (hBaseQ ℂ)
      rw [hNormalizedBaseToForm_q]
      simp [hPairBaseToForm, hBaseQ]

/-- Exclusion from the normalized `H` base ring descends to every quadratic
descent of the third form. -/
theorem hWeightedForm_not_mem_base_of_form_not_mem_base
    {R : Form ℂ}
    (hnotbase : R ∉ Set.range hNormalizedBaseToForm)
    {Rzero : MvPolynomial (Fin 2) ℂ}
    (hdescent : hQuadraticSubstitutionForm Rzero = R) :
    Rzero ∉ Set.range (hBaseToWeightedForm ℂ) := by
  intro hmembership
  obtain ⟨S, hS⟩ := hmembership
  apply hnotbase
  refine ⟨S, ?_⟩
  rw [hNormalizedBaseToForm, AlgHom.comp_apply, hS, hdescent]

/-- Exclusion from the algebra generated by an unnormalized pair is
preserved by the source and target rescalings that produce the `H` pair. -/
theorem rescaleForm_not_mem_hNormalizedBase_of_not_mem_hPairBase
    (P Q R : Form ℂ) (s u v : ℂ) (hs : s ≠ 0)
    (hP : rescaleForm s u P = cubicForm 3 0)
    (hQ : rescaleForm s v Q = quarticForm 1 0 4 0 2)
    (hnotbase : R ∉ Set.range (hPairBaseToForm P Q)) :
    rescaleForm s 1 R ∉ Set.range hNormalizedBaseToForm := by
  intro hmembership
  obtain ⟨S, hS⟩ := hmembership
  apply hnotbase
  refine ⟨hScaleBaseCoordinates u v S, ?_⟩
  apply diagonalPolynomialSubstitution_injective
    (sourceRescaleVector s) (sourceRescaleVector_ne_zero hs)
  rw [← hPairBaseToForm_rescale]
  rw [hNormalizedBaseToForm_eq_pairBaseToForm] at hS
  rw [← hP, ← hQ] at hS
  rw [hS]
  rw [rescaleForm, ← diagonalPolynomialSubstitution_sourceRescale]
  simp

/-- The ordinary pair base exclusion is preserved by a rescaling to the
normalized `H` pair. -/
theorem rescaleForm_not_mem_hNormalizedBase_of_not_mem_pairBase
    (P Q R : Form ℂ) (s u v : ℂ) (hs : s ≠ 0)
    (hP : rescaleForm s u P = cubicForm 3 0)
    (hQ : rescaleForm s v Q = quarticForm 1 0 4 0 2)
    (hnotbase : R ∉ Set.range (pairBaseToForm P Q)) :
    rescaleForm s 1 R ∉ Set.range hNormalizedBaseToForm := by
  exact rescaleForm_not_mem_hNormalizedBase_of_not_mem_hPairBase
    P Q R s u v hs hP hQ
      (not_mem_hPairBase_of_not_mem_pairBase hnotbase)

/-- The normalized `E` conditions on a pointed map germ and its third
homogeneous form. -/
@[expose]
def IsNormalizedECase
    (g : PointedMapGerm 2 3) (R : Form ℂ) (N : ℕ) : Prop :=
  R.IsHomogeneous N ∧
  R ∉ Set.range eNormalizedBaseToForm ∧
  formT ^ 5 ∣
    OnLeConjecture.Polynomial.jacobian (cubicForm 0 3) R ∧
  formT ^ 5 ∣
    OnLeConjecture.Polynomial.jacobian (quarticForm 1 0 0 4 0) R ∧
  ∀ i, g.1.component i - Germ.coordinatePolynomialAlgHom 2
      (eInvariantPolynomialMap R i) ∈
    Germ.maximalIdeal 2 ^ (eInvariantDegrees N i + 1)

/-- The normalized `H` conditions on a pointed map germ and its third
homogeneous form. -/
@[expose]
def IsNormalizedHCase
    (g : PointedMapGerm 2 3) (R : Form ℂ) (N : ℕ) : Prop :=
  R.IsHomogeneous N ∧
  R ∉ Set.range hNormalizedBaseToForm ∧
  formT ^ 5 ∣
    OnLeConjecture.Polynomial.jacobian (cubicForm 3 0) R ∧
  formT ^ 5 ∣
    OnLeConjecture.Polynomial.jacobian (quarticForm 1 0 4 0 2) R ∧
  ∀ i, g.1.component i - Germ.coordinatePolynomialAlgHom 2
      (hOrdinaryPolynomialMap R i) ∈
    Germ.maximalIdeal 2 ^ (hOrdinaryDegrees N i + 1)

/-- The normalized `E` conditions exclude an injective representative. -/
theorem IsNormalizedECase.not_hasInjectiveRepresentative
    {omega : ℂ} {g : PointedMapGerm 2 3} {R : Form ℂ} {N : ℕ}
    (data : IsNormalizedECase g R N)
    (homega : IsPrimitiveRoot omega 3) :
    ¬ g.HasInjectiveRepresentative := by
  rcases data with ⟨hR, hnotbase, hPdiv, _hQdiv, htail⟩
  exact eNormalizedPointedMap_not_hasInjectiveRepresentative_of_not_mem_base
    g R N homega hR hPdiv hnotbase htail

/-- Reflection invariance turns the normalized `H` conditions into a
contradiction to local injectivity. -/
theorem IsNormalizedHCase.not_hasInjectiveRepresentative_of_invariant
    {g : PointedMapGerm 2 3} {R : Form ℂ} {N : ℕ}
    (data : IsNormalizedHCase g R N)
    (hN : 5 ≤ N)
    (hinvariant : R = eRotateForm (-1) R) :
    ¬ g.HasInjectiveRepresentative := by
  rcases data with ⟨hR, hnotbase, hPdiv, hQdiv, htail⟩
  apply hInvariantNormalizedPointedMap_not_hasInjectiveRepresentative
    g R N hN hR hinvariant
  · intro Rzero hdescent
    exact hWeightedForm_not_mem_base_of_form_not_mem_base
      hnotbase hdescent
  · exact hPdiv
  · exact hQdiv
  · exact htail

/-- The coefficient classification and its analytic rescaling produce the
normalized `E` conditions or the normalized `H` conditions. -/
theorem exists_rightLeft_rescaling_isNormalizedECase_or_isNormalizedHCase
    (g : PointedMapGerm 2 3) (R : Form ℂ) (N : ℕ)
    (A B c4 c3 c2 c1 c0 c : ℂ)
    (hc : c ≠ 0)
    (hODE :
      4 * (cubic A B).derivative * quartic c4 c3 c2 c1 c0 -
          3 * cubic A B * (quartic c4 c3 c2 c1 c0).derivative =
        Polynomial.C c)
    (hR : R.IsHomogeneous N)
    (hPdiv : formT ^ 5 ∣
      OnLeConjecture.Polynomial.jacobian (cubicForm A B) R)
    (hQdiv : formT ^ 5 ∣
      OnLeConjecture.Polynomial.jacobian
        (quarticForm c4 c3 c2 c1 c0) R)
    (hnotbase : R ∉ Set.range
      (pairBaseToForm (cubicForm A B)
        (quarticForm c4 c3 c2 c1 c0)))
    (htailZero :
      g.1.component 0 - Germ.coordinatePolynomialAlgHom 2
          (cubicForm A B) ∈ Germ.maximalIdeal 2 ^ 4)
    (htailOne :
      g.1.component 1 - Germ.coordinatePolynomialAlgHom 2
          (quarticForm c4 c3 c2 c1 c0) ∈ Germ.maximalIdeal 2 ^ 5)
    (htailTwo :
      g.1.component 2 - Germ.coordinatePolynomialAlgHom 2 R ∈
        Germ.maximalIdeal 2 ^ (N + 1)) :
    ∃ s : ℂ, ∃ h : PointedMapGerm 2 3,
      s ≠ 0 ∧ g.RightLeftEquivalent h ∧
      (h.HasInjectiveRepresentative ↔ g.HasInjectiveRepresentative) ∧
      (IsNormalizedECase h (rescaleForm s 1 R) N ∨
        IsNormalizedHCase h (rescaleForm s 1 R) N) := by
  obtain ⟨s, u, v, hs, hu, hv, hE | hH⟩ :=
    rescaleForms_to_E_or_H A B c4 c3 c2 c1 c0 c hc hODE
  all_goals
    let h := rescaledPointedMap g s u v 1 hs hu hv one_ne_zero
    have hequivalent : g.RightLeftEquivalent h :=
      rightLeftEquivalent_rescaledPointedMap
        g s u v 1 hs hu hv one_ne_zero
    have hinjective := hequivalent.hasInjectiveRepresentative_iff
    refine ⟨s, h, hs, hequivalent, hinjective, ?_⟩
  · apply Or.inl
    rcases hE with ⟨hzeroForm, honeForm⟩
    refine ⟨rescaleForm_isHomogeneous hR s 1, ?_, ?_, ?_, ?_⟩
    · exact rescaleForm_not_mem_eNormalizedBase_of_not_mem_pairBase
        (cubicForm A B) (quarticForm c4 c3 c2 c1 c0) R
          s u v hs hzeroForm honeForm hnotbase
    · have hdiv := formT_pow_dvd_jacobian_rescaleForm
          s u 1 (cubicForm A B) R 5 hPdiv
      rw [hzeroForm] at hdiv
      exact hdiv
    · have hdiv := formT_pow_dvd_jacobian_rescaleForm
          s v 1 (quarticForm c4 c3 c2 c1 c0) R 5 hQdiv
      rw [honeForm] at hdiv
      exact hdiv
    · intro i
      fin_cases i
      · have htail := rescaledPointedMap_component_tail
            g s u v 1 hs hu hv one_ne_zero 0
              (cubicForm A B) 4 htailZero
        simpa [h, eInvariantPolynomialMap, eInvariantDegrees,
          targetRescaleVector, hzeroForm] using htail
      · have htail := rescaledPointedMap_component_tail
            g s u v 1 hs hu hv one_ne_zero 1
              (quarticForm c4 c3 c2 c1 c0) 5 htailOne
        simpa [h, eInvariantPolynomialMap, eInvariantDegrees,
          targetRescaleVector, honeForm] using htail
      · have htail := rescaledPointedMap_component_tail
            g s u v 1 hs hu hv one_ne_zero 2 R (N + 1) htailTwo
        simpa [h, eInvariantPolynomialMap, eInvariantDegrees,
          targetRescaleVector] using htail
  · apply Or.inr
    rcases hH with ⟨hzeroForm, honeForm⟩
    refine ⟨rescaleForm_isHomogeneous hR s 1, ?_, ?_, ?_, ?_⟩
    · exact rescaleForm_not_mem_hNormalizedBase_of_not_mem_pairBase
        (cubicForm A B) (quarticForm c4 c3 c2 c1 c0) R
          s u v hs hzeroForm honeForm hnotbase
    · have hdiv := formT_pow_dvd_jacobian_rescaleForm
          s u 1 (cubicForm A B) R 5 hPdiv
      rw [hzeroForm] at hdiv
      exact hdiv
    · have hdiv := formT_pow_dvd_jacobian_rescaleForm
          s v 1 (quarticForm c4 c3 c2 c1 c0) R 5 hQdiv
      rw [honeForm] at hdiv
      exact hdiv
    · intro i
      fin_cases i
      · have htail := rescaledPointedMap_component_tail
            g s u v 1 hs hu hv one_ne_zero 0
              (cubicForm A B) 4 htailZero
        simpa [h, hOrdinaryPolynomialMap, hOrdinaryDegrees,
          targetRescaleVector, hzeroForm] using htail
      · have htail := rescaledPointedMap_component_tail
            g s u v 1 hs hu hv one_ne_zero 1
              (quarticForm c4 c3 c2 c1 c0) 5 htailOne
        simpa [h, hOrdinaryPolynomialMap, hOrdinaryDegrees,
          targetRescaleVector, honeForm] using htail
      · have htail := rescaledPointedMap_component_tail
            g s u v 1 hs hu hv one_ne_zero 2 R (N + 1) htailTwo
        simpa [h, hOrdinaryPolynomialMap, hOrdinaryDegrees,
          targetRescaleVector] using htail

/-- The invariant normalized `H` exclusion theorem may be stated using the
image of the ordinary homogeneous base map. -/
theorem hInvariantNormalizedPointedMap_not_hasInjectiveRepresentative_of_not_mem_base
    (g : PointedMapGerm 2 3) (R : Form ℂ) (N : ℕ)
    (hN : 5 ≤ N)
    (hR : R.IsHomogeneous N)
    (hinvariant : R = eRotateForm (-1) R)
    (hnotbase : R ∉ Set.range hNormalizedBaseToForm)
    (hPdiv : formT ^ 5 ∣
      OnLeConjecture.Polynomial.jacobian (cubicForm 3 0) R)
    (hQdiv : formT ^ 5 ∣
      OnLeConjecture.Polynomial.jacobian
        (quarticForm 1 0 4 0 2) R)
    (htail : ∀ i,
      g.1.component i - Germ.coordinatePolynomialAlgHom 2
          (hOrdinaryPolynomialMap R i) ∈
        Germ.maximalIdeal 2 ^ (hOrdinaryDegrees N i + 1)) :
    ¬ g.HasInjectiveRepresentative := by
  apply hInvariantNormalizedPointedMap_not_hasInjectiveRepresentative
    g R N hN hR hinvariant
  · intro Rzero hdescent
    exact hWeightedForm_not_mem_base_of_form_not_mem_base
      hnotbase hdescent
  · exact hPdiv
  · exact hQdiv
  · exact htail

end OnLeConjecture.DThree
