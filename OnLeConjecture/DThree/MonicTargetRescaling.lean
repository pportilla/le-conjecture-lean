module

public import OnLeConjecture.DThree.WeightedAllResidueExclusion
import all OnLeConjecture.DThree.NormalizedBaseExclusion

/-!
# Target rescaling for a monic cubic initial form

Multiplying the first target coordinate by the inverse of its leading unit
makes the cubic initial form monic. This module records the induced changes
in the algebra generated by the first two forms and in all three analytic
Jacobians.
-/

public section

namespace OnLeConjecture.DThree

open OnLeConjecture.Analytic

/-- Scale the two variables in the polynomial ring used to represent the
algebra generated by a pair of forms. -/
@[expose]
noncomputable def pairTargetScale (u v : ℂ) : Form ℂ →ₐ[ℂ] Form ℂ :=
  MvPolynomial.aeval fun i =>
    if i = 0 then MvPolynomial.C u * formX
    else MvPolynomial.C v * formT

/-- Evaluation at scalar multiples of two forms equals evaluation after
scaling the two abstract variables. -/
theorem pairBaseToForm_C_mul
    (P Q : Form ℂ) (u v : ℂ) (S : Form ℂ) :
    pairBaseToForm (MvPolynomial.C u * P) (MvPolynomial.C v * Q) S =
      pairBaseToForm P Q (pairTargetScale u v S) := by
  let left : Form ℂ →ₐ[ℂ] Form ℂ :=
    pairBaseToForm (MvPolynomial.C u * P) (MvPolynomial.C v * Q)
  let right : Form ℂ →ₐ[ℂ] Form ℂ :=
    (pairBaseToForm P Q).comp (pairTargetScale u v)
  have hequality : left = right := by
    apply MvPolynomial.algHom_ext
    intro i
    fin_cases i
    · simp [left, right, pairBaseToForm, pairTargetScale, formX]
    · simp [left, right, pairBaseToForm, pairTargetScale, formT]
  exact AlgHom.congr_fun hequality S

/-- Exclusion from the algebra generated by a pair passes to arbitrary
scalar multiples of its two generators. -/
theorem not_mem_pairBase_C_mul_of_not_mem_pairBase
    (P Q R : Form ℂ) (u v : ℂ)
    (hnotbase : R ∉ Set.range (pairBaseToForm P Q)) :
    R ∉ Set.range
      (pairBaseToForm (MvPolynomial.C u * P) (MvPolynomial.C v * Q)) := by
  intro hmembership
  obtain ⟨S, hS⟩ := hmembership
  apply hnotbase
  refine ⟨pairTargetScale u v S, ?_⟩
  rw [← pairBaseToForm_C_mul, hS]

/-- If the first generator has a nonzero scalar factor, its removal
preserves exclusion from the generated algebra. -/
theorem not_mem_pairBase_of_not_mem_C_mul_pairBase
    (P Q R : Form ℂ) (r : ℂ) (hr : r ≠ 0)
    (hnotbase : R ∉ Set.range
      (pairBaseToForm (MvPolynomial.C r * P) Q)) :
    R ∉ Set.range (pairBaseToForm P Q) := by
  have hscaled := not_mem_pairBase_C_mul_of_not_mem_pairBase
    (MvPolynomial.C r * P) Q R r⁻¹ 1 hnotbase
  have hfirst :
      MvPolynomial.C r⁻¹ * (MvPolynomial.C r * P) = P := by
    rw [← mul_assoc, ← map_mul, inv_mul_cancel₀ hr, map_one, one_mul]
  simpa only [hfirst, map_one, one_mul] using hscaled

/-- The target vector which multiplies the first target coordinate by
`r⁻¹` and fixes the other two target coordinates. -/
@[expose]
noncomputable def monicFirstTargetVector (r : ℂ) : Fin 3 → ℂ :=
  ![r⁻¹, 1, 1]

theorem monicFirstTargetVector_ne_zero {r : ℂ} (hr : r ≠ 0) :
    ∀ i, monicFirstTargetVector r i ≠ 0 := by
  intro i
  fin_cases i
  · exact inv_ne_zero hr
  · exact one_ne_zero
  · exact one_ne_zero

/-- Apply the target rescaling which makes the first initial form monic. -/
@[expose]
noncomputable def monicFirstTargetRescaledMap
    (g : PointedMapGerm 2 3) (r : ℂ) (hr : r ≠ 0) :
    PointedMapGerm 2 3 :=
  (diagonalPointedEquiv (monicFirstTargetVector r)
    (monicFirstTargetVector_ne_zero hr)).forward.comp g

/-- The monic target rescaling is a right left equivalence. -/
theorem rightLeftEquivalent_monicFirstTargetRescaledMap
    (g : PointedMapGerm 2 3) (r : ℂ) (hr : r ≠ 0) :
    g.RightLeftEquivalent (monicFirstTargetRescaledMap g r hr) := by
  rw [monicFirstTargetRescaledMap]
  refine ⟨PointedEquivGerm.identity 2,
    diagonalPointedEquiv (monicFirstTargetVector r)
      (monicFirstTargetVector_ne_zero hr), ?_⟩
  rw [PointedEquivGerm.identity_forward, PointedMapGerm.comp_identity]

/-- Each component of the rescaled map is multiplied by its target scalar. -/
theorem monicFirstTargetRescaledMap_component
    (g : PointedMapGerm 2 3) (r : ℂ) (hr : r ≠ 0) (i : Fin 3) :
    (monicFirstTargetRescaledMap g r hr).1.component i =
      Germ.constRingHom 2 (monicFirstTargetVector r i) *
        g.1.component i := by
  change
    ((diagonalPointedEquiv (monicFirstTargetVector r)
      (monicFirstTargetVector_ne_zero hr)).forward.comp g).1.component i = _
  rw [PointedMapGerm.component_comp_general]
  rw [show
      (diagonalPointedEquiv (monicFirstTargetVector r)
        (monicFirstTargetVector_ne_zero hr)).forward.1.component i =
          Germ.constRingHom 3 (monicFirstTargetVector r i) *
            Germ.coordinate i by
    exact diagonalPointedEquiv_component
      (monicFirstTargetVector r) (monicFirstTargetVector_ne_zero hr) i]
  rw [map_mul, PointedMapGerm.pullback_constRingHom,
    PointedMapGerm.pullback_coordinate]

theorem monicFirstTargetRescaledMap_component_zero
    (g : PointedMapGerm 2 3) (r : ℂ) (hr : r ≠ 0) :
    (monicFirstTargetRescaledMap g r hr).1.component 0 =
      Germ.constRingHom 2 r⁻¹ * g.1.component 0 := by
  simpa only [monicFirstTargetVector, Matrix.cons_val_zero] using
    monicFirstTargetRescaledMap_component g r hr 0

theorem monicFirstTargetRescaledMap_component_one
    (g : PointedMapGerm 2 3) (r : ℂ) (hr : r ≠ 0) :
    (monicFirstTargetRescaledMap g r hr).1.component 1 =
      g.1.component 1 := by
  simpa [monicFirstTargetVector] using
    monicFirstTargetRescaledMap_component g r hr 1

theorem monicFirstTargetRescaledMap_component_two
    (g : PointedMapGerm 2 3) (r : ℂ) (hr : r ≠ 0) :
    (monicFirstTargetRescaledMap g r hr).1.component 2 =
      g.1.component 2 := by
  simpa [monicFirstTargetVector] using
    monicFirstTargetRescaledMap_component g r hr 2

/-- Multiplication of the first analytic function by a constant preserves a
prescribed second coordinate divisor of the Jacobian. -/
theorem coordinate_pow_dvd_jacobian_const_mul_left
    (c : ℂ) (f g : Germ 2) (N : ℕ)
    (hdiv : Germ.coordinate (1 : Fin 2) ^ N ∣ Germ.jacobian f g) :
    Germ.coordinate (1 : Fin 2) ^ N ∣
      Germ.jacobian (Germ.constRingHom 2 c * f) g := by
  rw [Germ.jacobian_mul_left, Germ.jacobian_const_left,
    mul_zero, add_zero]
  exact dvd_mul_of_dvd_right hdiv _

/-- The monic target rescaling preserves the divisor of the Jacobian of the
first and second components. -/
theorem coordinate_pow_dvd_jacobian_monicFirstTarget_zero_one
    (g : PointedMapGerm 2 3) (r : ℂ) (hr : r ≠ 0) (N : ℕ)
    (hdiv : Germ.coordinate (1 : Fin 2) ^ N ∣
      Germ.jacobian (g.1.component 0) (g.1.component 1)) :
    Germ.coordinate (1 : Fin 2) ^ N ∣
      Germ.jacobian
        ((monicFirstTargetRescaledMap g r hr).1.component 0)
        ((monicFirstTargetRescaledMap g r hr).1.component 1) := by
  rw [monicFirstTargetRescaledMap_component_zero,
    monicFirstTargetRescaledMap_component_one]
  exact coordinate_pow_dvd_jacobian_const_mul_left r⁻¹
    (g.1.component 0) (g.1.component 1) N hdiv

/-- The monic target rescaling preserves the divisor of the Jacobian of the
first and third components. -/
theorem coordinate_pow_dvd_jacobian_monicFirstTarget_zero_two
    (g : PointedMapGerm 2 3) (r : ℂ) (hr : r ≠ 0) (N : ℕ)
    (hdiv : Germ.coordinate (1 : Fin 2) ^ N ∣
      Germ.jacobian (g.1.component 0) (g.1.component 2)) :
    Germ.coordinate (1 : Fin 2) ^ N ∣
      Germ.jacobian
        ((monicFirstTargetRescaledMap g r hr).1.component 0)
        ((monicFirstTargetRescaledMap g r hr).1.component 2) := by
  rw [monicFirstTargetRescaledMap_component_zero,
    monicFirstTargetRescaledMap_component_two]
  exact coordinate_pow_dvd_jacobian_const_mul_left r⁻¹
    (g.1.component 0) (g.1.component 2) N hdiv

/-- The monic target rescaling fixes the Jacobian of the second and third
components. -/
theorem coordinate_pow_dvd_jacobian_monicFirstTarget_one_two
    (g : PointedMapGerm 2 3) (r : ℂ) (hr : r ≠ 0) (N : ℕ)
    (hdiv : Germ.coordinate (1 : Fin 2) ^ N ∣
      Germ.jacobian (g.1.component 1) (g.1.component 2)) :
    Germ.coordinate (1 : Fin 2) ^ N ∣
      Germ.jacobian
        ((monicFirstTargetRescaledMap g r hr).1.component 1)
        ((monicFirstTargetRescaledMap g r hr).1.component 2) := by
  simpa only [monicFirstTargetRescaledMap_component_one,
    monicFirstTargetRescaledMap_component_two] using hdiv

end OnLeConjecture.DThree
