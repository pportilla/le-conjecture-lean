/-!
# Removing the third-degree restriction in multiplicity three

The H cubic ramification condition forces every homogeneous form of degree
at most four into the algebra of the H pair. Thus the zero-residue case
already supplies the lower degree bound used in the existing collision
proof. The analytic cubic divisor also supplies the first-weight bound
needed by rescaling. Both bounds are derived here, and the prepared analytic
exclusion is restated without either additional degree hypothesis.
-/

public section

namespace OnLeConjecture.DThree

open _root_.Polynomial
open OnLeConjecture.Analytic

private theorem homogeneous_form_sum (N : ℕ) (R : Form ℂ)
    (hR : R.IsHomogeneous N) :
    R = ∑ i ∈ Finset.range (N + 1),
      MvPolynomial.C ((weightedDehomogenize R).coeff i) *
        formX ^ i * formT ^ (N - i) := by
  conv_lhs => rw [← homogenize_weightedDehomogenize hR, Polynomial.homogenize]
  rw [Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk]
  apply Finset.sum_congr rfl
  intro i hi
  rw [MvPolynomial.monomial_fin_two]
  simp [formX, formT]

/-- A homogeneous form of degree below five with the cubic H ramification
divisor belongs to the algebra generated by the cubic and quartic H forms. -/
theorem h_low_degree_mem_pairBase (N : ℕ) (R : Form ℂ)
    (hR : R.IsHomogeneous N) (hN : N ≤ 4)
    (hdiv : formT ^ 5 ∣ OnLeConjecture.Polynomial.jacobian (cubicForm 3 0) R) :
    R ∈ Set.range (pairBaseToForm (cubicForm 3 0) (quarticForm 1 0 4 0 2)) := by
  classical
  let c : ℕ → ℂ := fun i ↦ (weightedDehomogenize R).coeff i
  let ev : Form ℂ →ₐ[ℂ] ℂ[X] := MvPolynomial.aeval ![1, X]
  have heval : X ^ 5 ∣ ev (OnLeConjecture.Polynomial.jacobian (cubicForm 3 0) R) := by
    simpa [ev, formT] using map_dvd ev hdiv
  have hc (i : ℕ) (hi : i < 5) := (X_pow_dvd_iff.mp heval) i hi
  have hrep := homogeneous_form_sum N R hR
  change R = ∑ i ∈ Finset.range (N + 1),
    MvPolynomial.C (c i) * formX ^ i * formT ^ (N - i) at hrep
  interval_cases N
  all_goals simp only [Finset.sum_range_succ, Finset.sum_range_zero,
    Nat.sub_self, Nat.sub_zero, Nat.reduceSub, pow_zero, pow_one,
    mul_one, zero_add] at hrep
  · exact ⟨MvPolynomial.C (c 0), by simpa [pairBaseToForm] using hrep.symm⟩
  · have hc0 : c 0 = 0 := by
      simpa [hrep, ev, OnLeConjecture.Polynomial.jacobian, cubicForm,
        formX, formT] using hc 0 (by omega)
    have hc1 : c 1 = 0 := by
      simpa [hrep, ev, OnLeConjecture.Polynomial.jacobian, cubicForm,
        formX, formT, coeff_X, coeff_mul,
        Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk,
        Finset.sum_range_succ] using hc 1 (by omega)
    exact ⟨0, by simp [hrep, hc0, hc1]⟩
  · have h1 : 3 * (c 0 * 2) - 3 * 2 * (c 2 * 2) = 0 := by
      simpa [hrep, ev, OnLeConjecture.Polynomial.jacobian, cubicForm,
        formX, formT, coeff_X, coeff_mul,
        Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk,
        Finset.sum_range_succ] using hc 1 (by omega)
    have hc0 : c 0 = 0 := by
      simpa [hrep, ev, OnLeConjecture.Polynomial.jacobian, cubicForm,
        formX, formT, coeff_X, coeff_mul,
        Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk,
        Finset.sum_range_succ] using hc 3 (by omega)
    have hc1 : c 1 = 0 := by
      simpa [hrep, ev, OnLeConjecture.Polynomial.jacobian, cubicForm,
        formX, formT] using hc 0 (by omega)
    have hc2 : c 2 = 0 := by linear_combination (6 * hc0 - h1) / 12
    exact ⟨0, by simp [hrep, hc0, hc1, hc2]⟩
  · have h1 : 3 * (c 1 * 2) - 3 * 2 * (c 3 * 3) = 0 := by
      simpa [hrep, ev, OnLeConjecture.Polynomial.jacobian, cubicForm,
        formX, formT, coeff_X, coeff_mul,
        Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk,
        Finset.sum_range_succ] using hc 1 (by omega)
    have hc0 : c 0 = 0 := by
      simpa [hrep, ev, OnLeConjecture.Polynomial.jacobian, cubicForm,
        formX, formT, coeff_X, coeff_mul,
        Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk,
        Finset.sum_range_succ] using hc 4 (by omega)
    have hc2 : c 2 = 0 := by
      simpa [hrep, ev, OnLeConjecture.Polynomial.jacobian, cubicForm,
        formX, formT] using hc 0 (by omega)
    have hc1 : c 1 = 3 * c 3 := by linear_combination h1 / 6
    refine ⟨MvPolynomial.C (c 3) * formX, ?_⟩
    simp [pairBaseToForm, hrep, hc0, hc2, hc1, cubicForm, formX]
    ring
  · have h1 : 3 * (c 2 * 2) - 3 * 2 * (c 4 * 4) = 0 := by
      simpa [hrep, ev, OnLeConjecture.Polynomial.jacobian, cubicForm,
        formX, formT, coeff_X, coeff_mul,
        Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk,
        Finset.sum_range_succ] using hc 1 (by omega)
    have h2 : 3 * (c 1 * 3) + 3 * c 3 - 3 * 2 * (c 3 * 3) = 0 := by
      simpa [hrep, ev, OnLeConjecture.Polynomial.jacobian, cubicForm,
        formX, formT, coeff_X, coeff_mul,
        Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk,
        Finset.sum_range_succ] using hc 2 (by omega)
    have h3 : 3 * (c 0 * 4) + 3 * (c 2 * 2) - 3 * 2 * (c 2 * 2) = 0 := by
      simpa [hrep, ev, OnLeConjecture.Polynomial.jacobian, cubicForm,
        formX, formT, coeff_X, coeff_mul,
        Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk,
        Finset.sum_range_succ] using hc 3 (by omega)
    have hc3 : c 3 = 0 := by
      simpa [hrep, ev, OnLeConjecture.Polynomial.jacobian, cubicForm,
        formX, formT] using hc 0 (by omega)
    have hc2 : c 2 = 4 * c 4 := by linear_combination h1 / 6
    have hc1 : c 1 = 0 := by linear_combination (h2 + 15 * hc3) / 9
    have hc0 : c 0 = 2 * c 4 := by linear_combination (h3 + h1) / 12
    refine ⟨MvPolynomial.C (c 4) * formT, ?_⟩
    simp [pairBaseToForm, hrep, hc0, hc1, hc2, hc3, quarticForm, formT]
    ring

private theorem h_pairBase_lift (S : Form ℂ) :
    ∃ U : Form ℂ, U ∈ Set.range (hBaseToWeightedForm ℂ) ∧
      hQuadraticSubstitutionForm U =
        pairBaseToForm (cubicForm 3 0) (quarticForm 1 0 4 0 2) S := by
  let f : Form ℂ →ₐ[ℂ] HBaseRing ℂ :=
    MvPolynomial.aeval fun i ↦ if i = 0 then hBaseP ℂ else hBaseQ ℂ
  refine ⟨hBaseToWeightedForm ℂ (f S), ⟨f S, rfl⟩, ?_⟩
  have heq : hQuadraticSubstitutionForm.comp ((hBaseToWeightedForm ℂ).comp f) =
      pairBaseToForm (cubicForm 3 0) (quarticForm 1 0 4 0 2) := by
    apply MvPolynomial.algHom_ext
    intro i
    fin_cases i
    · simp [f, pairBaseToForm, hBaseToWeightedForm_p,
        hQuadraticSubstitutionForm_hPForm]
    · simp [f, pairBaseToForm, hBaseToWeightedForm_q,
        hQuadraticSubstitutionForm_hQForm]
  exact AlgHom.congr_fun heq S

/-- The H zero-residue hypotheses themselves force the ordinary third
degree to be at least five. -/
theorem h_zero_residue_degree_ge_five
    (a D : ℕ) (ha : 0 < a) (P : Form ℂ)
    (hP : P.IsWeightedHomogeneous ![a, 1] D) (hresidue : D % a = 0)
    (hdiv : formT ^ (6 * a - 1) ∣ OnLeConjecture.Polynomial.jacobian
      (weightedCubicPolynomial a 3 0) P)
    (hnotbase : ∀ S : Form ℂ, S ∈ Set.range (hBaseToWeightedForm ℂ) →
      weightedPowerSubstitutionForm a (hQuadraticSubstitutionForm S) ≠ P) :
    5 ≤ D / a := by
  by_contra hdegree
  obtain ⟨R, hR, hdecomposition⟩ :=
    exists_weightedPowerSubstitutionForm_of_residue_eq_zero a D ha P hP hresidue
  have hordinaryDiv : formT ^ 5 ∣
      OnLeConjecture.Polynomial.jacobian (cubicForm 3 0) R := by
    apply formT_five_dvd_jacobian_of_weighted_substitution_divisibility a ha
    rw [← weightedCubicPolynomial_eq_weightedPowerSubstitutionForm, ← hdecomposition]
    exact hdiv
  obtain ⟨S, hS⟩ := h_low_degree_mem_pairBase (D / a) R hR (by omega) hordinaryDiv
  obtain ⟨U, hU, hUS⟩ := h_pairBase_lift S
  apply hnotbase U hU
  rw [hUS, hS]
  exact hdecomposition.symm

/-- The normalized H analytic exclusion has no lower degree assumption. -/
theorem IsWeightedNormalizedHCase.not_hasInjectiveRepresentative_all_degrees
    {g : PointedMapGerm 2 3} {a D : ℕ} {R : Form ℂ}
    (data : IsWeightedNormalizedHCase g a D R) (ha : 0 < a) :
    ¬ g.HasInjectiveRepresentative := by
  rcases data with ⟨hR, hRzero, hPdiv, hQdiv, hnotbase, hzero, hone, htwo⟩
  by_cases hresidue : D % a = 0
  · exact hWeightedZeroResiduePointedMap_not_hasInjectiveRepresentative
      g a D ha (h_zero_residue_degree_ge_five a D ha R hR hresidue hPdiv hnotbase)
      R hR hresidue hPdiv hQdiv hnotbase hzero hone htwo
  · exact hPositiveResiduePointedMap_not_hasInjectiveRepresentative
      g a D ha R hR hRzero (Nat.pos_of_ne_zero hresidue) hzero hone htwo

private theorem low_weight_form (a D : ℕ) (_ha : 0 < a) (hDa : D < a)
    (R : Form ℂ) (hR : R.IsWeightedHomogeneous ![a, 1] D) :
    ∃ c : ℂ, R = MvPolynomial.C c * formT ^ D := by
  induction hR using MvPolynomial.IsWeightedHomogeneous.induction_on with
  | zero => exact ⟨0, by simp⟩
  | add p q hp hq ihp ihq =>
      obtain ⟨c, hc⟩ := ihp
      obtain ⟨d, hd⟩ := ihq
      exact ⟨c + d, by rw [hc, hd, map_add, add_mul]⟩
  | monomial d c hd =>
      have hdegree : a * d 0 + d 1 = D := by
        simpa [Finsupp.weight_apply, Finsupp.sum_fintype, mul_comm] using hd
      have hd0 : d 0 = 0 := by nlinarith
      have hd1 : d 1 = D := by simpa [hd0] using hdegree
      refine ⟨c, ?_⟩
      rw [MvPolynomial.monomial_fin_two]
      simp [hd0, hd1, formT]

/-- A nonconstant third initial form satisfying the cubic analytic
Jacobian divisor has degree at least the first weight. -/
theorem first_weight_le_third_degree
    (a D : ℕ) (ha : 0 < a) (A B : ℂ) (Q R : Form ℂ)
    (hR : R.IsWeightedHomogeneous ![a, 1] D) (hRzero : R ≠ 0)
    (hnotbase : R ∉ Set.range (pairBaseToForm (weightedCubicPolynomial a A B) Q))
    (f g : Germ 2)
    (hf : f - Germ.coordinatePolynomialAlgHom 2 (weightedCubicPolynomial a A B) ∈
      Germ.weightedOrderIdeal a (3 * a + 1))
    (hg : g - Germ.coordinatePolynomialAlgHom 2 R ∈ Germ.weightedOrderIdeal a (D + 1))
    (hdiv : Germ.coordinate (1 : Fin 2) ^ (6 * a - 1) ∣ Germ.jacobian f g) :
    a ≤ D := by
  by_contra hle
  have hDa : D < a := by omega
  obtain ⟨c, hc⟩ := low_weight_form a D ha hDa R hR
  have hcne : c ≠ 0 := by
    intro hczero
    apply hRzero
    simp [hc, hczero]
  have hD : 0 < D := by
    by_contra hD
    have hDzero : D = 0 := by omega
    apply hnotbase
    refine ⟨MvPolynomial.C c, ?_⟩
    simp [hc, hDzero, pairBaseToForm]
  have hdegree := newtonOmega_natDegree_le_one_of_analytic_jacobian_divisibility
    a D (6 * a) ha hD (by omega) A B R hR f g hf hg hdiv
  have hcoefficient : D = 0 ∨ c = 0 := by
    have hzero := Polynomial.coeff_eq_zero_of_natDegree_lt
      (show (newtonOmega D a A B (weightedDehomogenize R)).natDegree < 2 by omega)
    simpa [hc, weightedDehomogenize, formT, newtonOmega, cubic,
      coeff_mul, Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk,
      Finset.sum_range_succ, show (2 + 1 : ℂ) ≠ 0 by norm_num] using hzero
  rcases hcoefficient with hDzero | hczero
  · exact Nat.ne_of_gt hD hDzero
  · exact hcne hczero

/-- Classified weighted cubic and quartic initial forms exclude injectivity
without a restriction on the degree of the third initial form. -/
theorem classifiedWeightedThreeForms_not_hasInjectiveRepresentative_all_degrees
    (g : PointedMapGerm 2 3) (a D : ℕ) (ha : 0 < a)
    (R : Form ℂ) (hR : R.IsWeightedHomogeneous ![a, 1] D) (hRzero : R ≠ 0)
    (A B c₄ c₃ c₂ c₁ c₀ : ℂ) (hAB : A ≠ 0 ∨ B ≠ 0)
    (hquartic : weightedQuarticPolynomial a c₄ c₃ c₂ c₁ c₀ ≠ 0)
    (hnotbase : R ∉ Set.range (pairBaseToForm
      (weightedCubicPolynomial a A B) (weightedQuarticPolynomial a c₄ c₃ c₂ c₁ c₀)))
    (htailZero : g.1.component 0 - Germ.coordinatePolynomialAlgHom 2
      (weightedCubicPolynomial a A B) ∈ Germ.weightedOrderIdeal a (3 * a + 1))
    (htailOne : g.1.component 1 - Germ.coordinatePolynomialAlgHom 2
      (weightedQuarticPolynomial a c₄ c₃ c₂ c₁ c₀) ∈
      Germ.weightedOrderIdeal a (4 * a + 1))
    (htailTwo : g.1.component 2 - Germ.coordinatePolynomialAlgHom 2 R ∈
      Germ.weightedOrderIdeal a (D + 1))
    (hdivZeroOne : Germ.coordinate (1 : Fin 2) ^ (6 * a - 1) ∣
      Germ.jacobian (g.1.component 0) (g.1.component 1))
    (hdivZeroTwo : Germ.coordinate (1 : Fin 2) ^ (6 * a - 1) ∣
      Germ.jacobian (g.1.component 0) (g.1.component 2))
    (hdivOneTwo : Germ.coordinate (1 : Fin 2) ^ (6 * a - 1) ∣
      Germ.jacobian (g.1.component 1) (g.1.component 2)) :
    ¬ g.HasInjectiveRepresentative := by
  have haD := first_weight_le_third_degree a D ha A B
    (weightedQuarticPolynomial a c₄ c₃ c₂ c₁ c₀) R hR hRzero hnotbase
    (g.1.component 0) (g.1.component 2) htailZero htailTwo hdivZeroTwo
  obtain ⟨s, u, v, h, hs, hu, hv, hequivalent, hinjective, hcase⟩ :=
    exists_rightLeft_weightedRescaling_isWeightedNormalizedECase_or_HCase
      g a D ha haD R hR hRzero A B c₄ c₃ c₂ c₁ c₀
      hAB hquartic hnotbase htailZero htailOne htailTwo
      hdivZeroOne hdivZeroTwo hdivOneTwo
  have hnormalized : ¬ h.HasInjectiveRepresentative := by
    rcases hcase with hE | hH
    · exact hE.not_hasInjectiveRepresentative ha
    · exact hH.not_hasInjectiveRepresentative_all_degrees ha
  intro hg
  exact hnormalized (hinjective.mpr hg)

/-- Prepared cubic and quartic components, a third initial form outside
their algebra, and the three analytic Jacobian divisors exclude injectivity
for every possible third weighted degree. -/
theorem PointedMapGerm.preparedWeightedThreeComponents_not_hasInjectiveRepresentative_all_degrees
    (g : PointedMapGerm 2 3) (a D : ℕ) (ha : 0 < a)
    (a₁ a₀ : Germ 1) (u : Germ 2)
    (hfirst : g.1.component 0 =
      (Germ.coordinate (0 : Fin 2) ^ 3 +
        Germ.planeCoefficientExtension a₁ * Germ.coordinate (0 : Fin 2) +
        Germ.planeCoefficientExtension a₀) * u)
    (hu : IsUnit u)
    (ha₁ : a₁ ∈ Germ.maximalIdeal 1 ^ (2 * a))
    (ha₀ : a₀ ∈ Germ.maximalIdeal 1 ^ (3 * a))
    (hcubicExact : a₁ ∉ Germ.maximalIdeal 1 ^ (2 * a + 1) ∨
      a₀ ∉ Germ.maximalIdeal 1 ^ (3 * a + 1))
    (hquartic : g.1.component 1 ∈ Germ.weightedOrderIdeal a (4 * a))
    (hquarticExact : g.1.component 1 ∉ Germ.weightedOrderIdeal a (4 * a + 1))
    (R : Form ℂ) (hR : R.IsWeightedHomogeneous ![a, 1] D) (hRzero : R ≠ 0)
    (htailTwo : g.1.component 2 - Germ.coordinatePolynomialAlgHom 2 R ∈
      Germ.weightedOrderIdeal a (D + 1))
    (hnotbase : HasWeightedInitialPairBaseExclusion g a R)
    (hdivZeroOne : Germ.coordinate (1 : Fin 2) ^ (6 * a - 1) ∣
      Germ.jacobian (g.1.component 0) (g.1.component 1))
    (hdivZeroTwo : Germ.coordinate (1 : Fin 2) ^ (6 * a - 1) ∣
      Germ.jacobian (g.1.component 0) (g.1.component 2))
    (hdivOneTwo : Germ.coordinate (1 : Fin 2) ^ (6 * a - 1) ∣
      Germ.jacobian (g.1.component 1) (g.1.component 2)) :
    ¬ g.HasInjectiveRepresentative := by
  obtain ⟨h, A, B, c₄, c₃, c₂, c₁, c₀, hequivalent, hinjective,
      hAB, hQzero, hR, hRzero, hnotbase, htailZero, htailOne, htailTwo,
      hdivZeroOne, hdivZeroTwo, hdivOneTwo⟩ :=
    PointedMapGerm.exists_monicWeightedThreeInitialForms_of_preparedComponents
      g a D ha a₁ a₀ u hfirst hu ha₁ ha₀ hcubicExact hquartic hquarticExact
      R hR hRzero htailTwo hnotbase hdivZeroOne hdivZeroTwo hdivOneTwo
  have hn := classifiedWeightedThreeForms_not_hasInjectiveRepresentative_all_degrees
    h a D ha R hR hRzero A B c₄ c₃ c₂ c₁ c₀ hAB hQzero hnotbase
    htailZero htailOne htailTwo hdivZeroOne hdivZeroTwo hdivOneTwo
  intro hg
  exact hn (hinjective.mpr hg)

end OnLeConjecture.DThree
