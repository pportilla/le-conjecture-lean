module

public import OnLeConjecture.DThree.NormalizedBaseExclusion
import all OnLeConjecture.DThree.NormalizedBaseExclusion
public import OnLeConjecture.DThree.WeightedAnalyticRescaling

/-!
# Base exclusion under weighted rescaling

The pair of target scalars used to normalize the cubic and quartic also
transports exclusion from the algebra generated by these forms. Evaluation
at each normalized weighted pair agrees with weighted power substitution of
the corresponding E or H base map.
-/

public section

namespace OnLeConjecture.DThree

open OnLeConjecture.Analytic

/-- Exclusion from a generated pair is preserved by a rescaling to an
arbitrary E indexed pair. -/
theorem rescaleForm_not_mem_ePairBase_of_not_mem_pairBase
    (P Q R P' Q' : Form ℂ) (s u v : ℂ) (hs : s ≠ 0)
    (hP : rescaleForm s u P = P')
    (hQ : rescaleForm s v Q = Q')
    (hnotbase : R ∉ Set.range (pairBaseToForm P Q)) :
    rescaleForm s 1 R ∉ Set.range (ePairBaseToForm P' Q') := by
  have hnotE : R ∉ Set.range (ePairBaseToForm P Q) :=
    not_mem_ePairBase_of_not_mem_pairBase hnotbase
  intro hmembership
  obtain ⟨S, hS⟩ := hmembership
  apply hnotE
  refine ⟨eScaleBaseCoordinates u v S, ?_⟩
  apply diagonalPolynomialSubstitution_injective
    (sourceRescaleVector s) (sourceRescaleVector_ne_zero hs)
  rw [← ePairBaseToForm_rescale]
  rw [hP, hQ, hS]
  rw [rescaleForm, ← diagonalPolynomialSubstitution_sourceRescale]
  simp

/-- Exclusion from a generated pair is preserved by a rescaling to an
arbitrary H indexed pair. -/
theorem rescaleForm_not_mem_hPairBase_of_not_mem_pairBase
    (P Q R P' Q' : Form ℂ) (s u v : ℂ) (hs : s ≠ 0)
    (hP : rescaleForm s u P = P')
    (hQ : rescaleForm s v Q = Q')
    (hnotbase : R ∉ Set.range (pairBaseToForm P Q)) :
    rescaleForm s 1 R ∉ Set.range (hPairBaseToForm P' Q') := by
  have hnotH : R ∉ Set.range (hPairBaseToForm P Q) :=
    not_mem_hPairBase_of_not_mem_pairBase hnotbase
  intro hmembership
  obtain ⟨S, hS⟩ := hmembership
  apply hnotH
  refine ⟨hScaleBaseCoordinates u v S, ?_⟩
  apply diagonalPolynomialSubstitution_injective
    (sourceRescaleVector s) (sourceRescaleVector_ne_zero hs)
  rw [← hPairBaseToForm_rescale]
  rw [hP, hQ, hS]
  rw [rescaleForm, ← diagonalPolynomialSubstitution_sourceRescale]
  simp

/-- Evaluation at the normalized weighted E pair is weighted power
substitution after the E base map. -/
theorem ePairBaseToForm_weighted_normalized
    (a : ℕ) (S : EBaseRing ℂ) :
    ePairBaseToForm
        (weightedCubicPolynomial a 0 3)
        (weightedQuarticPolynomial a 1 0 0 4 0) S =
      weightedPowerSubstitutionForm a
        (eSourceCubeSubstitutionForm (eBaseToSource ℂ S)) := by
  let left : EBaseRing ℂ →ₐ[ℂ] Form ℂ :=
    ePairBaseToForm
      (weightedCubicPolynomial a 0 3)
      (weightedQuarticPolynomial a 1 0 0 4 0)
  let right : EBaseRing ℂ →ₐ[ℂ] Form ℂ :=
    (weightedPowerSubstitutionForm a).comp
      (eSourceCubeSubstitutionForm.comp (eBaseToSource ℂ))
  have hequality : left = right := by
    apply MvPolynomial.algHom_ext
    intro i
    cases i with
    | p =>
        simp only [left, right, ePairBaseToForm, AlgHom.comp_apply,
          MvPolynomial.aeval_X]
        change weightedCubicPolynomial a 0 3 =
          weightedPowerSubstitutionForm a
            (eSourceCubeSubstitutionForm
              (eBaseToSource ℂ (eBaseP ℂ)))
        rw [eBaseToSource_p, eSourceCubeSubstitutionForm_sourceP,
          weightedCubicPolynomial_eq_weightedPowerSubstitutionForm]
    | q =>
        simp only [left, right, ePairBaseToForm, AlgHom.comp_apply,
          MvPolynomial.aeval_X]
        change weightedQuarticPolynomial a 1 0 0 4 0 =
          weightedPowerSubstitutionForm a
            (eSourceCubeSubstitutionForm
              (eBaseToSource ℂ (eBaseQ ℂ)))
        rw [eBaseToSource_q, eSourceCubeSubstitutionForm_sourceQ,
          weightedQuarticPolynomial_eq_weightedPowerSubstitutionForm]
  exact AlgHom.congr_fun hequality S

/-- Evaluation at the normalized weighted H pair is weighted power
substitution after the H base map. -/
theorem hPairBaseToForm_weighted_normalized
    (a : ℕ) (S : HBaseRing ℂ) :
    hPairBaseToForm
        (weightedCubicPolynomial a 3 0)
        (weightedQuarticPolynomial a 1 0 4 0 2) S =
      weightedPowerSubstitutionForm a
        (hQuadraticSubstitutionForm (hBaseToWeightedForm ℂ S)) := by
  let left : HBaseRing ℂ →ₐ[ℂ] Form ℂ :=
    hPairBaseToForm
      (weightedCubicPolynomial a 3 0)
      (weightedQuarticPolynomial a 1 0 4 0 2)
  let right : HBaseRing ℂ →ₐ[ℂ] Form ℂ :=
    (weightedPowerSubstitutionForm a).comp
      (hQuadraticSubstitutionForm.comp (hBaseToWeightedForm ℂ))
  have hequality : left = right := by
    apply MvPolynomial.algHom_ext
    intro i
    cases i with
    | p =>
        simp only [left, right, hPairBaseToForm, AlgHom.comp_apply,
          MvPolynomial.aeval_X]
        change weightedCubicPolynomial a 3 0 =
          weightedPowerSubstitutionForm a
            (hQuadraticSubstitutionForm
              (hBaseToWeightedForm ℂ (hBaseP ℂ)))
        rw [hBaseToWeightedForm_p, hQuadraticSubstitutionForm_hPForm,
          weightedCubicPolynomial_eq_weightedPowerSubstitutionForm]
    | q =>
        simp only [left, right, hPairBaseToForm, AlgHom.comp_apply,
          MvPolynomial.aeval_X]
        change weightedQuarticPolynomial a 1 0 4 0 2 =
          weightedPowerSubstitutionForm a
            (hQuadraticSubstitutionForm
              (hBaseToWeightedForm ℂ (hBaseQ ℂ)))
        rw [hBaseToWeightedForm_q, hQuadraticSubstitutionForm_hQForm,
          weightedQuarticPolynomial_eq_weightedPowerSubstitutionForm]
  exact AlgHom.congr_fun hequality S

/-- Exclusion from the E indexed normalized weighted pair implies the base
exclusion required by the zero residue E theorem. -/
theorem eWeightedBaseExclusion_of_not_mem_pairBase
    (a : ℕ) (R : Form ℂ)
    (hnotbase : R ∉ Set.range
      (ePairBaseToForm
        (weightedCubicPolynomial a 0 3)
        (weightedQuarticPolynomial a 1 0 0 4 0))) :
    ∀ S : ESourceRing ℂ,
      S ∈ Set.range (eBaseToSource ℂ) →
        weightedPowerSubstitutionForm a
          (eSourceCubeSubstitutionForm S) ≠ R := by
  intro S hS hformula
  obtain ⟨T, hT⟩ := hS
  apply hnotbase
  refine ⟨T, ?_⟩
  rw [ePairBaseToForm_weighted_normalized, hT, hformula]

/-- Exclusion from the H indexed normalized weighted pair implies the base
exclusion required by the zero residue H theorem. -/
theorem hWeightedBaseExclusion_of_not_mem_pairBase
    (a : ℕ) (R : Form ℂ)
    (hnotbase : R ∉ Set.range
      (hPairBaseToForm
        (weightedCubicPolynomial a 3 0)
        (weightedQuarticPolynomial a 1 0 4 0 2))) :
    ∀ S : Form ℂ,
      S ∈ Set.range (hBaseToWeightedForm ℂ) →
        weightedPowerSubstitutionForm a
          (hQuadraticSubstitutionForm S) ≠ R := by
  intro S hS hformula
  obtain ⟨T, hT⟩ := hS
  apply hnotbase
  refine ⟨T, ?_⟩
  rw [hPairBaseToForm_weighted_normalized, hT, hformula]

end OnLeConjecture.DThree
