module

public import OnLeConjecture.KnotFloer.GridFullComplex
public import OnLeConjecture.KnotFloer.BifilteredSpectral

/-!
# The two filtrations of the full polynomial grid complex

The monomial state `V^e x` has coordinates `(-|e|, A(x) - |e|)`, where `|e|` is the total
O exponent and `A` is the computed grid Alexander grading. A level is the polynomial submodule
spanned by the explicit monomial states satisfying both coordinate bounds. Multiplication by an
O variable decreases both coordinates. For a term of the full rectangle differential, the first
coordinate drops by its O count and the second by its X count. Both are nonnegative.

This constructs a bifiltration of the full polynomial total complex. The Laurent extension,
its Maslov-zero distinguished homology generator, and invariance under knot moves are separate
requirements for the knot invariant Upsilon.
-/

@[expose] public section

namespace OnLeConjecture.KnotFloer.GridFull

open TauCeti CategoryTheory

variable {n : ℕ} (G : GridDiagram n) (R : Type*) [CommRing R]

/-- The polynomial submodule generated by monomial grid states satisfying both bounds. -/
noncomputable def bifiltrationLevel (a b : ℝ) :
    Submodule (MvPolynomial (Fin n) R) (GridChainMinus R n) :=
  Submodule.span (MvPolynomial (Fin n) R) {c | ∃ (e : Fin n →₀ ℕ) (x : GridState n),
    c = monomialGenerator R e x ∧ -(exponentSize e : ℝ) ≤ a ∧
      (G.alexander x : ℝ) - exponentSize e ≤ b}

/-- Each admissible monomial state belongs to its bifiltration level. -/
theorem monomialGenerator_mem_bifiltrationLevel (e : Fin n →₀ ℕ) (x : GridState n)
    {a b : ℝ} (ha : -(exponentSize e : ℝ) ≤ a)
    (hb : (G.alexander x : ℝ) - exponentSize e ≤ b) :
    monomialGenerator R e x ∈ bifiltrationLevel G R a b :=
  Submodule.subset_span ⟨e, x, rfl, ha, hb⟩

/-- Increasing either bound enlarges the bifiltration submodule. -/
theorem bifiltrationLevel_mono {a b a' b' : ℝ} (ha : a ≤ a') (hb : b ≤ b') :
    bifiltrationLevel G R a b ≤ bifiltrationLevel G R a' b' := by
  apply Submodule.span_mono
  rintro c ⟨e, x, rfl, he, hx⟩
  exact ⟨e, x, rfl, he.trans ha, hx.trans hb⟩

/-- The second filtration coordinate drops by exactly the X count of a rectangle. -/
theorem alexanderCoordinate_change {x y : GridState n} (r : GridRectangleBetween x y)
    (e : Fin n →₀ ℕ) :
    (G.alexander y : ℝ) - exponentSize (e + oExponent G r.toGridRectangle) =
      (G.alexander x : ℝ) - exponentSize e -
        (G.XSet ∩ r.toGridRectangle.coveredSquares).card := by
  have h := G.alexander_sub_alexander_eq_card_sub_card r
  rw [← G.card_OColumns r.toGridRectangle] at h
  have hreal : (G.alexander x : ℝ) - (G.alexander y : ℝ) =
      ((G.XSet ∩ r.toGridRectangle.coveredSquares).card : ℝ) -
        (G.OColumns r.toGridRectangle).card := by exact_mod_cast h
  rw [exponentSize_add, exponentSize_oExponent, Nat.cast_add]
  linarith

/-- Every full differential term respects both filtration bounds, including rectangles
containing X markings. -/
theorem rectangleTerm_mem_bifiltrationLevel {x y : GridState n}
    (r : GridRectangleBetween x y) (e : Fin n →₀ ℕ) {a b : ℝ}
    (ha : -(exponentSize e : ℝ) ≤ a)
    (hb : (G.alexander x : ℝ) - exponentSize e ≤ b) :
    monomialGenerator R (e + oExponent G r.toGridRectangle) y ∈
      bifiltrationLevel G R a b := by
  apply monomialGenerator_mem_bifiltrationLevel
  · rw [exponentSize_add, Nat.cast_add]
    have hnonneg := Nat.cast_nonneg (α := ℝ) (exponentSize (oExponent G r.toGridRectangle))
    linarith
  · rw [alexanderCoordinate_change]
    have hnonneg := Nat.cast_nonneg (α := ℝ)
      (G.XSet ∩ r.toGridRectangle.coveredSquares).card
    linarith

/-- The actual full rectangle differential preserves the two-coordinate filtration. -/
theorem differential_mem_bifiltrationLevel (a b : ℝ) (c : GridChainMinus R n)
    (hc : c ∈ bifiltrationLevel G R a b) :
    differential G R c ∈ bifiltrationLevel G R a b := by
  induction hc using Submodule.span_induction with
  | mem c hc =>
    obtain ⟨e, x, rfl, ha, hb⟩ := hc
    rw [differential_monomialGenerator]
    apply Submodule.sum_mem
    intro y _
    apply Submodule.sum_mem
    intro r _
    exact rectangleTerm_mem_bifiltrationLevel G R r e ha hb
  | zero => simp
  | add c d _ _ hc hd => simpa using Submodule.add_mem _ hc hd
  | smul p c _ hc => simpa using Submodule.smul_mem _ p hc

/-- Chains whose nonzero monomial coefficients satisfy both coordinate bounds. -/
noncomputable def boundedMonomialSupport (a b : ℝ) :
    Submodule (MvPolynomial (Fin n) R) (GridChainMinus R n) where
  carrier := {c | ∀ x e, e ∈ (c x).support →
    -(exponentSize e : ℝ) ≤ a ∧ (G.alexander x : ℝ) - exponentSize e ≤ b}
  zero_mem' := by simp
  add_mem' := by
    intro c d hc hd x e he
    have hm : e ∈ (c x).support ∪ (d x).support := MvPolynomial.support_add he
    exact (Finset.mem_union.mp hm).elim (hc x e) (hd x e)
  smul_mem' := by
    classical
    intro p c hc x e he
    change e ∈ (p * c x).support at he
    obtain ⟨d, _, f, hf, rfl⟩ := Finset.mem_add.mp (MvPolynomial.support_mul _ _ he)
    obtain ⟨ha, hb⟩ := hc x f hf
    rw [exponentSize_add, Nat.cast_add]
    have hn := Nat.cast_nonneg (α := ℝ) (exponentSize d)
    constructor <;> linarith

/-- The span definition agrees with the exact coordinate bounds on every nonzero monomial. -/
theorem mem_bifiltrationLevel_iff (a b : ℝ) (c : GridChainMinus R n) :
    c ∈ bifiltrationLevel G R a b ↔ ∀ x e, e ∈ (c x).support →
      -(exponentSize e : ℝ) ≤ a ∧ (G.alexander x : ℝ) - exponentSize e ≤ b := by
  classical
  constructor
  · have hle : bifiltrationLevel G R a b ≤ boundedMonomialSupport G R a b := by
      apply Submodule.span_le.mpr
      rintro _ ⟨e, x, rfl, ha, hb⟩ y f hf
      by_cases hy : y = x
      · subst y
        change f ∈ ((Finsupp.single x (MvPolynomial.monomial e (1 : R))) x).support at hf
        rw [Finsupp.single_eq_same] at hf
        have hfe := Finset.mem_singleton.mp (MvPolynomial.support_monomial_subset hf)
        subst f
        exact ⟨ha, hb⟩
      · simp [monomialGenerator, Finsupp.single_eq_of_ne hy] at hf
    exact fun hc => hle hc
  · intro hc
    rw [← c.sum_single]
    change (∑ x ∈ c.support, Finsupp.single x (c x)) ∈ bifiltrationLevel G R a b
    apply Submodule.sum_mem
    intro x _
    rw [MvPolynomial.as_sum (c x), Finsupp.single_finsetSum]
    apply Submodule.sum_mem
    intro e he
    have hgen := monomialGenerator_mem_bifiltrationLevel G R e x
      (hc x e he).1 (hc x e he).2
    have hterm : Finsupp.single x (MvPolynomial.monomial e ((c x).coeff e)) =
        (MvPolynomial.C ((c x).coeff e) : MvPolynomial (Fin n) R) •
          monomialGenerator R e x := by
      simp [monomialGenerator, Finsupp.smul_single, smul_eq_mul,
        MvPolynomial.C_mul_monomial]
    rw [hterm]
    exact Submodule.smul_mem _ _ hgen

/-- A finite common upper bound for the Alexander degrees of the grid-state generators. -/
noncomputable def alexanderBound : ℝ := ∑ x : GridState n, |(G.alexander x : ℝ)|

theorem alexander_le_bound (x : GridState n) : (G.alexander x : ℝ) ≤ alexanderBound G :=
  (le_abs_self _).trans
    (Finset.single_le_sum (fun y _ => abs_nonneg (G.alexander y : ℝ)) (Finset.mem_univ x))

/-- Every polynomial chain lies below the same finite upper pair of bounds. -/
theorem mem_bifiltrationLevel_bound (c : GridChainMinus R n) :
    c ∈ bifiltrationLevel G R 0 (alexanderBound G) := by
  rw [mem_bifiltrationLevel_iff]
  intro x e _
  have he := Nat.cast_nonneg (α := ℝ) (exponentSize e)
  have hx := alexander_le_bound G x
  constructor <;> linarith

set_option maxHeartbeats 800000 in
-- Elaborating the nested polynomial-support and Finsupp transports exceeds the default limit.
/-- Multiplication by any O variable lowers both filtration bounds by one. -/
theorem X_smul_mem_bifiltrationLevel (i : Fin n) {a b : ℝ} (c : GridChainMinus R n)
    (hc : c ∈ bifiltrationLevel G R a b) :
    (MvPolynomial.X i : MvPolynomial (Fin n) R) • c ∈
      bifiltrationLevel G R (a - 1) (b - 1) := by
  classical
  rw [mem_bifiltrationLevel_iff] at hc ⊢
  intro x e he
  change e ∈ (MvPolynomial.X i * c x).support at he
  rw [MvPolynomial.support_X_mul, Finset.mem_map] at he
  obtain ⟨d, hd, rfl⟩ := he
  obtain ⟨ha, hb⟩ := hc x d hd
  change -(exponentSize (Finsupp.single i 1 + d) : ℝ) ≤ a - 1 ∧
    (G.alexander x : ℝ) - exponentSize (Finsupp.single i 1 + d) ≤ b - 1
  have hsize : exponentSize (Finsupp.single i 1) = 1 := by simp [exponentSize]
  rw [exponentSize_add, hsize, Nat.cast_add, Nat.cast_one]
  constructor <;> linarith

variable [CharP R 2]

/-- The canonical identification of the total complex object with polynomial grid chains. -/
noncomputable def chainEquiv (i : Unit) :
    (complex G (R := R)).X i ≃ₗ[MvPolynomial (Fin n) R] GridChainMinus R n :=
  (eqToIso (complex_X G i)).toLinearEquiv

/-- Categorical and rectangle-counting differentials agree under the chain identification. -/
theorem chainEquiv_d (i j : Unit) (c : (complex G (R := R)).X i) :
    chainEquiv G R j ((complex G (R := R)).d i j c) =
      differential G R (chainEquiv G R i c) := by
  cases i
  cases j
  change (eqToHom (complex_X G ())) ((complex G (R := R)).d () () c) =
    differential G R ((eqToHom (complex_X G ())) c)
  rw [complex_d]
  simp only [ModuleCat.comp_apply]
  rw [← ModuleCat.comp_apply, Category.assoc, eqToHom_trans]
  simp

/-- The explicit monomial filtration packaged as a bifiltration of the native complex. -/
noncomputable def bifiltration : Bifiltration (complex G (R := R)) where
  level a b i := (bifiltrationLevel G R a b).comap (chainEquiv G R i).toLinearMap
  mono i _ _ _ _ ha hb := Submodule.comap_mono (bifiltrationLevel_mono G R ha hb)
  differential_mem a b i j c hc := by
    change chainEquiv G R j ((complex G (R := R)).d i j c) ∈ bifiltrationLevel G R a b
    rw [chainEquiv_d]
    exact differential_mem_bifiltrationLevel G R a b (chainEquiv G R i c) hc

end OnLeConjecture.KnotFloer.GridFull
