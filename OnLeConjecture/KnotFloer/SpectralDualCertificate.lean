module

public import OnLeConjecture.KnotFloer.SpectralThreshold
public import Mathlib.LinearAlgebra.Basis.VectorSpace

/-!
# Dual certificates for spectral thresholds

Fix a real number `a` and a homology class `ξ` in degree `i`. In this file,
a dual certificate for the bound `a ≤ F.spectralThreshold i ξ` is a linear
functional on degree `i` chains that vanishes on boundaries and on every
filtration level strictly below `a`, and takes the value `1` on every cycle
representing `ξ`. Over a field, such a functional exists exactly when the
bound holds. The reverse implication uses only the last two properties.

The functional is obtained by separating a cycle representative from the
submodule generated by boundaries and chains strictly below `a`. Neither
attainment of the threshold nor finite dimensionality is used.
-/

@[expose] public section

universe u v w

namespace OnLeConjecture.KnotFloer

open CategoryTheory HomologicalComplex

namespace RealFiltration

section Ring

variable {R : Type u} [CommRing R] {ι : Type w} {c : ComplexShape ι}
  {C : HomologicalComplex (ModuleCat.{v} R) c}

/-- The chains of degree `i` lying in some filtration level strictly
below `a`. Monotonicity of the levels makes this union a submodule. -/
def strictLevel (F : RealFiltration C) (a : ℝ) (i : ι) : Submodule R (C.X i) where
  carrier := {x | ∃ s : ℝ, s < a ∧ x ∈ F.level s i}
  add_mem' := by
    rintro x y ⟨s, hs, hx⟩ ⟨t, ht, hy⟩
    exact ⟨max s t, max_lt hs ht, Submodule.add_mem _
      (F.mono i (le_max_left s t) hx) (F.mono i (le_max_right s t) hy)⟩
  zero_mem' := ⟨a - 1, sub_one_lt a, Submodule.zero_mem _⟩
  smul_mem' := by
    rintro r x ⟨s, hs, hx⟩
    exact ⟨s, hs, Submodule.smul_mem _ r hx⟩

theorem mem_strictLevel {F : RealFiltration C} {a : ℝ} {i : ι} {x : C.X i} :
    x ∈ F.strictLevel a i ↔ ∃ s : ℝ, s < a ∧ x ∈ F.level s i :=
  Iff.rfl

/-- If `a` is at most the threshold of `ξ`, then no cycle representing `ξ`
is the sum of a boundary and a chain strictly below `a`. -/
theorem iCycles_notMem_range_sup_strictLevel (F : RealFiltration C) {i : ι} (j : ι)
    {ξ : C.homology i} {a : ℝ} (ha : (a : EReal) ≤ F.spectralThreshold i ξ)
    {z : C.cycles i} (hz : C.homologyπ i z = ξ) :
    C.iCycles i z ∉ LinearMap.range (C.d j i).hom ⊔ F.strictLevel a i := by
  intro hmem
  obtain ⟨_, ⟨b, rfl⟩, y, ⟨s, hs, hy⟩, hsum⟩ := Submodule.mem_sup.mp hmem
  have hbi : C.iCycles i (C.toCycles j i b) = C.d j i b :=
    congrArg (fun f : C.X j ⟶ C.X i => f b) (C.toCycles_i j i)
  have hbπ : C.homologyπ i (C.toCycles j i b) = 0 :=
    congrArg (fun f : C.X j ⟶ C.homology i => f b) (C.toCycles_comp_homologyπ j i)
  have hrep : F.RepresentedBelow i ξ s := by
    refine ⟨z - C.toCycles j i b, ?_, ?_⟩
    · have hdiff : C.iCycles i (z - C.toCycles j i b) = y := by
        rw [map_sub, hbi, ← hsum]
        change (C.d j i).hom b + y - (C.d j i).hom b = y
        abel
      rw [hdiff]
      exact hy
    · rw [map_sub, hbπ, sub_zero, hz]
  have hle := ha.trans (spectralThreshold_le_of_representedBelow hrep)
  exact (not_lt.mpr (EReal.coe_le_coe_iff.mp hle)) hs

/-- Two cycles representing the same homology class differ by a boundary
from the degree `j` with `c.prev i = j`. -/
theorem exists_boundary_of_homologyπ_eq {i j : ι} (hj : c.prev i = j)
    {z z' : C.cycles i} (h : C.homologyπ i z = C.homologyπ i z') :
    ∃ b : C.X j, C.iCycles i z = C.iCycles i z' + C.d j i b := by
  have hexact : (ShortComplex.mk (C.toCycles j i) (C.homologyπ i)
      (C.toCycles_comp_homologyπ j i)).Exact :=
    ShortComplex.exact_of_g_is_cokernel _ (C.homologyIsCokernel j i hj)
  obtain ⟨b, hb⟩ := (ShortComplex.moduleCat_exact_iff _).mp hexact (z - z') (by
    change C.homologyπ i (z - z') = 0
    rw [map_sub, h, sub_self])
  refine ⟨b, ?_⟩
  have hbi : C.iCycles i (C.toCycles j i b) = C.d j i b :=
    congrArg (fun f : C.X j ⟶ C.X i => f b) (C.toCycles_i j i)
  change C.toCycles j i b = z - z' at hb
  rw [← hbi, hb, map_sub]
  abel

/-- A functional taking the value `1` on every cycle representing `ξ` and
vanishing on every level strictly below `a` bounds the threshold of `ξ`
below by `a`. -/
theorem le_spectralThreshold_of_dual [Nontrivial R] (F : RealFiltration C) {i : ι}
    {ξ : C.homology i} {a : ℝ} (ℓ : C.X i →ₗ[R] R)
    (hℓξ : ∀ z : C.cycles i, C.homologyπ i z = ξ → ℓ (C.iCycles i z) = 1)
    (hℓlevel : ∀ s : ℝ, s < a → ∀ x ∈ F.level s i, ℓ x = 0) :
    (a : EReal) ≤ F.spectralThreshold i ξ := by
  apply le_spectralThreshold
  rintro s ⟨z, hz, hzξ⟩
  refine EReal.coe_le_coe_iff.mpr (not_lt.mp fun hs => ?_)
  exact one_ne_zero ((hℓξ z hzξ).symm.trans (hℓlevel s hs _ hz))

end Ring

section Field

variable {K : Type u} [Field K] {ι : Type w} {c : ComplexShape ι}
  {C : HomologicalComplex (ModuleCat.{v} K) c}

/-- Dual certificate for a lower bound on a spectral threshold. If `a` is
at most the threshold of `ξ`, then some functional on degree `i` chains
vanishes on boundaries from degree `j = c.prev i`, takes the value `1` on
every cycle representing `ξ`, and vanishes on every level strictly
below `a`. -/
theorem exists_dual_of_le_spectralThreshold (F : RealFiltration C) {i j : ι}
    (hj : c.prev i = j) (ξ : C.homology i) (a : ℝ)
    (ha : (a : EReal) ≤ F.spectralThreshold i ξ) :
    ∃ ℓ : C.X i →ₗ[K] K,
      (∀ b : C.X j, ℓ (C.d j i b) = 0) ∧
      (∀ z : C.cycles i, C.homologyπ i z = ξ → ℓ (C.iCycles i z) = 1) ∧
      (∀ s : ℝ, s < a → ∀ x ∈ F.level s i, ℓ x = 0) := by
  obtain ⟨z₀, hz₀⟩ := (ModuleCat.epi_iff_surjective (C.homologyπ i)).mp inferInstance ξ
  obtain ⟨f, hf, hker⟩ := Submodule.exists_le_ker_of_notMem
    (F.iCycles_notMem_range_sup_strictLevel j ha hz₀)
  let ℓ : C.X i →ₗ[K] K := (f (C.iCycles i z₀))⁻¹ • f
  have hℓ : ∀ x ∈ LinearMap.range (C.d j i).hom ⊔ F.strictLevel a i, ℓ x = 0 := by
    intro x hx
    simp [ℓ, LinearMap.mem_ker.mp (hker hx)]
  have hℓd : ∀ b : C.X j, ℓ (C.d j i b) = 0 := fun b =>
    hℓ _ (Submodule.mem_sup_left ⟨b, rfl⟩)
  refine ⟨ℓ, hℓd, fun z hz => ?_, fun s hs x hx => hℓ x (Submodule.mem_sup_right ⟨s, hs, hx⟩)⟩
  obtain ⟨b, hb⟩ := exists_boundary_of_homologyπ_eq hj (hz.trans hz₀.symm)
  rw [hb, map_add, hℓd, add_zero]
  simp [ℓ, hf]

/-- Over a field, `a` is at most the threshold of `ξ` exactly when a dual
certificate exists. -/
theorem le_spectralThreshold_iff_exists_dual (F : RealFiltration C) {i j : ι}
    (hj : c.prev i = j) (ξ : C.homology i) (a : ℝ) :
    (a : EReal) ≤ F.spectralThreshold i ξ ↔
      ∃ ℓ : C.X i →ₗ[K] K,
        (∀ b : C.X j, ℓ (C.d j i b) = 0) ∧
        (∀ z : C.cycles i, C.homologyπ i z = ξ → ℓ (C.iCycles i z) = 1) ∧
        (∀ s : ℝ, s < a → ∀ x ∈ F.level s i, ℓ x = 0) :=
  ⟨F.exists_dual_of_le_spectralThreshold hj ξ a,
    fun ⟨ℓ, _, hℓξ, hℓlevel⟩ => F.le_spectralThreshold_of_dual ℓ hℓξ hℓlevel⟩

end Field

/-- Degree zero dual certificate for a finite spectral threshold of a
chain complex indexed by `ℤ`. -/
theorem exists_dual_of_spectralThreshold_eq {K : Type u} [Field K]
    {C : ChainComplex (ModuleCat.{v} K) ℤ} (F : RealFiltration C) (ξ : C.homology 0) (a : ℝ)
    (ha : F.spectralThreshold 0 ξ = (a : EReal)) :
    ∃ ℓ : C.X 0 →ₗ[K] K,
      (∀ b : C.X 1, ℓ (C.d 1 0 b) = 0) ∧
      (∀ z : C.cycles 0, C.homologyπ 0 z = ξ → ℓ (C.iCycles 0 z) = 1) ∧
      (∀ s : ℝ, s < a → ∀ x ∈ F.level s 0, ℓ x = 0) :=
  F.exists_dual_of_le_spectralThreshold ((ChainComplex.prev ℤ 0).trans (zero_add 1)) ξ a ha.ge

end RealFiltration

end OnLeConjecture.KnotFloer
