module

public import Mathlib.LinearAlgebra.Finsupp.LSum
public import Mathlib.LinearAlgebra.Quotient.Basic
public import Mathlib.Data.Finset.Max
public import Mathlib.Data.EReal.Basic
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.Algebra.Homology.ShortComplex.ModuleCat

/-!
# The degree-zero homology of a finite staircase

The vertices are a free module on `Fin (n+1)`. Each edge has boundary
the difference of its two consecutive vertices. The quotient by these
boundaries is canonically the coefficient ring, by summing coefficients.
For any real weights on the vertices, a nonzero class has a representative
supported below a level exactly when at least one vertex has weight below
that level. This computes the algebra needed for staircase spectral values.

This file does not identify a staircase with the knot Floer complex of an
algebraic or torus knot. That geometric comparison is a separate theorem.
-/

@[expose] public section

namespace OnLeConjecture.KnotFloer.Staircase

variable (R : Type*) [CommRing R] (n : ℕ)

/-- The free module on the vertices of a staircase. -/
abbrev Vertices := Fin (n + 1) →₀ R

/-- A vertex basis vector. -/
noncomputable def vertex (j : Fin (n + 1)) : Vertices R n := Finsupp.single j 1

/-- The boundary of an oriented edge. In characteristic two the sign becomes a plus. -/
noncomputable def edgeBoundary (j : Fin n) : Vertices R n :=
  vertex R n j.succ - vertex R n j.castSucc

/-- The submodule of boundaries generated by the consecutive edges. -/
noncomputable def boundaries : Submodule R (Vertices R n) :=
  Submodule.span R (Set.range (edgeBoundary R n))

/-- Degree-zero homology as the explicit boundary quotient. -/
abbrev H0 := Vertices R n ⧸ boundaries R n

/-- The actual differential sends each edge to its two endpoint vertices with opposite signs. -/
noncomputable def boundaryMap : (Fin n →₀ R) →ₗ[R] Vertices R n :=
  Finsupp.linearCombination R (edgeBoundary R n)

@[simp] theorem boundaryMap_single (j : Fin n) :
    boundaryMap R n (Finsupp.single j 1) = edgeBoundary R n j := by
  simp [boundaryMap]

theorem range_boundaryMap : (boundaryMap R n).range = boundaries R n :=
  Finsupp.range_linearCombination R

/-- Sum the coefficients of a vertex chain. -/
noncomputable def augmentation : Vertices R n →ₗ[R] R :=
  Finsupp.lsum R fun _ : Fin (n + 1) => (LinearMap.id : R →ₗ[R] R)

@[simp] theorem augmentation_single (j : Fin (n + 1)) (a : R) :
    augmentation R n (Finsupp.single j a) = a := by
  simp [augmentation]

@[simp] theorem augmentation_vertex (j : Fin (n + 1)) :
    augmentation R n (vertex R n j) = 1 := augmentation_single R n j 1

theorem boundaries_le_ker_augmentation : boundaries R n ≤ (augmentation R n).ker := by
  rw [boundaries, Submodule.span_le]
  rintro _ ⟨j, rfl⟩
  simp [LinearMap.mem_ker, edgeBoundary]

/-- Every vertex represents the same homology class. -/
theorem mk_vertex_eq (j : Fin (n + 1)) :
    (Submodule.Quotient.mk (vertex R n j) : H0 R n) =
      Submodule.Quotient.mk (vertex R n 0) := by
  induction j using Fin.induction with
  | zero => rfl
  | succ j hj =>
    have h : (Submodule.Quotient.mk (vertex R n j.succ) : H0 R n) =
        Submodule.Quotient.mk (vertex R n j.castSucc) :=
      (Submodule.Quotient.eq (boundaries R n)).mpr (Submodule.subset_span ⟨j, rfl⟩)
    exact h.trans hj

/-- A chain's homology class is its coefficient sum times any vertex class. -/
theorem mk_eq_augmentation_smul (v : Vertices R n) :
    (Submodule.Quotient.mk v : H0 R n) =
      augmentation R n v • Submodule.Quotient.mk (vertex R n 0) := by
  induction v using Finsupp.induction_linear with
  | zero => simp
  | add v w hv hw => simp [Submodule.Quotient.mk_add, hv, hw, add_smul]
  | single j a =>
    have h : Finsupp.single j a = a • vertex R n j := by simp [vertex]
    rw [h, Submodule.Quotient.mk_smul, mk_vertex_eq]
    simp

/-- The edge boundaries are precisely the chains with coefficient sum zero. -/
theorem boundaries_eq_ker_augmentation : boundaries R n = (augmentation R n).ker := by
  apply le_antisymm (boundaries_le_ker_augmentation R n)
  intro v hv
  apply (Submodule.Quotient.mk_eq_zero (boundaries R n)).mp
  rw [mk_eq_augmentation_smul, LinearMap.mem_ker.mp hv, zero_smul]

/-- Summing coefficients descends to the homology quotient. -/
noncomputable def homologyAugmentation : H0 R n →ₗ[R] R :=
  (boundaries R n).liftQ (augmentation R n) (boundaries_le_ker_augmentation R n)

@[simp] theorem homologyAugmentation_mk (v : Vertices R n) :
    homologyAugmentation R n (Submodule.Quotient.mk v) = augmentation R n v := rfl

/-- The finite staircase has degree-zero homology equal to one copy of its coefficient ring. -/
noncomputable def homologyEquiv : H0 R n ≃ₗ[R] R where
  toLinearMap := homologyAugmentation R n
  invFun a := a • Submodule.Quotient.mk (vertex R n 0)
  left_inv x := by
    induction x using Submodule.Quotient.induction_on with
    | _ v => exact (mk_eq_augmentation_smul R n v).symm
  right_inv a := by simp

/-- The vertex chains supported at or below a real weight. -/
def Below (w : Fin (n + 1) → ℝ) (s : ℝ) (v : Vertices R n) : Prop :=
  ∀ j, v j ≠ 0 → w j ≤ s

/-- A class is represented below a level if an actual chain with that support represents it. -/
def RepresentedBelow (w : Fin (n + 1) → ℝ) (s : ℝ) (ξ : H0 R n) : Prop :=
  ∃ v : Vertices R n, Below R n w s v ∧ Submodule.Quotient.mk v = ξ

/-- Nonzero classes become visible as soon as the first vertex does. -/
theorem representedBelow_iff (w : Fin (n + 1) → ℝ) (s : ℝ)
    (ξ : H0 R n) (hξ : ξ ≠ 0) :
    RepresentedBelow R n w s ξ ↔ ∃ j, w j ≤ s := by
  classical
  constructor
  · rintro ⟨v, hv, rfl⟩
    have hne : v ≠ 0 := by intro h; simp [h] at hξ
    obtain ⟨j, hj⟩ := Finsupp.support_nonempty_iff.mpr hne
    exact ⟨j, hv j (Finsupp.mem_support_iff.mp hj)⟩
  · rintro ⟨j, hj⟩
    let a := homologyAugmentation R n ξ
    refine ⟨Finsupp.single j a, ?_, ?_⟩
    · intro k hk
      by_cases hkj : k = j
      · simpa [hkj] using hj
      · exact (hk (Finsupp.single_eq_of_ne hkj)).elim
    · apply (homologyEquiv R n).injective
      simp [homologyEquiv, a]

/-- The spectral threshold of a class in the explicitly computed degree-zero homology. -/
noncomputable def spectralThreshold (w : Fin (n + 1) → ℝ) (ξ : H0 R n) : EReal :=
  sInf {a : EReal | ∃ s : ℝ, RepresentedBelow R n w s ξ ∧ a = (s : EReal)}

/-- A vertex of minimum weight attains the spectral threshold of every nonzero class. -/
theorem spectralThreshold_eq_minimum (w : Fin (n + 1) → ℝ) (ξ : H0 R n)
    (hξ : ξ ≠ 0) (j : Fin (n + 1)) (hj : ∀ k, w j ≤ w k) :
    spectralThreshold R n w ξ = (w j : EReal) := by
  apply le_antisymm
  · exact sInf_le ⟨w j, (representedBelow_iff R n w (w j) ξ hξ).mpr ⟨j, le_rfl⟩, rfl⟩
  · apply le_sInf
    rintro _ ⟨s, hs, rfl⟩
    obtain ⟨k, hk⟩ := (representedBelow_iff R n w s ξ hξ).mp hs
    exact EReal.coe_le_coe ((hj k).trans hk)

/-- The minimum is attained even for the staircase with no edges. -/
theorem exists_minimum_vertex (w : Fin (n + 1) → ℝ) :
    ∃ j, ∀ k, w j ≤ w k := by
  obtain ⟨j, _, hj⟩ := Finset.exists_min_image Finset.univ w Finset.univ_nonempty
  exact ⟨j, fun k => hj k (Finset.mem_univ k)⟩

/-- The real minimum of the finite list of vertex weights. -/
noncomputable def minimumWeight (w : Fin (n + 1) → ℝ) : ℝ :=
  w (Classical.choose (exists_minimum_vertex n w))

theorem minimumWeight_le (w : Fin (n + 1) → ℝ) (j : Fin (n + 1)) :
    minimumWeight n w ≤ w j :=
  Classical.choose_spec (exists_minimum_vertex n w) j

theorem exists_minimumWeight_eq (w : Fin (n + 1) → ℝ) :
    ∃ j, minimumWeight n w = w j := ⟨_, rfl⟩

theorem minimumWeight_eq_of_le (w : Fin (n + 1) → ℝ) (j : Fin (n + 1))
    (hj : ∀ k, w j ≤ w k) : minimumWeight n w = w j := by
  exact le_antisymm (minimumWeight_le n w j) (hj _)

/-- The real minimum is the spectral threshold, with no assumption on the coefficient field. -/
theorem spectralThreshold_eq_minimumWeight (w : Fin (n + 1) → ℝ)
    (ξ : H0 R n) (hξ : ξ ≠ 0) :
    spectralThreshold R n w ξ = (minimumWeight n w : EReal) :=
  spectralThreshold_eq_minimum R n w ξ hξ _ (Classical.choose_spec (exists_minimum_vertex n w))

/-- Every nonzero staircase homology class has a finite attained threshold. -/
theorem exists_spectralThreshold_eq_vertex (w : Fin (n + 1) → ℝ)
    (ξ : H0 R n) (hξ : ξ ≠ 0) :
    ∃ j, spectralThreshold R n w ξ = (w j : EReal) ∧ ∀ k, w j ≤ w k := by
  obtain ⟨j, hj⟩ := exists_minimum_vertex n w
  exact ⟨j, spectralThreshold_eq_minimum R n w ξ hξ j hj, hj⟩

open CategoryTheory in
/-- The edge-to-vertex differential as a native short complex with zero outgoing map. -/
noncomputable def shortComplex : ShortComplex (ModuleCat R) :=
  ModuleCat.shortComplexOfCompEqZero (boundaryMap R n) (0 : Vertices R n →ₗ[R] R) (by simp)

open CategoryTheory in
/-- Native homology agrees with the explicit quotient by edge boundaries. -/
noncomputable def nativeHomologyEquivQuotient : (shortComplex R n).homology ≃ₗ[R] H0 R n := by
  let h := ShortComplex.RightHomologyData.ofIsColimitCokernelCofork
    (shortComplex R n) rfl _ (ModuleCat.cokernelIsColimit (ModuleCat.ofHom (boundaryMap R n)))
  exact h.homologyIso.toLinearEquiv.trans
    (Submodule.quotEquivOfEq _ _ (range_boundaryMap R n))

/-- Native degree-zero homology of the actual edge differential is the coefficient ring. -/
noncomputable def nativeHomologyEquiv : (shortComplex R n).homology ≃ₗ[R] R :=
  (nativeHomologyEquivQuotient R n).trans (homologyEquiv R n)

end OnLeConjecture.KnotFloer.Staircase
