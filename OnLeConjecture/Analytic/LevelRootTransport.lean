/-!
# Transport of labels along grid edges

This module prepares the transitivity argument of the subsection "Global factorization, exponent
count, and transitivity" of Section 3 of the written proof of Statement E
(`statement-E-complete-proof.tex`): the monodromies of the based loops of the marked cells of a
grid generate the monodromy of the root family over the grid rectangle minus the critical values.

* `IsFibreLabel Z c f`: `f` is an injective labelling of the finite set `Z c`.
* `segT Z p q f`: the labels at `q` obtained by continuing the labels `f` at `p` along the segment
  from `p` to `q`. It is equivariant (`segT_comp`), inverted by the reverse segment (`segT_symm`),
  and computed by every labelling over a set containing the segment (`segT_of_labelling`).
* `IsRootFamily.exists_convex_labelling`: a root family has a labelling over every convex subset
  of its base, by the lifting theorem for coverings over simply connected, locally path connected
  spaces (`IsCoveringMap.existsUnique_continuousMap_lifts`).
* `vertT Z xs ys f₀ i j`: the labels at the grid vertex `(i, j)` continued from `f₀` at `(0, 0)` up
  the left column and along the row `j`, as in the based loops.
* `IsRootFamily.basedLoop_monodromy`: the monodromy of the based loop of a cell is the permutation
  `π` with `aroundT (vertT i j) = vertT i j ∘ π`, where `aroundT` continues the labels
  counterclockwise around the cell.
* `IsRootFamily.exists_vertical_defect`: the continuation of `vertT i j` up a vertical edge is
  `vertT i (j + 1) ∘ g` with `g` in the group generated by the monodromies of the based loops of
  the marked cells.
-/

@[expose] public noncomputable section

open Set Function

namespace OnLeConjecture.Analytic

open KnotTheory SignedAdjacentWord

variable {S : ℕ} {Z : ℂ → Set ℂ} {U : Set ℂ}

/-! ### Labels of fibres -/

/-- `f` is an injective labelling of the finite set `Z c`. -/
def IsFibreLabel (Z : ℂ → Set ℂ) (c : ℂ) (f : Fin S → ℂ) : Prop := Injective f ∧ range f = Z c

namespace IsFibreLabel

variable {c : ℂ} {f f' : Fin S → ℂ}

theorem comp (hf : IsFibreLabel Z c f) (σ : Equiv.Perm (Fin S)) : IsFibreLabel Z c (f ∘ σ) :=
  ⟨hf.1.comp σ.injective, by rw [σ.surjective.range_comp f, hf.2]⟩

/-- Two labellings of the same fibre differ by a permutation. -/
theorem exists_perm (hf : IsFibreLabel Z c f) (hf' : IsFibreLabel Z c f') :
    ∃ σ : Equiv.Perm (Fin S), f' = f ∘ σ := by
  have h : ∀ k, ∃ l, f l = f' k := fun k => by
    have : f' k ∈ range f := by rw [hf.2, ← hf'.2]; exact ⟨k, rfl⟩
    exact this
  choose φ hφ using h
  have hinj : Injective φ := fun k k' hkk => hf'.1 (by rw [← hφ k, ← hφ k', hkk])
  refine ⟨Equiv.ofBijective φ (Finite.injective_iff_bijective.mp hinj), funext fun k => ?_⟩
  simp [hφ k]

theorem perm_unique (hf : IsFibreLabel Z c f) {σ σ' : Equiv.Perm (Fin S)}
    (h : f ∘ σ = f ∘ σ') : σ = σ' :=
  Equiv.ext fun k => hf.1 (congrFun h k)

end IsFibreLabel

theorem IsRootLabellingOn.isFibreLabel {X : Type*} [TopologicalSpace X] {P : X → ℂ} {A : Set X}
    {K : Fin S → X → ℂ} (hK : IsRootLabellingOn Z P A K) {x : X} (hx : x ∈ A) :
    IsFibreLabel Z (P x) fun k => K k x :=
  ⟨hK.injective x hx, hK.range_eq x hx⟩

/-- Two labellings on a preconnected set that agree at one point agree everywhere. -/
theorem IsRootLabellingOn.eq_of_eq {X : Type*} [TopologicalSpace X] {P : X → ℂ} {A : Set X}
    {K K' : Fin S → X → ℂ} (hA : IsPreconnected A) (hK : IsRootLabellingOn Z P A K)
    (hK' : IsRootLabellingOn Z P A K') {x₀ : X} (hx₀ : x₀ ∈ A) (h : ∀ k, K k x₀ = K' k x₀) :
    ∀ k, ∀ x ∈ A, K k x = K' k x := by
  obtain ⟨τ, hτ⟩ := hK.exists_perm hA hK'
  have hτ1 : ∀ k, τ k = k := fun k => hK.injective x₀ hx₀ (by
    simp only
    rw [← hτ k x₀ hx₀, ← h k])
  intro k x hx
  rw [hτ k x hx, hτ1]

/-! ### Transport along segments -/

/-- `K` labels the roots along the segment from `p` to `q`, starting with `f`. -/
def IsSegLabel (Z : ℂ → Set ℂ) (p q : ℂ) (f : Fin S → ℂ) (K : Fin S → ℝ → ℂ) : Prop :=
  IsRootLabellingOn Z (segmentPath p q) (Icc 0 1) K ∧ ∀ k, K k 0 = f k

theorem IsRootFamily.exists_segLabel (hZ : IsRootFamily Z S U) {p q : ℂ}
    (hpq : MapsTo (segmentPath p q) (Icc 0 1) U) {f : Fin S → ℂ} (hf : IsFibreLabel Z p f) :
    ∃ K, IsSegLabel Z p q f K := by
  obtain ⟨K₀, hK₀⟩ := hZ.exists_path_labelling zero_lt_one
    (continuous_segmentPath p q).continuousOn hpq
  have h0 : (0 : ℝ) ∈ Icc (0 : ℝ) 1 := ⟨le_rfl, zero_le_one⟩
  have hf₀ := hK₀.isFibreLabel h0
  rw [segmentPath_zero] at hf₀
  obtain ⟨σ, hσ⟩ := hf₀.exists_perm hf
  exact ⟨fun k t => K₀ (σ k) t, hK₀.relabel σ, fun k => by rw [hσ]; rfl⟩

open Classical in
/-- **Transport of labels along a segment**: the labels at `q` continued from the labels `f` at
`p` along the segment from `p` to `q`. -/
def segT (Z : ℂ → Set ℂ) (p q : ℂ) (f : Fin S → ℂ) : Fin S → ℂ :=
  if h : ∃ K : Fin S → ℝ → ℂ, IsSegLabel Z p q f K then fun k => h.choose k 1 else f

theorem segT_eq {p q : ℂ} {f : Fin S → ℂ} {K : Fin S → ℝ → ℂ} (hK : IsSegLabel Z p q f K) :
    segT Z p q f = fun k => K k 1 := by
  have h : ∃ K : Fin S → ℝ → ℂ, IsSegLabel Z p q f K := ⟨K, hK⟩
  rw [segT, dif_pos h]
  funext k
  have hc := h.choose_spec
  exact IsRootLabellingOn.eq_of_eq isPreconnected_Icc hc.1 hK.1 ⟨le_rfl, zero_le_one⟩
    (fun k => by rw [hc.2, hK.2]) k 1 ⟨zero_le_one, le_rfl⟩

theorem IsRootFamily.isFibreLabel_segT (hZ : IsRootFamily Z S U) {p q : ℂ}
    (hpq : MapsTo (segmentPath p q) (Icc 0 1) U) {f : Fin S → ℂ} (hf : IsFibreLabel Z p f) :
    IsFibreLabel Z q (segT Z p q f) := by
  obtain ⟨K, hK⟩ := hZ.exists_segLabel hpq hf
  rw [segT_eq hK]
  have := hK.1.isFibreLabel (⟨zero_le_one, le_rfl⟩ : (1 : ℝ) ∈ Icc (0 : ℝ) 1)
  rwa [segmentPath_one] at this

theorem IsRootFamily.segT_comp (hZ : IsRootFamily Z S U) {p q : ℂ}
    (hpq : MapsTo (segmentPath p q) (Icc 0 1) U) {f : Fin S → ℂ} (hf : IsFibreLabel Z p f)
    (σ : Equiv.Perm (Fin S)) : segT Z p q (f ∘ σ) = segT Z p q f ∘ σ := by
  obtain ⟨K, hK⟩ := hZ.exists_segLabel hpq hf
  have hK' : IsSegLabel Z p q (f ∘ σ) fun k t => K (σ k) t :=
    ⟨hK.1.relabel σ, fun k => hK.2 (σ k)⟩
  rw [segT_eq hK', segT_eq hK]
  rfl

theorem IsRootFamily.segT_symm (hZ : IsRootFamily Z S U) {p q : ℂ}
    (hpq : MapsTo (segmentPath p q) (Icc 0 1) U) {f : Fin S → ℂ} (hf : IsFibreLabel Z p f) :
    segT Z q p (segT Z p q f) = f := by
  obtain ⟨K, hK⟩ := hZ.exists_segLabel hpq hf
  have hmaps : MapsTo (fun t : ℝ => 1 - t) (Icc 0 1) (Icc 0 1) := fun t ht =>
    ⟨by linarith [ht.2], by linarith [ht.1]⟩
  have hK' : IsSegLabel Z q p (segT Z p q f) fun k t => K k (1 - t) := by
    refine ⟨⟨fun k => (hK.1.continuousOn k).comp (by fun_prop) hmaps,
      fun t ht => hK.1.injective _ (hmaps ht), fun t ht => ?_⟩, fun k => ?_⟩
    · rw [hK.1.range_eq _ (hmaps ht), segmentPath_symm]
      congr 1; ring_nf
    · rw [segT_eq hK]; simp
  rw [segT_eq hK']
  funext k
  simp [hK.2]

/-- A segment between two points of a convex set lies in it. -/
theorem mapsTo_segmentPath_of_convex {D : Set ℂ} (hD : Convex ℝ D) {p q : ℂ} (hp : p ∈ D)
    (hq : q ∈ D) : MapsTo (segmentPath p q) (Icc 0 1) D := fun t ht => by
  have := hD.add_smul_sub_mem hp hq ht
  simpa [segmentPath, Complex.real_smul] using this

/-- **Transport is computed by labellings.** For a labelling `Λ` of the roots over a set `D`
containing the segment from `p` to `q`, the transport of `Λ p` is `Λ q`. -/
theorem segT_of_labelling {D : Set ℂ} {Λ : Fin S → ℂ → ℂ} (hΛ : IsRootLabellingOn Z id D Λ)
    {p q : ℂ} (hpq : MapsTo (segmentPath p q) (Icc 0 1) D) :
    segT Z p q (fun k => Λ k p) = fun k => Λ k q := by
  have hK : IsSegLabel Z p q (fun k => Λ k p) fun k t => Λ k (segmentPath p q t) := by
    refine ⟨⟨fun k => (hΛ.continuousOn k).comp (continuous_segmentPath p q).continuousOn hpq,
      fun t ht => hΛ.injective _ (hpq ht), fun t ht => hΛ.range_eq _ (hpq ht)⟩, fun k => ?_⟩
    simp
  rw [segT_eq hK]
  simp

/-- **Labellings over convex sets.** A root family has a labelling over every convex subset of
its base, with prescribed labels at one point. -/
theorem IsRootFamily.exists_convex_labelling (hZ : IsRootFamily Z S U) {D : Set ℂ}
    (hD : Convex ℝ D) (hDU : D ⊆ U) {z₀ : ℂ} (hz₀ : z₀ ∈ D) {f : Fin S → ℂ}
    (hf : IsFibreLabel Z z₀ f) :
    ∃ Λ : Fin S → ℂ → ℂ, IsRootLabellingOn Z id D Λ ∧ ∀ k, Λ k z₀ = f k := by
  classical
  have : ContractibleSpace D := hD.contractibleSpace ⟨z₀, hz₀⟩
  have : LocallyPathConnectedSpace D := hD.locallyPathConnectedSpace
  have cov := hZ.isCoveringMap
  let φ : C(D, U) := ⟨fun z => ⟨z.1, hDU z.2⟩, by fun_prop⟩
  let e₀ : Fin S → RootSpace Z U := fun k =>
    ⟨(z₀, f k), hDU hz₀, by rw [← hf.2]; exact ⟨k, rfl⟩⟩
  have he : ∀ k, rootProj Z U (e₀ k) = φ ⟨z₀, hz₀⟩ := fun k => rfl
  choose F hF using fun k => (cov.existsUnique_continuousMap_lifts φ ⟨z₀, hz₀⟩ (e₀ k) (he k)).exists
  have hbase : ∀ k (z : D), (F k z).1.1 = z.1 := fun k z => by
    have := congrArg Subtype.val (congrFun (hF k).2 z)
    exact this
  let Λ : Fin S → ℂ → ℂ := fun k z => if h : z ∈ D then (F k ⟨z, h⟩).1.2 else 0
  have hΛ : ∀ k (z : D), Λ k z = (F k z).1.2 := fun k z => by simp [Λ, z.2]
  have hinj : ∀ z : D, Injective fun k => (F k z).1.2 := by
    intro z k l hkl
    have hz : F k z = F l z := by
      apply Subtype.ext
      exact Prod.ext ((hbase k z).trans (hbase l z).symm) hkl
    have hFF := cov.eq_of_comp_eq (F k).continuous (F l).continuous
      ((hF k).2.trans (hF l).2.symm) z hz
    have h0 := congrFun hFF ⟨z₀, hz₀⟩
    rw [(hF k).1, (hF l).1] at h0
    exact hf.1 (congrArg (fun q : RootSpace Z U => q.1.2) h0)
  refine ⟨Λ, ⟨fun k => ?_, fun z hz => ?_, fun z hz => ?_⟩, fun k => ?_⟩
  · rw [continuousOn_iff_continuous_domRestrict]
    have : D.domRestrict (Λ k) = fun z : D => (F k z).1.2 := funext fun z => hΛ k z
    rw [this]
    exact continuous_snd.comp (continuous_subtype_val.comp (F k).continuous)
  · rw [show (fun k => Λ k z) = fun k => (F k ⟨z, hz⟩).1.2 from
      funext fun k => hΛ k ⟨z, hz⟩]
    exact hinj ⟨z, hz⟩
  · have hmem : ∀ k, (F k ⟨z, hz⟩).1.2 ∈ Z z := fun k => by
      have := (F k ⟨z, hz⟩).2.2
      rwa [hbase k ⟨z, hz⟩] at this
    simp only [id]
    rw [show (fun k => Λ k z) = fun k => (F k ⟨z, hz⟩).1.2 from funext fun k => hΛ k ⟨z, hz⟩]
    exact hZ.range_eq_of_injective (hDU hz) (hinj ⟨z, hz⟩) hmem
  · rw [hΛ k ⟨z₀, hz₀⟩, (hF k).1]

/-! ### Transport along polygons -/

/-- A labelling along a polygon continues its labels along each side. -/
theorem IsRootLabellingOn.polygon_step {w : ℕ → ℂ} {M : ℕ} {K : Fin S → ℝ → ℂ}
    (hK : IsRootLabellingOn Z (polygonPath w) (Icc 0 (M : ℝ)) K) {m : ℕ} (hm : m < M) :
    segT Z (w m) (w (m + 1)) (fun k => K k m) = fun k => K k (m + 1 : ℕ) := by
  have hmaps : MapsTo (fun t : ℝ => (m : ℝ) + t) (Icc 0 1) (Icc 0 (M : ℝ)) := fun t ht => by
    have : (m : ℝ) + 1 ≤ M := by exact_mod_cast hm
    exact ⟨by linarith [ht.1, (Nat.cast_nonneg m : (0 : ℝ) ≤ m)], by linarith [ht.2]⟩
  have hseg : IsSegLabel Z (w m) (w (m + 1)) (fun k => K k m) fun k t => K k (m + t) := by
    refine ⟨⟨fun k => (hK.continuousOn k).comp (by fun_prop) hmaps,
      fun t ht => hK.injective _ (hmaps ht), fun t ht => ?_⟩, fun k => by simp⟩
    rw [hK.range_eq _ (hmaps ht), polygonPath_eq w m ⟨by linarith [ht.1], by linarith [ht.2]⟩]
    congr 1; ring_nf
  rw [segT_eq hseg]
  funext k
  push_cast
  rfl

/-! ### Transport along the grid -/

variable {xs ys : ℕ → ℝ} {n : ℕ} {marked : ℕ → ℕ → Prop}

/-- The labels at the vertex `(0, j)` continued up the left column. -/
def colT (Z : ℂ → Set ℂ) (xs ys : ℕ → ℝ) (f₀ : Fin S → ℂ) : ℕ → Fin S → ℂ
  | 0 => f₀
  | j + 1 => segT Z (gridPoint xs ys 0 j) (gridPoint xs ys 0 (j + 1)) (colT Z xs ys f₀ j)

/-- The labels at the vertex `(i, j)` continued up the left column and along the row `j`. -/
def vertT (Z : ℂ → Set ℂ) (xs ys : ℕ → ℝ) (f₀ : Fin S → ℂ) : ℕ → ℕ → Fin S → ℂ
  | 0, j => colT Z xs ys f₀ j
  | i + 1, j => segT Z (gridPoint xs ys i j) (gridPoint xs ys (i + 1) j) (vertT Z xs ys f₀ i j)

theorem vertT_zero (f₀ : Fin S → ℂ) (j : ℕ) : vertT Z xs ys f₀ 0 j = colT Z xs ys f₀ j := rfl

theorem vertT_succ (f₀ : Fin S → ℂ) (i j : ℕ) :
    vertT Z xs ys f₀ (i + 1) j =
      segT Z (gridPoint xs ys i j) (gridPoint xs ys (i + 1) j) (vertT Z xs ys f₀ i j) := rfl

theorem vertT_zero_succ (f₀ : Fin S → ℂ) (j : ℕ) :
    vertT Z xs ys f₀ 0 (j + 1) =
      segT Z (gridPoint xs ys 0 j) (gridPoint xs ys 0 (j + 1)) (vertT Z xs ys f₀ 0 j) := rfl

theorem IsRootFamily.isFibreLabel_vertT (hZ : IsRootFamily Z S U)
    (G : IsRootGrid U xs ys n marked) {f₀ : Fin S → ℂ}
    (hf₀ : IsFibreLabel Z (gridPoint xs ys 0 0) f₀) :
    ∀ i ≤ n, ∀ j ≤ n, IsFibreLabel Z (gridPoint xs ys i j) (vertT Z xs ys f₀ i j) := by
  have hcol : ∀ j ≤ n, IsFibreLabel Z (gridPoint xs ys 0 j) (colT Z xs ys f₀ j) := by
    intro j hj
    induction j with
    | zero => exact hf₀
    | succ j ih =>
      exact hZ.isFibreLabel_segT (G.mapsTo_vertical (Nat.zero_le n) (by omega)) (ih (by omega))
  intro i hi j hj
  induction i with
  | zero => exact hcol j hj
  | succ i ih =>
    exact hZ.isFibreLabel_segT (G.mapsTo_horizontal (by omega) hj) (ih (by omega))

/-- The labels continued counterclockwise around the cell `(i, j)`. -/
def aroundT (Z : ℂ → Set ℂ) (xs ys : ℕ → ℝ) (i j : ℕ) (f : Fin S → ℂ) : Fin S → ℂ :=
  segT Z (gridPoint xs ys i (j + 1)) (gridPoint xs ys i j)
    (segT Z (gridPoint xs ys (i + 1) (j + 1)) (gridPoint xs ys i (j + 1))
      (segT Z (gridPoint xs ys (i + 1) j) (gridPoint xs ys (i + 1) (j + 1))
        (segT Z (gridPoint xs ys i j) (gridPoint xs ys (i + 1) j) f)))

section Cell

variable (hZ : IsRootFamily Z S U) (G : IsRootGrid U xs ys n marked)
include hZ G

theorem isFibreLabel_aroundT {i j : ℕ} (hi : i < n) (hj : j < n) {f : Fin S → ℂ}
    (hf : IsFibreLabel Z (gridPoint xs ys i j) f) :
    IsFibreLabel Z (gridPoint xs ys i j) (aroundT Z xs ys i j f) := by
  have h1 := hZ.isFibreLabel_segT (G.mapsTo_horizontal hi hj.le) hf
  have h2 := hZ.isFibreLabel_segT (G.mapsTo_vertical hi hj) h1
  have h3 := hZ.isFibreLabel_segT (mapsTo_segmentPath_symm (G.mapsTo_horizontal hi hj)) h2
  exact hZ.isFibreLabel_segT (mapsTo_segmentPath_symm (G.mapsTo_vertical hi.le hj)) h3

theorem aroundT_comp {i j : ℕ} (hi : i < n) (hj : j < n) {f : Fin S → ℂ}
    (hf : IsFibreLabel Z (gridPoint xs ys i j) f) (σ : Equiv.Perm (Fin S)) :
    aroundT Z xs ys i j (f ∘ σ) = aroundT Z xs ys i j f ∘ σ := by
  have h1 := hZ.isFibreLabel_segT (G.mapsTo_horizontal hi hj.le) hf
  have h2 := hZ.isFibreLabel_segT (G.mapsTo_vertical hi hj) h1
  have h3 := hZ.isFibreLabel_segT (mapsTo_segmentPath_symm (G.mapsTo_horizontal hi hj)) h2
  unfold aroundT
  rw [hZ.segT_comp (G.mapsTo_horizontal hi hj.le) hf, hZ.segT_comp (G.mapsTo_vertical hi hj) h1,
    hZ.segT_comp (mapsTo_segmentPath_symm (G.mapsTo_horizontal hi hj)) h2,
    hZ.segT_comp (mapsTo_segmentPath_symm (G.mapsTo_vertical hi.le hj)) h3]

/-- Around an unmarked cell the labels come back. -/
theorem aroundT_of_not_marked {i j : ℕ} (hi : i < n) (hj : j < n) (hm : ¬ marked i j)
    {f : Fin S → ℂ} (hf : IsFibreLabel Z (gridPoint xs ys i j) f) :
    aroundT Z xs ys i j f = f := by
  have hconv : Convex ℝ (gridCell xs ys i j) :=
    ((convex_Icc _ _).is_linear_preimage Complex.reLm.isLinear).inter
      ((convex_Icc _ _).is_linear_preimage Complex.imLm.isLinear)
  have hxi := G.xs_lt i hi
  have hyj := G.ys_lt j hj
  have hv : ∀ a b, a ∈ ({i, i + 1} : Set ℕ) → b ∈ ({j, j + 1} : Set ℕ) →
      gridPoint xs ys a b ∈ gridCell xs ys i j := by
    rintro a b (rfl | rfl) (rfl | rfl) <;>
      exact ⟨⟨by simp [gridPoint] <;> linarith, by simp [gridPoint] <;> linarith⟩,
        ⟨by simp [gridPoint] <;> linarith, by simp [gridPoint] <;> linarith⟩⟩
  have h00 := hv i j (by simp) (by simp)
  have h10 := hv (i + 1) j (by simp) (by simp)
  have h11 := hv (i + 1) (j + 1) (by simp) (by simp)
  have h01 := hv i (j + 1) (by simp) (by simp)
  obtain ⟨Λ, hΛ, hΛ0⟩ := hZ.exists_convex_labelling hconv (G.cell i hi j hj hm) h00 hf
  have hf' : f = fun k => Λ k (gridPoint xs ys i j) := funext fun k => (hΛ0 k).symm
  unfold aroundT
  rw [hf', segT_of_labelling hΛ (mapsTo_segmentPath_of_convex hconv h00 h10),
    segT_of_labelling hΛ (mapsTo_segmentPath_of_convex hconv h10 h11),
    segT_of_labelling hΛ (mapsTo_segmentPath_of_convex hconv h11 h01),
    segT_of_labelling hΛ (mapsTo_segmentPath_of_convex hconv h01 h00)]

end Cell

/-! ### The monodromy of a based loop -/

/-- **The monodromy of a based loop.** For labels `f₀` at `(0, 0)`, the labelling along the based
loop of the cell `(a, b)` starting with `f₀` ends with `f₀ ∘ π`, where
`aroundT (vertT a b) = vertT a b ∘ π`. -/
theorem IsRootFamily.basedLoop_monodromy (hZ : IsRootFamily Z S U)
    (G : IsRootGrid U xs ys n marked) {f₀ : Fin S → ℂ}
    (hf₀ : IsFibreLabel Z (gridPoint xs ys 0 0) f₀) {a b : ℕ} (ha : a < n) (hb : b < n)
    {π : Equiv.Perm (Fin S)}
    (hπ : aroundT Z xs ys a b (vertT Z xs ys f₀ a b) = vertT Z xs ys f₀ a b ∘ π) :
    ∃ K : Fin S → ℝ → ℂ, IsRootLabellingOn Z (polygonPath (basedLoop xs ys a b))
      (Icc 0 (basedLength a b : ℝ)) K ∧ (∀ k, K k 0 = f₀ k) ∧
        ∀ k, K k (basedLength a b) = f₀ (π k) := by
  set w := basedLoop xs ys a b with hw
  set M := basedLength a b with hM
  have hMpos : 0 < M := by rw [hM]; unfold basedLength; omega
  have hside := IsRootGrid.mapsTo_basedLoop G ha hb
  obtain ⟨K₀, hK₀⟩ := hZ.exists_polygon_labelling hMpos hside
  have h0 : (0 : ℝ) ∈ Icc (0 : ℝ) M := ⟨le_rfl, Nat.cast_nonneg _⟩
  have hf₀' := hK₀.isFibreLabel h0
  rw [show polygonPath w 0 = gridPoint xs ys 0 0 by
    rw [polygonPath_eq w 0 (by simp)]; simp [hw, basedLoop_zero]] at hf₀'
  obtain ⟨σ, hσ⟩ := hf₀'.exists_perm hf₀
  set K : Fin S → ℝ → ℂ := fun k t => K₀ (σ k) t with hKdef
  have hK : IsRootLabellingOn Z (polygonPath w) (Icc 0 (M : ℝ)) K := hK₀.relabel σ
  have hK0 : ∀ k, K k 0 = f₀ k := fun k => by rw [hσ]; rfl
  -- The labels at the vertices.
  set V : ℕ → Fin S → ℂ := fun m k => K k (m : ℕ) with hVdef
  have hstep : ∀ m < M, segT Z (w m) (w (m + 1)) (V m) = V (m + 1) := fun m hm =>
    hK.polygon_step hm
  have hV0 : V 0 = f₀ := funext fun k => by simp [hVdef, hK0]
  have hfib := hZ.isFibreLabel_vertT G hf₀
  -- Up the left column.
  have hcol : ∀ m ≤ b, V m = vertT Z xs ys f₀ 0 m := by
    intro m hm
    induction m with
    | zero => rw [hV0]; rfl
    | succ m ih =>
      rw [← hstep m (by unfold basedLength at hM; omega), ih (by omega), hw,
        basedLoop_col xs ys a b (by omega : m ≤ b), basedLoop_col xs ys a b hm]
      rfl
  -- Along the row.
  have hrow : ∀ m ≤ a, V (b + m) = vertT Z xs ys f₀ m b := by
    intro m hm
    induction m with
    | zero => simpa using hcol b le_rfl
    | succ m ih =>
      rw [show b + (m + 1) = b + m + 1 by omega, ← hstep (b + m)
        (by unfold basedLength at hM; omega), ih (by omega), hw,
        basedLoop_row xs ys a b (by omega) (by omega : b + m ≤ b + a),
        basedLoop_row xs ys a b (by omega) (by omega : b + m + 1 ≤ b + a)]
      simp only [show b + m - b = m by omega, show b + m + 1 - b = m + 1 by omega]
      rfl
  -- Around the cell.
  have hcorner := hrow a le_rfl
  have hc1 : V (b + a + 1) = segT Z (gridPoint xs ys a b) (gridPoint xs ys (a + 1) b)
      (vertT Z xs ys f₀ a b) := by
    rw [← hstep (b + a) (by unfold basedLength at hM; omega), hcorner, hw, basedLoop_corner,
      basedLoop_c1]
  have hc2 : V (b + a + 2) = segT Z (gridPoint xs ys (a + 1) b) (gridPoint xs ys (a + 1) (b + 1))
      (V (b + a + 1)) := by
    rw [← hstep (b + a + 1) (by unfold basedLength at hM; omega), hw, basedLoop_c1, basedLoop_c2]
  have hc3 : V (b + a + 3) = segT Z (gridPoint xs ys (a + 1) (b + 1))
      (gridPoint xs ys a (b + 1)) (V (b + a + 2)) := by
    rw [← hstep (b + a + 2) (by unfold basedLength at hM; omega), hw, basedLoop_c2, basedLoop_c3]
  have hc4 : V (b + a + 4) = segT Z (gridPoint xs ys a (b + 1)) (gridPoint xs ys a b)
      (V (b + a + 3)) := by
    rw [← hstep (b + a + 3) (by unfold basedLength at hM; omega), hw, basedLoop_c3,
      basedLoop_back xs ys a b (by omega) (by omega)]
    rw [show b + 2 * a + 4 - (b + a + 3 + 1) = a by omega]
  have haround : V (b + a + 4) = vertT Z xs ys f₀ a b ∘ π := by
    rw [hc4, hc3, hc2, hc1, ← hπ]
    rfl
  -- Back along the row.
  have hback : ∀ m ≤ a, V (b + a + 4 + m) = vertT Z xs ys f₀ (a - m) b ∘ π := by
    intro m hm
    induction m with
    | zero => simpa using haround
    | succ m ih =>
      rw [show b + a + 4 + (m + 1) = b + a + 4 + m + 1 by omega,
        ← hstep (b + a + 4 + m) (by unfold basedLength at hM; omega), ih (by omega), hw,
        basedLoop_back xs ys a b (by omega) (by omega),
        basedLoop_back xs ys a b (by omega) (by omega)]
      rw [show b + 2 * a + 4 - (b + a + 4 + m) = a - m by omega,
        show b + 2 * a + 4 - (b + a + 4 + m + 1) = a - (m + 1) by omega]
      obtain ⟨m', hm'⟩ : ∃ m', a - m = m' + 1 := ⟨a - m - 1, by omega⟩
      rw [hm', show a - (m + 1) = m' by omega, vertT_succ]
      have hpq := G.mapsTo_horizontal (a := m') (b := b) (by omega) hb.le
      have hfm := hfib m' (by omega) b hb.le
      rw [hZ.segT_comp (mapsTo_segmentPath_symm hpq) (hZ.isFibreLabel_segT hpq hfm),
        hZ.segT_symm hpq hfm]
  -- Down the left column.
  have hdown : ∀ m ≤ b, V (b + 2 * a + 4 + m) = vertT Z xs ys f₀ 0 (b - m) ∘ π := by
    intro m hm
    induction m with
    | zero =>
      have := hback a le_rfl
      rw [show b + a + 4 + a = b + 2 * a + 4 + 0 by omega, Nat.sub_self] at this
      simpa using this
    | succ m ih =>
      rw [show b + 2 * a + 4 + (m + 1) = b + 2 * a + 4 + m + 1 by omega,
        ← hstep (b + 2 * a + 4 + m) (by unfold basedLength at hM; omega), ih (by omega), hw,
        basedLoop_down xs ys a b (by omega), basedLoop_down xs ys a b (by omega)]
      rw [show 2 * b + 2 * a + 4 - (b + 2 * a + 4 + m) = b - m by omega,
        show 2 * b + 2 * a + 4 - (b + 2 * a + 4 + m + 1) = b - (m + 1) by omega]
      obtain ⟨m', hm'⟩ : ∃ m', b - m = m' + 1 := ⟨b - m - 1, by omega⟩
      rw [hm', show b - (m + 1) = m' by omega, vertT_zero_succ]
      have hpq := G.mapsTo_vertical (a := 0) (b := m') (Nat.zero_le n) (by omega)
      have hfm := hfib 0 (Nat.zero_le n) m' (by omega)
      rw [hZ.segT_comp (mapsTo_segmentPath_symm hpq) (hZ.isFibreLabel_segT hpq hfm),
        hZ.segT_symm hpq hfm]
  have hend : V M = f₀ ∘ π := by
    have := hdown b le_rfl
    rw [show b + 2 * a + 4 + b = M by rw [hM]; unfold basedLength; omega, Nat.sub_self] at this
    rw [this]
    rfl
  refine ⟨K, hK, hK0, fun k => ?_⟩
  have := congrFun hend k
  simpa [hVdef] using this

/-! ### The vertical defects -/

/-- The group generated by the monodromies of the based loops of the marked cells. -/
def basedLoopGroup (Z : ℂ → Set ℂ) (xs ys : ℕ → ℝ) (marked : ℕ → ℕ → Prop)
    (baseLabel : Fin S → ℂ) : Subgroup (Equiv.Perm (Fin S)) :=
  Subgroup.closure {τ : Equiv.Perm (Fin S) | ∃ a b, marked a b ∧ ∃ K : Fin S → ℝ → ℂ,
    IsRootLabellingOn Z (polygonPath (basedLoop xs ys a b)) (Icc 0 (basedLength a b : ℝ)) K ∧
    (∀ k, K k 0 = baseLabel k) ∧ ∀ k, K k (basedLength a b) = baseLabel (τ k)}

/-- The monodromy around every cell lies in the group of the based loops. -/
theorem IsRootFamily.exists_around_perm (hZ : IsRootFamily Z S U)
    (G : IsRootGrid U xs ys n marked) {f₀ : Fin S → ℂ}
    (hf₀ : IsFibreLabel Z (gridPoint xs ys 0 0) f₀) {a b : ℕ} (ha : a < n) (hb : b < n) :
    ∃ π ∈ basedLoopGroup Z xs ys marked f₀,
      aroundT Z xs ys a b (vertT Z xs ys f₀ a b) = vertT Z xs ys f₀ a b ∘ π := by
  have hfab := hZ.isFibreLabel_vertT G hf₀ a ha.le b hb.le
  obtain ⟨π, hπ⟩ := hfab.exists_perm (isFibreLabel_aroundT hZ G ha hb hfab)
  refine ⟨π, ?_, hπ⟩
  by_cases hm : marked a b
  · apply Subgroup.subset_closure
    exact ⟨a, b, hm, hZ.basedLoop_monodromy G hf₀ ha hb hπ⟩
  · have h1 := aroundT_of_not_marked hZ G ha hb hm hfab
    have : π = 1 := hfab.perm_unique (by rw [← hπ, h1]; rfl)
    rw [this]
    exact Subgroup.one_mem _

/-- **The vertical defects.** The continuation of `vertT i j` up the vertical edge from `(i, j)`
to `(i, j + 1)` is `vertT i (j + 1) ∘ g` with `g` in the group of the based loops. -/
theorem IsRootFamily.exists_vertical_defect (hZ : IsRootFamily Z S U)
    (G : IsRootGrid U xs ys n marked) {f₀ : Fin S → ℂ}
    (hf₀ : IsFibreLabel Z (gridPoint xs ys 0 0) f₀) :
    ∀ i ≤ n, ∀ j < n, ∃ g ∈ basedLoopGroup Z xs ys marked f₀,
      segT Z (gridPoint xs ys i j) (gridPoint xs ys i (j + 1)) (vertT Z xs ys f₀ i j) =
        vertT Z xs ys f₀ i (j + 1) ∘ g := by
  have hfib := hZ.isFibreLabel_vertT G hf₀
  intro i hi
  induction i with
  | zero =>
    intro j hj
    exact ⟨1, Subgroup.one_mem _, by rw [vertT_zero_succ]; rfl⟩
  | succ i ih =>
    intro j hj
    obtain ⟨g, hg, hgeq⟩ := ih (by omega) j hj
    obtain ⟨π, hπ, hπeq⟩ := hZ.exists_around_perm G hf₀ (a := i) (b := j) (by omega) hj
    refine ⟨g * π, Subgroup.mul_mem _ hg hπ, ?_⟩
    -- The four sides of the cell `(i, j)`.
    have e0 := G.mapsTo_horizontal (a := i) (b := j) (by omega) hj.le
    have e1 := G.mapsTo_vertical (a := i + 1) (b := j) hi hj
    have e2 := G.mapsTo_horizontal (a := i) (b := j + 1) (by omega) hj
    have e3 := G.mapsTo_vertical (a := i) (b := j) (by omega) hj
    have f0 := hfib i (by omega) j hj.le
    have f1 := hZ.isFibreLabel_segT e0 f0
    have f2 := hZ.isFibreLabel_segT e1 f1
    have f3 := hZ.isFibreLabel_segT (mapsTo_segmentPath_symm e2) f2
    have f01 := hfib i (by omega) (j + 1) hj
    -- The value at the upper left corner.
    have hB : segT Z (gridPoint xs ys (i + 1) (j + 1)) (gridPoint xs ys i (j + 1))
        (segT Z (gridPoint xs ys (i + 1) j) (gridPoint xs ys (i + 1) (j + 1))
          (vertT Z xs ys f₀ (i + 1) j)) = vertT Z xs ys f₀ i (j + 1) ∘ (g * π) := by
      have h := congrArg (segT Z (gridPoint xs ys i j) (gridPoint xs ys i (j + 1))) hπeq
      unfold aroundT at h
      rw [hZ.segT_symm (mapsTo_segmentPath_symm e3) f3, hZ.segT_comp e3 f0, hgeq] at h
      rw [vertT_succ, h]
      rfl
    have f2' : IsFibreLabel Z (gridPoint xs ys (i + 1) (j + 1))
        (segT Z (gridPoint xs ys (i + 1) j) (gridPoint xs ys (i + 1) (j + 1))
          (vertT Z xs ys f₀ (i + 1) j)) := hZ.isFibreLabel_segT e1 (hfib (i + 1) hi j hj.le)
    have h := congrArg (segT Z (gridPoint xs ys i (j + 1)) (gridPoint xs ys (i + 1) (j + 1))) hB
    rw [hZ.segT_symm (mapsTo_segmentPath_symm e2) f2', hZ.segT_comp e2 f01] at h
    rw [h, vertT_succ]

end OnLeConjecture.Analytic
