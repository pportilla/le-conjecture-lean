module

public import OnLeConjecture.Analytic.ThirdCoordinateSubtraction
public import OnLeConjecture.Analytic.MonicTriangularFinite

/-!
# Analytic subtraction from the second target coordinate

The inverse adds the same analytic function of the unchanged first
coordinate. This is an equality of analytic image rings, not a claim
about polynomial algebras generated by two analytic germs.
-/

public section

namespace OnLeConjecture.Analytic.PointedMapGerm

open Filter
open scoped Topology

@[expose] noncomputable def firstCoordinateProjection : PointedMapGerm 2 1 :=
  ofFunction (fun z => fun _ => z 0)
    (by
      apply AnalyticAt.pi
      intro i
      exact (ContinuousLinearMap.proj (R := ℂ) (φ := fun _ : Fin 2 => ℂ) 0).analyticAt 0)
    (by funext i; rfl)

@[simp] theorem firstCoordinateProjection_component (i : Fin 1) :
    firstCoordinateProjection.1.component i = Germ.coordinate (0 : Fin 2) := by
  apply Subtype.ext
  rfl

/-- Every analytic scalar germ vanishing at zero can be subtracted from
the second target coordinate by an analytic pointed equivalence. -/
theorem exists_secondCoordinateSubtraction
    (q : Germ 1) (hq : q ∈ Germ.maximalIdeal 1) :
    ∃ e : PointedEquivGerm 2,
      e.forward.1.component 0 = Germ.coordinate 0 ∧
      e.forward.1.component 1 = Germ.coordinate 1 -
        firstCoordinateProjection.pullbackRingHom q := by
  rcases q with ⟨q, hqanalytic⟩
  induction q using Filter.Germ.inductionOn with
  | _ q =>
    rw [mem_analyticGermSubring, isAnalyticGerm_ofFun] at hqanalytic
    have hqzero : q 0 = 0 := by
      rw [Germ.mem_maximalIdeal_iff] at hq
      change Germ.valueRingHom 1 (Germ.ofFunction q hqanalytic) = 0 at hq
      rwa [Germ.valueRingHom_ofFunction] at hq
    let subq : Source 2 → Source 2 := fun z => ![z 0, z 1 - q (fun _ => z 0)]
    let addq : Source 2 → Source 2 := fun z => ![z 0, z 1 + q (fun _ => z 0)]
    have hfirst : AnalyticAt ℂ (fun z : Source 2 => fun _ : Fin 1 => z 0) 0 := by
      apply AnalyticAt.pi
      intro i
      exact (ContinuousLinearMap.proj (R := ℂ) (φ := fun _ : Fin 2 => ℂ) 0).analyticAt 0
    have hqcomp : AnalyticAt ℂ (fun z : Source 2 => q (fun _ => z 0)) 0 :=
      hqanalytic.comp_of_eq hfirst rfl
    have hsub : AnalyticAt ℂ subq 0 := by
      apply AnalyticAt.pi
      intro i
      fin_cases i
      · exact (ContinuousLinearMap.proj (R := ℂ) (φ := fun _ : Fin 2 => ℂ) 0).analyticAt 0
      · exact ((ContinuousLinearMap.proj (R := ℂ)
          (φ := fun _ : Fin 2 => ℂ) 1).analyticAt 0).sub hqcomp
    have hadd : AnalyticAt ℂ addq 0 := by
      apply AnalyticAt.pi
      intro i
      fin_cases i
      · exact (ContinuousLinearMap.proj (R := ℂ) (φ := fun _ : Fin 2 => ℂ) 0).analyticAt 0
      · exact ((ContinuousLinearMap.proj (R := ℂ)
          (φ := fun _ : Fin 2 => ℂ) 1).analyticAt 0).add hqcomp
    have hqzero' : q (fun _ : Fin 1 => 0) = 0 := hqzero
    have hsubzero : subq 0 = 0 := by ext i; fin_cases i <;> simp [subq, hqzero']
    have haddzero : addq 0 = 0 := by ext i; fin_cases i <;> simp [addq, hqzero']
    let e : PointedEquivGerm 2 :=
      { forward := ofFunction subq hsub hsubzero
        inverse := ofFunction addq hadd haddzero
        forward_inverse := by
          rw [comp_ofFunction]
          apply Subtype.ext
          apply Subtype.ext
          apply Filter.Germ.coe_eq.mpr
          filter_upwards [] with z
          ext i
          fin_cases i <;> simp [subq, addq]
        inverse_forward := by
          rw [comp_ofFunction]
          apply Subtype.ext
          apply Subtype.ext
          apply Filter.Germ.coe_eq.mpr
          filter_upwards [] with z
          ext i
          fin_cases i <;> simp [subq, addq] }
    refine ⟨e, ?_, ?_⟩
    · apply Subtype.ext
      rfl
    · apply Subtype.ext
      rfl

/-- Target subtraction preserves both the analytic image subring and
the coordinate ideal. -/
theorem exists_target_second_subtraction (f : PointedMapGerm 2 2)
    (q : Germ 1) (hq : q ∈ Germ.maximalIdeal 1) :
    ∃ h : PointedMapGerm 2 2,
      f.RightLeftEquivalent h ∧
      h.1.component 0 = f.1.component 0 ∧
      h.1.component 1 = f.1.component 1 -
        (firstCoordinateProjection.comp f).pullbackRingHom q ∧
      h.ImageRing = f.ImageRing ∧ h.1.coordinateIdeal = f.1.coordinateIdeal := by
  obtain ⟨e, he0, he1⟩ := exists_secondCoordinateSubtraction q hq
  refine ⟨e.forward.comp f, ?_, ?_, ?_,
    f.imageRing_targetEquiv_comp e, f.coordinateIdeal_targetEquiv_comp e⟩
  · refine ⟨PointedEquivGerm.identity 2, e, ?_⟩
    rw [PointedEquivGerm.identity_forward, comp_identity]
  · rw [component_comp_eq_pullback, he0, pullback_coordinate]
  · rw [component_comp_eq_pullback, he1, map_sub, pullback_coordinate, pullbackRingHom_comp]
    rfl

end OnLeConjecture.Analytic.PointedMapGerm
