module

public import OnLeConjecture.Analytic.FiniteGraphProjection

/-!
# A finite plane image equals the zero set of its principal equation

Prepared projection first supplies actual analytic equations for the image
of a closed source ball. If the entire pullback kernel is generated by one
germ, all those equations are multiples of that generator. This proves
pointwise coverage of its nearby zero set. Compact confinement then gives
proper representatives onto that zero set.
-/

@[expose] public section

open Filter Metric Set
open scoped Topology

namespace OnLeConjecture.Analytic

namespace Germ

/-- Divisibility of analytic germs gives the corresponding zero-set
inclusion on representatives after shrinking the neighborhood. -/
theorem eventually_zero_imp_zero_of_dvd
    {n : ℕ} (F H : Source n → ℂ)
    (hF : AnalyticAt ℂ F 0) (hH : AnalyticAt ℂ H 0)
    (hdiv : Germ.ofFunction F hF ∣ Germ.ofFunction H hH) :
    ∀ᶠ y in 𝓝 0, F y = 0 → H y = 0 := by
  obtain ⟨q, hq⟩ := hdiv
  obtain ⟨Q, hQ, hqQ⟩ := Germ.exists_analyticRepresentative_allOrders q
  rw [hqQ] at hq
  have hevent : ∀ᶠ y in 𝓝 (0 : Source n), H y = F y * Q y :=
    Filter.Germ.coe_eq.mp (congrArg (fun a : Germ n => (a : FunctionGerm n)) hq)
  filter_upwards [hevent] with y hy hzero
  simpa only [hzero, zero_mul] using hy

end Germ

namespace PointedMapGerm

/-- For a finite plane germ with principal pullback kernel, the image of a
small closed ball equals the nearby zero set of its generator. The ball
can be chosen inside any prescribed source neighborhood. -/
theorem exists_closedBall_image_eq_zero_set_of_finite
    {m : ℕ} (g : PointedMapGerm 2 m) (hf : g.IsFiniteAtOrigin)
    (G : Source 2 → Source m) (hG : AnalyticAt ℂ G 0) (hG0 : G 0 = 0)
    (hg : g = ofFunction G hG hG0)
    (F : Source m → ℂ) (hF : AnalyticAt ℂ F 0)
    (hker : RingHom.ker g.pullbackRingHom = Ideal.span {Germ.ofFunction F hF})
    (S : Set (Source 2)) (hS : S ∈ 𝓝 0) :
    ∃ r : ℝ, 0 < r ∧ closedBall (0 : Source 2) r ⊆ S ∧
      AnalyticOnNhd ℂ G (closedBall 0 r) ∧
      (∀ x ∈ closedBall (0 : Source 2) r, G x = 0 → x = 0) ∧
      (∀ x ∈ closedBall (0 : Source 2) r, F (G x) = 0) ∧
      ∀ᶠ y in 𝓝 0,
        F y = 0 ↔ ∃ x ∈ closedBall (0 : Source 2) r, G x = y := by
  have hvanish : g.pullbackRingHom (Germ.ofFunction F hF) = 0 := by
    exact (show Germ.ofFunction F hF ∈ RingHom.ker g.pullbackRingHom from
      hker ▸ Ideal.subset_span (Set.mem_singleton _))
  have hvanishevent : ∀ᶠ x in 𝓝 (0 : Source 2), F (G x) = 0 := by
    rw [hg] at hvanish
    exact Filter.Germ.coe_eq.mp (congrArg (fun q : Germ 2 => q.1) hvanish)
  obtain ⟨Z, hZ, hzero⟩ :=
    g.exists_isolated_zero_neighborhood_of_isFiniteAtOrigin hf G hG hG0 hg
  obtain ⟨r, s, E, hr, hrsub, hanalytic, hE, himage⟩ :=
    g.exists_closedBall_image_equations_of_finite hf G hG hG0 hg
      (S ∩ Z ∩ {x | F (G x) = 0}) (inter_mem (inter_mem hS hZ) hvanishevent)
  have hGt : Tendsto G (𝓝 0) (𝓝 (0 : Source m)) := by
    simpa only [hG0] using hG.continuousAt.tendsto
  have hEq (k : Fin s) : g.pullbackRingHom (Germ.ofFunction (E k) (hE k)) = 0 := by
    have hevent : ∀ᶠ x in 𝓝 (0 : Source 2), E k (G x) = 0 := by
      filter_upwards [hGt.eventually himage, closedBall_mem_nhds (0 : Source 2) hr] with x hx hxball
      exact (hx.mpr ⟨x, hxball, rfl⟩) k
    rw [hg]
    apply Subtype.ext
    exact Filter.Germ.coe_eq.mpr hevent
  have hdiv (k : Fin s) : Germ.ofFunction F hF ∣ Germ.ofFunction (E k) (hE k) := by
    rw [← Ideal.mem_span_singleton, ← hker]
    exact hEq k
  have htarget : ∀ᶠ y in 𝓝 (0 : Source m), ∀ k, F y = 0 → E k y = 0 :=
    Filter.eventually_all.mpr fun k =>
      Germ.eventually_zero_imp_zero_of_dvd F (E k) hF (hE k) (hdiv k)
  refine ⟨r, hr, fun x hx => (hrsub hx).1.1, hanalytic,
    fun x hx => hzero x (hrsub hx).1.2,
    fun x hx => (hrsub hx).2, ?_⟩
  filter_upwards [himage, htarget] with y hy hzeroes
  constructor
  · intro hyF
    exact hy.mp (fun k => hzeroes k hyF)
  · rintro ⟨x, hx, rfl⟩
    exact (hrsub hx).2

/-- A finite plane germ with principal kernel admits a proper analytic
representative whose image is exactly the full zero set of its defining
equation in an open target neighborhood. -/
theorem exists_proper_representative_image_eq_zero_set_of_finite
    {m : ℕ} (g : PointedMapGerm 2 m) (hf : g.IsFiniteAtOrigin)
    (G : Source 2 → Source m) (hG : AnalyticAt ℂ G 0) (hG0 : G 0 = 0)
    (hg : g = ofFunction G hG hG0)
    (F : Source m → ℂ) (hF : AnalyticAt ℂ F 0)
    (hker : RingHom.ker g.pullbackRingHom = Ideal.span {Germ.ofFunction F hF})
    (S : Set (Source 2)) (hS : S ∈ 𝓝 0) :
    ∃ (U : Set (Source 2)) (V : Set (Source m)) (hUV : MapsTo G U V),
      IsOpen U ∧ 0 ∈ U ∧ U ⊆ S ∧ AnalyticOnNhd ℂ G U ∧
      IsOpen V ∧ 0 ∈ V ∧ AnalyticOnNhd ℂ F V ∧
      IsProperMap (hUV.restrict G U V) ∧
      G '' U = {y | y ∈ V ∧ F y = 0} := by
  obtain ⟨r, hr, hrS, hGK, hzero, hFG, himage⟩ :=
    g.exists_closedBall_image_eq_zero_set_of_finite hf G hG hG0 hg F hF hker S hS
  obtain ⟨V₀, hV₀sub, hV₀, hV₀0⟩ := _root_.mem_nhds_iff.mp
    (himage.and hF.eventually_analyticAt)
  have hW0 : (0 : Source 2) ∈ ball 0 (r / 2) := mem_ball_self (by linarith)
  have hWK : ball (0 : Source 2) (r / 2) ⊆ interior (closedBall 0 r) := by
    intro x hx
    apply ball_subset_interior_closedBall
    exact ball_subset_ball (by linarith) hx
  obtain ⟨U, V, hUV, hU, hU0, hUW, hV, hV0, hVV₀, hconfine, hp⟩ :=
    exists_proper_restriction_of_compact_unique_fibre G
      (isCompact_closedBall (0 : Source 2) r) hGK.continuousOn
      isOpen_ball hW0 hWK hV₀ hV₀0 hG0 hzero
  have hUK : U ⊆ closedBall (0 : Source 2) r :=
    fun x hx => interior_subset (hWK (hUW hx))
  refine ⟨U, V, hUV, hU, hU0, hUK.trans hrS, hGK.mono hUK,
    hV, hV0, fun y hy => (hV₀sub (hVV₀ hy)).2, hp, ?_⟩
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact ⟨hUV hx, hFG x (hUK hx)⟩
  · rintro ⟨hyV, hyF⟩
    obtain ⟨x, hx, hxy⟩ := (hV₀sub (hVV₀ hyV)).1.mp hyF
    exact ⟨x, hconfine x hx (hxy ▸ hyV), hxy⟩

/-- Every locally injective plane germ into three-space admits an
irreducible analytic equation and a proper representative which is a closed
embedding onto the entire zero set of that equation in an open target
neighborhood. -/
theorem exists_proper_closed_embedding_onto_irreducible_zero_set
    (g : PointedMapGerm 2 3) (hi : g.HasInjectiveRepresentative) :
    ∃ (F : Source 3 → ℂ) (hF : AnalyticAt ℂ F 0),
      Irreducible (Germ.ofFunction F hF) ∧ F 0 = 0 ∧
      RingHom.ker g.pullbackRingHom = Ideal.span {Germ.ofFunction F hF} ∧
      ∃ (G : Source 2 → Source 3) (hG : AnalyticAt ℂ G 0) (hG0 : G 0 = 0),
        g = ofFunction G hG hG0 ∧
        ∃ (U : Set (Source 2)) (V : Set (Source 3)) (hUV : MapsTo G U V),
          IsOpen U ∧ 0 ∈ U ∧ AnalyticOnNhd ℂ G U ∧
          IsOpen V ∧ 0 ∈ V ∧ AnalyticOnNhd ℂ F V ∧
          IsProperMap (hUV.restrict G U V) ∧
          Topology.IsClosedEmbedding (hUV.restrict G U V) ∧
          G '' U = {y | y ∈ V ∧ F y = 0} := by
  have hf := g.injective_isFiniteAtOrigin_two hi
  obtain ⟨f, hfirr, hfm, hker⟩ := g.exists_irreducible_generator_of_finite hf
  obtain ⟨F, hF, hfF⟩ := Germ.exists_analyticRepresentative_allOrders f
  rw [hfF] at hfirr hfm hker
  have hF0 : F 0 = 0 := by
    rw [Germ.mem_maximalIdeal_iff, Germ.valueRingHom_ofFunction] at hfm
    exact hfm
  obtain ⟨G, hG, hG0, hg, S, hS, hGS⟩ := hi
  obtain ⟨U, V, hUV, hU, hU0, hUS, hGU, hV, hV0, hFV, hp, himage⟩ :=
    g.exists_proper_representative_image_eq_zero_set_of_finite hf G hG hG0 hg F hF hker S hS
  refine ⟨F, hF, hfirr, hF0, hker, G, hG, hG0, hg,
    U, V, hUV, hU, hU0, hGU, hV, hV0, hFV, hp, ?_, himage⟩
  rw [Topology.IsClosedEmbedding.isClosedEmbedding_iff_continuous_injective_isClosedMap]
  refine ⟨hp.continuous, ?_, hp.isClosedMap⟩
  intro x y hxy
  apply Subtype.ext
  exact hGS (hUS x.property) (hUS y.property) (congrArg Subtype.val hxy)

end PointedMapGerm

/-- A closed embedding with the established exact image equality gives a
homeomorphism onto the hypersurface itself, with the original map as its
underlying function. -/
noncomputable def homeomorphZeroSetOfClosedEmbedding
    {n m : ℕ} (G : Source n → Source m) (F : Source m → ℂ)
    (U : Set (Source n)) (V : Set (Source m)) (hUV : MapsTo G U V)
    (hemb : Topology.IsClosedEmbedding (hUV.restrict G U V))
    (himage : G '' U = {y | y ∈ V ∧ F y = 0}) :
    U ≃ₜ {y : V | F y = 0} := by
  have hrange : Set.range (hUV.restrict G U V) = {y : V | F y = 0} := by
    ext y
    constructor
    · rintro ⟨x, rfl⟩
      have hx : G x ∈ G '' U := ⟨x, x.property, rfl⟩
      rw [himage] at hx
      exact hx.2
    · intro hy
      have hyimage : (y : Source m) ∈ G '' U := by
        rw [himage]
        exact ⟨y.property, hy⟩
      obtain ⟨x, hx, hxy⟩ := hyimage
      exact ⟨⟨x, hx⟩, Subtype.ext hxy⟩
  exact hemb.toIsEmbedding.toHomeomorph.trans (Homeomorph.setCongr hrange)

@[simp]
theorem homeomorphZeroSetOfClosedEmbedding_apply
    {n m : ℕ} (G : Source n → Source m) (F : Source m → ℂ)
    (U : Set (Source n)) (V : Set (Source m)) (hUV : MapsTo G U V)
    (hemb : Topology.IsClosedEmbedding (hUV.restrict G U V))
    (himage : G '' U = {y | y ∈ V ∧ F y = 0}) (x : U) :
    ((homeomorphZeroSetOfClosedEmbedding G F U V hUV hemb himage x :
      {y : V | F y = 0}) : Source m) = G x := rfl

end OnLeConjecture.Analytic
