module

public import OnLeConjecture.Analytic.Hadamard
public import Mathlib.LinearAlgebra.StdBasis

/-!
# Coordinate generators of the analytic maximal ideal

This file proves that the maximal ideal of the ring of analytic germs at the
origin is generated by the coordinate germs. It also defines the cotangent
space as the quotient of the maximal ideal by its square.
-/

public section

namespace OnLeConjecture.Analytic

open Filter
open scoped Topology

namespace Germ

@[simp]
theorem valueRingHom_coordinate {n : ℕ} (i : Fin n) :
    Germ.valueRingHom n (Germ.coordinate i) = 0 := by
  change Filter.Germ.value
    ((Germ.coordinate i : Germ n) : FunctionGerm n) = 0
  rw [Germ.coe_coordinate]
  exact Filter.Germ.value_ofFun (fun z : Source n ↦ z i) 0

/-- Every coordinate germ vanishes at the origin. -/
theorem coordinate_mem_maximalIdeal {n : ℕ} (i : Fin n) :
    Germ.coordinate i ∈ Germ.maximalIdeal n := by
  rw [Germ.mem_maximalIdeal_iff, Germ.valueRingHom_coordinate]

/-- A germ that vanishes at the origin is a sum of the coordinate germs with
analytic germ coefficients. -/
theorem exists_eq_sum_coordinate_mul {n : ℕ} {g : Germ n}
    (hg : g ∈ Germ.maximalIdeal n) :
    ∃ a : Fin n → Germ n, g = ∑ i, Germ.coordinate i * a i := by
  rcases g with ⟨g, hgan⟩
  induction g using Filter.Germ.inductionOn with
  | _ f =>
      rw [mem_analyticGermSubring, isAnalyticGerm_ofFun] at hgan
      rw [Germ.mem_maximalIdeal_iff] at hg
      have hf0 : f 0 = 0 := by
        change Filter.Germ.value (f : FunctionGerm n) = 0 at hg
        simpa only [Filter.Germ.value_ofFun] using hg
      rcases AnalyticAt.exists_eventuallyEq_add_apply hgan with
        ⟨A, hA, _hA_zero, hfactor⟩
      let b : Module.Basis (Fin n) ℂ (Source n) := Pi.basisFun ℂ (Fin n)
      have hcoefficient (i : Fin n) :
          AnalyticAt ℂ (fun z : Source n ↦ A z (b i)) 0 := by
        exact ((ContinuousLinearMap.apply ℂ ℂ (b i)).analyticAt (A 0)).comp hA
      let coefficient (i : Fin n) : Germ n :=
        Germ.ofFunction (fun z : Source n ↦ A z (b i)) (hcoefficient i)
      refine ⟨coefficient, ?_⟩
      apply Subtype.ext
      have hfun : (f : FunctionGerm n) =
          ((fun z : Source n ↦ ∑ i, z i * A z (b i)) : FunctionGerm n) := by
        apply Filter.Germ.coe_eq.mpr
        filter_upwards [hfactor] with z hz
        rw [hz, hf0, zero_add]
        calc
          A z z = A z (∑ i, z i • b i) := by
            congr 1
            simpa only [b, Pi.basisFun_repr] using (b.sum_repr z).symm
          _ = ∑ i, z i * A z (b i) := by
            simp only [map_sum, map_smul, smul_eq_mul]
      calc
        ((⟨(f : FunctionGerm n),
          (mem_analyticGermSubring.mpr
            ((isAnalyticGerm_ofFun f).mpr hgan))⟩ : Germ n) :
            FunctionGerm n) = (f : FunctionGerm n) := rfl
        _ = ((fun z : Source n ↦ ∑ i, z i * A z (b i)) :
            FunctionGerm n) := hfun
        _ = ((∑ i, Germ.coordinate i * coefficient i : Germ n) :
            FunctionGerm n) := by
          have hsum (s : Finset (Fin n)) :
              ((fun z : Source n ↦ ∑ i ∈ s, z i * A z (b i)) :
                FunctionGerm n) =
                  ∑ i ∈ s,
                    ((fun z : Source n ↦ z i * A z (b i)) :
                      FunctionGerm n) := by
            induction s using Finset.induction_on with
            | empty =>
                change (((fun _ : Source n ↦ (0 : ℂ)) :
                  FunctionGerm n)) = 0
                exact Filter.Germ.coe_zero
            | @insert i s his ih =>
                simp only [Finset.sum_insert his]
                rw [← ih]
                exact Filter.Germ.coe_add
                  (fun z : Source n ↦ z i * A z (b i))
                  (fun z : Source n ↦ ∑ j ∈ s, z j * A z (b j))
          rw [hsum Finset.univ]
          calc
            ∑ i, ((fun z : Source n ↦ z i * A z (b i)) :
                FunctionGerm n) =
                ∑ i, (((Germ.coordinate i * coefficient i : Germ n) :
                  FunctionGerm n)) := by
              apply Finset.sum_congr rfl
              intro i _
              have hpoint :
                  (fun z : Source n ↦ z i * A z (b i)) =
                    (fun z : Source n ↦ z i) *
                      (fun z : Source n ↦ A z (b i)) := by
                funext z
                rfl
              rw [hpoint]
              calc
                (((fun z : Source n ↦ z i) *
                  (fun z : Source n ↦ A z (b i))) : FunctionGerm n) =
                    ((fun z : Source n ↦ z i) : FunctionGerm n) *
                      ((fun z : Source n ↦ A z (b i)) :
                        FunctionGerm n) :=
                  Filter.Germ.coe_mul
                    (l := nhds (0 : Source n))
                    (fun z : Source n ↦ z i)
                    (fun z : Source n ↦ A z (b i))
                _ = ((Germ.coordinate i : Germ n) : FunctionGerm n) *
                    ((coefficient i : Germ n) : FunctionGerm n) := by
                  simp only [Germ.coe_coordinate, coefficient,
                    Germ.coe_ofFunction]
                _ = (((Germ.coordinate i * coefficient i : Germ n) :
                    FunctionGerm n)) := by
                  exact ((analyticGermSubring n).subtype.map_mul
                    (Germ.coordinate i) (coefficient i)).symm
            _ = ((∑ i, Germ.coordinate i * coefficient i : Germ n) :
                FunctionGerm n) := by
              exact (map_sum (analyticGermSubring n).subtype
                (fun i ↦ Germ.coordinate i * coefficient i)
                Finset.univ).symm

/-- The coordinate germs generate the maximal ideal of the analytic local
ring. -/
theorem span_range_coordinate_eq_maximalIdeal (n : ℕ) :
    Ideal.span (Set.range (Germ.coordinate : Fin n → Germ n)) =
      Germ.maximalIdeal n := by
  apply le_antisymm
  · rw [Ideal.span_le]
    intro x hx
    rcases hx with ⟨i, rfl⟩
    exact Germ.coordinate_mem_maximalIdeal i
  · intro g hg
    rcases Germ.exists_eq_sum_coordinate_mul hg with ⟨a, rfl⟩
    exact Submodule.sum_mem _ fun i _ ↦
      Ideal.mul_mem_right (a i) _
        (Ideal.subset_span (Set.mem_range_self i))

/-- The subspace of the maximal ideal consisting of germs in its square. -/
noncomputable def cotangentSquareSubmodule (n : ℕ) :
    Submodule ℂ (Germ.maximalIdeal n) :=
  ((Germ.maximalIdeal n ^ 2).restrictScalars ℂ).comap
    ((Germ.maximalIdeal n).subtype.restrictScalars ℂ)

/-- The cotangent space of the analytic local ring at the origin. -/
noncomputable abbrev CotangentSpace (n : ℕ) :=
  Germ.maximalIdeal n ⧸ Germ.cotangentSquareSubmodule n

/-- The class of a coordinate germ in the cotangent space. -/
noncomputable def cotangentCoordinate {n : ℕ} (i : Fin n) :
    Germ.CotangentSpace n :=
  Submodule.Quotient.mk
    ⟨Germ.coordinate i, Germ.coordinate_mem_maximalIdeal i⟩

@[simp]
theorem differential_coordinate_apply {n : ℕ} (i : Fin n)
    (v : Source n) :
    Germ.differential (Germ.coordinate i) v = v i := by
  let p : Source n →L[ℂ] ℂ :=
    ContinuousLinearMap.proj (R := ℂ)
      (φ := fun _ : Fin n ↦ ℂ) i
  have hp : AnalyticAt ℂ (fun z : Source n ↦ z i) 0 :=
    p.analyticAt 0
  have hcoordinate : Germ.coordinate i =
      Germ.ofFunction (fun z : Source n ↦ z i) hp := by
    apply Subtype.ext
    rw [Germ.coe_coordinate, Germ.coe_ofFunction]
  rw [hcoordinate, Germ.differential_ofFunction]
  change fderiv ℂ (p : Source n → ℂ) 0 v = p v
  have h : fderiv ℂ (p : Source n → ℂ) 0 = p :=
    ContinuousLinearMap.fderiv p
  exact congrArg (fun L : Source n →L[ℂ] ℂ ↦ L v) h

@[simp]
theorem differential_constRingHom (n : ℕ) (c : ℂ) :
    Germ.differential (Germ.constRingHom n c) = 0 := by
  change fderiv ℂ (fun _ : Source n ↦ c) 0 = 0
  exact congrFun (fderiv_const (𝕜 := ℂ) (E := Source n) c) 0

@[simp]
theorem differential_smul (n : ℕ) (c : ℂ) (g : Germ n) :
    Germ.differential (c • g) = c • Germ.differential g := by
  rw [Algebra.smul_def, Germ.differential_mul]
  change
    Germ.valueRingHom n (Germ.constRingHom n c) •
        Germ.differential g +
      Germ.valueRingHom n g •
        Germ.differential (Germ.constRingHom n c) =
      c • Germ.differential g
  rw [Germ.valueRingHom_const, Germ.differential_constRingHom]
  apply ContinuousLinearMap.ext
  intro v
  simp

/-- The differential at the origin as a complex linear map on analytic
germs. -/
@[expose] noncomputable def differentialLinearMap (n : ℕ) :
    Germ n →ₗ[ℂ] (Source n →L[ℂ] ℂ) where
  toFun := Germ.differential
  map_add' := Germ.differential_add
  map_smul' := Germ.differential_smul n

@[simp]
theorem differentialLinearMap_apply (n : ℕ) (g : Germ n) :
    Germ.differentialLinearMap n g = Germ.differential g :=
  rfl

@[simp]
theorem mem_cotangentSquareSubmodule {n : ℕ}
    (g : Germ.maximalIdeal n) :
    g ∈ Germ.cotangentSquareSubmodule n ↔
      (g : Germ n) ∈ Germ.maximalIdeal n ^ 2 :=
  Iff.rfl

/-- The coordinate classes in the cotangent space are linearly independent. -/
theorem cotangentCoordinate_linearIndependent (n : ℕ) :
    LinearIndependent ℂ
      (Germ.cotangentCoordinate : Fin n → Germ.CotangentSpace n) := by
  rw [Fintype.linearIndependent_iff]
  intro c hc j
  let x : Fin n → Germ.maximalIdeal n := fun i ↦
    ⟨Germ.coordinate i, Germ.coordinate_mem_maximalIdeal i⟩
  have hquotient : Submodule.Quotient.mk
      (∑ i, c i • x i) =
        (0 : Germ.CotangentSpace n) := by
    change (Germ.cotangentSquareSubmodule n).mkQ
      (∑ i, c i • x i) = 0
    rw [map_sum]
    simpa only [map_smul, Submodule.mkQ_apply,
      Germ.cotangentCoordinate, x] using hc
  have hsquare :
      ((∑ i, c i • x i : Germ.maximalIdeal n) : Germ n) ∈
        Germ.maximalIdeal n ^ 2 := by
    rw [← Germ.mem_cotangentSquareSubmodule]
    exact (Submodule.Quotient.mk_eq_zero
      (Germ.cotangentSquareSubmodule n)).mp hquotient
  have hfirst :
      ((∑ i, c i • x i : Germ.maximalIdeal n) : Germ n) ∈
        Germ.firstOrderIdeal n :=
    Germ.maximalIdeal_sq_le_firstOrderIdeal n hsquare
  have hdiff : Germ.differential
      (((∑ i, c i • x i : Germ.maximalIdeal n) : Germ n)) = 0 :=
    (Germ.mem_firstOrderIdeal_iff.mp hfirst).2
  have hcoe :
      (((∑ i, c i • x i : Germ.maximalIdeal n) : Germ n)) =
        ∑ i, c i • Germ.coordinate i := by
    change ((Germ.maximalIdeal n).subtype.restrictScalars ℂ)
      (∑ i, c i • x i) = _
    rw [map_sum]
    apply Finset.sum_congr rfl
    intro i _
    rw [map_smul]
    rfl
  rw [hcoe] at hdiff
  change Germ.differentialLinearMap n
    (∑ i, c i • Germ.coordinate i) = 0 at hdiff
  rw [map_sum] at hdiff
  have happ := congrArg
    (fun L : Source n →L[ℂ] ℂ ↦ L (Pi.single j 1)) hdiff
  simpa only [map_sum, Germ.differentialLinearMap_apply,
    Germ.differential_add,
    Germ.differential_smul, Germ.differential_coordinate_apply,
    sum_apply, smul_apply,
    Pi.single_apply, smul_eq_mul, mul_ite, mul_one, mul_zero,
    Finset.sum_ite_eq', Finset.mem_univ, if_true,
    zero_apply] using happ

/-- The cotangent class of a germ is the linear combination of the coordinate
classes whose coefficients are its directional derivatives along the standard
basis. -/
theorem cotangent_mk_eq_sum_differential (n : ℕ)
    (g : Germ.maximalIdeal n) :
    (Submodule.Quotient.mk g : Germ.CotangentSpace n) =
      ∑ i, Germ.differential (g : Germ n)
        ((Pi.basisFun ℂ (Fin n)) i) • Germ.cotangentCoordinate i := by
  let b : Module.Basis (Fin n) ℂ (Source n) := Pi.basisFun ℂ (Fin n)
  let x : Fin n → Germ.maximalIdeal n := fun i ↦
    ⟨Germ.coordinate i, Germ.coordinate_mem_maximalIdeal i⟩
  let c : Fin n → ℂ := fun i ↦
    Germ.differential (g : Germ n) (b i)
  let y : Germ.maximalIdeal n := ∑ i, c i • x i
  have hcoe : (y : Germ n) = ∑ i, c i • Germ.coordinate i := by
    change ((Germ.maximalIdeal n).subtype.restrictScalars ℂ)
      (∑ i, c i • x i) = _
    rw [map_sum]
    apply Finset.sum_congr rfl
    intro i _
    rw [map_smul]
    rfl
  have hdiff : Germ.differential (y : Germ n) =
      Germ.differential (g : Germ n) := by
    rw [hcoe]
    change Germ.differentialLinearMap n
      (∑ i, c i • Germ.coordinate i) =
        Germ.differential (g : Germ n)
    rw [map_sum]
    apply ContinuousLinearMap.ext
    intro v
    have hv : v = ∑ i, v i • b i := by
      simpa only [b, Pi.basisFun_repr] using (b.sum_repr v).symm
    calc
      (∑ i, Germ.differentialLinearMap n
          (c i • Germ.coordinate i)) v =
          ∑ i, c i * v i := by
        simp only [Germ.differentialLinearMap_apply,
          Germ.differential_smul, Germ.differential_coordinate_apply,
          sum_apply, smul_apply, smul_eq_mul]
      _ = ∑ i, v i * c i := by
        apply Finset.sum_congr rfl
        intro i _
        exact mul_comm _ _
      _ = Germ.differential (g : Germ n)
          (∑ i, v i • b i) := by
        rw [map_sum]
        simp only [map_smul, c, smul_eq_mul]
      _ = Germ.differential (g : Germ n) v := by rw [← hv]
  have hfirst : ((g - y : Germ.maximalIdeal n) : Germ n) ∈
      Germ.firstOrderIdeal n := by
    rw [Germ.mem_firstOrderIdeal_iff]
    constructor
    · exact Germ.mem_maximalIdeal_iff.mp (g - y).2
    · have hsub :
          ((g - y : Germ.maximalIdeal n) : Germ n) =
            (g : Germ n) - (y : Germ n) := by
          rfl
      rw [hsub]
      rw [← Germ.differentialLinearMap_apply]
      rw [map_sub, Germ.differentialLinearMap_apply,
        Germ.differentialLinearMap_apply, hdiff, sub_self]
  have hsquare : ((g - y : Germ.maximalIdeal n) : Germ n) ∈
      Germ.maximalIdeal n ^ 2 := by
    rw [← Germ.firstOrderIdeal_eq_maximalIdeal_sq]
    exact hfirst
  calc
    (Submodule.Quotient.mk g : Germ.CotangentSpace n) =
        Submodule.Quotient.mk y := by
      rw [Submodule.Quotient.eq (Germ.cotangentSquareSubmodule n)]
      rw [Germ.mem_cotangentSquareSubmodule]
      exact hsquare
    _ = ∑ i, c i • Germ.cotangentCoordinate i := by
      change (Germ.cotangentSquareSubmodule n).mkQ y = _
      change (Germ.cotangentSquareSubmodule n).mkQ
        (∑ i, c i • x i) = _
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro i _
      rw [map_smul]
      rfl
    _ = ∑ i, Germ.differential (g : Germ n)
        ((Pi.basisFun ℂ (Fin n)) i) •
          Germ.cotangentCoordinate i := by
      rfl

/-- The coordinate classes span the cotangent space. -/
theorem span_range_cotangentCoordinate_eq_top (n : ℕ) :
    Submodule.span ℂ
      (Set.range
        (Germ.cotangentCoordinate : Fin n → Germ.CotangentSpace n)) = ⊤ := by
  apply top_unique
  intro q _hq
  obtain ⟨g, rfl⟩ :=
    (Germ.cotangentSquareSubmodule n).mkQ_surjective q
  change (Submodule.Quotient.mk g : Germ.CotangentSpace n) ∈ _
  rw [Germ.cotangent_mk_eq_sum_differential]
  exact Submodule.sum_mem _ fun i _ ↦
    Submodule.smul_mem _ _
      (Submodule.subset_span (Set.mem_range_self i))

/-- The coordinate classes form a basis of the cotangent space. -/
noncomputable def cotangentBasis (n : ℕ) :
    Module.Basis (Fin n) ℂ (Germ.CotangentSpace n) :=
  Module.Basis.mk (Germ.cotangentCoordinate_linearIndependent n) (by
    rw [Germ.span_range_cotangentCoordinate_eq_top])

end Germ

end OnLeConjecture.Analytic
