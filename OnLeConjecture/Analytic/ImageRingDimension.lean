module

public import OnLeConjecture.Analytic.ImageRing
public import OnLeConjecture.Analytic.PlaneInjectiveFiniteness
public import OnLeConjecture.Analytic.PlaneNoetherian
public import OnLeConjecture.Analytic.FiniteDimensionalNoetherian
public import OnLeConjecture.External.TauCeti.KrullDimensionIntegral

/-!
# Dimension and equations of the analytic image ring

The image ring of a finite plane germ has Krull dimension two by
invariance of dimension under injective integral extensions. The same is
therefore true for every locally injective plane germ. Its presentation as
a quotient by the pullback kernel uses the actual target analytic germ
ring. Rückert's theorem makes every analytic image ring Noetherian. In
target dimension greater than two, the difference of dimensions forces
a nonzero equation vanishing on each finite plane image. The ideal is not
yet proved to be generated by a single equation.
-/

public section

namespace OnLeConjecture.Analytic.PointedMapGerm

/-- The target ring modulo its vanishing ideal is the analytic image ring. -/
@[expose] noncomputable def quotientKernelEquivImageRing
    {n m : ℕ} (g : PointedMapGerm n m) :
    (Germ m ⧸ RingHom.ker g.pullbackRingHom) ≃+* g.ImageRing :=
  g.pullbackRingHom.quotientKerEquivRange

/-- The ideal of target equations of an analytic map germ is prime. -/
theorem pullback_kernel_isPrime {n m : ℕ} (g : PointedMapGerm n m) :
    (RingHom.ker g.pullbackRingHom).IsPrime :=
  RingHom.ker_isPrime g.pullbackRingHom

/-- Noetherianity of the target germ ring descends to the image ring. -/
theorem imageRing_isNoetherian_of_target
    {n m : ℕ} (g : PointedMapGerm n m) [IsNoetherianRing (Germ m)] :
    IsNoetherianRing g.ImageRing :=
  isNoetherianRing_of_surjective (Germ m) g.ImageRing g.pullbackToImageRing
    g.pullbackToImageRing_surjective

/-- Rückert's theorem gives Noetherianity of every analytic image ring,
without finiteness or injectivity assumptions on the map. -/
theorem imageRing_isNoetherian {n m : ℕ} (g : PointedMapGerm n m) :
    IsNoetherianRing g.ImageRing := by
  let := Germ.isNoetherianRing_all m
  exact g.imageRing_isNoetherian_of_target

/-- The analytic image of a finite plane germ has Krull dimension two. -/
theorem imageRing_ringKrullDim_eq_two_of_finite
    {m : ℕ} (g : PointedMapGerm 2 m) (hfinite : g.IsFiniteAtOrigin) :
    ringKrullDim g.ImageRing = (2 : ℕ∞) := by
  let : Module.Finite g.ImageRing (Germ 2) := hfinite
  let : FaithfulSMul g.ImageRing (Germ 2) :=
    (faithfulSMul_iff_algebraMap_injective g.ImageRing (Germ 2)).mpr Subtype.val_injective
  rw [← TauCeti.ringKrullDim_eq_of_isIntegral_of_faithfulSMul
    (R := g.ImageRing) (S := Germ 2)]
  exact Germ.ringKrullDim_two

/-- Local injectivity supplies finiteness, hence dimension two for the image. -/
theorem imageRing_ringKrullDim_eq_two_of_injective
    {m : ℕ} (g : PointedMapGerm 2 m) (hinjective : g.HasInjectiveRepresentative) :
    ringKrullDim g.ImageRing = (2 : ℕ∞) :=
  g.imageRing_ringKrullDim_eq_two_of_finite (g.injective_isFiniteAtOrigin_two hinjective)

/-- The quotient by the actual ideal of image equations has dimension two. -/
theorem quotient_kernel_ringKrullDim_eq_two_of_injective
    {m : ℕ} (g : PointedMapGerm 2 m) (hinjective : g.HasInjectiveRepresentative) :
    ringKrullDim (Germ m ⧸ RingHom.ker g.pullbackRingHom) = (2 : ℕ∞) := by
  rw [g.quotientKernelEquivImageRing.ringKrullDim]
  exact g.imageRing_ringKrullDim_eq_two_of_injective hinjective

/-- A finite plane image in target dimension greater than two has a
nonzero ideal of target equations. -/
theorem pullback_kernel_ne_bot_of_finite_of_two_lt
    {m : ℕ} (g : PointedMapGerm 2 m) (hfinite : g.IsFiniteAtOrigin) (hm : 2 < m) :
    RingHom.ker g.pullbackRingHom ≠ ⊥ := by
  intro hker
  have hdim : ringKrullDim (Germ m ⧸ RingHom.ker g.pullbackRingHom) = (2 : ℕ∞) := by
    rw [g.quotientKernelEquivImageRing.ringKrullDim]
    exact g.imageRing_ringKrullDim_eq_two_of_finite hfinite
  rw [hker, (RingEquiv.quotientBot (Germ m)).ringKrullDim, Germ.ringKrullDim_all] at hdim
  have hlt : (2 : WithBot ℕ∞) < (m : WithBot ℕ∞) := by exact_mod_cast hm
  exact hlt.ne hdim.symm

/-- In particular an injective plane germ into three-space has a nonzero
pullback kernel in the actual analytic target ring. -/
theorem pullback_kernel_ne_bot_of_injective
    (g : PointedMapGerm 2 3) (hinjective : g.HasInjectiveRepresentative) :
    RingHom.ker g.pullbackRingHom ≠ ⊥ :=
  g.pullback_kernel_ne_bot_of_finite_of_two_lt (g.injective_isFiniteAtOrigin_two hinjective)
    (by decide)

/-- A finite plane image in a higher-dimensional target satisfies a
nonzero analytic equation vanishing at the target origin. -/
theorem exists_nonzero_vanishing_equation_of_finite_of_two_lt
    {m : ℕ} (g : PointedMapGerm 2 m) (hfinite : g.IsFiniteAtOrigin) (hm : 2 < m) :
    ∃ f : Germ m, f ≠ 0 ∧ f ∈ Germ.maximalIdeal m ∧ g.pullbackRingHom f = 0 := by
  obtain ⟨f, hf, hfne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot
    (g.pullback_kernel_ne_bot_of_finite_of_two_lt hfinite hm)
  have hzero : g.pullbackRingHom f = 0 := hf
  refine ⟨f, hfne, ?_, hzero⟩
  rw [Germ.mem_maximalIdeal_iff, ← g.valueRingHom_pullback f, hzero, map_zero]

/-- Every locally injective plane germ into three-space satisfies a
nonzero analytic target equation. -/
theorem exists_nonzero_vanishing_equation_of_injective
    (g : PointedMapGerm 2 3) (hinjective : g.HasInjectiveRepresentative) :
    ∃ f : Germ 3, f ≠ 0 ∧ f ∈ Germ.maximalIdeal 3 ∧ g.pullbackRingHom f = 0 :=
  g.exists_nonzero_vanishing_equation_of_finite_of_two_lt
    (g.injective_isFiniteAtOrigin_two hinjective) (by decide)

end OnLeConjecture.Analytic.PointedMapGerm
