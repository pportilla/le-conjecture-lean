module

public import OnLeConjecture.Analytic.LocalRing
public import OnLeConjecture.Analytic.MapGerm
public import Mathlib.Analysis.Calculus.FDeriv.Analytic
public import Mathlib.Analysis.Calculus.FDeriv.Linear
public import Mathlib.RingTheory.Ideal.Span

/-!
# Coordinate functions of analytic map germs

This file associates scalar analytic germs and their generated ideal to an
analytic map germ. For a representative

`f : ℂⁿ → ℂᵐ`,

the generated ideal is the ideal of `ℂⁿ` generated by the `m` coordinate
functions of `f`.
-/

public section

namespace OnLeConjecture.Analytic

open Filter
open scoped Topology

/-- The `i`th scalar component of an analytic map germ. -/
@[expose] noncomputable def MapGerm.component {n m : ℕ} (g : MapGerm n m)
    (i : Fin m) : Germ n := by
  refine ⟨Filter.Germ.map (fun z : Source m ↦ z i) g.1, ?_⟩
  rcases g with ⟨g, hg⟩
  change IsAnalyticGerm (Filter.Germ.map (fun z : Source m ↦ z i) g)
  induction g using Filter.Germ.inductionOn with
  | _ f =>
      rw [Filter.Germ.map_coe]
      rw [isAnalyticGerm_ofFun]
      rw [isAnalyticMapGerm_ofFun] at hg
      exact
        ((ContinuousLinearMap.proj (R := ℂ)
          (φ := fun _ : Fin m ↦ ℂ) i).analyticAt (f 0)).comp hg

@[simp]
theorem MapGerm.component_ofFunction {n m : ℕ}
    (f : Source n → Source m) (hf : AnalyticAt ℂ f 0) (i : Fin m) :
    ((MapGerm.ofFunction f hf).component i).1 =
      ((fun z ↦ f z i) : FunctionGerm n) := by
  change Filter.Germ.map (fun z : Source m ↦ z i)
    ((MapGerm.ofFunction f hf).1 : FunctionMapGerm n m) = _
  rw [MapGerm.ofFunction]
  exact Filter.Germ.map_coe _ _

@[simp]
theorem MapGerm.valueRingHom_component {n m : ℕ} (g : MapGerm n m)
    (i : Fin m) :
    Germ.valueRingHom n (g.component i) = g.valueAtOrigin i := by
  rcases g with ⟨g, hg⟩
  induction g using Filter.Germ.inductionOn with
  | _ f =>
      have hf : AnalyticAt ℂ f 0 := by
        rw [isAnalyticMapGerm_ofFun] at hg
        exact hg
      have hmap : (⟨(f : FunctionMapGerm n m), hg⟩ : MapGerm n m) =
          MapGerm.ofFunction f hf := by
        apply Subtype.ext
        rfl
      have hfi : AnalyticAt ℂ (fun z : Source n ↦ f z i) 0 := by
        exact
          ((ContinuousLinearMap.proj (R := ℂ)
            (φ := fun _ : Fin m ↦ ℂ) i).analyticAt (f 0)).comp hf
      rw [hmap]
      have hcomponent : (MapGerm.ofFunction f hf).component i =
          Germ.ofFunction (fun z ↦ f z i) hfi := by
        apply Subtype.ext
        exact MapGerm.component_ofFunction f hf i
      rw [hcomponent, Germ.valueRingHom_ofFunction]
      rfl

/-- The ideal generated by the scalar components of an analytic map germ. -/
noncomputable def MapGerm.coordinateIdeal {n m : ℕ} (g : MapGerm n m) :
    Ideal (Germ n) :=
  Ideal.span (Set.range g.component)

theorem MapGerm.component_mem_coordinateIdeal {n m : ℕ}
    (g : MapGerm n m) (i : Fin m) :
    g.component i ∈ g.coordinateIdeal := by
  exact Ideal.subset_span (Set.mem_range_self i)

theorem MapGerm.coordinateIdeal_le {n m : ℕ} (g : MapGerm n m)
    (I : Ideal (Germ n)) :
    g.coordinateIdeal ≤ I ↔ ∀ i, g.component i ∈ I := by
  rw [MapGerm.coordinateIdeal, Ideal.span_le]
  constructor
  · intro h i
    exact h (Set.mem_range_self i)
  · intro h _ hi
    obtain ⟨i, rfl⟩ := hi
    exact h i

/-- The coordinate ideal of a pointed map germ is contained in the maximal
ideal of the source analytic local ring. -/
theorem PointedMapGerm.coordinateIdeal_le_maximalIdeal {n m : ℕ}
    (g : PointedMapGerm n m) :
    g.1.coordinateIdeal ≤ Germ.maximalIdeal n := by
  rw [MapGerm.coordinateIdeal_le]
  intro i
  rw [Germ.mem_maximalIdeal_iff, MapGerm.valueRingHom_component]
  rw [g.2]
  rfl

/-- The differential of the `i`th coordinate function of a map germ. -/
@[expose] noncomputable def MapGerm.componentDifferential {n m : ℕ}
    (g : MapGerm n m) (i : Fin m) : Source n →L[ℂ] ℂ :=
  (ContinuousLinearMap.proj (R := ℂ)
    (φ := fun _ : Fin m ↦ ℂ) i) ∘L g.differential

@[simp]
theorem MapGerm.componentDifferential_apply {n m : ℕ}
    (g : MapGerm n m) (i : Fin m) (v : Source n) :
    g.componentDifferential i v = g.differential v i :=
  rfl

theorem MapGerm.componentDifferential_ofFunction {n m : ℕ}
    (f : Source n → Source m) (hf : AnalyticAt ℂ f 0) (i : Fin m) :
    (MapGerm.ofFunction f hf).componentDifferential i =
      fderiv ℂ (fun z ↦ f z i) 0 := by
  change
    (ContinuousLinearMap.proj (R := ℂ)
      (φ := fun _ : Fin m ↦ ℂ) i) ∘L fderiv ℂ f 0 = _
  rw [show (fun z ↦ f z i) =
      (ContinuousLinearMap.proj (R := ℂ)
        (φ := fun _ : Fin m ↦ ℂ) i) ∘ f by rfl]
  rw [fderiv_comp 0
    (ContinuousLinearMap.proj (R := ℂ)
      (φ := fun _ : Fin m ↦ ℂ) i).differentiableAt
    hf.differentiableAt]
  rw [ContinuousLinearMap.fderiv]

/-- A map germ has zero differential exactly when every scalar component has
zero differential. -/
theorem MapGerm.differential_eq_zero_iff {n m : ℕ} (g : MapGerm n m) :
    g.differential = 0 ↔ ∀ i, g.componentDifferential i = 0 := by
  constructor
  · intro h i
    rw [MapGerm.componentDifferential, h]
    rfl
  · intro h
    apply ContinuousLinearMap.ext
    intro v
    funext i
    have hi := congrArg (fun L : Source n →L[ℂ] ℂ ↦ L v) (h i)
    simpa using hi

end OnLeConjecture.Analytic
