module

public import OnLeConjecture.Analytic.PlaneWeierstrassPrimes
public import OnLeConjecture.PlaneCurve.Intersection

/-!
# Analytic and polynomial intersection quotients

For a distinguished monic polynomial in the first plane coordinate, analytic
Weierstrass division identifies its polynomial and analytic quotients.
The same identification holds after adjoining a second polynomial equation.
-/

public section

namespace OnLeConjecture.Analytic

private theorem comap_pair_span_of_quotient_properties
    {R S : Type*} [CommRing R] [CommRing S]
    (f : R →+* S) (p q : R)
    (hsurj : ∀ s : S, ∃ r : R, s - f r ∈ Ideal.span {f p})
    (hreflect : ∀ r : R, f r ∈ Ideal.span {f p} → r ∈ Ideal.span {p}) :
    Ideal.comap f (Ideal.span {f p, f q}) = Ideal.span {p, q} := by
  apply le_antisymm
  · intro r hr
    change f r ∈ Ideal.span {f p, f q} at hr
    obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp hr
    obtain ⟨b₀, hb₀⟩ := hsurj b
    have hfirst : f r - f b₀ * f q ∈ Ideal.span {f p} := by
      have hp := Ideal.subset_span (Set.mem_singleton (f p))
      have hsum := (Ideal.span {f p}).add_mem
        (Ideal.mul_mem_left _ a hp) (Ideal.mul_mem_right (f q) _ hb₀)
      convert hsum using 1
      rw [← hab]
      ring
    have hpre : r - b₀ * q ∈ Ideal.span {p} :=
      hreflect _ (by simpa only [map_sub, map_mul] using hfirst)
    have hle : Ideal.span ({p} : Set R) ≤ Ideal.span {p, q} := by
      apply Ideal.span_mono
      exact Set.singleton_subset_iff.mpr (Set.mem_insert p {q})
    have hq := Ideal.subset_span (show q ∈ ({p, q} : Set R) by simp)
    have hsum := (Ideal.span {p, q}).add_mem (hle hpre)
      (Ideal.mul_mem_left _ b₀ hq)
    simpa only [sub_add_cancel] using hsum
  · rw [Ideal.span_le]
    rintro x (rfl | rfl)
    · exact Ideal.subset_span (by simp)
    · exact Ideal.subset_span (by simp)

namespace Germ

/-- Polynomial evaluation at the first analytic coordinate as a complex
algebra homomorphism. -/
noncomputable def firstCoordinatePolynomialEvaluationAlgHom :
    Polynomial (Germ 1) →ₐ[ℂ] Germ 2 :=
  { firstCoordinatePolynomialEvaluationRingHom with
    commutes' := by
      intro c
      rw [Polynomial.algebraMap_apply]
      change firstCoordinatePolynomialEvaluation
          (Polynomial.C (Germ.constRingHom 1 c)) = Germ.constRingHom 2 c
      rw [firstCoordinatePolynomialEvaluation, Polynomial.eval₂_C]
      apply Subtype.ext
      rfl }

/-- The Weierstrass quotient equivalence is induced by polynomial evaluation. -/
theorem distinguishedWeierstrassQuotientRingEquiv_mk
    (d : ℕ) (P : Polynomial (Germ 1))
    (hPMonic : P.Monic) (hPDegree : P.natDegree = d + 1)
    (hPCoeff : ∀ k, k < d + 1 → P.coeff k ∈ maximalIdeal 1)
    (Q : Polynomial (Germ 1)) :
    distinguishedWeierstrassQuotientRingEquiv d P hPMonic hPDegree hPCoeff
        (Ideal.Quotient.mk (Ideal.span {P}) Q) =
      Ideal.Quotient.mk (Ideal.span {firstCoordinatePolynomialEvaluation P})
        (firstCoordinatePolynomialEvaluation Q) := rfl

/-- Every analytic germ is a polynomial in the first coordinate modulo a
distinguished Weierstrass polynomial. -/
theorem exists_polynomial_mod_distinguished
    (d : ℕ) (P : Polynomial (Germ 1))
    (hPMonic : P.Monic) (hPDegree : P.natDegree = d + 1)
    (hPCoeff : ∀ k, k < d + 1 → P.coeff k ∈ maximalIdeal 1)
    (h : Germ 2) :
    ∃ Q : Polynomial (Germ 1),
      h - firstCoordinatePolynomialEvaluation Q ∈
        Ideal.span {firstCoordinatePolynomialEvaluation P} := by
  let e := distinguishedWeierstrassQuotientRingEquiv d P hPMonic hPDegree hPCoeff
  obtain ⟨q, hq⟩ := e.surjective
    (Ideal.Quotient.mk (Ideal.span {firstCoordinatePolynomialEvaluation P}) h)
  obtain ⟨Q, rfl⟩ := Ideal.Quotient.mk_surjective q
  refine ⟨Q, ?_⟩
  rw [← Ideal.Quotient.mk_eq_mk_iff_sub_mem]
  exact hq.symm

/-- Polynomial evaluation reflects divisibility by a distinguished
Weierstrass polynomial. -/
theorem polynomial_mem_span_of_eval_mem_span_distinguished
    (d : ℕ) (P : Polynomial (Germ 1))
    (hPMonic : P.Monic) (hPDegree : P.natDegree = d + 1)
    (hPCoeff : ∀ k, k < d + 1 → P.coeff k ∈ maximalIdeal 1)
    (Q : Polynomial (Germ 1))
    (hQ : firstCoordinatePolynomialEvaluation Q ∈
      Ideal.span {firstCoordinatePolynomialEvaluation P}) :
    Q ∈ Ideal.span {P} := by
  let e := distinguishedWeierstrassQuotientRingEquiv d P hPMonic hPDegree hPCoeff
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  apply e.injective
  rw [map_zero]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr hQ

/-- Polynomial evaluation identifies the analytic and polynomial ideals
generated by a distinguished polynomial and any second polynomial. -/
theorem comap_pairIdeal_firstCoordinatePolynomialEvaluation
    (d : ℕ) (P Q : Polynomial (Germ 1))
    (hPMonic : P.Monic) (hPDegree : P.natDegree = d + 1)
    (hPCoeff : ∀ k, k < d + 1 → P.coeff k ∈ maximalIdeal 1) :
    Ideal.comap firstCoordinatePolynomialEvaluationRingHom
        (PlaneCurve.pairIdeal (firstCoordinatePolynomialEvaluation P)
          (firstCoordinatePolynomialEvaluation Q)) = Ideal.span {P, Q} := by
  exact comap_pair_span_of_quotient_properties
    firstCoordinatePolynomialEvaluationRingHom P Q
    (exists_polynomial_mod_distinguished d P hPMonic hPDegree hPCoeff)
    (polynomial_mem_span_of_eval_mem_span_distinguished d P hPMonic hPDegree hPCoeff)

/-- The actual local intersection algebra of two polynomial plane germs
agrees with their polynomial quotient if the first is distinguished monic. -/
noncomputable def distinguishedWeierstrassPairQuotientAlgEquiv
    (d : ℕ) (P Q : Polynomial (Germ 1))
    (hPMonic : P.Monic) (hPDegree : P.natDegree = d + 1)
    (hPCoeff : ∀ k, k < d + 1 → P.coeff k ∈ maximalIdeal 1) :
    (Polynomial (Germ 1) ⧸ Ideal.span {P, Q}) ≃ₐ[ℂ]
      (Germ 2 ⧸ PlaneCurve.pairIdeal (firstCoordinatePolynomialEvaluation P)
        (firstCoordinatePolynomialEvaluation Q)) := by
  let I := Ideal.span ({P, Q} : Set (Polynomial (Germ 1)))
  let J := PlaneCurve.pairIdeal (firstCoordinatePolynomialEvaluation P)
    (firstCoordinatePolynomialEvaluation Q)
  have hcomap : Ideal.comap firstCoordinatePolynomialEvaluationRingHom J = I :=
    comap_pairIdeal_firstCoordinatePolynomialEvaluation d P Q hPMonic hPDegree hPCoeff
  let F : (Polynomial (Germ 1) ⧸ I) →ₐ[ℂ] (Germ 2 ⧸ J) :=
    Ideal.quotientMapₐ J firstCoordinatePolynomialEvaluationAlgHom hcomap.ge
  apply AlgEquiv.ofBijective F
  constructor
  · exact Ideal.quotientMap_injective' (H := hcomap.ge) (fun r hr ↦ hcomap ▸ hr)
  · intro h
    obtain ⟨h, rfl⟩ := Ideal.Quotient.mk_surjective h
    obtain ⟨S, hS⟩ := exists_polynomial_mod_distinguished d P hPMonic hPDegree hPCoeff h
    refine ⟨Ideal.Quotient.mk I S, ?_⟩
    change Ideal.Quotient.mk J (firstCoordinatePolynomialEvaluation S) = Ideal.Quotient.mk J h
    apply Eq.symm
    rw [Ideal.Quotient.mk_eq_mk_iff_sub_mem]
    apply (Ideal.span_mono (show
      ({firstCoordinatePolynomialEvaluation P} : Set (Germ 2)) ⊆
        {firstCoordinatePolynomialEvaluation P, firstCoordinatePolynomialEvaluation Q} by simp)) hS

end Germ

end OnLeConjecture.Analytic
