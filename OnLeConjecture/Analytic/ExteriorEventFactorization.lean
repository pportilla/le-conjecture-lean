module

public import OnLeConjecture.Analytic.ResolutionSectionNativeChoice
public import OnLeConjecture.KnotTheory.ExteriorSignedBraid

/-!
# The event factorization of Section 3 of the proof of Statement E

Lemma `finiteProjectionEventFactorization` of the written proof of Statement E
(`statement_E_complete_proof.tex`, Section 3) is the analytic input of the combinatorial
construction of the exterior native map. This file states it as a Lean proposition,
`EventFactorizationStatement`, in the form consumed by the assembly. It is not proved here.

For an assembly `A`, a level `L` and native route choices `C`, write `S = A.squareSum`,
`N = L.points.card`, `w = C.imageWord`, and `β_j = C.factorWord j` on `a_j = C.strands j`
strands. An `EventFactorization A L C` consists of

* a number `B` of simple factors and a labelling `core : Fin (N + B) → Option (Fin N)` in which
  every singular point `j` labels exactly one factor (`core_unique`); the other `B` factors are
  simple;
* the bounds `a_j ≤ S`;
* conjugators `γ_l`, signed words on `S` strands;
* a derivation `SignedBraidConj (d_S w) (q_0 ⋯ q_{N+B-1})`, where `d_S = fullTwistWord S`, the
  factor `q_l = γ_l η_l γ_l⁻¹` has core `η_l = β_j` placed on the first `a_j` strands when
  `core l = some j`, and `η_l = σ_0` when `core l = none`;
* transitivity: the permutations of the factors generate a group acting transitively on the
  `S` strands.

`SignedBraidConj` is the equivalence relation on signed words generated by free cancellation,
far commutation, the positive braid relation and cyclic rotation
(`KnotTheory/ExteriorSignedBraid.lean`): equality in the braid group up to conjugacy. The count
`B = S - Σ_j a_j + N - 1 + μ(V)` of the written lemma is a consequence of the exponent sums and is
not part of the statement.

The written lemma also asserts the existence of the level and the projection. Only the
combinatorial output enters the statement.
-/

@[expose] public noncomputable section

namespace OnLeConjecture.Analytic

open OnLeConjecture.KnotTheory OnLeConjecture.PlaneCurve

variable {g : PointedMapGerm 2 3} {hd : g.differential = 0}
  {hi : g.HasInjectiveRepresentative}

/-- The square sum of an assembly of a germ with zero differential is at least two. -/
theorem ResolutionSectionAssembly.two_le_squareSum (A : ResolutionSectionAssembly g hd hi) :
    2 ≤ A.squareSum := by
  have := A.tree.four_le_square_sum_of_differential_eq_zero hd
  unfold ResolutionSectionAssembly.squareSum
  omega

/-- The generator `σ_0` on `S ≥ 2` strands as a signed word. -/
def firstGeneratorWord {S : ℕ} (hS : 2 ≤ S) : SignedAdjacentWord S :=
  [(⟨0, by omega⟩, 1)]

/-- **The event factorization** of Lemma `finiteProjectionEventFactorization` for an assembly,
a level and native route choices. -/
structure EventFactorization (A : ResolutionSectionAssembly g hd hi)
    (L : ResolutionSectionLevel A) (C : NativeRouteChoice A L) where
  /-- The number `B` of simple factors. -/
  simpleCount : ℕ
  /-- The core label of each factor: a singular point or `none` for the simple generator. -/
  core : Fin (L.points.card + simpleCount) → Option (Fin L.points.card)
  /-- Every singular point labels exactly one factor. -/
  core_unique : ∀ j, ∃! l, core l = some j
  /-- Every local braid fits on the `S` strands. -/
  strands_le : ∀ j, C.strands j ≤ A.squareSum
  /-- The conjugator `γ_l` of each factor. -/
  conjugator : Fin (L.points.card + simpleCount) → SignedAdjacentWord A.squareSum

namespace EventFactorization

variable {A : ResolutionSectionAssembly g hd hi} {L : ResolutionSectionLevel A}
  {C : NativeRouteChoice A L}

/-- The core `η_l` of a factor. -/
def coreWord (E : EventFactorization A L C) (l : Fin (L.points.card + E.simpleCount)) :
    SignedAdjacentWord A.squareSum :=
  match E.core l with
  | some j => liftPositiveWord (E.strands_le j) (C.factorWord j)
  | none => firstGeneratorWord A.two_le_squareSum

/-- The factor `q_l = γ_l η_l γ_l⁻¹`. -/
def factor (E : EventFactorization A L C) (l : Fin (L.points.card + E.simpleCount)) :
    SignedAdjacentWord A.squareSum :=
  conjugateWord (E.conjugator l) (E.coreWord l)

/-- The ordered product `q_0 ⋯ q_{N+B-1}`. -/
def product (E : EventFactorization A L C) : SignedAdjacentWord A.squareSum :=
  (List.ofFn E.factor).flatten

end EventFactorization

/-- An event factorization together with its derivation and transitivity: the combinatorial
output of Lemma `finiteProjectionEventFactorization`. -/
structure EventFactorizationData (A : ResolutionSectionAssembly g hd hi)
    (L : ResolutionSectionLevel A) (C : NativeRouteChoice A L)
    extends EventFactorization A L C where
  /-- The finite signed-word derivation, up to whole-word conjugacy, of
  `d_S w ∼ q_0 ⋯ q_{N+B-1}`. -/
  derivation : SignedBraidConj (fullTwistWord A.squareSum ++ C.imageWord).toSigned
    toEventFactorization.product
  /-- The factor permutations generate a transitive group on the `S` strands. -/
  transitive : ∀ x y : Fin A.squareSum, ∃ σ ∈ Subgroup.closure
    (Set.range fun l => (toEventFactorization.factor l).permutation), σ x = y

/-- **Lemma `finiteProjectionEventFactorization`** (Section 3 of the written proof of
Statement E), in the form consumed by the assembly: every locally injective germ with zero
differential has an assembly, a level, native route choices, and an event factorization of
`d_S w` into conjugates of the local words and of `σ_0`, with transitive factor
permutations. -/
def EventFactorizationStatement : Prop :=
  ∀ (g : PointedMapGerm 2 3) (hd : g.differential = 0) (hi : g.HasInjectiveRepresentative),
    ∃ (A : ResolutionSectionAssembly g hd hi) (L : ResolutionSectionLevel A)
      (C : NativeRouteChoice A L), Nonempty (EventFactorizationData A L C)

end OnLeConjecture.Analytic
