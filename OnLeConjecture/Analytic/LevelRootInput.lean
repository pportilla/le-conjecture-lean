/-!
# The projection data of a level

This module states, without a grid, the analytic inputs of Lemma
`finiteProjectionEventFactorization` (Section 3 of the written proof of Statement E,
`statement-E-complete-proof.tex`) for one level `L` of an assembly `A`, as the fields of the
structure `LevelProjectionInput A L`. Every field is a statement about the roots
`levelRoots A L h ζ c` over a disc of base values, over one circle around `0`, or over one small
circle around each critical value. The construction of a grid, of its cut system, of its clusters
and of the conjugacies of `LevelRootFamily A L` from these data is `LevelRootAssembly.lean`.

* `LevelCriticalValueData A L h ζ c`: the roots over the circle `c + r e^{iθ}` around a critical
  value `c` lie in `count` ordered vertical strips (`IsStripDecomposition`, for every base angle);
  the strip `i` is a singular cluster (`kind i = some j`: its word is the word `β_j` of the
  singular point `j`, with the factor-word identities, and `h (H (Q_j)) = c`) or carries the
  Coxeter word on its `size i` strands (an ordinary ramification of order `size i ≥ 2`, or a
  single unramified sheet when `size i = 1`). At least one strip is a cluster.
* `LevelProjectionInput A L`: linear coordinates `h, ζ`; a disc `B(0, ρ)` and a finite set `V`
  of critical values in the open square `(-a, a)²`; the root family over `B(0, ρ) \ V`; the outer
  braid over the circle of radius `ρ₂` (with `a ≤ ρ₂ √2/2` and `ρ₂ < ρ`) conjugate to `d_S w`, with
  the image-word identities; the local data at each critical value, with a punctured disc
  `B(c, R_c) \ {c}` in the regular set; each singular point occurring in exactly one strip; and the
  connectedness of the level minus the fibres over `V`, over the closed square `[-a, a]²`.
* `GridTransitivityStatement`: the topological statement that the connectedness of the total
  space of a root family over a grid rectangle minus the centers of the marked cells gives a
  transitive group generated by the monodromies of the based loops of the marked cells. It is
  proved in `LevelRootTransitive.lean`.
-/

@[expose] public noncomputable section

open Set Function Real

namespace OnLeConjecture.Analytic

open KnotTheory PlaneCurve SignedAdjacentWord

/-- The closed square `[-a, a]²`. -/
def baseSquare (a : ℝ) : Set ℂ := {z | z.re ∈ Icc (-a) a ∧ z.im ∈ Icc (-a) a}

/-- **Transitivity from connectedness.** For a root family over `U` and a grid whose marked cells
have centers `center a b` in their interiors with the punctured closed cells in `U`, if the total
space of the family over the closed grid rectangle minus the centers is preconnected, the
monodromies of the based loops of the marked cells generate a transitive group. -/
def GridTransitivityStatement : Prop :=
  ∀ (S : ℕ) (Z : ℂ → Set ℂ) (U : Set ℂ) (xs ys : ℕ → ℝ) (n : ℕ) (marked : ℕ → ℕ → Prop)
    (center : ℕ → ℕ → ℂ) (baseLabel : Fin S → ℂ),
    IsRootFamily Z S U → IsRootGrid U xs ys n marked →
    (∀ a < n, ∀ b < n, marked a b → center a b ∈ gridCellInterior xs ys a b ∧
      gridCell xs ys a b \ {center a b} ⊆ U) →
    Injective baseLabel → range baseLabel = Z (gridPoint xs ys 0 0) →
    IsPreconnected {q : ℂ × ℂ | (q.1.re ∈ Icc (xs 0) (xs n) ∧ q.1.im ∈ Icc (ys 0) (ys n)) ∧
      (∀ a < n, ∀ b < n, marked a b → q.1 ≠ center a b) ∧ q.2 ∈ Z q.1} →
    ∀ x y : Fin S, ∃ τ ∈ Subgroup.closure
      {τ : Equiv.Perm (Fin S) | ∃ a b, marked a b ∧ ∃ K : Fin S → ℝ → ℂ,
        IsRootLabellingOn Z (polygonPath (basedLoop xs ys a b)) (Icc 0 (basedLength a b : ℝ)) K ∧
        (∀ k, K k 0 = baseLabel k) ∧ ∀ k, K k (basedLength a b) = baseLabel (τ k)}, τ x = y

variable {g : PointedMapGerm 2 3} {hd : g.differential = 0}
  {hi : g.HasInjectiveRepresentative}

/-- **The roots around a critical value `c`**, over the circle `c + r e^{iθ}`, decomposed into
ordered vertical strips. -/
structure LevelCriticalValueData (A : ResolutionSectionAssembly g hd hi)
    (L : ResolutionSectionLevel A) (baseCoord fibreCoord : Source 3 →L[ℂ] ℂ) (c : ℂ) where
  /-- The radius `R_c` of a punctured disc around `c` of regular values. -/
  discRadius : ℝ
  /-- The radius `r` of the circle. -/
  circleRadius : ℝ
  circleRadius_pos : 0 < circleRadius
  circleRadius_lt : circleRadius < discRadius
  /-- The number of strips. -/
  count : ℕ
  /-- The strip `i` is `edge i < Re < edge (i + 1)`. -/
  edge : ℕ → ℝ
  /-- The number of roots in the strip `i`. -/
  size : ℕ → ℕ
  /-- The word of the strip `i`. -/
  word : ∀ i, PositiveAdjacentWord (size i)
  strips : ∀ b : ℝ, IsStripDecomposition (levelRoots A L baseCoord fibreCoord)
    (fun θ => c + circlePath circleRadius θ) b (b + 2 * π) count edge size word
  /-- The singular point of the strip `i`, if it is a singular cluster. -/
  kind : ℕ → Option (Fin L.points.card)
  kind_singular : ∀ i < count, ∀ j, kind i = some j →
    2 ≤ size i ∧ size i ≤ (g.criticalJacobianFactorization hi).maxMultiplicity ∧
    (word i).toSigned.cycleCount = 1 ∧ (word i).toSigned.generatorIndices = Finset.univ ∧
    (word i).length + 1 = 2 * deltaInvariant (localSectionEquation A.H (L.point j)) + size i ∧
    baseCoord (A.H (L.point j)) = c
  kind_none : ∀ i < count, kind i = none → word i = coxeterWord (size i)
  nontrivial : ∃ i < count, kind i ≠ none ∨ 2 ≤ size i

/-- **The projection data of a level**, without a grid. -/
structure LevelProjectionInput (A : ResolutionSectionAssembly g hd hi)
    (L : ResolutionSectionLevel A) where
  /-- The base coordinate `h`. -/
  baseCoord : Source 3 →L[ℂ] ℂ
  /-- The fibre coordinate `ζ`. -/
  fibreCoord : Source 3 →L[ℂ] ℂ
  coordinates : Injective fun y : Source 3 => (y 0, baseCoord y, fibreCoord y)
  /-- The radius `ρ` of the disc of base values. -/
  radius : ℝ
  /-- The critical values `V`. -/
  critical : Finset ℂ
  rootFamily : IsRootFamily (levelRoots A L baseCoord fibreCoord) A.squareSum
    (Metric.ball 0 radius \ ↑critical)
  /-- The half side `a` of the square containing the critical values. -/
  square : ℝ
  square_pos : 0 < square
  critical_mem : ∀ c ∈ critical, c.re ∈ Ioo (-square) square ∧ c.im ∈ Ioo (-square) square
  /-- The radius `ρ₂` of the outer circle. -/
  outerRadius : ℝ
  square_le : square ≤ outerRadius * (√2 / 2)
  outerRadius_lt : outerRadius < radius
  /-- The image word `w`. -/
  imageWord : PositiveAdjacentWord A.squareSum
  imageWord_cycleCount : imageWord.toSigned.cycleCount = irreducibleBranchCount A.imageEquation
  imageWord_length : imageWord.length + A.squareSum * (A.squareSum - 1) +
      irreducibleBranchCount A.imageEquation = 2 * deltaInvariant A.imageEquation + A.squareSum
  /-- The outer braid is conjugate to `d_S w`. -/
  outer : ∀ (b : ℝ) (K : Fin A.squareSum → ℝ → ℂ),
    IsRootLabellingOn (levelRoots A L baseCoord fibreCoord) (circlePath outerRadius)
      (Icc b (b + 2 * π)) K →
    ∀ W, IsPathWord K b (b + 2 * π) W →
      SignedBraidConj W (fullTwistWord A.squareSum ++ imageWord).toSigned
  /-- The local data at each critical value. -/
  atCritical : ∀ c : critical, LevelCriticalValueData A L baseCoord fibreCoord c
  disc_subset : ∀ c : critical, Metric.ball (c : ℂ) (atCritical c).discRadius ⊆
    Metric.ball 0 radius
  disc_isolated : ∀ c : critical, ∀ c' ∈ critical,
    c' ∈ Metric.ball (c : ℂ) (atCritical c).discRadius → c' = c
  /-- Every singular point occurs in exactly one strip. -/
  singular_unique : ∀ j : Fin L.points.card, ∃! p : (Σ _ : critical, ℕ),
    p.2 < (atCritical p.1).count ∧ (atCritical p.1).kind p.2 = some j
  /-- The level minus the fibres over the critical values, over the closed square, is
  connected. -/
  connected : IsPreconnected {x | x ∈ Metric.ball (0 : Source 2) L.radius ∧
    A.H x 0 = L.parameter ∧ baseCoord (A.H x) ∈ baseSquare square \ ↑critical}

/-- **The projection data of the levels**: every locally injective germ with zero differential
has an assembly and a level with projection data. -/
def LevelProjectionStatement : Prop :=
  ∀ (g : PointedMapGerm 2 3) (hd : g.differential = 0) (hi : g.HasInjectiveRepresentative),
    ∃ (A : ResolutionSectionAssembly g hd hi) (L : ResolutionSectionLevel A),
      Nonempty (LevelProjectionInput A L)

/-! ### Splitting the projection data -/

/-- **The setup of the projection of a level**: the coordinates, the disc of base values, the
critical values, the square and the outer circle. The analytic fields of `LevelProjectionInput`
are the four propositions `RootFamilyHolds`, `OuterHolds`, `CriticalHolds`, `ConnectedHolds`
about one setup. -/
structure LevelProjectionSetup (A : ResolutionSectionAssembly g hd hi)
    (L : ResolutionSectionLevel A) where
  baseCoord : Source 3 →L[ℂ] ℂ
  fibreCoord : Source 3 →L[ℂ] ℂ
  coordinates : Injective fun y : Source 3 => (y 0, baseCoord y, fibreCoord y)
  radius : ℝ
  critical : Finset ℂ
  square : ℝ
  square_pos : 0 < square
  critical_mem : ∀ c ∈ critical, c.re ∈ Ioo (-square) square ∧ c.im ∈ Ioo (-square) square
  outerRadius : ℝ
  square_le : square ≤ outerRadius * (√2 / 2)
  outerRadius_lt : outerRadius < radius

namespace LevelProjectionSetup

variable {A : ResolutionSectionAssembly g hd hi} {L : ResolutionSectionLevel A}
  (P : LevelProjectionSetup A L)

/-- The roots of the level for the coordinates of the setup. -/
abbrev roots : ℂ → Set ℂ := levelRoots A L P.baseCoord P.fibreCoord

/-- (A) The roots form a root family of `S` points over `B(0, ρ) \ V`. -/
def RootFamilyHolds : Prop :=
  IsRootFamily P.roots A.squareSum (Metric.ball 0 P.radius \ ↑P.critical)

/-- (B) The outer braid, over the circle of radius `ρ₂`, is conjugate to `d_S w` for an image
word `w` with the identities of `NativeRouteChoice`. -/
def OuterHolds : Prop :=
  ∃ w : PositiveAdjacentWord A.squareSum,
    w.toSigned.cycleCount = irreducibleBranchCount A.imageEquation ∧
    w.length + A.squareSum * (A.squareSum - 1) + irreducibleBranchCount A.imageEquation =
      2 * deltaInvariant A.imageEquation + A.squareSum ∧
    ∀ (b : ℝ) (K : Fin A.squareSum → ℝ → ℂ),
      IsRootLabellingOn P.roots (circlePath P.outerRadius) (Icc b (b + 2 * π)) K →
      ∀ W, IsPathWord K b (b + 2 * π) W →
        SignedBraidConj W (fullTwistWord A.squareSum ++ w).toSigned

/-- (C) The strip data at the critical values, with punctured discs of regular values and every
singular point in exactly one strip. -/
def CriticalHolds : Prop :=
  ∃ atCritical : ∀ c : P.critical, LevelCriticalValueData A L P.baseCoord P.fibreCoord c,
    (∀ c : P.critical, Metric.ball (c : ℂ) (atCritical c).discRadius ⊆ Metric.ball 0 P.radius) ∧
    (∀ c : P.critical, ∀ c' ∈ P.critical,
      c' ∈ Metric.ball (c : ℂ) (atCritical c).discRadius → c' = c) ∧
    ∀ j : Fin L.points.card, ∃! p : (Σ _ : P.critical, ℕ),
      p.2 < (atCritical p.1).count ∧ (atCritical p.1).kind p.2 = some j

/-- (D) The level minus the fibres over the critical values, over the closed square, is
connected. -/
def ConnectedHolds : Prop :=
  IsPreconnected {x | x ∈ Metric.ball (0 : Source 2) L.radius ∧
    A.H x 0 = L.parameter ∧ P.baseCoord (A.H x) ∈ baseSquare P.square \ ↑P.critical}

/-- The four propositions about one setup give the projection data. -/
theorem nonempty_levelProjectionInput (h₁ : P.RootFamilyHolds) (h₂ : P.OuterHolds)
    (h₃ : P.CriticalHolds) (h₄ : P.ConnectedHolds) : Nonempty (LevelProjectionInput A L) := by
  obtain ⟨w, hw₁, hw₂, hw₃⟩ := h₂
  obtain ⟨atCritical, hc₁, hc₂, hc₃⟩ := h₃
  exact ⟨{ baseCoord := P.baseCoord
           fibreCoord := P.fibreCoord
           coordinates := P.coordinates
           radius := P.radius
           critical := P.critical
           rootFamily := h₁
           square := P.square
           square_pos := P.square_pos
           critical_mem := P.critical_mem
           outerRadius := P.outerRadius
           square_le := P.square_le
           outerRadius_lt := P.outerRadius_lt
           imageWord := w
           imageWord_cycleCount := hw₁
           imageWord_length := hw₂
           outer := hw₃
           atCritical := atCritical
           disc_subset := hc₁
           disc_isolated := hc₂
           singular_unique := hc₃
           connected := h₄ }⟩

end LevelProjectionSetup

/-- **The projection data of the levels, split**: every locally injective germ with zero
differential has an assembly, a level and a setup satisfying the four propositions. -/
def LevelProjectionSetupStatement : Prop :=
  ∀ (g : PointedMapGerm 2 3) (hd : g.differential = 0) (hi : g.HasInjectiveRepresentative),
    ∃ (A : ResolutionSectionAssembly g hd hi) (L : ResolutionSectionLevel A)
      (P : LevelProjectionSetup A L),
      P.RootFamilyHolds ∧ P.OuterHolds ∧ P.CriticalHolds ∧ P.ConnectedHolds

theorem levelProjectionStatement_of_setup (h : LevelProjectionSetupStatement) :
    LevelProjectionStatement := by
  intro g hd hi
  obtain ⟨A, L, P, h₁, h₂, h₃, h₄⟩ := h g hd hi
  exact ⟨A, L, P.nonempty_levelProjectionInput h₁ h₂ h₃ h₄⟩

end OnLeConjecture.Analytic
