module

public import OnLeConjecture.Analytic.Coordinates
public import OnLeConjecture.Analytic.OneVariable
public import Mathlib.RingTheory.DiscreteValuationRing.Basic

/-!
# Order of vanishing for analytic germs in one variable

The coordinate germ is a uniformizer of the ring of analytic germs in one
complex variable. The corresponding additive valuation records the order of
vanishing of every germ.
-/

public section

namespace OnLeConjecture.Analytic

namespace Germ

/-- The coordinate germ in one variable is nonzero. -/
theorem coordinate_zero_ne_zero : Germ.coordinate (0 : Fin 1) ≠ 0 := by
  intro h
  have hd := congrArg Germ.differential h
  have happ := congrArg
    (fun L : Source 1 →L[ℂ] ℂ ↦ L (Pi.single (0 : Fin 1) 1)) hd
  simp at happ

/-- The analytic maximal ideal in one variable is generated by the coordinate
germ. -/
theorem maximalIdeal_one_eq_span_coordinate :
    Germ.maximalIdeal 1 =
      Ideal.span {Germ.coordinate (0 : Fin 1)} := by
  rw [← Germ.span_range_coordinate_eq_maximalIdeal]
  congr 1
  ext q
  constructor
  · rintro ⟨i, rfl⟩
    simp only [Fin.eq_zero, Set.mem_singleton_iff]
  · intro hq
    rw [Set.mem_singleton_iff] at hq
    subst q
    exact ⟨0, rfl⟩

/-- The ring of analytic germs in one variable is a discrete valuation ring. -/
noncomputable instance instIsDiscreteValuationRingOne :
    IsDiscreteValuationRing (Germ 1) where
  not_a_field' := by
    rw [← IsLocalRing.eq_maximalIdeal
      (Germ.maximalIdeal_isMaximal 1)]
    rw [Germ.maximalIdeal_one_eq_span_coordinate]
    exact (Ideal.span_singleton_eq_bot.not.mpr
      Germ.coordinate_zero_ne_zero)

/-- The coordinate germ is a uniformizer of the analytic discrete valuation
ring in one variable. -/
theorem coordinate_zero_irreducible :
    Irreducible (Germ.coordinate (0 : Fin 1)) := by
  apply IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal
    (Germ.coordinate (0 : Fin 1)) Germ.coordinate_zero_ne_zero
  rw [← IsLocalRing.eq_maximalIdeal
    (Germ.maximalIdeal_isMaximal 1)]
  exact Germ.maximalIdeal_one_eq_span_coordinate

/-- The order of vanishing of an analytic germ in one variable. The zero germ
has order `⊤`. -/
noncomputable def vanishingOrder : Germ 1 → ℕ∞ :=
  IsDiscreteValuationRing.addVal (Germ 1)

@[simp]
theorem vanishingOrder_zero : vanishingOrder 0 = ⊤ :=
  IsDiscreteValuationRing.addVal_zero

@[simp]
theorem vanishingOrder_one : vanishingOrder 1 = 0 :=
  IsDiscreteValuationRing.addVal_one

@[simp]
theorem vanishingOrder_coordinate :
    vanishingOrder (Germ.coordinate (0 : Fin 1)) = 1 :=
  IsDiscreteValuationRing.addVal_uniformizer
    Germ.coordinate_zero_irreducible

@[simp]
theorem vanishingOrder_eq_top_iff {q : Germ 1} :
    vanishingOrder q = ⊤ ↔ q = 0 :=
  IsDiscreteValuationRing.addVal_eq_top_iff

/-- The order of a product is the sum of the orders. -/
theorem vanishingOrder_mul (q r : Germ 1) :
    vanishingOrder (q * r) = vanishingOrder q + vanishingOrder r :=
  IsDiscreteValuationRing.addVal_mul

/-- The order of a power is the corresponding multiple of the order. -/
theorem vanishingOrder_pow (q : Germ 1) (n : ℕ) :
    vanishingOrder (q ^ n) = n • vanishingOrder q :=
  IsDiscreteValuationRing.addVal_pow q n

@[simp]
theorem vanishingOrder_coordinate_pow (n : ℕ) :
    vanishingOrder (Germ.coordinate (0 : Fin 1) ^ n) = n :=
  Germ.coordinate_zero_irreducible.addVal_pow n

/-- A germ is a unit exactly when its order is zero. -/
theorem vanishingOrder_eq_zero_iff_isUnit {q : Germ 1} :
    vanishingOrder q = 0 ↔ IsUnit q :=
  IsDiscreteValuationRing.addVal_eq_zero_iff

/-- Divisibility of germs is equivalent to the order inequality. -/
theorem vanishingOrder_le_iff_dvd {q r : Germ 1} :
    vanishingOrder q ≤ vanishingOrder r ↔ q ∣ r :=
  IsDiscreteValuationRing.addVal_le_iff_dvd

/-- A factorization by a coordinate power determines the order. -/
theorem vanishingOrder_eq_of_eq_coordinate_pow_mul_unit
    {q u : Germ 1} {n : ℕ} (hu : IsUnit u)
    (hq : q = Germ.coordinate (0 : Fin 1) ^ n * u) :
    vanishingOrder q = n := by
  rcases hu with ⟨u, rfl⟩
  rw [hq, mul_comm]
  exact IsDiscreteValuationRing.addVal_def'
    u Germ.coordinate_zero_irreducible n

/-- The exponent in a factorization by a coordinate power and a unit is
unique. -/
theorem coordinate_pow_mul_unit_exponent_unique
    {q u v : Germ 1} {m n : ℕ} (hu : IsUnit u) (hv : IsUnit v)
    (hm : q = Germ.coordinate (0 : Fin 1) ^ m * u)
    (hn : q = Germ.coordinate (0 : Fin 1) ^ n * v) :
    m = n := by
  have hmOrder :=
    Germ.vanishingOrder_eq_of_eq_coordinate_pow_mul_unit hu hm
  have hnOrder :=
    Germ.vanishingOrder_eq_of_eq_coordinate_pow_mul_unit hv hn
  exact ENat.natCast_inj.mp (hmOrder.symm.trans hnOrder)

/-- Every nonzero germ has a unique order and a factorization by the
corresponding coordinate power and a unit. -/
theorem exists_unique_order_and_unit_factorization {q : Germ 1}
    (hq : q ≠ 0) :
    ∃! n : ℕ, ∃ u : Germ 1, IsUnit u ∧
      q = Germ.coordinate (0 : Fin 1) ^ n * u := by
  rcases Germ.exists_eq_coordinate_pow_mul_unit hq with
    ⟨n, u, hu, hqu⟩
  refine ⟨n, ⟨u, hu, hqu⟩, ?_⟩
  intro m hm
  rcases hm with ⟨v, hv, hqv⟩
  exact Germ.coordinate_pow_mul_unit_exponent_unique
    hv hu hqv hqu

/-- The `n`th power of the analytic maximal ideal is generated by the `n`th
power of the coordinate germ. -/
theorem maximalIdeal_one_pow_eq_span_coordinate_pow (n : ℕ) :
    Germ.maximalIdeal 1 ^ n =
      Ideal.span {Germ.coordinate (0 : Fin 1) ^ n} := by
  rw [Germ.maximalIdeal_one_eq_span_coordinate,
    Ideal.span_singleton_pow]

/-- Membership in a power of the analytic maximal ideal is characterized by
the order of vanishing. -/
theorem mem_maximalIdeal_one_pow_iff {q : Germ 1} {n : ℕ} :
    q ∈ Germ.maximalIdeal 1 ^ n ↔
      (n : ℕ∞) ≤ vanishingOrder q := by
  rw [Germ.maximalIdeal_one_pow_eq_span_coordinate_pow,
    Ideal.mem_span_singleton, ← Germ.vanishingOrder_le_iff_dvd,
    Germ.vanishingOrder_coordinate_pow]

end Germ

end OnLeConjecture.Analytic
