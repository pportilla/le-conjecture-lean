module

public import OnLeConjecture.Analytic.DoublePointGerms
public import OnLeConjecture.Analytic.IsolatedFiber
public import OnLeConjecture.External.LocalComplexGeometry.Nullstellensatz.Main

/-!
# Nilpotence of coordinate differences on the analytic double-point germ

Local injectivity makes the common zero set of the equations
`g(x) = g(y)` lie in the diagonal. The local analytic Nullstellensatz
therefore puts a positive power of each coordinate difference in the
ideal generated by the component differences.
-/

@[expose] public noncomputable section

open Filter
open scoped Topology

namespace OnLeConjecture.Analytic.PointedMapGerm

/-- For an injective analytic germ, a positive power of each diagonal
coordinate equation is an analytic combination of the equal-image equations. -/
theorem exists_coordinate_difference_pow_eq_sum_of_injective
    {n m : ℕ} (g : PointedMapGerm n m) (hi : g.HasInjectiveRepresentative)
    (i : Fin n) :
    ∃ N : ℕ, 0 < N ∧ ∃ H : Fin m → Germ (n + n),
      ((firstProjection n n).scalarPullback (Germ.coordinate i) -
        (secondProjection n n).scalarPullback (Germ.coordinate i)) ^ N =
      ∑ j, H j * ((firstProjection n n).scalarPullback (g.1.component j) -
        (secondProjection n n).scalarPullback (g.1.component j)) := by
  obtain ⟨F, hF, hF0, rfl, s, hs, hinj⟩ := hi
  let L := coordinateSelectionLinear (Fin.castAdd n : Fin n → Fin (n + n))
  let R := coordinateSelectionLinear (Fin.natAdd n : Fin n → Fin (n + n))
  let A : Fin m → Source (n + n) → ℂ := fun j z ↦ F (L z) j - F (R z) j
  let B : Source (n + n) → ℂ := fun z ↦ L z i - R z i
  have hL : AnalyticAt ℂ (F ∘ L) 0 := hF.comp_of_eq (L.analyticAt 0) (map_zero L)
  have hR : AnalyticAt ℂ (F ∘ R) 0 := hF.comp_of_eq (R.analyticAt 0) (map_zero R)
  have hA : ∀ j, AnalyticAt ℂ (A j) 0 := fun j ↦
    (analyticAt_pi_iff.mp hL j).sub (analyticAt_pi_iff.mp hR j)
  have hB : AnalyticAt ℂ B 0 :=
    (analyticAt_pi_iff.mp (L.analyticAt 0) i).sub
      (analyticAt_pi_iff.mp (R.analyticAt 0) i)
  have hz : ∀ᶠ z in 𝓝 (0 : Source (n + n)), (∀ j, A j z = 0) → B z = 0 := by
    have hLs : ∀ᶠ z in 𝓝 (0 : Source (n + n)), L z ∈ s :=
      L.continuous.tendsto' 0 0 (map_zero L) hs
    have hRs : ∀ᶠ z in 𝓝 (0 : Source (n + n)), R z ∈ s :=
      R.continuous.tendsto' 0 0 (map_zero R) hs
    filter_upwards [hLs, hRs] with z hzL hzR ha
    have heq : F (L z) = F (R z) := funext fun j ↦ sub_eq_zero.mp (ha j)
    exact sub_eq_zero.mpr (congrFun (hinj hzL hzR heq) i)
  obtain ⟨N, hN, H, hH, heq⟩ :=
    LocalComplexGeometry.localAnalyticNullstellensatz_core hA hB hz
  refine ⟨N, hN, fun j ↦ Germ.ofFunction (H j) (hH j), ?_⟩
  have hleft : (firstProjection n n).scalarPullback (Germ.coordinate i) -
      (secondProjection n n).scalarPullback (Germ.coordinate i) = Germ.ofFunction B hB := by
    rfl
  have hright (j : Fin m) :
      (firstProjection n n).scalarPullback ((ofFunction F hF hF0).1.component j) -
      (secondProjection n n).scalarPullback ((ofFunction F hF hF0).1.component j) =
        Germ.ofFunction (A j) (hA j) := by
    rfl
  rw [hleft]
  simp_rw [hright]
  apply Subtype.ext
  simp only [Subring.coe_pow, AddSubmonoidClass.coe_finsetSum, Subring.coe_mul]
  change (B : FunctionGerm (n + n)) ^ N =
    ∑ j, (H j : FunctionGerm (n + n)) * (A j : FunctionGerm (n + n))
  have hsum := map_sum (Filter.Germ.coeRingHom (𝓝 (0 : Source (n + n))))
    (fun j ↦ H j * A j) Finset.univ
  simp only [map_mul] at hsum
  rw [← Filter.Germ.coe_pow]
  calc
    ((B ^ N : Source (n + n) → ℂ) : FunctionGerm (n + n)) =
        ((∑ j, H j * A j : Source (n + n) → ℂ) : FunctionGerm (n + n)) :=
      Filter.Germ.coe_eq.mpr (by
        filter_upwards [heq] with z hz
        simpa only [Finset.sum_apply, Pi.mul_apply, Pi.pow_apply] using hz)
    _ = _ := hsum

end OnLeConjecture.Analytic.PointedMapGerm
