module

public import OnLeConjecture.Analytic.ImageConductor
public import OnLeConjecture.Analytic.FiniteParametricMorse

/-!
# The image conductor and the ideal of Jacobian minors

For a plane map, the square of every conductor element belongs to the
ideal generated by the coordinate Jacobian minors. The proof uses the
chain rule for arbitrary target germs and the determinant identity for
the three image germs `q`, `q*x`, and `q*y`.
-/

public section

namespace OnLeConjecture.Analytic.PointedMapGerm

open OnLeConjecture.Analytic.Germ

/-- The conductor of the analytic image ring, as an ideal of the source ring. -/
@[expose] noncomputable def imageConductor {n m : ℕ} (g : PointedMapGerm n m) :
    Ideal (Germ n) where
  carrier := {q | ∀ a : Germ n, q * a ∈ g.ImageRing}
  zero_mem' := by intro a; simp
  add_mem' := by
    intro p q hp hq a
    simpa only [add_mul] using g.ImageRing.add_mem (hp a) (hq a)
  smul_mem' := by
    intro r q hq a
    change (r * q) * a ∈ g.ImageRing
    simpa only [mul_left_comm, mul_assoc] using hq (r * a)

@[simp] theorem mem_imageConductor_iff {n m : ℕ} (g : PointedMapGerm n m)
    (q : Germ n) : q ∈ g.imageConductor ↔ ∀ a : Germ n, q * a ∈ g.ImageRing := Iff.rfl

theorem imageConductor_mem_imageRing {n m : ℕ} (g : PointedMapGerm n m)
    {q : Germ n} (hq : q ∈ g.imageConductor) : q ∈ g.ImageRing := by
  simpa only [mul_one] using hq 1

/-- The conductor of a locally injective plane germ is nonzero. -/
theorem imageConductor_ne_bot_of_injective_two {m : ℕ} (g : PointedMapGerm 2 m)
    (hi : g.HasInjectiveRepresentative) : g.imageConductor ≠ ⊥ := by
  obtain ⟨q, hq, _, h⟩ := g.exists_nonzero_conductor_element_of_injective_two hi
  intro hz
  exact hq (by simpa only [← mem_imageConductor_iff, hz, Submodule.mem_bot] using h)

/-- The ideal generated by all two-by-two coordinate minors of a plane map. -/
@[expose] noncomputable def coordinateMinorIdeal {m : ℕ} (g : PointedMapGerm 2 m) :
    Ideal (Germ 2) :=
  Ideal.span (Set.range (fun ij : Fin m × Fin m =>
    jacobian (g.1.component ij.1) (g.1.component ij.2)))

theorem coordinate_jacobian_mem_coordinateMinorIdeal {m : ℕ}
    (g : PointedMapGerm 2 m) (i j : Fin m) :
    jacobian (g.1.component i) (g.1.component j) ∈ g.coordinateMinorIdeal :=
  Ideal.subset_span (Set.mem_range_self (i, j))

/-- The chain rule expresses every pullback Jacobian in the coordinate minors. -/
theorem jacobian_pullbacks_eq_sum {m : ℕ} (g : PointedMapGerm 2 m)
    (p q : Germ m) :
    jacobian (g.pullbackRingHom p) (g.pullbackRingHom q) =
      ∑ i : Fin m, ∑ j : Fin m,
        (g.pullbackRingHom (partialDerivative i p) *
          g.pullbackRingHom (partialDerivative j q)) *
            jacobian (g.1.component i) (g.1.component j) := by
  classical
  simp only [jacobian_eq, pullbackRingHom_apply, partialDerivative_compPointed_sum]
  calc
    _ = ∑ i : Fin m, ∑ j : Fin m,
        ((compPointed (partialDerivative i p) g * partialDerivative 0 (g.1.component i)) *
          (compPointed (partialDerivative j q) g * partialDerivative 1 (g.1.component j)) -
        (compPointed (partialDerivative i p) g * partialDerivative 1 (g.1.component i)) *
          (compPointed (partialDerivative j q) g * partialDerivative 0 (g.1.component j))) := by
      simp only [Finset.sum_sub_distrib, Finset.sum_mul, Finset.mul_sum]
      congr 1 <;> exact Finset.sum_comm
    _ = _ := by
      apply Finset.sum_congr rfl
      intro i _
      apply Finset.sum_congr rfl
      intro j _
      ring

theorem jacobian_pullbacks_mem_coordinateMinorIdeal {m : ℕ}
    (g : PointedMapGerm 2 m) (p q : Germ m) :
    jacobian (g.pullbackRingHom p) (g.pullbackRingHom q) ∈ g.coordinateMinorIdeal := by
  rw [g.jacobian_pullbacks_eq_sum]
  apply Ideal.sum_mem
  intro i _
  apply Ideal.sum_mem
  intro j _
  exact Ideal.mul_mem_left _ _ (g.coordinate_jacobian_mem_coordinateMinorIdeal i j)

theorem jacobian_mem_coordinateMinorIdeal_of_mem_imageRing {m : ℕ}
    (g : PointedMapGerm 2 m) {p q : Germ 2}
    (hp : p ∈ g.ImageRing) (hq : q ∈ g.ImageRing) :
    jacobian p q ∈ g.coordinateMinorIdeal := by
  obtain ⟨p, rfl⟩ := hp
  obtain ⟨q, rfl⟩ := hq
  exact g.jacobian_pullbacks_mem_coordinateMinorIdeal p q

/-- A conductor square belongs to the actual ideal of coordinate minors. -/
theorem sq_mem_coordinateMinorIdeal_of_mem_imageConductor {m : ℕ}
    (g : PointedMapGerm 2 m) {q : Germ 2} (hq : q ∈ g.imageConductor) :
    q ^ 2 ∈ g.coordinateMinorIdeal := by
  have hid : q ^ 2 =
      jacobian (q * coordinate 0) (q * coordinate 1) -
        coordinate 0 * jacobian q (q * coordinate 1) +
        coordinate 1 * jacobian q (q * coordinate 0) := by
    simp only [jacobian_eq, partialDerivative_mul,
      partialDerivative_coordinate_same,
      partialDerivative_coordinate_ne (by decide : (0 : Fin 2) ≠ 1),
      partialDerivative_coordinate_ne (by decide : (1 : Fin 2) ≠ 0)]
    ring
  rw [hid]
  have hq0 := hq (coordinate 0)
  have hq1 := hq (coordinate 1)
  have hq' := g.imageConductor_mem_imageRing hq
  exact g.coordinateMinorIdeal.add_mem (g.coordinateMinorIdeal.sub_mem
    (g.jacobian_mem_coordinateMinorIdeal_of_mem_imageRing hq0 hq1)
    (Ideal.mul_mem_left _ _
      (g.jacobian_mem_coordinateMinorIdeal_of_mem_imageRing hq' hq1)))
    (Ideal.mul_mem_left _ _
      (g.jacobian_mem_coordinateMinorIdeal_of_mem_imageRing hq' hq0))

/-- The conductor is contained in the radical of the coordinate-minor ideal. -/
theorem imageConductor_le_radical_coordinateMinorIdeal {m : ℕ}
    (g : PointedMapGerm 2 m) : g.imageConductor ≤ g.coordinateMinorIdeal.radical := by
  intro q hq
  exact ⟨2, g.sq_mem_coordinateMinorIdeal_of_mem_imageConductor hq⟩

/-- Every common divisor of the coordinate minors divides every conductor square. -/
theorem dvd_conductor_sq_of_dvd_coordinate_minors {m : ℕ}
    (g : PointedMapGerm 2 m) (d : Germ 2)
    (hd : ∀ i j, d ∣ jacobian (g.1.component i) (g.1.component j))
    {q : Germ 2} (hq : q ∈ g.imageConductor) : d ∣ q ^ 2 := by
  have hle : g.coordinateMinorIdeal ≤ Ideal.span {d} := by
    apply Ideal.span_le.mpr
    rintro _ ⟨⟨i, j⟩, rfl⟩
    exact Ideal.mem_span_singleton.mpr (hd i j)
  exact Ideal.mem_span_singleton.mp
    (hle (g.sq_mem_coordinateMinorIdeal_of_mem_imageConductor hq))

end OnLeConjecture.Analytic.PointedMapGerm
