/-!
# Delta invariants of a coordinate plane section and of its image

Let `g : (ℂ², 0) → (ℂ³, 0)` be locally injective, let `v = g₀` be its first
component, and suppose that the source curve `V = {v = 0}` is reduced. Its
image `W` lies in the coordinate plane `x₀ = 0` and has the reduced
equation `w` constructed in `SectionImageFactorization`.

Write `B = ℂ{u₀, u₁}` and let `A = g^* ℂ{x₀, x₁, x₂}` be the analytic image
ring, a complex subspace of `B`. The source branches of `V` and their
images in `W` have the same injective parametrizations up to composition
with `g`. Hence the normalization of `V` also normalizes `W`, and

`δ(W) = δ(V) + dim_ℂ B/(A + v B)`.

The quotient `B/(A + v B)` is the fibre `M/vM` of the normalization defect
`M = B/A`. The proof uses the codimension tower for the composite of the
branch pullbacks with `g^*`, and division by the first target coordinate
to replace the plane pullbacks by the full image ring.

Applied to the map recentered at a point `x` of a representative where the
level set of `v` is smooth, the same identity computes the delta invariant
of the actual image germ at `g(x)` as the local normalization defect at
`x`. That image germ is irreducible. An irreducible plane germ is smooth
exactly when its delta invariant vanishes.

The sum of these local defects over a nearby level set is not treated here.
-/

@[expose] public section

namespace OnLeConjecture.DeltaLinearAlgebra

open Module

variable {K X V : Type*} [Field K] [AddCommGroup X] [Module K X] [AddCommGroup V] [Module K V]

/-- Finite codimension of `L(B)` gives finite codimension of the range of
`L` and of `B ⊔ ker L`. -/
theorem finiteDimensional_of_finiteDimensional_quotient_map (L : X →ₗ[K] V)
    (B : Submodule K X) (h : FiniteDimensional K (V ⧸ B.map L)) :
    FiniteDimensional K (V ⧸ LinearMap.range L) ∧
      FiniteDimensional K (X ⧸ (B ⊔ LinearMap.ker L)) := by
  have hle : B.map L ≤ LinearMap.range L := by
    rintro _ ⟨x, -, rfl⟩
    exact ⟨x, rfl⟩
  let A := B.map L
  refine ⟨Module.Finite.of_surjective (Submodule.factor hle) (Submodule.factor_surjective hle),
    ?_⟩
  have hker : LinearMap.ker (A.mkQ ∘ₗ L) = B ⊔ LinearMap.ker L := by
    rw [LinearMap.ker_comp, Submodule.ker_mkQ, Submodule.comap_map_eq]
  exact Module.Finite.equiv ((Submodule.quotEquivOfEq _ _ hker.symm).trans
    (A.mkQ ∘ₗ L).quotKerEquivRange).symm

end OnLeConjecture.DeltaLinearAlgebra

namespace OnLeConjecture.Analytic

open Filter
open scoped Topology
open OnLeConjecture.Analytic.Germ PlaneCurve Module UniqueFactorizationMonoid

/-- The joint kernel of injective parametrizations of pairwise
non-associated irreducible equations is generated by their product. -/
theorem ker_pi_pullbackAlgHom_eq {ι : Type*} [Fintype ι] (p : ι → Germ 2)
    (hp : ∀ i, Irreducible (p i)) (hpij : ∀ i j, i ≠ j → ¬ Associated (p i) (p j))
    (γ : ι → PointedMapGerm 1 2) (hγ : ∀ i, (γ i).IsInjectiveParametrizationOf (p i)) :
    LinearMap.ker (LinearMap.pi fun i => (γ i).pullbackAlgHom.toLinearMap) =
      (Ideal.span {∏ i, p i}).restrictScalars ℂ := by
  classical
  ext h
  rw [LinearMap.mem_ker, Submodule.restrictScalars_mem, Ideal.mem_span_singleton]
  constructor
  · intro hz
    apply Finset.prod_dvd_of_isRelPrime
    · intro i _ j _ hij
      apply (hp i).isRelPrime_iff_not_dvd.mpr
      intro hd
      rcases (hp j).dvd_iff.mp hd with hu | hass
      · exact (hp i).not_isUnit hu
      · exact hpij i j hij hass.symm
    · intro i _
      rw [← Ideal.mem_span_singleton,
        ← parametrization_kernel_eq_span_singleton (p i) (hp i) (γ i) (hγ i).2.1 (hγ i).2.2]
      exact congrFun hz i
  · intro hdvd
    funext i
    obtain ⟨c, rfl⟩ := (Finset.dvd_prod_of_mem p (Finset.mem_univ i)).trans hdvd
    change (γ i).pullbackRingHom (p i * c) = 0
    rw [map_mul, (hγ i).2.1, zero_mul]

/-- A squarefree plane germ with one branch is irreducible. -/
theorem irreducible_of_squarefree_of_irreducibleBranchCount_eq_one {w : Germ 2}
    (hsq : Squarefree w) (hb : irreducibleBranchCount w = 1) : Irreducible w := by
  classical
  have hne : Associates.mk w ≠ 0 := Associates.mk_ne_zero.mpr hsq.ne_zero
  have hnodup := (squarefree_iff_nodup_normalizedFactors hne).mp (squarefree_associates_mk hsq)
  have hcard : Multiset.card (normalizedFactors (Associates.mk w)) = 1 := by
    rw [← Multiset.toFinset_card_of_nodup hnodup]
    rw [irreducibleBranchCount] at hb
    convert hb
  obtain ⟨a, ha⟩ := Multiset.card_eq_one.mp hcard
  have hprod := prod_normalizedFactors hne
  rw [ha, Multiset.prod_singleton] at hprod
  have hirr : Irreducible a :=
    irreducible_of_normalized_factor a (by rw [ha]; exact Multiset.mem_singleton_self a)
  rw [← Associates.irreducible_mk, ← associated_iff_eq.mp hprod]
  exact hirr

/-- An irreducible plane germ with vanishing delta invariant is smooth. -/
theorem not_mem_maximalIdeal_sq_of_deltaInvariant_eq_zero {w : Germ 2} (hw : Irreducible w)
    (hδ : deltaInvariant w = 0) : w ∉ maximalIdeal 2 ^ 2 := by
  have hmem := irreducible_mem_maximalIdeal w hw
  have hformula := jacobianColength_add_irreducibleBranchCount hmem hw.squarefree
  rw [hδ, irreducibleBranchCount_eq_one_of_irreducible w hw] at hformula
  have hμ : finrank ℂ (Germ 2 ⧸ jacobianIdeal w) = 0 := by omega
  have hfin : Module.Finite ℂ (Germ 2 ⧸ jacobianIdeal w) :=
    hasFiniteJacobianAlgebra_of_squarefree w hmem hw.squarefree
  have hsub : Subsingleton (Germ 2 ⧸ jacobianIdeal w) := Module.finrank_zero_iff.mp hμ
  have htop : jacobianIdeal w = ⊤ := by
    rw [← Ideal.Quotient.subsingleton_iff]
    exact hsub
  intro hsq
  have hfirst := (mem_firstOrderIdeal_iff.mp ((maximalIdeal_sq_le_firstOrderIdeal 2) hsq)).2
  have hpartial : ∀ i : Fin 2, partialDerivative i w ∈ maximalIdeal 2 :=
    (differential_eq_zero_iff_partialDerivatives_mem_maximalIdeal w).mp hfirst
  have hle : jacobianIdeal w ≤ maximalIdeal 2 := by
    rw [jacobianIdeal, pairIdeal, Ideal.span_le]
    intro q hq
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hq
    rcases hq with rfl | rfl
    · exact hpartial 0
    · exact hpartial 1
  rw [htop] at hle
  exact (maximalIdeal_isMaximal 2).ne_top (top_le_iff.mp hle)

namespace SectionImageFactorization

variable {g : PointedMapGerm 2 3} (D : SectionImageFactorization g)

include D in
theorem squarefree_component_zero : Squarefree (g.1.component 0) := by
  classical
  apply D.sourceAssociated.squarefree_iff.mp
  apply Finset.squarefree_prod_of_pairwise_isCoprime
  · intro i _ j _ hij
    apply (D.sourceIrreducible i).isRelPrime_iff_not_dvd.mpr
    intro hd
    rcases (D.sourceIrreducible j).dvd_iff.mp hd with hu | hass
    · exact (D.sourceIrreducible i).not_isUnit hu
    · exact D.sourceNonassociated i j hij hass.symm
  · intro i _
    exact (D.sourceIrreducible i).squarefree

theorem irreducibleBranchCount_component_zero :
    irreducibleBranchCount (g.1.component 0) = Fintype.card D.branches := by
  classical
  rw [← irreducibleBranchCount_eq_of_associated D.sourceAssociated,
    irreducibleBranchCount_prod_of_pairwise_finite]
  · simp only [fun i : D.branches =>
      irreducibleBranchCount_eq_one_of_irreducible _ (D.sourceIrreducible i),
      Finset.sum_const, Finset.card_univ, smul_eq_mul, mul_one]
  · intro i _ j _ hij
    apply hasFiniteIntersection_of_irreducible_not_dvd _ _ (D.sourceIrreducible i)
    intro hd
    rcases (D.sourceIrreducible j).dvd_iff.mp hd with hu | hass
    · exact (D.sourceIrreducible i).not_isUnit hu
    · exact D.sourceNonassociated i j hij hass.symm

theorem irreducibleBranchCount_imageEquation (hg : g.HasInjectiveRepresentative) :
    irreducibleBranchCount D.imageEquation = Fintype.card D.branches := by
  classical
  rw [imageEquation, irreducibleBranchCount_prod_of_pairwise_finite]
  · simp only [fun i : D.branches =>
      irreducibleBranchCount_eq_one_of_irreducible _ (D.imageIrreducible i),
      Finset.sum_const, Finset.card_univ, smul_eq_mul, mul_one]
  · intro i _ j _ hij
    apply hasFiniteIntersection_of_irreducible_not_dvd _ _ (D.imageIrreducible i)
    intro hd
    rcases (D.imageIrreducible j).dvd_iff.mp hd with hu | hass
    · exact (D.imageIrreducible i).not_isUnit hu
    · exact D.image_nonassociated hg i j hij hass.symm

/-- The plane pullbacks and the full image ring give the same subspace
modulo the section equation. -/
theorem range_plane_sup_span_eq :
    LinearMap.range (g.pullbackAlgHom.toLinearMap ∘ₗ
        (hyperplaneTailGerm 2).pullbackAlgHom.toLinearMap) ⊔
      (Ideal.span {g.1.component 0}).restrictScalars ℂ =
    LinearMap.range g.pullbackAlgHom.toLinearMap ⊔
      (Ideal.span {g.1.component 0}).restrictScalars ℂ := by
  apply le_antisymm
  · exact sup_le_sup_right (LinearMap.range_comp_le_range _ _) _
  · refine sup_le ?_ le_sup_right
    rintro _ ⟨h, rfl⟩
    obtain ⟨⟨q, r⟩, hqr, -⟩ := exists_unique_firstCoordinate_division (n := 2) h
    rw [Submodule.mem_sup]
    refine ⟨g.pullbackRingHom (hyperplaneExtension 2 r), ⟨r, rfl⟩,
      g.1.component 0 * g.pullbackRingHom q,
      Ideal.mem_span_singleton.mpr (dvd_mul_right _ _), ?_⟩
    change _ = g.pullbackRingHom h
    rw [hqr, map_add, map_mul, PointedMapGerm.pullback_coordinate]
    change _ = _ + g.pullbackRingHom ((hyperplaneTailGerm 2).pullbackRingHom r)
    rw [← hyperplaneExtension]
    ring

/-- **Delta invariant of the image of a reduced coordinate section.**
For locally injective `g` with reduced section `V = {g₀ = 0}` and reduced
image equation `w = D.imageEquation`, the quotient `B/(A + g₀ B)` of
`B = ℂ{u₀, u₁}` by the image ring `A` and the section equation is finite
dimensional, `δ(W) = δ(V) + dim_ℂ B/(A + g₀ B)`, and `V` and `W` have the
same number of branches. -/
theorem finiteDimensional_and_deltaInvariant_imageEquation
    (hg : g.HasInjectiveRepresentative) :
    FiniteDimensional ℂ (Germ 2 ⧸ (LinearMap.range g.pullbackAlgHom.toLinearMap ⊔
        (Ideal.span {g.1.component 0}).restrictScalars ℂ)) ∧
      deltaInvariant D.imageEquation = deltaInvariant (g.1.component 0) +
        finrank ℂ (Germ 2 ⧸ (LinearMap.range g.pullbackAlgHom.toLinearMap ⊔
          (Ideal.span {g.1.component 0}).restrictScalars ℂ)) ∧
      irreducibleBranchCount D.imageEquation = irreducibleBranchCount (g.1.component 0) := by
  classical
  let p : D.branches → Germ 2 := fun i => (i : Germ 2)
  let γ := D.parametrization
  let β : D.branches → PointedMapGerm 1 2 := fun i => g.sectionBranch (γ i)
  have hγ : ∀ i, (γ i).IsInjectiveParametrizationOf (p i) := fun i =>
    ⟨D.parametrizationInjective i, D.sourceAnnihilates i,
      (γ i).exists_nonzero_coordinate_pullback_of_injective_curve (D.parametrizationInjective i)⟩
  have hβ : ∀ i, (β i).IsInjectiveParametrizationOf (D.equation i) := fun i =>
    ⟨D.image_injective hg i, D.imageAnnihilates i,
      (β i).exists_nonzero_coordinate_pullback_of_injective_curve (D.image_injective hg i)⟩
  have hpij : ∀ i j, Associated (p i) (p j) → i = j := fun i j h => by
    by_contra hne
    exact D.sourceNonassociated i j hne h
  have hqij : ∀ i j, Associated (D.equation i) (D.equation j) → i = j := fun i j h => by
    by_contra hne
    exact D.image_nonassociated hg i j hne h
  have hδv := finrank_eq_deltaInvariant (squarefree_component_zero D) p D.sourceIrreducible hpij
    D.sourceAssociated γ hγ
  have hδw := finrank_eq_deltaInvariant (D.imageEquation_squarefree hg) D.equation
    D.imageIrreducible hqij (Associated.refl _) β hβ
  obtain ⟨ew⟩ := nonempty_normalizationQuotient_equiv (D.imageEquation_squarefree hg) D.equation
    D.imageIrreducible hqij (Associated.refl _) β hβ
  have := finiteDimensional_normalizationQuotient D.imageEquation
  have hfdw := ew.symm.finiteDimensional
  let L := LinearMap.pi fun i => (γ i).pullbackAlgHom.toLinearMap
  let P := g.pullbackAlgHom.toLinearMap ∘ₗ (hyperplaneTailGerm 2).pullbackAlgHom.toLinearMap
  have hcomp : (LinearMap.pi fun i => (β i).pullbackAlgHom.toLinearMap) = L ∘ₗ P := by
    refine LinearMap.ext fun h => funext fun i => ?_
    change (g.sectionBranch (γ i)).pullbackRingHom h =
      (γ i).pullbackRingHom (g.pullbackRingHom ((hyperplaneTailGerm 2).pullbackRingHom h))
    rw [PointedMapGerm.sectionBranch, PointedMapGerm.pullbackRingHom_comp,
      PointedMapGerm.pullbackRingHom_comp]
    rfl
  have hrange : LinearMap.range (LinearMap.pi fun i => (β i).pullbackAlgHom.toLinearMap) =
      (LinearMap.range P).map L := by
    rw [hcomp, LinearMap.range_comp]
  have hker : LinearMap.ker L = (Ideal.span {g.1.component 0}).restrictScalars ℂ := by
    rw [ker_pi_pullbackAlgHom_eq p D.sourceIrreducible D.sourceNonassociated γ hγ,
      Ideal.span_singleton_eq_span_singleton.mpr D.sourceAssociated]
  rw [hrange] at hfdw
  obtain ⟨hfdL, hfdX⟩ :=
    DeltaLinearAlgebra.finiteDimensional_of_finiteDimensional_quotient_map L _ hfdw
  obtain ⟨-, htower⟩ := DeltaLinearAlgebra.finiteDimensional_and_finrank_quotient_map L
    (LinearMap.range P) hfdL hfdX
  rw [hker, range_plane_sup_span_eq] at hfdX htower
  refine ⟨hfdX, ?_, ?_⟩
  · rw [← hδw, ← hδv, hrange, htower]
  · rw [D.irreducibleBranchCount_imageEquation hg, D.irreducibleBranchCount_component_zero]

/-- Nonsingular case: if the image ring is all of `B`, the image of the
section has the same delta invariant as the section. -/
theorem deltaInvariant_imageEquation_eq_of_pullback_surjective
    (hg : g.HasInjectiveRepresentative) (hsurj : Function.Surjective g.pullbackRingHom) :
    deltaInvariant D.imageEquation = deltaInvariant (g.1.component 0) := by
  obtain ⟨-, h, -⟩ := D.finiteDimensional_and_deltaInvariant_imageEquation hg
  have htop : LinearMap.range g.pullbackAlgHom.toLinearMap ⊔
      (Ideal.span {g.1.component 0}).restrictScalars ℂ = ⊤ := by
    rw [eq_top_iff]
    intro b _
    obtain ⟨a, rfl⟩ := hsurj b
    exact Submodule.mem_sup_left ⟨a, rfl⟩
  rw [h, htop, finrank_zero_of_subsingleton, add_zero]

end SectionImageFactorization


namespace PointedMapGerm

/-- Nakayama over the image ring: if the image ring and the section
equation together span the source ring, every source germ is a pullback. -/
theorem pullback_surjective_of_range_sup_span_eq_top (g : PointedMapGerm 2 3)
    (hf : g.IsFiniteAtOrigin)
    (h : LinearMap.range g.pullbackAlgHom.toLinearMap ⊔
      (Ideal.span {g.1.component 0}).restrictScalars ℂ = ⊤) :
    Function.Surjective g.pullbackRingHom := by
  let _ : Module.Finite g.ImageRing (Germ 2) := hf
  let v : g.ImageRing := g.pullbackToImageRing (coordinate 0)
  let I : Ideal g.ImageRing := Ideal.span {v}
  have hjac : I ≤ (⊥ : Ideal g.ImageRing).jacobson := by
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_jacobson_bot]
    intro y
    obtain ⟨q, rfl⟩ := g.pullbackToImageRing_surjective y
    rw [← map_mul, ← map_one g.pullbackToImageRing, ← map_add]
    apply IsUnit.map
    apply isUnit_of_valueRingHom_ne_zero
    rw [map_add, map_mul, map_one, mem_maximalIdeal_iff.mp (coordinate_mem_maximalIdeal 0),
      zero_mul, zero_add]
    exact one_ne_zero
  let N : Submodule g.ImageRing (Germ 2) := LinearMap.range (Algebra.linearMap g.ImageRing (Germ 2))
  have hle : (⊤ : Submodule g.ImageRing (Germ 2)) ≤ N ⊔ I • ⊤ := by
    intro b _
    have hb : b ∈ LinearMap.range g.pullbackAlgHom.toLinearMap ⊔
        (Ideal.span {g.1.component 0}).restrictScalars ℂ := by
      rw [h]
      trivial
    obtain ⟨_, ⟨q, rfl⟩, z, hz, rfl⟩ := Submodule.mem_sup.mp hb
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hz
    apply Submodule.add_mem_sup
    · exact ⟨g.pullbackToImageRing q, rfl⟩
    · have hvc : c * g.1.component 0 = v • c := by
        change _ = g.pullbackRingHom (coordinate 0) * c
        rw [pullback_coordinate, mul_comm]
      rw [hvc]
      exact Submodule.smul_mem_smul (Ideal.mem_span_singleton_self v) Submodule.mem_top
  have htop := Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top hjac hle
  intro b
  obtain ⟨a, ha⟩ := htop Submodule.mem_top
  obtain ⟨q, rfl⟩ := g.pullbackToImageRing_surjective a
  exact ⟨q, ha⟩

/-- For a finite germ, the fibre `B/(A + g₀ B)` of the normalization
defect vanishes exactly when every source germ is a pullback. -/
theorem range_sup_span_eq_top_iff (g : PointedMapGerm 2 3) (hf : g.IsFiniteAtOrigin) :
    LinearMap.range g.pullbackAlgHom.toLinearMap ⊔
        (Ideal.span {g.1.component 0}).restrictScalars ℂ = ⊤ ↔
      Function.Surjective g.pullbackRingHom := by
  refine ⟨g.pullback_surjective_of_range_sup_span_eq_top hf, fun hsurj => ?_⟩
  rw [eq_top_iff]
  intro b _
  obtain ⟨a, rfl⟩ := hsurj b
  exact Submodule.mem_sup_left ⟨a, rfl⟩

end PointedMapGerm

/-- The first component of a recentered map is singular-free at the
origin when the first component of the differential is nonzero. -/
theorem recenter_component_zero_not_mem_sq (G : Source 2 → Source 3) (x : Source 2)
    (hG : AnalyticAt ℂ G x) (hsmooth : ∃ z : Source 2, fderiv ℂ G x z 0 ≠ 0) :
    (PointedMapGerm.recenterOfFunction G x hG).1.component 0 ∉ maximalIdeal 2 ^ 2 := by
  intro hmem
  have hfirst := (mem_firstOrderIdeal_iff.mp ((maximalIdeal_sq_le_firstOrderIdeal 2) hmem)).2
  obtain ⟨z, hz⟩ := hsmooth
  apply hz
  have hscalar : (PointedMapGerm.recenterOfFunction G x hG).differential z 0 =
      Germ.differential ((PointedMapGerm.recenterOfFunction G x hG).1.component 0) z := by
    rw [MapGerm.germDifferential_component, MapGerm.componentDifferential_apply]
    rfl
  rw [← PointedMapGerm.differential_recenterOfFunction G x hG, hscalar, hfirst]
  rfl

/-- **Delta invariant of the actual image at a smooth point of a level
set.** Let `G` be an analytic representative, injective on a neighbourhood
`S` of `x`, with `d(G₀)_x ≠ 0`. Then the level set `{G₀ = G₀(x)}` is smooth at
`x`, and there is a reduced equation `w` in the plane `{x₀ = G₀(x)}`,
recentred at `G(x)`, such that:
* `w` is irreducible;
* the local defect `B/(A_x + (G₀ - G₀(x)) B)` is finite dimensional and
  `δ(w)` equals its dimension;
* `w` is smooth exactly when `dG_x` is injective;
* for every analytic representative `W` of `w`, the zero set of `W` near the
  origin is exactly the translated image under `G` of the level set in an
  arbitrarily small closed ball around `x`. -/
theorem exists_recentered_section_image_delta (G : Source 2 → Source 3) (x : Source 2)
    (hG : AnalyticAt ℂ G x) (S : Set (Source 2)) (hS : S ∈ 𝓝 x) (hinj : Set.InjOn G S)
    (hsmooth : ∃ z : Source 2, fderiv ℂ G x z 0 ≠ 0) :
    ∃ D : SectionImageFactorization (PointedMapGerm.recenterOfFunction G x hG),
      Irreducible D.imageEquation ∧
      FiniteDimensional ℂ (Germ 2 ⧸
        (LinearMap.range (PointedMapGerm.recenterOfFunction G x hG).pullbackAlgHom.toLinearMap ⊔
          (Ideal.span {(PointedMapGerm.recenterOfFunction G x hG).1.component 0}).restrictScalars
            ℂ)) ∧
      deltaInvariant D.imageEquation =
        finrank ℂ (Germ 2 ⧸
          (LinearMap.range (PointedMapGerm.recenterOfFunction G x hG).pullbackAlgHom.toLinearMap ⊔
            (Ideal.span {(PointedMapGerm.recenterOfFunction G x hG).1.component 0}).restrictScalars
              ℂ)) ∧
      (D.imageEquation ∉ maximalIdeal 2 ^ 2 ↔ Function.Injective (fderiv ℂ G x)) ∧
      ∀ (W : Source 2 → ℂ) (hW : AnalyticAt ℂ W 0), D.imageEquation = ofFunction W hW →
        ∀ T ∈ 𝓝 (0 : Source 2), ∃ r : ℝ, 0 < r ∧ Metric.closedBall (0 : Source 2) r ⊆ T ∧
          ∀ᶠ y in 𝓝 (0 : Source 2), W y = 0 ↔
            ∃ z ∈ Metric.closedBall (0 : Source 2) r,
              G (x + z) - G x = hyperplaneInclusion 2 y := by
  let g := PointedMapGerm.recenterOfFunction G x hG
  have hg : g.HasInjectiveRepresentative :=
    PointedMapGerm.recenter_hasInjectiveRepresentative G x hG S hS hinj
  have hvmem : g.1.component 0 ∈ maximalIdeal 2 :=
    g.coordinateIdeal_le_maximalIdeal (g.1.component_mem_coordinateIdeal 0)
  have hvn := recenter_component_zero_not_mem_sq G x hG hsmooth
  have hvirr := (smooth_irreducible_of_mem_maximalIdeal_not_mem_sq _ hvmem hvn).2
  obtain ⟨D⟩ := g.exists_sectionImageFactorization hg hvirr.squarefree
  obtain ⟨hfd, hδ, hb⟩ := D.finiteDimensional_and_deltaInvariant_imageEquation hg
  rw [deltaInvariant_eq_zero_of_order_one hvmem hvn, zero_add] at hδ
  have hirr : Irreducible D.imageEquation :=
    irreducible_of_squarefree_of_irreducibleBranchCount_eq_one (D.imageEquation_squarefree hg)
      (hb.trans (irreducibleBranchCount_eq_one_of_irreducible _ hvirr))
  have hsmoothIff : D.imageEquation ∉ maximalIdeal 2 ^ 2 ↔ deltaInvariant D.imageEquation = 0 :=
    ⟨fun hsm => deltaInvariant_eq_zero_of_order_one (irreducible_mem_maximalIdeal _ hirr) hsm,
      not_mem_maximalIdeal_sq_of_deltaInvariant_eq_zero hirr⟩
  have hdefect : deltaInvariant D.imageEquation = 0 ↔ Function.Injective (fderiv ℂ G x) := by
    rw [hδ, ← PointedMapGerm.differential_recenterOfFunction G x hG,
      PointedMapGerm.differential_injective_iff_pullback_surjective g,
      ← PointedMapGerm.range_sup_span_eq_top_iff g
        (PointedMapGerm.injective_isFiniteAtOrigin_two g hg),
      Module.finrank_zero_iff, Submodule.Quotient.subsingleton_iff]
  refine ⟨D, hirr, hfd, hδ, hsmoothIff.trans hdefect, fun W hW hWeq T hT => ?_⟩
  obtain ⟨r, hr, hrT, -, hiff⟩ := D.exists_closedBall_section_image_eq_zero_set hg
    (fun z => G (x + z) - G x) _ _ rfl W hW hWeq T hT
  exact ⟨r, hr, hrT, hiff⟩

namespace SectionImageFactorization

/-- Positivity of the central defect. The image of the section has
strictly larger delta invariant than the section exactly when `g` is not an
immersion at the origin. -/
theorem deltaInvariant_lt_iff_not_injective_differential
    {g : PointedMapGerm 2 3} (D : SectionImageFactorization g) (hg : g.HasInjectiveRepresentative) :
    deltaInvariant (g.1.component 0) < deltaInvariant D.imageEquation ↔
      ¬ Function.Injective g.differential := by
  obtain ⟨hfd, hδ, -⟩ := D.finiteDimensional_and_deltaInvariant_imageEquation hg
  have key : finrank ℂ (Germ 2 ⧸ (LinearMap.range g.pullbackAlgHom.toLinearMap ⊔
      (Ideal.span {g.1.component 0}).restrictScalars ℂ)) = 0 ↔
      LinearMap.range g.pullbackAlgHom.toLinearMap ⊔
        (Ideal.span {g.1.component 0}).restrictScalars ℂ = ⊤ := by
    rw [Module.finrank_zero_iff, Submodule.Quotient.subsingleton_iff]
  rw [hδ, PointedMapGerm.differential_injective_iff_pullback_surjective,
    ← PointedMapGerm.range_sup_span_eq_top_iff g
      (PointedMapGerm.injective_isFiniteAtOrigin_two g hg), ← key]
  constructor <;> intro h <;> omega

/-- Under the zero-differential hypothesis, the central defect is positive. -/
theorem deltaInvariant_lt_of_differential_eq_zero
    {g : PointedMapGerm 2 3} (D : SectionImageFactorization g) (hg : g.HasInjectiveRepresentative)
    (h0 : g.differential = 0) :
    deltaInvariant (g.1.component 0) < deltaInvariant D.imageEquation := by
  rw [D.deltaInvariant_lt_iff_not_injective_differential hg, h0]
  intro hinj
  have h := @hinj (Pi.single 0 1) 0 (by simp)
  have h1 := congrFun h 0
  simp at h1


end SectionImageFactorization

