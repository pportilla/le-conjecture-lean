module

public import OnLeConjecture.Analytic.PlaneFiniteBirationalDegree
public import OnLeConjecture.Analytic.PolynomialCoordinates
public import Mathlib.RingTheory.Nakayama

/-!
# Coordinate generation for finite analytic map germs

For a finite analytic map germ, the source germ ring is generated as an
algebra over the image ring by the source coordinate germs. Polynomial jets
give generation modulo the image maximal ideal. Nakayama's lemma upgrades
this to exact generation.

For a plane source, it follows that distinct generic field embeddings differ
on at least one source coordinate.
-/

public section

namespace OnLeConjecture.Analytic

namespace PointedMapGerm

/-- Every polynomial in the source coordinates belongs to the algebra
generated by those coordinates over the image ring. -/
theorem coordinatePolynomial_mem_coordinateAdjoin
    {n m : ℕ} (f : PointedMapGerm n m)
    (p : MvPolynomial (Fin n) ℂ) :
    Germ.coordinatePolynomialAlgHom n p ∈
      Algebra.adjoin f.ImageRing (Set.range Germ.coordinate) := by
  induction p using MvPolynomial.induction_on with
  | C c =>
      let a : f.ImageRing :=
        f.pullbackToImageRing (Germ.constRingHom m c)
      have ha : algebraMap f.ImageRing (Germ n) a =
          Germ.constRingHom n c := by
        change (a : Germ n) = Germ.constRingHom n c
        simp only [a, coe_pullbackToImageRing,
          PointedMapGerm.pullback_constRingHom]
      rw [Germ.coordinatePolynomialAlgHom_C, ← ha]
      exact (Algebra.adjoin f.ImageRing
        (Set.range Germ.coordinate)).algebraMap_mem a
  | add p q hp hq =>
      rw [map_add]
      exact (Algebra.adjoin f.ImageRing
        (Set.range Germ.coordinate)).add_mem hp hq
  | mul_X p i hp =>
      rw [map_mul, Germ.coordinatePolynomialAlgHom_X]
      apply (Algebra.adjoin f.ImageRing
        (Set.range Germ.coordinate)).mul_mem hp
      exact Algebra.subset_adjoin (Set.mem_range_self i)

/-- A finite analytic source germ ring is generated over its image ring by
the source coordinate germs. -/
theorem coordinateAdjoin_eq_top_of_isFiniteAtOrigin
    {n m : ℕ} (f : PointedMapGerm n m)
    (hfinite : f.IsFiniteAtOrigin) :
    Algebra.adjoin f.ImageRing
      (Set.range (Germ.coordinate : Fin n → Germ n)) = ⊤ := by
  let _ : Module.Finite f.ImageRing (Germ n) := hfinite
  let S : Submodule f.ImageRing (Germ n) :=
    (Algebra.adjoin f.ImageRing
      (Set.range (Germ.coordinate : Fin n → Germ n))).toSubmodule
  obtain ⟨N, hN⟩ :=
    f.exists_maximalIdeal_pow_le_coordinateIdeal hfinite
  have htop : (⊤ : Submodule f.ImageRing (Germ n)) ≤
      S ⊔ f.imageMaximalIdeal •
        (⊤ : Submodule f.ImageRing (Germ n)) := by
    intro g _hg
    obtain ⟨p, hp⟩ :=
      Germ.exists_coordinatePolynomial_mod_maximalIdeal_pow n N g
    let q : Germ n := Germ.coordinatePolynomialAlgHom n p
    have hqS : q ∈ S :=
      f.coordinatePolynomial_mem_coordinateAdjoin p
    have hremCoordinate : g - q ∈ f.1.coordinateIdeal :=
      hN hp
    have hremSmul : g - q ∈ f.imageMaximalIdeal •
        (⊤ : Submodule f.ImageRing (Germ n)) := by
      rw [Ideal.smul_top_eq_map]
      change g - q ∈ Ideal.map
        (algebraMap f.ImageRing (Germ n)) f.imageMaximalIdeal
      simpa only [Algebra.algebraMap_ofSubring,
        f.map_imageMaximalIdeal_eq_coordinateIdeal] using hremCoordinate
    rw [Submodule.mem_sup]
    exact ⟨q, hqS, g - q, hremSmul, by abel⟩
  have htopLe : (⊤ : Submodule f.ImageRing (Germ n)) ≤ S :=
    Submodule.le_of_le_smul_of_le_jacobson_bot
      Module.Finite.fg_top (by
        rw [f.imageMaximalIdeal_eq_isLocalRing]
        exact IsLocalRing.maximalIdeal_le_jacobson ⊥) htop
  apply top_unique
  exact htopLe

set_option maxHeartbeats 400000 in
-- Elaborating the nested fraction field structures exceeds the default limit.
/-- Distinct generic embeddings for a finite plane map differ on at least one
source coordinate. -/
theorem exists_coordinate_separating_generic_embeddings
    {m : ℕ} (f : PointedMapGerm 2 m)
    (hfinite : f.IsFiniteAtOrigin) :
    let _ : Algebra (FractionRing f.ImageRing)
        (FractionRing (Germ 2)) := f.genericFractionFieldAlgebra
    ∀ sigma tau : Field.Emb (FractionRing f.ImageRing)
        (FractionRing (Germ 2)),
      sigma ≠ tau →
        ∃ j : Fin 2,
          sigma
              (algebraMap (Germ 2) (FractionRing (Germ 2))
                (Germ.coordinate j)) ≠
            tau
              (algebraMap (Germ 2) (FractionRing (Germ 2))
                (Germ.coordinate j)) := by
  let _ : Algebra (FractionRing f.ImageRing)
      (FractionRing (Germ 2)) := f.genericFractionFieldAlgebra
  let _ : Module.Finite f.ImageRing (Germ 2) := hfinite
  let _ : FaithfulSMul f.ImageRing (Germ 2) :=
    (faithfulSMul_iff_algebraMap_injective
      f.ImageRing (Germ 2)).mpr f.ImageRing.subtype_injective
  let _ : Module.IsTorsionFree f.ImageRing (Germ 2) :=
    (Module.isTorsionFree_iff_algebraMap_injective).2
      f.ImageRing.subtype_injective
  let _ : IsScalarTower f.ImageRing (Germ 2)
      (FractionRing (Germ 2)) :=
    IsScalarTower.of_algebraMap_eq fun x => rfl
  let _ : IsScalarTower f.ImageRing (FractionRing f.ImageRing)
      (FractionRing (Germ 2)) :=
    IsScalarTower.of_algebraMap_eq fun x => by
      rw [RingHom.algebraMap_toAlgebra]
      exact (f.fractionFieldMap_algebraMap x).symm
  change ∀ sigma tau : Field.Emb (FractionRing f.ImageRing)
      (FractionRing (Germ 2)),
    sigma ≠ tau →
      ∃ j : Fin 2,
        sigma
            (algebraMap (Germ 2) (FractionRing (Germ 2))
              (Germ.coordinate j)) ≠
          tau
            (algebraMap (Germ 2) (FractionRing (Germ 2))
              (Germ.coordinate j))
  intro sigma tau hne
  by_contra hcoordinates
  push Not at hcoordinates
  let sigmaSource : Germ 2 →ₐ[f.ImageRing]
      AlgebraicClosure (FractionRing (Germ 2)) :=
    AlgHom.comp
      ((AlgHomClass.toAlgHom sigma).restrictScalars f.ImageRing)
      (IsScalarTower.toAlgHom f.ImageRing (Germ 2)
        (FractionRing (Germ 2)))
  let tauSource : Germ 2 →ₐ[f.ImageRing]
      AlgebraicClosure (FractionRing (Germ 2)) :=
    AlgHom.comp
      ((AlgHomClass.toAlgHom tau).restrictScalars f.ImageRing)
      (IsScalarTower.toAlgHom f.ImageRing (Germ 2)
        (FractionRing (Germ 2)))
  have hsource : sigmaSource = tauSource := by
    apply AlgHom.ext_of_adjoin_eq_top
      (f.coordinateAdjoin_eq_top_of_isFiniteAtOrigin hfinite)
    rintro _ ⟨j, rfl⟩
    exact hcoordinates j
  apply hne
  apply AlgHom.coe_ringHom_injective
  apply IsFractionRing.ringHom_ext (A := Germ 2)
  intro g
  exact AlgHom.congr_fun hsource g

end PointedMapGerm

end OnLeConjecture.Analytic
