module

public import OnLeConjecture.Analytic.WeightedMonomialDivision
public import Mathlib.Algebra.MvPolynomial.Monad

/-!
# Finite monomial ideals for two source weights

The existing weighted order ideal uses source weights `(a, 1)`. This file
defines the finite monomial ideal for arbitrary source weights `(a, b)`.
Both exponents are bounded by the threshold, and only pairs whose weighted
degree reaches the threshold are retained.
-/

public section

namespace OnLeConjecture.Analytic

open scoped BigOperators

/-- Substitution by polynomials whose weighted degrees are scaled by `L`
preserves weighted homogeneity and scales the target degree by `L`. -/
theorem MvPolynomial.IsWeightedHomogeneous.bind₁_scaled
    {R : Type*} [CommSemiring R] {sigma tau : Type*}
    {P : MvPolynomial sigma R} {w : sigma → ℕ} {w' : tau → ℕ}
    {D L : ℕ} (hP : P.IsWeightedHomogeneous w D)
    (Q : sigma → MvPolynomial tau R)
    (hQ : ∀ i, (Q i).IsWeightedHomogeneous w' (L * w i)) :
    (MvPolynomial.bind₁ Q P).IsWeightedHomogeneous w' (L * D) := by
  induction hP using MvPolynomial.IsWeightedHomogeneous.induction_on with
  | zero =>
      rw [map_zero]
      exact MvPolynomial.isWeightedHomogeneous_zero R w' (L * D)
  | add p q hp hq ihp ihq =>
      rw [map_add]
      exact ihp.add ihq
  | monomial d c hd =>
      rw [MvPolynomial.bind₁_monomial]
      have hprod := MvPolynomial.IsWeightedHomogeneous.prod d.support
        (fun i ↦ Q i ^ d i) (fun i ↦ d i • (L * w i))
        (fun i _ ↦ (hQ i).pow (d i))
      have hd' : ∑ i ∈ d.support, w i * d i = D := by
        simpa [Finsupp.weight_apply, Finsupp.sum, mul_comm] using hd
      have hdegree :
          ∑ i ∈ d.support, d i • (L * w i) = L * D := by
        simp only [nsmul_eq_mul]
        rw [← hd', Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro i _
        simp [mul_assoc, mul_comm]
      rw [hdegree] at hprod
      exact hprod.C_mul c

namespace Germ

/-- Exponent pairs in the finite box whose weighted degree is at least the
specified threshold. -/
abbrev TwoWeightOrderIndex (a b D : ℕ) :=
  {p : Fin (D + 1) × Fin (D + 1) //
    D ≤ a * (p.1 : ℕ) + b * (p.2 : ℕ)}

instance (a b D : ℕ) : Fintype (TwoWeightOrderIndex a b D) :=
  inferInstance

theorem TwoWeightOrderIndex.threshold_le_weight
    {a b D : ℕ} (k : TwoWeightOrderIndex a b D) :
    D ≤ a * (k.1.1 : ℕ) + b * (k.1.2 : ℕ) :=
  k.2

/-- The monomial associated with a finite two weight exponent pair. -/
@[expose]
noncomputable def twoWeightOrderGenerator
    (a b D : ℕ) (k : TwoWeightOrderIndex a b D) : Germ 2 :=
  Germ.coordinate (0 : Fin 2) ^ (k.1.1 : ℕ) *
    Germ.coordinate (1 : Fin 2) ^ (k.1.2 : ℕ)

/-- The finite monomial ideal generated by exponent pairs of two weight at
least `D` in the box from zero through `D`. -/
@[expose]
noncomputable def twoWeightOrderIdeal
    (a b D : ℕ) : Ideal (Germ 2) :=
  Ideal.span (Set.range (Germ.twoWeightOrderGenerator a b D))

/-- Membership in the two weight order ideal is equivalent to a finite
coefficient decomposition in its generators. -/
theorem mem_twoWeightOrderIdeal_iff (a b D : ℕ) (f : Germ 2) :
    f ∈ Germ.twoWeightOrderIdeal a b D ↔
      ∃ c : TwoWeightOrderIndex a b D → Germ 2,
        ∑ k, c k * Germ.twoWeightOrderGenerator a b D k = f := by
  change f ∈ Submodule.span (Germ 2)
      (Set.range (Germ.twoWeightOrderGenerator a b D)) ↔ _
  rw [Submodule.mem_span_range_iff_exists_fun]
  simp only [smul_eq_mul]

/-- Every displayed generator belongs to the two weight order ideal. -/
theorem twoWeightOrderGenerator_mem
    (a b D : ℕ) (k : TwoWeightOrderIndex a b D) :
    Germ.twoWeightOrderGenerator a b D k ∈
      Germ.twoWeightOrderIdeal a b D :=
  Ideal.subset_span (Set.mem_range_self k)

/-- Every monomial whose two weight is at least `D` belongs to the finite
ideal. Positivity of the weights makes an exponent of size at least `D`
divisible by one of the two boundary generators. -/
theorem monomial_mem_twoWeightOrderIdeal_of_threshold
    (a b D u v : ℕ) (ha : 0 < a) (hb : 0 < b)
    (hweight : D ≤ a * u + b * v) :
    Germ.coordinate (0 : Fin 2) ^ u * Germ.coordinate (1 : Fin 2) ^ v ∈
      Germ.twoWeightOrderIdeal a b D := by
  by_cases hu : D ≤ u
  · let j : TwoWeightOrderIndex a b D :=
      ⟨(⟨D, by omega⟩, ⟨0, by omega⟩), by
        calc
          D = 1 * D := by simp
          _ ≤ a * D := Nat.mul_le_mul_right D ha
          _ ≤ a * D + b * 0 := by simp⟩
    have hj := twoWeightOrderGenerator_mem a b D j
    have hpow : Germ.coordinate (0 : Fin 2) ^ (u - D) *
        Germ.coordinate (0 : Fin 2) ^ D =
          Germ.coordinate (0 : Fin 2) ^ u := by
      rw [← pow_add, Nat.sub_add_cancel hu]
    have heq :
        Germ.coordinate (0 : Fin 2) ^ u *
            Germ.coordinate (1 : Fin 2) ^ v =
          (Germ.coordinate (0 : Fin 2) ^ (u - D) *
              Germ.coordinate (1 : Fin 2) ^ v) *
            Germ.twoWeightOrderGenerator a b D j := by
      simp only [Germ.twoWeightOrderGenerator, j, pow_zero, mul_one]
      rw [← hpow]
      ring
    rw [heq]
    exact Ideal.mul_mem_left _ _ hj
  · by_cases hv : D ≤ v
    · let j : TwoWeightOrderIndex a b D :=
        ⟨(⟨0, by omega⟩, ⟨D, by omega⟩), by
          calc
            D = 1 * D := by simp
            _ ≤ b * D := Nat.mul_le_mul_right D hb
            _ ≤ a * 0 + b * D := by simp⟩
      have hj := twoWeightOrderGenerator_mem a b D j
      have hpow : Germ.coordinate (1 : Fin 2) ^ (v - D) *
          Germ.coordinate (1 : Fin 2) ^ D =
            Germ.coordinate (1 : Fin 2) ^ v := by
        rw [← pow_add, Nat.sub_add_cancel hv]
      have heq :
          Germ.coordinate (0 : Fin 2) ^ u *
              Germ.coordinate (1 : Fin 2) ^ v =
            (Germ.coordinate (0 : Fin 2) ^ u *
                Germ.coordinate (1 : Fin 2) ^ (v - D)) *
              Germ.twoWeightOrderGenerator a b D j := by
        simp only [Germ.twoWeightOrderGenerator, j, pow_zero, one_mul]
        rw [← hpow]
        ring
      rw [heq]
      exact Ideal.mul_mem_left _ _ hj
    · have huD : u < D := by omega
      have hvD : v < D := by omega
      let j : TwoWeightOrderIndex a b D :=
        ⟨(⟨u, by omega⟩, ⟨v, by omega⟩), hweight⟩
      simpa [Germ.twoWeightOrderGenerator, j] using
        twoWeightOrderGenerator_mem a b D j

/-- The excess of a generator's weighted degree above the threshold. -/
noncomputable def twoWeightOrderExcess
    (a b D : ℕ) (k : TwoWeightOrderIndex a b D) : ℕ :=
  a * (k.1.1 : ℕ) + b * (k.1.2 : ℕ) - D

theorem twoWeightOrderWeight_eq_threshold_add_excess
    (a b D : ℕ) (k : TwoWeightOrderIndex a b D) :
    a * (k.1.1 : ℕ) + b * (k.1.2 : ℕ) =
      D + twoWeightOrderExcess a b D k := by
  rw [twoWeightOrderExcess]
  exact (Nat.add_sub_of_le k.threshold_le_weight).symm

/-- A two weight monomial has the exact radial factor determined by its
threshold and excess. -/
theorem twoWeightOrderGenerator_radial_factor
    (a b D : ℕ) (k : TwoWeightOrderIndex a b D)
    (lambda x y : ℂ) :
    (lambda ^ a * x) ^ (k.1.1 : ℕ) *
        (lambda ^ b * y) ^ (k.1.2 : ℕ) =
      lambda ^ D *
        (lambda ^ twoWeightOrderExcess a b D k *
          x ^ (k.1.1 : ℕ) * y ^ (k.1.2 : ℕ)) := by
  calc
    (lambda ^ a * x) ^ (k.1.1 : ℕ) *
        (lambda ^ b * y) ^ (k.1.2 : ℕ) =
      (lambda ^ (a * (k.1.1 : ℕ)) *
        lambda ^ (b * (k.1.2 : ℕ))) *
          (x ^ (k.1.1 : ℕ) * y ^ (k.1.2 : ℕ)) := by
            rw [mul_pow, mul_pow, ← pow_mul, ← pow_mul]
            ring
    _ = lambda ^
          (a * (k.1.1 : ℕ) + b * (k.1.2 : ℕ)) *
            (x ^ (k.1.1 : ℕ) * y ^ (k.1.2 : ℕ)) := by
          rw [pow_add]
    _ = lambda ^ (D + twoWeightOrderExcess a b D k) *
          (x ^ (k.1.1 : ℕ) * y ^ (k.1.2 : ℕ)) := by
          rw [twoWeightOrderWeight_eq_threshold_add_excess]
    _ = lambda ^ D *
        (lambda ^ twoWeightOrderExcess a b D k *
          x ^ (k.1.1 : ℕ) * y ^ (k.1.2 : ℕ)) := by
          rw [pow_add]
          ring

end Germ

end OnLeConjecture.Analytic
