public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Restriction of analytic germs to a coordinate hyperplane

This file constructs restriction to the hyperplane whose first coordinate is
zero. It proves that restriction is surjective, identifies its kernel with the
ideal generated by the first coordinate, and identifies the quotient with the
ring of analytic germs on the hyperplane.
-/

public section

namespace OnLeConjecture.Analytic

open Filter
open scoped ENNReal NNReal Topology

namespace Germ

/-- The linear inclusion of `ℂⁿ` as the hyperplane whose first coordinate is
zero in `ℂⁿ⁺¹`. -/
@[expose] noncomputable def hyperplaneInclusion (n : ℕ) :
    Source n →L[ℂ] Source (n + 1) :=
  ContinuousLinearMap.pi fun i ↦
    Fin.cases (0 : Source n →L[ℂ] ℂ)
      (fun j ↦ ContinuousLinearMap.proj (R := ℂ) j) i

@[simp]
theorem hyperplaneInclusion_apply_zero (n : ℕ) (z : Source n) :
    hyperplaneInclusion n z 0 = 0 :=
  by simp [hyperplaneInclusion]

@[simp]
theorem hyperplaneInclusion_apply_succ (n : ℕ) (z : Source n)
    (i : Fin n) :
    hyperplaneInclusion n z i.succ = z i :=
  by simp [hyperplaneInclusion]

/-- The linear projection that removes the first coordinate of `ℂⁿ⁺¹`. -/
@[expose] noncomputable def hyperplaneTail (n : ℕ) :
    Source (n + 1) →L[ℂ] Source n :=
  ContinuousLinearMap.pi fun i ↦
    ContinuousLinearMap.proj (R := ℂ) i.succ

@[simp]
theorem hyperplaneTail_apply (n : ℕ) (z : Source (n + 1))
    (i : Fin n) :
    hyperplaneTail n z i = z i.succ :=
  by simp [hyperplaneTail]

@[simp]
theorem hyperplaneTail_inclusion (n : ℕ) (z : Source n) :
    hyperplaneTail n (hyperplaneInclusion n z) = z := by
  ext i
  simp

/-- Projection onto the coordinate hyperplane whose first coordinate is
zero. -/
@[expose] noncomputable def hyperplaneProjection (n : ℕ) :
    Source (n + 1) →L[ℂ] Source (n + 1) :=
  (hyperplaneInclusion n).comp (hyperplaneTail n)

@[simp]
theorem hyperplaneProjection_apply_zero (n : ℕ) (z : Source (n + 1)) :
    hyperplaneProjection n z 0 = 0 := by
  simp [hyperplaneProjection]

@[simp]
theorem hyperplaneProjection_apply_succ (n : ℕ) (z : Source (n + 1))
    (i : Fin n) :
    hyperplaneProjection n z i.succ = z i.succ := by
  simp [hyperplaneProjection]

/-- The first coordinate vector of `ℂⁿ⁺¹`. -/
@[expose] noncomputable def firstCoordinateVector (n : ℕ) : Source (n + 1) :=
  Pi.single (0 : Fin (n + 1)) 1

@[simp]
theorem firstCoordinateVector_apply_zero (n : ℕ) :
    firstCoordinateVector n 0 = 1 := by
  simp [firstCoordinateVector]

@[simp]
theorem firstCoordinateVector_apply_succ (n : ℕ) (i : Fin n) :
    firstCoordinateVector n i.succ = 0 := by
  simp [firstCoordinateVector, Fin.succ_ne_zero]

theorem sub_hyperplaneProjection (n : ℕ) (z : Source (n + 1)) :
    z - hyperplaneProjection n z = z 0 • firstCoordinateVector n := by
  ext i
  induction i using Fin.cases with
  | zero => simp
  | succ i => simp

theorem norm_hyperplaneProjection_apply_le (n : ℕ)
    (z : Source (n + 1)) :
    ‖hyperplaneProjection n z‖ ≤ ‖z‖ := by
  rw [Pi.norm_def, Pi.norm_def]
  norm_cast
  apply Finset.sup_le
  intro i _
  induction i using Fin.cases with
  | zero => simp
  | succ i =>
      simpa using (Finset.le_sup
        (f := fun j : Fin (n + 1) ↦ ‖z j‖₊) (Finset.mem_univ i.succ))

theorem norm_hyperplaneProjection_le_one (n : ℕ) :
    ‖hyperplaneProjection n‖ ≤ 1 := by
  apply ContinuousLinearMap.opNorm_le_bound _ zero_le_one
  intro z
  simpa using norm_hyperplaneProjection_apply_le n z

@[simp]
theorem norm_firstCoordinateVector (n : ℕ) :
    ‖firstCoordinateVector n‖ = 1 := by
  simp [firstCoordinateVector, Pi.norm_single]

/-- The `k`th homogeneous term of division by the first coordinate. The
construction replaces, successively, each argument of the original
multilinear map by its projection to the coordinate hyperplane. -/
@[expose] noncomputable def hyperplaneDivisionTerm (n k : ℕ)
    (p : ContinuousMultilinearMap ℂ
      (fun _ : Fin (k + 1) ↦ Source (n + 1)) ℂ) :
    ContinuousMultilinearMap ℂ (fun _ : Fin k ↦ Source (n + 1)) ℂ :=
  ∑ j : Fin (k + 1),
    (p.curryMid j (firstCoordinateVector n)).compContinuousLinearMap
      fun i ↦ if i.castSucc < j then hyperplaneProjection n
        else ContinuousLinearMap.id ℂ (Source (n + 1))

@[simp]
theorem hyperplaneDivisionTerm_apply (n k : ℕ)
    (p : ContinuousMultilinearMap ℂ
      (fun _ : Fin (k + 1) ↦ Source (n + 1)) ℂ)
    (v : Fin k → Source (n + 1)) :
    hyperplaneDivisionTerm n k p v =
      ∑ j : Fin (k + 1),
        p (j.insertNth (firstCoordinateVector n) fun i ↦
          if i.castSucc < j then hyperplaneProjection n (v i) else v i) := by
  rw [hyperplaneDivisionTerm, sum_apply]
  simp only [
    ContinuousMultilinearMap.compContinuousLinearMap_apply,
    ContinuousMultilinearMap.curryMid_apply]
  apply Finset.sum_congr rfl
  intro j _
  have htail :
      (fun i ↦
        (if i.castSucc < j then hyperplaneProjection n
          else ContinuousLinearMap.id ℂ (Source (n + 1))) (v i)) =
        fun i ↦ if i.castSucc < j then
          hyperplaneProjection n (v i) else v i := by
    funext i
    split
    · simp_all
    · simp_all
  rw [htail]

/-- Dividing a homogeneous term increases its norm by at most its degree. -/
theorem norm_hyperplaneDivisionTerm_le (n k : ℕ)
    (p : ContinuousMultilinearMap ℂ
      (fun _ : Fin (k + 1) ↦ Source (n + 1)) ℂ) :
    ‖hyperplaneDivisionTerm n k p‖ ≤ (k + 1) * ‖p‖ := by
  rw [hyperplaneDivisionTerm]
  refine (norm_sum_le Finset.univ _).trans ?_
  calc
    ∑ j : Fin (k + 1),
        ‖(p.curryMid j (firstCoordinateVector n)).compContinuousLinearMap
          (fun i ↦ if i.castSucc < j then hyperplaneProjection n
            else ContinuousLinearMap.id ℂ (Source (n + 1)))‖ ≤
        ∑ _j : Fin (k + 1), ‖p‖ := by
      apply Finset.sum_le_sum
      intro j _
      let u : Fin k → Source (n + 1) →L[ℂ] Source (n + 1) :=
        fun i ↦ if i.castSucc < j then hyperplaneProjection n
          else ContinuousLinearMap.id ℂ (Source (n + 1))
      have hbase : ‖p.curryMid j (firstCoordinateVector n)‖ ≤ ‖p‖ := by
        calc
          ‖p.curryMid j (firstCoordinateVector n)‖ ≤
              ‖p.curryMid j‖ * ‖firstCoordinateVector n‖ :=
            (p.curryMid j).le_opNorm (firstCoordinateVector n)
          _ = ‖p‖ := by simp
      have hu (i : Fin k) : ‖u i‖ ≤ 1 := by
        dsimp only [u]
        split
        · exact norm_hyperplaneProjection_le_one n
        · exact ContinuousLinearMap.norm_id_le
      calc
        ‖(p.curryMid j (firstCoordinateVector n)).compContinuousLinearMap u‖ ≤
            ‖p.curryMid j (firstCoordinateVector n)‖ * ∏ i, ‖u i‖ :=
          ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
        _ ≤ ‖p‖ * 1 := by
          gcongr
          exact Finset.prod_le_one (fun i _ ↦ norm_nonneg (u i))
            (fun i _ ↦ hu i)
        _ = ‖p‖ := mul_one _
    _ = (k + 1) * ‖p‖ := by simp [Nat.cast_add, Nat.cast_one]

private noncomputable def hyperplaneHybrid {n k : ℕ}
    (z : Source (n + 1)) (r : ℕ) :
    Fin k → Source (n + 1) := fun i ↦
  if i.val < r then hyperplaneProjection n z else z

private theorem hyperplaneHybrid_zero {n k : ℕ} (z : Source (n + 1)) :
    hyperplaneHybrid (k := k) z 0 = fun _ ↦ z := by
  funext i
  simp [hyperplaneHybrid]

private theorem hyperplaneHybrid_length {n k : ℕ} (z : Source (n + 1)) :
    hyperplaneHybrid (k := k) z k = fun _ ↦ hyperplaneProjection n z := by
  funext i
  simp [hyperplaneHybrid, i.isLt]

private theorem insertNth_hyperplaneHybrid_left {n k : ℕ}
    (z : Source (n + 1)) (j : Fin (k + 1)) :
    j.insertNth z (fun i ↦
      if i.castSucc < j then hyperplaneProjection n z else z) =
        hyperplaneHybrid z j.val := by
  funext l
  induction l using j.succAboveCases
  · simp [hyperplaneHybrid]
  · rename_i i
    simp only [Fin.insertNth_apply_succAbove]
    simp only [hyperplaneHybrid]
    change (if i.castSucc < j then hyperplaneProjection n z else z) =
      if j.succAbove i < j then hyperplaneProjection n z else z
    simp only [Fin.succAbove_lt_iff_castSucc_lt]

private theorem insertNth_hyperplaneHybrid_right {n k : ℕ}
    (z : Source (n + 1)) (j : Fin (k + 1)) :
    j.insertNth (hyperplaneProjection n z) (fun i ↦
      if i.castSucc < j then hyperplaneProjection n z else z) =
        hyperplaneHybrid z (j.val + 1) := by
  funext l
  induction l using j.succAboveCases
  · simp [hyperplaneHybrid]
  · rename_i i
    simp only [Fin.insertNth_apply_succAbove]
    simp only [hyperplaneHybrid]
    by_cases h : i.castSucc < j
    · have hs : j.succAbove i < j :=
        (Fin.succAbove_lt_iff_castSucc_lt j i).2 h
      have hs' : (j.succAbove i).val < j.val + 1 := by omega
      simp only [if_pos h, if_pos hs']
    · have hs : ¬j.succAbove i < j := by
        simpa only [Fin.succAbove_lt_iff_castSucc_lt] using h
      have hne : j.succAbove i ≠ j := Fin.succAbove_ne j i
      have hs' : ¬(j.succAbove i).val < j.val + 1 := by omega
      simp only [if_neg h, if_neg hs']

/-- Homogeneous Hadamard division identity for one coordinate. -/
theorem smul_hyperplaneDivisionTerm_apply (n k : ℕ)
    (p : ContinuousMultilinearMap ℂ
      (fun _ : Fin (k + 1) ↦ Source (n + 1)) ℂ)
    (z : Source (n + 1)) :
    z 0 • hyperplaneDivisionTerm n k p (fun _ ↦ z) =
      p (fun _ ↦ z) - p (fun _ ↦ hyperplaneProjection n z) := by
  rw [hyperplaneDivisionTerm_apply, Finset.smul_sum]
  have hterm (j : Fin (k + 1)) :
      z 0 • p (j.insertNth (firstCoordinateVector n) fun i ↦
        if i.castSucc < j then hyperplaneProjection n z else z) =
        p (hyperplaneHybrid z j.val) -
          p (hyperplaneHybrid z (j.val + 1)) := by
    let m : Fin k → Source (n + 1) := fun i ↦
      if i.castSucc < j then hyperplaneProjection n z else z
    have hneg : p (j.insertNth (-(hyperplaneProjection n z)) m) =
        -p (j.insertNth (hyperplaneProjection n z) m) := by
      simpa using p.toMultilinearMap.map_insertNth_smul j m
        (-1 : ℂ) (hyperplaneProjection n z)
    have hadd : p (j.insertNth (z - hyperplaneProjection n z) m) =
        p (j.insertNth z m) +
          p (j.insertNth (-(hyperplaneProjection n z)) m) := by
      change p.toMultilinearMap
          (j.insertNth (z - hyperplaneProjection n z) m) =
        p.toMultilinearMap (j.insertNth z m) +
          p.toMultilinearMap
            (j.insertNth (-(hyperplaneProjection n z)) m)
      simpa only [sub_eq_add_neg] using
        p.toMultilinearMap.map_insertNth_add j m z
          (-(hyperplaneProjection n z))
    calc
      z 0 • p (j.insertNth (firstCoordinateVector n) m) =
          p (j.insertNth (z 0 • firstCoordinateVector n) m) :=
        (p.toMultilinearMap.map_insertNth_smul j m
          (z 0) (firstCoordinateVector n)).symm
      _ = p (j.insertNth (z - hyperplaneProjection n z) m) := by
        rw [sub_hyperplaneProjection]
      _ = p (j.insertNth z m) -
          p (j.insertNth (hyperplaneProjection n z) m) := by
        rw [hadd, hneg, sub_eq_add_neg]
      _ = p (hyperplaneHybrid z j.val) -
          p (hyperplaneHybrid z (j.val + 1)) := by
        rw [insertNth_hyperplaneHybrid_left,
          insertNth_hyperplaneHybrid_right]
  rw [Finset.sum_congr rfl fun j _ ↦ hterm j]
  rw [← hyperplaneHybrid_zero (k := k + 1),
    ← hyperplaneHybrid_length (k := k + 1)]
  let F : ℕ → ℂ := fun r ↦ p (hyperplaneHybrid (k := k + 1) z r)
  change Finset.univ.sum (fun j : Fin (k + 1) ↦
    F j.val - F (j.val + 1)) = F 0 - F (k + 1)
  exact (Fin.sum_univ_eq_sum_range
    (fun r ↦ F r - F (r + 1)) (k + 1)).trans
      (Finset.sum_range_sub' F (k + 1))

/-- Formal power series obtained by dividing the difference between a series
and its restriction to the first coordinate hyperplane. -/
@[expose] noncomputable def hyperplaneDivisionSeries (n : ℕ)
    (p : FormalMultilinearSeries ℂ (Source (n + 1)) ℂ) :
    FormalMultilinearSeries ℂ (Source (n + 1)) ℂ := fun k ↦
  hyperplaneDivisionTerm n k (p (k + 1))

@[simp]
theorem hyperplaneDivisionSeries_apply (n : ℕ)
    (p : FormalMultilinearSeries ℂ (Source (n + 1)) ℂ) (k : ℕ) :
    hyperplaneDivisionSeries n p k =
      hyperplaneDivisionTerm n k (p (k + 1)) :=
  rfl

private theorem nat_succ_le_two_pow_succ (n : ℕ) :
    n + 1 ≤ 2 ^ (n + 1) := by
  induction n with
  | zero => norm_num
  | succ n ih =>
      rw [pow_succ]
      omega

/-- Coordinate division preserves a positive radius of convergence. -/
theorem hyperplaneDivisionSeries_radius_pos (n : ℕ)
    (p : FormalMultilinearSeries ℂ (Source (n + 1)) ℂ)
    (hp : 0 < p.radius) :
    0 < (hyperplaneDivisionSeries n p).radius := by
  obtain ⟨C, r, hC, hr, hp_bound⟩ := p.le_mul_pow_of_radius_pos hp
  let S : ℝ := 2 * r
  let D : ℝ := C * S
  have hS : 0 < S := by
    dsimp only [S]
    positivity
  have hD : 0 ≤ D := by
    dsimp only [D]
    positivity
  have hbound (k : ℕ) :
      ‖hyperplaneDivisionSeries n p k‖ ≤ D * S ^ k := by
    calc
      ‖hyperplaneDivisionSeries n p k‖ ≤
          (k + 1) * ‖p (k + 1)‖ :=
        norm_hyperplaneDivisionTerm_le n k (p (k + 1))
      _ ≤ (k + 1) * (C * r ^ (k + 1)) := by
        gcongr
        exact hp_bound (k + 1)
      _ ≤ (2 : ℝ) ^ (k + 1) * (C * r ^ (k + 1)) := by
        gcongr
        exact_mod_cast nat_succ_le_two_pow_succ k
      _ = D * S ^ k := by
        dsimp only [D, S]
        rw [pow_succ]
        ring
  let s : ℝ≥0 := ⟨S⁻¹, (inv_pos.mpr hS).le⟩
  have hs_real : (s : ℝ) = S⁻¹ := rfl
  have hs_pos : 0 < (s : ℝ≥0∞) := by
    rw [ENNReal.coe_pos]
    exact (inv_pos.mpr hS)
  refine hs_pos.trans_le ((hyperplaneDivisionSeries n p).le_radius_of_bound D ?_)
  intro k
  rw [hs_real]
  calc
    ‖hyperplaneDivisionSeries n p k‖ * S⁻¹ ^ k ≤
        (D * S ^ k) * S⁻¹ ^ k := by
      gcongr
      exact hbound k
    _ = D := by
      rw [mul_assoc, ← mul_pow, mul_inv_cancel₀ hS.ne', one_pow, mul_one]

/-- The sum of the division series satisfies the coordinate Hadamard identity
where all three relevant series converge. -/
theorem smul_hyperplaneDivisionSeries_sum (n : ℕ)
    (p : FormalMultilinearSeries ℂ (Source (n + 1)) ℂ)
    (z : Source (n + 1))
    (hz : z ∈ Metric.eball 0 p.radius)
    (hzProjection : hyperplaneProjection n z ∈ Metric.eball 0 p.radius)
    (hzDivision : z ∈
      Metric.eball 0 (hyperplaneDivisionSeries n p).radius) :
    z 0 • (hyperplaneDivisionSeries n p).sum z =
      p.sum z - p.sum (hyperplaneProjection n z) := by
  have hdivision :=
    ((hyperplaneDivisionSeries n p).hasSum hzDivision).const_smul (z 0)
  have hdivision' : HasSum (fun k ↦
      p (k + 1) (fun _ ↦ z) -
        p (k + 1) (fun _ ↦ hyperplaneProjection n z))
      (z 0 • (hyperplaneDivisionSeries n p).sum z) := by
    apply HasSum.congr_fun hdivision
    intro k
    exact (smul_hyperplaneDivisionTerm_apply n k (p (k + 1)) z).symm
  have hdifference := (p.hasSum hz).sub (p.hasSum hzProjection)
  have htail : HasSum (fun k ↦
      p (k + 1) (fun _ ↦ z) -
        p (k + 1) (fun _ ↦ hyperplaneProjection n z))
      (p.sum z - p.sum (hyperplaneProjection n z)) := by
    have h := (hasSum_nat_add_iff' 1).mpr hdifference
    have hzero : p 0 (fun _ ↦ z) =
        p 0 (fun _ ↦ hyperplaneProjection n z) := by
      congr 1
      funext i
      exact Fin.elim0 i
    simpa only [Finset.sum_range_one, hzero, sub_self, sub_zero] using h
  exact hdivision'.unique htail

/-- Parametric analytic Hadamard division along the first coordinate. An
analytic function is, near the origin, its restriction to the coordinate
hyperplane plus its first coordinate times another analytic function. -/
theorem AnalyticAt.exists_eventuallyEq_hyperplane_add_coordinate_mul
    {n : ℕ} {f : Source (n + 1) → ℂ} (hf : AnalyticAt ℂ f 0) :
    ∃ q : Source (n + 1) → ℂ,
      AnalyticAt ℂ q 0 ∧
        f =ᶠ[𝓝 0] fun z ↦
          f (hyperplaneProjection n z) + z 0 * q z := by
  rcases hf with ⟨p, hp⟩
  let qSeries := hyperplaneDivisionSeries n p
  let q : Source (n + 1) → ℂ := qSeries.sum
  have hqRadius : 0 < qSeries.radius :=
    hyperplaneDivisionSeries_radius_pos n p hp.radius_pos
  have hqAnalytic : AnalyticAt ℂ q 0 := by
    exact (qSeries.hasFPowerSeriesOnBall hqRadius).analyticAt
  have hpSum : HasFPowerSeriesAt p.sum p 0 :=
    (p.hasFPowerSeriesOnBall hp.radius_pos).hasFPowerSeriesAt
  have hf_eq_sum : f =ᶠ[𝓝 0] p.sum := by
    filter_upwards [hp.eventually_hasSum_sub,
      hpSum.eventually_hasSum_sub] with z hzf hzsum
    simpa only [sub_zero] using hzf.unique hzsum
  have hprojectionTendsto :
      Tendsto (hyperplaneProjection n) (𝓝 0) (𝓝 0) := by
    have h := (hyperplaneProjection n).continuous.continuousAt
      (x := (0 : Source (n + 1)))
    simpa only [ContinuousAt, map_zero] using h
  have hf_projection_eq_sum :
      (fun z ↦ f (hyperplaneProjection n z)) =ᶠ[𝓝 0]
        fun z ↦ p.sum (hyperplaneProjection n z) :=
    hf_eq_sum.comp_tendsto hprojectionTendsto
  have hpBall : Metric.eball (0 : Source (n + 1)) p.radius ∈ 𝓝 0 :=
    Metric.eball_mem_nhds 0 hp.radius_pos
  have hqBall : Metric.eball (0 : Source (n + 1)) qSeries.radius ∈ 𝓝 0 :=
    Metric.eball_mem_nhds 0 hqRadius
  have hpProjectionBall :
      ∀ᶠ z in 𝓝 (0 : Source (n + 1)),
        hyperplaneProjection n z ∈ Metric.eball 0 p.radius := by
    exact (hyperplaneProjection n).continuous.continuousAt.preimage_mem_nhds
      (by simpa using hpBall)
  refine ⟨q, hqAnalytic, ?_⟩
  filter_upwards [hf_eq_sum, hf_projection_eq_sum, hpBall, hqBall,
    hpProjectionBall] with z hzf hzprojection hzp hzq hzprojectionBall
  rw [hzf, hzprojection]
  have hdivision := smul_hyperplaneDivisionSeries_sum n p z hzp
    hzprojectionBall hzq
  change p.sum z = p.sum (hyperplaneProjection n z) + z 0 * qSeries.sum z
  calc
    p.sum z = p.sum (hyperplaneProjection n z) +
        (p.sum z - p.sum (hyperplaneProjection n z)) := by ring
    _ = p.sum (hyperplaneProjection n z) + z 0 * qSeries.sum z := by
      rw [← hdivision, smul_eq_mul]

/-- If an analytic function vanishes on the first coordinate hyperplane, it
is divisible by the first coordinate near the origin. -/
theorem AnalyticAt.exists_eventuallyEq_coordinate_mul_of_restrict_eq_zero
    {n : ℕ} {f : Source (n + 1) → ℂ} (hf : AnalyticAt ℂ f 0)
    (hzero : (f ∘ hyperplaneInclusion n) =ᶠ[𝓝 0]
      fun _ : Source n ↦ 0) :
    ∃ q : Source (n + 1) → ℂ,
      AnalyticAt ℂ q 0 ∧
        f =ᶠ[𝓝 0] fun z ↦ z 0 * q z := by
  obtain ⟨q, hq, hfactor⟩ :=
    AnalyticAt.exists_eventuallyEq_hyperplane_add_coordinate_mul hf
  have htailTendsto : Tendsto (hyperplaneTail n) (𝓝 0) (𝓝 0) := by
    have h := (hyperplaneTail n).continuous.continuousAt
      (x := (0 : Source (n + 1)))
    simpa only [ContinuousAt, map_zero] using h
  have hzeroProjection := hzero.comp_tendsto htailTendsto
  refine ⟨q, hq, ?_⟩
  filter_upwards [hfactor, hzeroProjection] with z hfactorz hzeroz
  rw [hfactorz]
  have hprojection :
      hyperplaneInclusion n (hyperplaneTail n z) =
        hyperplaneProjection n z := rfl
  change f (hyperplaneInclusion n (hyperplaneTail n z)) = 0 at hzeroz
  rw [hprojection] at hzeroz
  rw [hzeroz, zero_add]

/-- The pointed analytic germ of the coordinate hyperplane inclusion. -/
@[expose] noncomputable def hyperplaneInclusionGerm (n : ℕ) :
    PointedMapGerm n (n + 1) :=
  PointedMapGerm.ofFunction (hyperplaneInclusion n)
    ((hyperplaneInclusion n).analyticAt 0)
    (map_zero (hyperplaneInclusion n))

/-- The pointed analytic germ of the projection that removes the first
coordinate. -/
@[expose] noncomputable def hyperplaneTailGerm (n : ℕ) :
    PointedMapGerm (n + 1) n :=
  PointedMapGerm.ofFunction (hyperplaneTail n)
    ((hyperplaneTail n).analyticAt 0)
    (map_zero (hyperplaneTail n))

/-- Restriction of analytic germs to the hyperplane whose first coordinate is
zero. -/
@[expose] noncomputable def hyperplaneRestriction (n : ℕ) :
    Germ (n + 1) →+* Germ n :=
  (hyperplaneInclusionGerm n).pullbackRingHom

/-- Restriction to a coordinate hyperplane as a homomorphism of complex
algebras. -/
@[expose] noncomputable def hyperplaneRestrictionAlgHom (n : ℕ) :
    Germ (n + 1) →ₐ[ℂ] Germ n :=
  { hyperplaneRestriction n with
    commutes' := fun c ↦ by
      change (hyperplaneInclusionGerm n).pullbackRingHom
        (Germ.constRingHom (n + 1) c) = Germ.constRingHom n c
      exact PointedMapGerm.pullback_constRingHom
        (hyperplaneInclusionGerm n) c }

@[simp]
theorem hyperplaneRestrictionAlgHom_apply (n : ℕ) (g : Germ (n + 1)) :
    hyperplaneRestrictionAlgHom n g = hyperplaneRestriction n g :=
  rfl

@[simp]
theorem hyperplaneRestrictionAlgHom_toRingHom (n : ℕ) :
    (hyperplaneRestrictionAlgHom n).toRingHom = hyperplaneRestriction n :=
  rfl

/-- Extension along the projection that removes the first coordinate. -/
@[expose] noncomputable def hyperplaneExtension (n : ℕ) :
    Germ n →+* Germ (n + 1) :=
  (hyperplaneTailGerm n).pullbackRingHom

@[simp]
theorem hyperplaneRestriction_ofFunction (n : ℕ)
    (f : Source (n + 1) → ℂ) (hf : AnalyticAt ℂ f 0) :
    hyperplaneRestriction n (Germ.ofFunction f hf) =
      Germ.ofFunction (f ∘ hyperplaneInclusion n)
        (by
          have hf' : AnalyticAt ℂ f (hyperplaneInclusion n 0) := by
            simpa using hf
          exact hf'.comp ((hyperplaneInclusion n).analyticAt 0)) := by
  exact Germ.compPointed_ofFunction f hf (hyperplaneInclusion n)
    ((hyperplaneInclusion n).analyticAt 0) (map_zero (hyperplaneInclusion n))

@[simp]
theorem hyperplaneExtension_ofFunction (n : ℕ)
    (f : Source n → ℂ) (hf : AnalyticAt ℂ f 0) :
    hyperplaneExtension n (Germ.ofFunction f hf) =
      Germ.ofFunction (f ∘ hyperplaneTail n)
        (by
          have hf' : AnalyticAt ℂ f (hyperplaneTail n 0) := by
            simpa using hf
          exact hf'.comp ((hyperplaneTail n).analyticAt 0)) := by
  exact Germ.compPointed_ofFunction f hf (hyperplaneTail n)
    ((hyperplaneTail n).analyticAt 0) (map_zero (hyperplaneTail n))

/-- Restriction after extension is the identity. -/
theorem hyperplaneRestriction_comp_extension (n : ℕ) :
    (hyperplaneRestriction n).comp (hyperplaneExtension n) =
      RingHom.id (Germ n) := by
  apply RingHom.ext
  intro q
  rcases q with ⟨q, hq⟩
  induction q using Filter.Germ.inductionOn with
  | _ q =>
      rw [mem_analyticGermSubring, isAnalyticGerm_ofFun] at hq
      change hyperplaneRestriction n
          (hyperplaneExtension n (Germ.ofFunction q hq)) =
        Germ.ofFunction q hq
      rw [hyperplaneExtension_ofFunction, hyperplaneRestriction_ofFunction]
      apply Germ.ofFunction_eq_of_eventuallyEq
      exact Filter.Eventually.of_forall fun z ↦ by
        simp only [Function.comp_apply, hyperplaneTail_inclusion]

/-- Restriction to a coordinate hyperplane is surjective. -/
theorem hyperplaneRestriction_surjective (n : ℕ) :
    Function.Surjective (hyperplaneRestriction n) := by
  intro q
  refine ⟨hyperplaneExtension n q, ?_⟩
  have h := DFunLike.congr_fun (hyperplaneRestriction_comp_extension n) q
  exact h

theorem hyperplaneRestrictionAlgHom_surjective (n : ℕ) :
    Function.Surjective (hyperplaneRestrictionAlgHom n) := by
  intro q
  rcases hyperplaneRestriction_surjective n q with ⟨g, hg⟩
  exact ⟨g, by
    change hyperplaneRestriction n g = q
    exact hg⟩

/-- Restriction kills the first coordinate germ. -/
@[simp]
theorem hyperplaneRestriction_coordinate_zero (n : ℕ) :
    hyperplaneRestriction n (Germ.coordinate (0 : Fin (n + 1))) = 0 := by
  apply Subtype.ext
  change
    ((fun z : Source (n + 1) ↦ z 0) : FunctionGerm (n + 1)).compTendsto'
        (hyperplaneInclusionGerm n).1.1
        (hyperplaneInclusionGerm n).tendsto_origin = 0
  rw [Filter.Germ.coe_compTendsto']
  apply Filter.Germ.coe_eq.mpr
  filter_upwards [] with z
  simp

/-- Restriction sends every remaining coordinate to the corresponding
coordinate on the hyperplane. -/
@[simp]
theorem hyperplaneRestriction_coordinate_succ (n : ℕ) (i : Fin n) :
    hyperplaneRestriction n (Germ.coordinate i.succ) =
      Germ.coordinate i := by
  rw [hyperplaneRestriction, PointedMapGerm.pullback_coordinate]
  apply Subtype.ext
  rw [hyperplaneInclusionGerm]
  change
    ((MapGerm.ofFunction (hyperplaneInclusion n)
      ((hyperplaneInclusion n).analyticAt 0)).component i.succ).1 =
      (Germ.coordinate i).1
  rw [MapGerm.component_ofFunction]
  apply Filter.Germ.coe_eq.mpr
  exact Filter.Eventually.of_forall fun z ↦ by simp

/-- The ideal generated by the first coordinate is contained in the kernel of
hyperplane restriction. -/
theorem span_coordinate_zero_le_ker_hyperplaneRestriction (n : ℕ) :
    Ideal.span {Germ.coordinate (0 : Fin (n + 1))} ≤
      RingHom.ker (hyperplaneRestriction n) := by
  rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker,
    hyperplaneRestriction_coordinate_zero]

/-- The kernel of restriction to the first coordinate hyperplane is generated
by the first coordinate germ. -/
theorem ker_hyperplaneRestriction_eq_span_coordinate_zero (n : ℕ) :
    RingHom.ker (hyperplaneRestriction n) =
      Ideal.span {Germ.coordinate (0 : Fin (n + 1))} := by
  apply le_antisymm
  · intro g hg
    rw [RingHom.mem_ker] at hg
    rcases g with ⟨g, hgan⟩
    induction g using Filter.Germ.inductionOn with
    | _ f =>
        rw [mem_analyticGermSubring, isAnalyticGerm_ofFun] at hgan
        have hrestrictionGerm :
            ((f ∘ hyperplaneInclusion n) : FunctionGerm n) = 0 := by
          change hyperplaneRestriction n (Germ.ofFunction f hgan) = 0 at hg
          rw [hyperplaneRestriction_ofFunction] at hg
          exact congrArg Subtype.val hg
        have hrestriction :
            (f ∘ hyperplaneInclusion n) =ᶠ[𝓝 0]
              fun _ : Source n ↦ 0 := by
          apply Filter.Germ.coe_eq.mp
          exact hrestrictionGerm.trans Filter.Germ.coe_zero.symm
        obtain ⟨q, hq, hfactor⟩ :=
          AnalyticAt.exists_eventuallyEq_coordinate_mul_of_restrict_eq_zero
            hgan hrestriction
        have hcoordinate :
            AnalyticAt ℂ (fun z : Source (n + 1) ↦ z 0) 0 :=
          (ContinuousLinearMap.proj (R := ℂ)
            (φ := fun _ : Fin (n + 1) ↦ ℂ)
            (0 : Fin (n + 1))).analyticAt 0
        have hproduct :
            AnalyticAt ℂ (fun z : Source (n + 1) ↦ z 0 * q z) 0 :=
          hcoordinate.mul hq
        have hfactorGerm :
            Germ.ofFunction f hgan =
              Germ.coordinate (0 : Fin (n + 1)) *
                Germ.ofFunction q hq := by
          calc
            Germ.ofFunction f hgan =
                Germ.ofFunction (fun z : Source (n + 1) ↦ z 0 * q z)
                  hproduct :=
              Germ.ofFunction_eq_of_eventuallyEq hgan hproduct hfactor
            _ = Germ.coordinate (0 : Fin (n + 1)) *
                Germ.ofFunction q hq := by
              apply Subtype.ext
              rfl
        rw [Ideal.mem_span_singleton']
        refine ⟨Germ.ofFunction q hq, ?_⟩
        rw [mul_comm]
        exact hfactorGerm.symm
  · exact span_coordinate_zero_le_ker_hyperplaneRestriction n

/-- The kernel of restriction as a homomorphism of complex algebras is
generated by the first coordinate germ. -/
theorem ker_hyperplaneRestrictionAlgHom_eq_span_coordinate_zero (n : ℕ) :
    RingHom.ker (hyperplaneRestrictionAlgHom n) =
      Ideal.span {Germ.coordinate (0 : Fin (n + 1))} := by
  change RingHom.ker (hyperplaneRestriction n) =
    Ideal.span {Germ.coordinate (0 : Fin (n + 1))}
  exact ker_hyperplaneRestriction_eq_span_coordinate_zero n

/-- The quotient by the first coordinate is the ring of analytic germs on the
coordinate hyperplane. -/
noncomputable def hyperplaneQuotientEquiv (n : ℕ) :
    Germ (n + 1) ⧸
        Ideal.span {Germ.coordinate (0 : Fin (n + 1))} ≃+*
      Germ n :=
  (Ideal.quotEquivOfEq
      (ker_hyperplaneRestriction_eq_span_coordinate_zero n).symm).trans
    (RingHom.quotientKerEquivOfSurjective
      (hyperplaneRestriction_surjective n))

/-- The quotient by the first coordinate as an equivalence of complex
algebras. -/
noncomputable def hyperplaneQuotientAlgEquiv (n : ℕ) :
    (Germ (n + 1) ⧸
        Ideal.span {Germ.coordinate (0 : Fin (n + 1))}) ≃ₐ[ℂ]
      Germ n :=
  (Ideal.quotientEquivAlgOfEq ℂ
      (ker_hyperplaneRestrictionAlgHom_eq_span_coordinate_zero n).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective
      (f := hyperplaneRestrictionAlgHom n)
      (hyperplaneRestrictionAlgHom_surjective n))

@[simp]
theorem hyperplaneQuotientAlgEquiv_mk (n : ℕ) (g : Germ (n + 1)) :
    hyperplaneQuotientAlgEquiv n
        (Ideal.Quotient.mk
          (Ideal.span {Germ.coordinate (0 : Fin (n + 1))}) g) =
      hyperplaneRestriction n g := by
  rw [hyperplaneQuotientAlgEquiv, AlgEquiv.trans_apply,
    Ideal.quotientEquivAlgOfEq_mk,
    Ideal.quotientKerAlgEquivOfSurjective_mk]
  rfl

@[simp]
theorem hyperplaneQuotientEquiv_mk (n : ℕ) (g : Germ (n + 1)) :
    hyperplaneQuotientEquiv n
        (Ideal.Quotient.mk
          (Ideal.span {Germ.coordinate (0 : Fin (n + 1))}) g) =
      hyperplaneRestriction n g := by
  rw [hyperplaneQuotientEquiv]
  change
    (RingHom.quotientKerEquivOfSurjective
      (hyperplaneRestriction_surjective n))
        ((Ideal.quotEquivOfEq
          (ker_hyperplaneRestriction_eq_span_coordinate_zero n).symm)
            (Ideal.Quotient.mk
              (Ideal.span {Germ.coordinate (0 : Fin (n + 1))}) g)) =
      hyperplaneRestriction n g
  rw [Ideal.quotEquivOfEq_mk,
    RingHom.quotientKerEquivOfSurjective_apply_mk]

/-- The ideal generated by the first coordinate germ is prime. -/
theorem span_coordinate_zero_isPrime (n : ℕ) :
    (Ideal.span {Germ.coordinate (0 : Fin (n + 1))}).IsPrime := by
  rw [← ker_hyperplaneRestriction_eq_span_coordinate_zero]
  exact RingHom.ker_isPrime (hyperplaneRestriction n)

end Germ

