module

public import OnLeConjecture.Analytic.WeightedInitialFormExistence
public import OnLeConjecture.Analytic.WeightedPrincipalClosure
public import OnLeConjecture.Analytic.Derivation
public import Mathlib.Algebra.Polynomial.Div

/-!
# Finite normalization by polynomial powers of a first component

For a finite-colength pair of plane analytic germs, subtracting a polynomial
in the first germ eventually produces a nonzero weighted initial form that
is not a scalar positive power of the first initial form. The initial form
may have any positive weighted degree. The correction has zero constant
term and preserves both the pair ideal and its Jacobian.
-/

public section

namespace OnLeConjecture.Analytic.Germ

open _root_.Polynomial

/-- A polynomial with zero constant term evaluates into the principal ideal
of the germ at which it is evaluated. -/
theorem polynomial_aeval_mem_span_singleton (g : Germ 2) (p : ℂ[X])
    (hp : p.coeff 0 = 0) : Polynomial.aeval g p ∈ Ideal.span {g} := by
  rw [Ideal.mem_span_singleton]
  obtain ⟨q, hq⟩ := Polynomial.X_dvd_iff.mpr hp
  refine ⟨Polynomial.aeval g q, ?_⟩
  rw [hq, map_mul]
  simp

/-- Subtracting a polynomial in the first generator, with zero constant
term, preserves the ideal generated by the pair. -/
theorem span_pair_sub_polynomial_aeval (g u : Germ 2) (p : ℂ[X])
    (hp : p.coeff 0 = 0) :
    Ideal.span ({g, u - Polynomial.aeval g p} : Set (Germ 2)) =
      Ideal.span {g, u} := by
  obtain ⟨q, hq⟩ := Ideal.mem_span_singleton.mp
    (polynomial_aeval_mem_span_singleton g p hp)
  rw [hq, sub_eq_add_neg, ← mul_neg]
  exact Ideal.span_pair_add_left_mul g u (-q)

/-- The Jacobian with a polynomial in the first germ vanishes. -/
theorem jacobian_polynomial_aeval (g : Germ 2) (p : ℂ[X]) :
    Germ.jacobian g (Polynomial.aeval g p) = 0 := by
  have hpowers (s : ℕ) : Germ.jacobian g (g ^ s) = 0 := by
    induction s with
    | zero =>
        rw [pow_zero, ← map_one (Germ.constRingHom 2)]
        exact Germ.jacobian_const_right g 1
    | succ s ih =>
        rw [pow_succ, Germ.jacobian_mul_right, ih, Germ.jacobian_self]
        ring
  induction p using Polynomial.induction_on' with
  | add p q hp hq =>
      rw [map_add, Germ.jacobian_add_right, hp, hq, add_zero]
  | monomial s c =>
      rw [Polynomial.aeval_def, Polynomial.eval₂_monomial]
      change Germ.jacobian g (Germ.constRingHom 2 c * g ^ s) = 0
      simp only [Germ.jacobian_mul_right, Germ.jacobian_const_right, hpowers]
      ring

/-- Polynomial correction in the first component preserves the Jacobian. -/
theorem jacobian_sub_polynomial_aeval (g u : Germ 2) (p : ℂ[X]) :
    Germ.jacobian g (u - Polynomial.aeval g p) = Germ.jacobian g u := by
  have hzero := jacobian_polynomial_aeval g p
  simp only [Germ.jacobian_eq, Germ.partialDerivative_sub] at hzero ⊢
  linear_combination -hzero

/-- Finite colength forces normalization by positive powers of any nonzero
weighted initial form to terminate. -/
theorem exists_weighted_initial_form_avoiding_powers
    (a d D₀ : ℕ) (ha : 0 < a) (hd : 0 < d)
    (P : MvPolynomial (Fin 2) ℂ) (_hPzero : P ≠ 0)
    (hP : P.IsWeightedHomogeneous ![a, 1] d) (g u : Germ 2)
    (hg : g - Germ.coordinatePolynomialAlgHom 2 P ∈
      Germ.weightedOrderIdeal a (d + 1))
    (hu : u ∈ Germ.weightedOrderIdeal a D₀)
    (hfinite : ∃ N : ℕ, Germ.maximalIdeal 2 ^ N ≤ Ideal.span {g, u}) :
    ∃ ell : ℕ, ∃ Q : MvPolynomial (Fin 2) ℂ, ∃ p : ℂ[X],
      D₀ ≤ ell ∧ p.coeff 0 = 0 ∧ Q ≠ 0 ∧
      Q.IsWeightedHomogeneous ![a, 1] ell ∧
      u - Polynomial.aeval g p ∈ Germ.weightedOrderIdeal a ell ∧
      u - Polynomial.aeval g p ∉ Germ.weightedOrderIdeal a (ell + 1) ∧
      (u - Polynomial.aeval g p) - Germ.coordinatePolynomialAlgHom 2 Q ∈
        Germ.weightedOrderIdeal a (ell + 1) ∧
      Ideal.span ({g, u - Polynomial.aeval g p} : Set (Germ 2)) =
        Ideal.span {g, u} ∧
      Germ.jacobian g (u - Polynomial.aeval g p) = Germ.jacobian g u ∧
      ∀ (s : ℕ) (c : ℂ), 0 < s → c ≠ 0 → Q ≠ MvPolynomial.C c * P ^ s := by
  classical
  let pGerm : Germ 2 := Germ.coordinatePolynomialAlgHom 2 P
  have hpGerm : pGerm ∈ Germ.weightedOrderIdeal a d :=
    Germ.coordinatePolynomial_mem_weightedOrderIdeal a d ha hP
  have hgOrder : g ∈ Germ.weightedOrderIdeal a d := by
    have htail := Germ.weightedOrderIdeal_antitone a d (d + 1) ha (by omega) hg
    have hequality : g = (g - pGerm) + pGerm := by ring
    rw [hequality]
    exact (Germ.weightedOrderIdeal a d).add_mem htail hpGerm
  have hgMaximal : g ∈ Germ.maximalIdeal 2 := by
    have horderOne := Germ.weightedOrderIdeal_antitone a 1 d ha hd hgOrder
    rwa [Germ.weightedOrderIdeal_one_eq_maximalIdeal a ha] at horderOne
  let Approx (D : ℕ) : Prop := ∃ p : ℂ[X], p.coeff 0 = 0 ∧
    u - Polynomial.aeval g p ∈ Germ.weightedOrderIdeal a D
  have hfailure : ∃ D : ℕ, ¬ Approx D := by
    by_contra hall
    have hall' : ∀ D : ℕ, Approx D := by
      intro D
      by_contra hD
      exact hall ⟨D, hD⟩
    have huPrincipal : u ∈ Ideal.span {g} := by
      apply Germ.mem_ideal_of_sub_mem_weightedOrderIdeal_all a ha (Ideal.span {g}) u
      intro D
      obtain ⟨p, hpzero, hp⟩ := hall' D
      exact ⟨Polynomial.aeval g p, polynomial_aeval_mem_span_singleton g p hpzero, hp⟩
    exact Germ.not_mem_span_singleton_of_pair_finite_colength
      g u hgMaximal hfinite huPrincipal
  let N : ℕ := Nat.find hfailure
  have hNfailed : ¬ Approx N := Nat.find_spec hfailure
  have hbefore : ∀ D < N, Approx D := by
    intro D hDN
    by_contra hD
    exact Nat.find_min hfailure hDN hD
  have hD₀Approx : Approx D₀ := ⟨0, by simp, by simpa using hu⟩
  have hD₀N : D₀ < N := by
    by_contra hnot
    have hND₀ : N ≤ D₀ := by omega
    apply hNfailed
    obtain ⟨p, hpzero, hp⟩ := hD₀Approx
    exact ⟨p, hpzero, Germ.weightedOrderIdeal_antitone a N D₀ ha hND₀ hp⟩
  let ell : ℕ := N - 1
  have hellN : ell < N := by dsimp only [ell]; omega
  have hellSucc : ell + 1 = N := by dsimp only [ell]; omega
  have hD₀ell : D₀ ≤ ell := by dsimp only [ell]; omega
  obtain ⟨p, hpzero, hp⟩ := hbefore ell hellN
  let residual : Germ 2 := u - Polynomial.aeval g p
  have hresidual : residual ∈ Germ.weightedOrderIdeal a ell := hp
  have hresidualNext : residual ∉ Germ.weightedOrderIdeal a (ell + 1) := by
    intro hnext
    apply hNfailed
    rw [← hellSucc]
    exact ⟨p, hpzero, hnext⟩
  obtain ⟨Q, hQzero, hQ, hQtail⟩ :=
    Germ.exists_nonzero_weightedHomogeneous_coordinatePolynomial_mod_succ
      a ell ha residual hresidual hresidualNext
  refine ⟨ell, Q, p, hD₀ell, hpzero, hQzero, hQ, hresidual, hresidualNext,
    hQtail, span_pair_sub_polynomial_aeval g u p hpzero,
    jacobian_sub_polynomial_aeval g u p, ?_⟩
  intro s c hs hc hQpower
  have hpowerHomogeneous : (MvPolynomial.C c * P ^ s).IsWeightedHomogeneous
      ![a, 1] (s • d) := (hP.pow s).C_mul c
  have hellPower : ell = d * s := by
    have hdegree := MvPolynomial.IsWeightedHomogeneous.inj_right
      hQzero hQ (hQpower ▸ hpowerHomogeneous)
    simpa [nsmul_eq_mul, Nat.mul_comm] using hdegree
  have hpowerTail : g ^ s - pGerm ^ s ∈ Germ.weightedOrderIdeal a (ell + 1) := by
    simpa only [hellPower] using
      Germ.pow_sub_pow_mem_weightedOrderIdeal a d s ha hs hgOrder hpGerm hg
  have hQevaluation : Germ.coordinatePolynomialAlgHom 2 Q =
      Germ.constRingHom 2 c * pGerm ^ s := by
    have hevaluation := congrArg (Germ.coordinatePolynomialAlgHom 2) hQpower
    simpa only [map_mul, map_pow, Germ.coordinatePolynomialAlgHom_C, pGerm] using hevaluation
  let correction : ℂ[X] := p + C c * X ^ s
  have hcorrectionZero : correction.coeff 0 = 0 := by
    have hzeroIndex : (0 : ℕ) ≠ s := Nat.ne_of_lt hs
    simp [correction, hpzero, hzeroIndex]
  have hcorrectionEvaluation : Polynomial.aeval g correction =
      Polynomial.aeval g p + Germ.constRingHom 2 c * g ^ s := by
    change Polynomial.aeval g (p + C c * X ^ s) = _
    rw [map_add, map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
    rfl
  have hscalarPowerTail : Germ.constRingHom 2 c * (g ^ s - pGerm ^ s) ∈
      Germ.weightedOrderIdeal a (ell + 1) := Ideal.mul_mem_left _ _ hpowerTail
  have hnewTail : u - Polynomial.aeval g correction ∈
      Germ.weightedOrderIdeal a (ell + 1) := by
    rw [hcorrectionEvaluation]
    have hequality : u - (Polynomial.aeval g p + Germ.constRingHom 2 c * g ^ s) =
        (residual - Germ.coordinatePolynomialAlgHom 2 Q) -
          Germ.constRingHom 2 c * (g ^ s - pGerm ^ s) := by
      rw [hQevaluation]
      dsimp only [residual]
      ring
    rw [hequality]
    exact (Germ.weightedOrderIdeal a (ell + 1)).sub_mem hQtail hscalarPowerTail
  apply hNfailed
  rw [← hellSucc]
  exact ⟨correction, hcorrectionZero, hnewTail⟩

end OnLeConjecture.Analytic.Germ
