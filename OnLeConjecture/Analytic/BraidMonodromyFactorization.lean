/-!
# From the braid monodromy of a level to the event factorization

This module carries out the global part of Lemma `finiteProjectionEventFactorization`
(Section 3 of the written proof of Statement E, `statement-E-complete-proof.tex`, subsection
"Global factorization, exponent count, and transitivity") on the level of closed braids.

`LevelBraidFactorization A L` records the closed-braid output of the finite projection of the
level `L`:

* the outer closed braid over `[0, 1]`, represented through closed braids by `d_S w`
  (`outer_represented`), with the cycle and length identities of the image word `w`;
* the local data of the singular points, `a_j` strands and positive words `β_j`, with the
  properties of `NativeRouteChoice`, and the orders `d_i ≥ 2` of the ordinary ramification
  points;
* a family of strands `loops` over `[0, r]`, `r = N + R`, whose restriction to `[l, l + 1]` is a
  closed braid represented through closed braids by the core of the loop `l`: the word `β_j`
  placed on the first `a_j` strands for a singular loop, and the Coxeter word `σ_0 ⋯ σ_{d-2}`
  placed on the first `d` strands for an ordinary ramification of order `d`;
* a homotopy with fixed endpoints between the outer braid (reparametrized to `[0, r]`) and
  `loops`;
* transitivity of the group generated by the monodromies of the loops.

`LevelBraidFactorization.exists_eventFactorizationData` proves that these data give native route
choices `C` and an event factorization with derivation and transitivity. The proof uses the finite
word relations of homotopies (`BraidMonodromyHomotopy.lean`) and of representations
(`BraidMonodromyModel.lean`), splits every ramification core into `d - 1` conjugates of `σ_0`
(`exists_conjugate_positive_equiv_flatten`), and transfers the transitivity through the
permutations of the path words (`IsPathWord.permutation_of_closing`). In the factor list the
singular factor of `Q_j` occurs exactly once, in the position of its loop.

`LevelBraidFactorizationStatement` asserts the existence of such data for some assembly and
level of every germ. `eventFactorizationStatement_of_levelBraidFactorization` proves
`EventFactorizationStatement` from it. The geometric content of `LevelBraidFactorizationStatement`
is the finite projection of Section 3 (proper projection of degree `S`, the deformation of the
outer braid of the level to the root braid of the central image curve, which job J14 represents
by `d_S w`, the cut system of the critical values, the local braids at the singular points and at
the ordinary ramification points, and the connectedness of the level). It is not proved here.
-/

@[expose] public noncomputable section

open Set Function

namespace OnLeConjecture.Analytic

open KnotTheory PlaneCurve SignedAdjacentWord

/-! ### Lists -/

theorem exists_unique_get_of_count_eq_one {α : Type*} [BEq α] [LawfulBEq α] {a : α} :
    ∀ {l : List α}, l.count a = 1 → ∃! i : Fin l.length, l.get i = a
  | [], h => by simp at h
  | b :: l, h => by
    by_cases hb : b = a
    · subst hb
      have h0 : l.count b = 0 := by simpa [List.count_cons] using h
      refine ⟨⟨0, by simp⟩, rfl, fun i hi => ?_⟩
      rcases i with ⟨_ | j, hj⟩
      · rfl
      · exfalso
        have hm : b ∈ l := by
          rw [← hi]
          exact List.getElem_mem _
        exact (List.count_pos_iff.mpr hm).ne' h0
    · have h1 : l.count a = 1 := by simpa [List.count_cons, hb] using h
      obtain ⟨⟨j, hj⟩, hjv, huniq⟩ := exists_unique_get_of_count_eq_one h1
      refine ⟨⟨j + 1, by simp; omega⟩, by simpa using hjv, fun i hi => ?_⟩
      rcases i with ⟨_ | i, hi'⟩
      · exact absurd hi hb
      · have := huniq ⟨i, by simpa using hi'⟩ (by simpa using hi)
        simp only [Fin.ext_iff] at this ⊢
        omega

theorem ofFn_get_cast {α β : Type*} {n : ℕ} (l : List α) (h : n = l.length) (f : α → β) :
    List.ofFn (fun i : Fin n => f (l.get (Fin.cast h i))) = l.map f := by
  apply List.ext_getElem
  · simp [h]
  · intro i h1 h2
    simp

theorem signedBraidEquiv_ofFn_flatten {S r : ℕ} {W V : Fin r → SignedAdjacentWord S}
    (h : ∀ l, SignedBraidEquiv (W l) (V l)) :
    SignedBraidEquiv (List.ofFn W).flatten (List.ofFn V).flatten := by
  induction r with
  | zero => simpa using SignedBraidEquiv.refl []
  | succ r ih =>
    rw [List.ofFn_succ', List.ofFn_succ', List.concat_eq_append, List.concat_eq_append,
      List.flatten_concat, List.flatten_concat]
    exact (ih fun l => h l.castSucc).append (h (Fin.last r))

theorem permutation_flatten {S : ℕ} (L : List (SignedAdjacentWord S)) :
    SignedAdjacentWord.permutation L.flatten =
      (L.map SignedAdjacentWord.permutation).prod := by
  induction L with
  | nil => simp
  | cons w L ih => rw [List.flatten_cons, permutation_append, ih, List.map_cons, List.prod_cons]

/-- Path words of consecutive unit intervals concatenate. -/
theorem isPathWord_ofFn_flatten {S : ℕ} {K : Fin S → ℝ → ℂ} {R : ℕ}
    (hcont : ∀ k, ContinuousOn (K k) (Icc 0 (R : ℝ)))
    (hinj : ∀ t ∈ Icc (0 : ℝ) R, Injective fun k => K k t) :
    ∀ r, 0 < r → r ≤ R → ∀ W : Fin r → SignedAdjacentWord S,
      (∀ l : Fin r, IsPathWord K (l : ℝ) ((l : ℝ) + 1) (W l)) →
      IsPathWord K 0 r (List.ofFn W).flatten := by
  intro r
  induction r with
  | zero => intro h; omega
  | succ r ih =>
    intro _ hr W hW
    rw [List.ofFn_succ', List.concat_eq_append, List.flatten_concat]
    have hlast := hW (Fin.last r)
    simp only [Fin.val_last] at hlast
    rcases Nat.eq_zero_or_pos r with h0 | hpos
    · subst h0
      simpa using hlast
    · have h1 := ih hpos (by omega) (fun l => W l.castSucc) fun l => by
        simpa using hW l.castSucc
      push_cast
      have hrR : ((r : ℝ) + 1) ≤ R := by exact_mod_cast hr
      exact h1.append (by exact_mod_cast hpos) (by linarith)
        (fun k => (hcont k).mono (Icc_subset_Icc le_rfl hrR))
        (fun t ht => hinj t ⟨ht.1, ht.2.trans hrR⟩) hlast

/-! ### The closed-braid output of the finite projection -/

/-- A positive word on `a` strands placed on the first `a` of `S ≥ a` strands. -/
def liftPositive {a S : ℕ} (h : a ≤ S) (w : PositiveAdjacentWord a) : PositiveAdjacentWord S :=
  w.map fun i => Fin.castLE (by omega) i

theorem toSigned_liftPositive {a S : ℕ} (h : a ≤ S) (w : PositiveAdjacentWord a) :
    (liftPositive h w).toSigned = liftPositiveWord h w := by
  simp [liftPositive, liftPositiveWord, PositiveAdjacentWord.toSigned, Function.comp_def]

theorem length_liftPositive {a S : ℕ} (h : a ≤ S) (w : PositiveAdjacentWord a) :
    (liftPositive h w).length = w.length := by
  simp [liftPositive]

variable {g : PointedMapGerm 2 3} {hd : g.differential = 0}
  {hi : g.HasInjectiveRepresentative}

/-- **The closed-braid output of the finite projection of a level** (Section 3 of the written
proof of Statement E). Write `S = A.squareSum`, `N = L.points.card`, `R = ramCount` and
`r = N + R`. -/
structure LevelBraidFactorization (A : ResolutionSectionAssembly g hd hi)
    (L : ResolutionSectionLevel A) where
  /-- The image word `w`. -/
  imageWord : PositiveAdjacentWord A.squareSum
  imageWord_cycleCount : imageWord.toSigned.cycleCount = irreducibleBranchCount A.imageEquation
  imageWord_length : imageWord.length + A.squareSum * (A.squareSum - 1) +
      irreducibleBranchCount A.imageEquation = 2 * deltaInvariant A.imageEquation + A.squareSum
  /-- The number of strands `a_j` of the singular point `j`. -/
  strands : Fin L.points.card → ℕ
  /-- The positive word `β_j` of the singular point `j`. -/
  factorWord : ∀ j, PositiveAdjacentWord (strands j)
  two_le_strands : ∀ j, 2 ≤ strands j
  strands_le : ∀ j, strands j ≤ (g.criticalJacobianFactorization hi).maxMultiplicity
  strands_le_squareSum : ∀ j, strands j ≤ A.squareSum
  factorWord_cycleCount : ∀ j, (factorWord j).toSigned.cycleCount = 1
  factorWord_generators : ∀ j, (factorWord j).toSigned.generatorIndices = Finset.univ
  factorWord_length : ∀ j, (factorWord j).length + 1 =
    2 * deltaInvariant (localSectionEquation A.H (L.point j)) + strands j
  /-- The number of ordinary ramification loops. -/
  ramCount : ℕ
  /-- The ramification orders `d ≥ 2`. -/
  ramOrder : Fin ramCount → ℕ
  two_le_ramOrder : ∀ i, 2 ≤ ramOrder i
  ramOrder_le : ∀ i, ramOrder i ≤ A.squareSum
  /-- The kind of each loop, in the order of the cut system. -/
  loopKind : Fin (L.points.card + ramCount) ≃ Fin L.points.card ⊕ Fin ramCount
  /-- The core word of each loop. -/
  loopCore : Fin (L.points.card + ramCount) → PositiveAdjacentWord A.squareSum
  loopCore_singular : ∀ l j, loopKind l = Sum.inl j →
    loopCore l = liftPositive (strands_le_squareSum j) (factorWord j)
  loopCore_ram : ∀ l i, loopKind l = Sum.inr i →
    loopCore l = liftPositive (ramOrder_le i) (coxeterWord (ramOrder i))
  /-- The outer closed braid over `[0, 1]`. -/
  outer : Fin A.squareSum → ℝ → ℂ
  outer_represented :
    IsRepresentedByPositiveWord outer 0 1 (fullTwistWord A.squareSum ++ imageWord)
  /-- The loops over `[0, r]`; the loop `l` is the restriction to `[l, l + 1]`. -/
  loops : Fin A.squareSum → ℝ → ℂ
  loops_continuousOn : ∀ k, ContinuousOn (loops k) (Icc 0 ((L.points.card + ramCount : ℕ) : ℝ))
  loops_injective : ∀ t ∈ Icc (0 : ℝ) ((L.points.card + ramCount : ℕ) : ℝ),
    Injective fun k => loops k t
  loop_represented : ∀ l : Fin (L.points.card + ramCount),
    IsRepresentedByPositiveWord loops (l : ℝ) ((l : ℝ) + 1) (loopCore l)
  /-- The homotopy with fixed endpoints from the reparametrized outer braid to the loops. -/
  homotopy : ∃ H : ℝ → Fin A.squareSum → ℝ → ℂ,
    (∀ k, ContinuousOn (fun p : ℝ × ℝ => H p.1 k p.2)
      (Icc 0 1 ×ˢ Icc 0 ((L.points.card + ramCount : ℕ) : ℝ))) ∧
    (∀ s ∈ Icc (0 : ℝ) 1, ∀ t ∈ Icc (0 : ℝ) ((L.points.card + ramCount : ℕ) : ℝ),
      Injective fun k => H s k t) ∧
    (∀ k, ∀ t ∈ Icc (0 : ℝ) ((L.points.card + ramCount : ℕ) : ℝ),
      H 0 k t = outer k (t / ((L.points.card + ramCount : ℕ) : ℝ))) ∧
    (∀ k, ∀ t ∈ Icc (0 : ℝ) ((L.points.card + ramCount : ℕ) : ℝ), H 1 k t = loops k t) ∧
    (∀ s ∈ Icc (0 : ℝ) 1, ∀ k, H s k 0 = outer k 0) ∧
    (∀ s ∈ Icc (0 : ℝ) 1, ∀ k, H s k ((L.points.card + ramCount : ℕ) : ℝ) = outer k 1)
  /-- The monodromies of the loops generate a transitive group. -/
  loops_transitive : ∀ x y : Fin A.squareSum, ∃ σ ∈ Subgroup.closure
    {τ : Equiv.Perm (Fin A.squareSum) | ∃ l : Fin (L.points.card + ramCount),
      ∀ k, loops k ((l : ℝ) + 1) = loops (τ k) (l : ℝ)}, σ x = y

/-- **The closed-braid form of Lemma `finiteProjectionEventFactorization`**: every locally
injective germ with zero differential has an assembly and a level whose finite projection
gives `LevelBraidFactorization` data. -/
def LevelBraidFactorizationStatement : Prop :=
  ∀ (g : PointedMapGerm 2 3) (hd : g.differential = 0) (hi : g.HasInjectiveRepresentative),
    ∃ (A : ResolutionSectionAssembly g hd hi) (L : ResolutionSectionLevel A),
      Nonempty (LevelBraidFactorization A L)

end OnLeConjecture.Analytic
