module

public import OnLeConjecture.KnotTheory.PositiveWordNormalForms
import all OnLeConjecture.KnotTheory.BraidPermutationCycles

/-! # Positive braid equivalence of positive words

This module introduces positive braid equivalence of positive words, the equivalence relation
generated by far commutations and positive braid relations applied inside words (job J08 of the
dependency audit). No cyclic rotation is allowed. Positive braid equivalence is a congruence for
concatenation, it preserves the strand permutation, and on nonempty words it implies positive
word conjugacy.

The module also records invariants of positive word conjugacy. Conjugate words have equal
length, are nonempty, have the same generator indices and the same cycle count, and their strand
permutations are conjugate. Since `PositiveWordConj` has no reflexivity constructor, the empty
word is conjugate to no word, and every nonempty word is conjugate to itself.
-/

@[expose] public section

namespace OnLeConjecture.KnotTheory

open Equiv

/-- One far commutation or one positive braid relation applied inside a positive word. -/
inductive PositiveBraidStep {m : ℕ} : PositiveAdjacentWord m → PositiveAdjacentWord m → Prop
  | far (u v : PositiveAdjacentWord m) (i j : Fin (m - 1))
      (h : i.val + 2 ≤ j.val ∨ j.val + 2 ≤ i.val) :
      PositiveBraidStep (u ++ i :: j :: v) (u ++ j :: i :: v)
  | braid (u v : PositiveAdjacentWord m) (i j : Fin (m - 1)) (h : j.val = i.val + 1) :
      PositiveBraidStep (u ++ [i, j, i] ++ v) (u ++ [j, i, j] ++ v)

/-- Positive braid equivalence of positive words: the equivalence relation generated by far
commutations and positive braid relations applied inside words. It contains no cyclic
rotation. -/
def PositiveBraidEquiv {m : ℕ} (u v : PositiveAdjacentWord m) : Prop :=
  Relation.EqvGen PositiveBraidStep u v

/-- The value of an adjacent transposition applied to a strand. -/
theorem adjacentSwap_apply_val {m : ℕ} (i : Fin (m - 1)) (y : Fin m) :
    (adjacentSwap i y).val =
      if y.val = i.val then i.val + 1 else if y.val = i.val + 1 then i.val else y.val := by
  simp only [adjacentSwap, Equiv.swap_apply_def, Fin.ext_iff]
  split_ifs <;> simp_all

/-- Adjacent transpositions whose indices differ by at least two commute. -/
theorem adjacentSwap_mul_comm_of_far {m : ℕ} {i j : Fin (m - 1)}
    (h : i.val + 2 ≤ j.val ∨ j.val + 2 ≤ i.val) :
    adjacentSwap i * adjacentSwap j = adjacentSwap j * adjacentSwap i := by
  ext x
  simp only [Perm.mul_apply, adjacentSwap_apply_val]
  split_ifs <;> omega

/-- Three transpositions of three distinct points satisfy the braid relation. -/
theorem swap_braid_relation {α : Type*} [DecidableEq α] {a b c : α} (hab : a ≠ b) (hbc : b ≠ c)
    (hac : a ≠ c) :
    swap a b * swap b c * swap a b = swap b c * swap a b * swap b c := by
  calc swap a b * swap b c * swap a b = swap b a * swap c b * swap b a := by
        rw [swap_comm a b, swap_comm b c]
    _ = swap a c := swap_mul_swap_mul_swap hbc.symm hac.symm
    _ = swap c a := swap_comm a c
    _ = swap b c * swap a b * swap b c := (swap_mul_swap_mul_swap hab hac).symm

/-- The two sides of a positive braid relation have the same strand permutation. -/
theorem adjacentSwap_braid {m : ℕ} {i j : Fin (m - 1)} (h : j.val = i.val + 1) :
    adjacentSwap i * adjacentSwap j * adjacentSwap i =
      adjacentSwap j * adjacentSwap i * adjacentSwap j := by
  have e₁ : (⟨j.val, by omega⟩ : Fin m) = ⟨i.val + 1, by omega⟩ := Fin.ext h
  have e₂ : (⟨j.val + 1, by omega⟩ : Fin m) = ⟨i.val + 2, by omega⟩ := Fin.ext (by simp [h])
  have hj : adjacentSwap j = swap (⟨i.val + 1, by omega⟩ : Fin m) ⟨i.val + 2, by omega⟩ := by
    unfold adjacentSwap
    rw [e₁, e₂]
  rw [hj]
  exact swap_braid_relation (by simp [Fin.ext_iff]) (by simp [Fin.ext_iff])
    (by simp [Fin.ext_iff])

namespace PositiveAdjacentWord

/-- The strand permutation of a concatenation is the product of the strand permutations. -/
theorem permutation_append_eq_mul {m : ℕ} (u v : PositiveAdjacentWord m) :
    (u ++ v).permutation = u.permutation * v.permutation := by
  rw [permutation_eq_prod, permutation_eq_prod, permutation_eq_prod, List.map_append,
    List.prod_append]

/-- The generator indices of a positive word are its letters. -/
theorem toSigned_generatorIndices {m : ℕ} (w : PositiveAdjacentWord m) :
    w.toSigned.generatorIndices = w.toFinset := by
  simp [SignedAdjacentWord.generatorIndices, toSigned, Function.comp_def]

end PositiveAdjacentWord

/-- Two signed words whose strand permutations are conjugate have the same cycle count. -/
theorem SignedAdjacentWord.cycleCount_eq_of_isConj {m : ℕ} {w w' : SignedAdjacentWord m}
    (h : IsConj w.permutation w'.permutation) : w.cycleCount = w'.cycleCount := by
  classical
  obtain ⟨g, hg⟩ := isConj_iff.mp h
  unfold SignedAdjacentWord.cycleCount
  let e : Quotient (Perm.SameCycle.setoid w.permutation) ≃
      Quotient (Perm.SameCycle.setoid w'.permutation) :=
    Quotient.congr g fun a b => by
      change w.permutation.SameCycle a b ↔ w'.permutation.SameCycle (g a) (g b)
      rw [← hg, Perm.sameCycle_conj]
      simp
  convert Fintype.card_congr e

namespace PositiveBraidStep

variable {m : ℕ} {u v : PositiveAdjacentWord m}

/-- A step remains a step after a word is added on the left. -/
theorem append_left (h : PositiveBraidStep u v) (a : PositiveAdjacentWord m) :
    PositiveBraidStep (a ++ u) (a ++ v) := by
  cases h with
  | far u v i j h => simpa only [List.append_assoc] using far (a ++ u) v i j h
  | braid u v i j h => simpa only [List.append_assoc] using braid (a ++ u) v i j h

/-- A step remains a step after a word is added on the right. -/
theorem append_right (h : PositiveBraidStep u v) (b : PositiveAdjacentWord m) :
    PositiveBraidStep (u ++ b) (v ++ b) := by
  cases h with
  | far u v i j h =>
    simpa only [List.append_assoc, List.cons_append] using far u (v ++ b) i j h
  | braid u v i j h => simpa only [List.append_assoc] using braid u (v ++ b) i j h

/-- A step preserves the length of a word. -/
theorem length_eq (h : PositiveBraidStep u v) : u.length = v.length := by
  cases h <;> simp

/-- A step preserves the set of letters of a word. -/
theorem toFinset_eq (h : PositiveBraidStep u v) : u.toFinset = v.toFinset := by
  cases h <;> ext x <;> simp <;> tauto

/-- A step preserves the strand permutation of a word. -/
theorem permutation_eq (h : PositiveBraidStep u v) : u.permutation = v.permutation := by
  cases h with
  | far u v i j h =>
    simp only [PositiveAdjacentWord.permutation_append_eq_mul,
      PositiveAdjacentWord.permutation_cons, ← mul_assoc, adjacentSwap_mul_comm_of_far h]
  | braid u v i j h =>
    have hb := adjacentSwap_braid h
    simp only [PositiveAdjacentWord.permutation_append_eq_mul,
      PositiveAdjacentWord.permutation_cons, ← mul_assoc, hb]

end PositiveBraidStep

namespace PositiveBraidEquiv

variable {m : ℕ} {u v w : PositiveAdjacentWord m}

/-- Positive braid equivalence is reflexive. -/
@[refl] theorem refl (u : PositiveAdjacentWord m) : PositiveBraidEquiv u u :=
  Relation.EqvGen.refl u

/-- Positive braid equivalence is symmetric. -/
@[symm] theorem symm (h : PositiveBraidEquiv u v) : PositiveBraidEquiv v u :=
  Relation.EqvGen.symm _ _ h

/-- Positive braid equivalence is transitive. -/
theorem trans (h₁ : PositiveBraidEquiv u v) (h₂ : PositiveBraidEquiv v w) :
    PositiveBraidEquiv u w :=
  Relation.EqvGen.trans _ _ _ h₁ h₂

/-- A single step is a positive braid equivalence. -/
theorem of_step (h : PositiveBraidStep u v) : PositiveBraidEquiv u v :=
  Relation.EqvGen.rel _ _ h

/-- Equal words are positive braid equivalent. -/
theorem of_eq (h : u = v) : PositiveBraidEquiv u v :=
  h ▸ refl u

/-- Transitivity of positive braid equivalence, for `calc` chains. -/
instance instTransPositiveBraidEquiv :
    Trans (@PositiveBraidEquiv m) (@PositiveBraidEquiv m) (@PositiveBraidEquiv m) :=
  ⟨trans⟩

/-- Positive braid equivalence is an equivalence relation. -/
theorem equivalence : Equivalence (@PositiveBraidEquiv m) :=
  ⟨refl, symm, trans⟩

/-- A far commutation inside a word. -/
theorem far (u v : PositiveAdjacentWord m) (i j : Fin (m - 1))
    (h : i.val + 2 ≤ j.val ∨ j.val + 2 ≤ i.val) :
    PositiveBraidEquiv (u ++ i :: j :: v) (u ++ j :: i :: v) :=
  of_step (.far u v i j h)

/-- A positive braid relation inside a word. -/
theorem braid (u v : PositiveAdjacentWord m) (i j : Fin (m - 1)) (h : j.val = i.val + 1) :
    PositiveBraidEquiv (u ++ [i, j, i] ++ v) (u ++ [j, i, j] ++ v) :=
  of_step (.braid u v i j h)

/-- A map of words sending each step to a step preserves positive braid equivalence. -/
theorem map_of_step {f : PositiveAdjacentWord m → PositiveAdjacentWord m}
    (hf : ∀ u v, PositiveBraidStep u v → PositiveBraidStep (f u) (f v))
    (h : PositiveBraidEquiv u v) : PositiveBraidEquiv (f u) (f v) := by
  unfold PositiveBraidEquiv at h
  induction h with
  | rel x y hxy => exact of_step (hf x y hxy)
  | refl x => exact refl _
  | symm x y _ ih => exact ih.symm
  | trans x y z _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- A property of pairs of words that is an equivalence relation and holds for every step
holds for every pair of positive braid equivalent words. -/
theorem rec_on_steps {p : PositiveAdjacentWord m → PositiveAdjacentWord m → Prop}
    (hp : Equivalence p) (hstep : ∀ u v, PositiveBraidStep u v → p u v)
    (h : PositiveBraidEquiv u v) : p u v := by
  unfold PositiveBraidEquiv at h
  induction h with
  | rel x y hxy => exact hstep x y hxy
  | refl x => exact hp.refl x
  | symm x y _ ih => exact hp.symm ih
  | trans x y z _ _ ih₁ ih₂ => exact hp.trans ih₁ ih₂

/-- Positive braid equivalence is preserved by adding a word on the left. -/
theorem append_left (h : PositiveBraidEquiv u v) (a : PositiveAdjacentWord m) :
    PositiveBraidEquiv (a ++ u) (a ++ v) :=
  map_of_step (fun _ _ hs => hs.append_left a) h

/-- Positive braid equivalence is preserved by adding a word on the right. -/
theorem append_right (h : PositiveBraidEquiv u v) (b : PositiveAdjacentWord m) :
    PositiveBraidEquiv (u ++ b) (v ++ b) :=
  map_of_step (fun _ _ hs => hs.append_right b) h

/-- Positive braid equivalence is a congruence for concatenation. -/
theorem append {u' v' : PositiveAdjacentWord m} (h₁ : PositiveBraidEquiv u v)
    (h₂ : PositiveBraidEquiv u' v') : PositiveBraidEquiv (u ++ u') (v ++ v') :=
  (h₁.append_right u').trans (h₂.append_left v)

/-- Positive braid equivalence is preserved inside an arbitrary context. -/
theorem append_middle (h : PositiveBraidEquiv u v) (a b : PositiveAdjacentWord m) :
    PositiveBraidEquiv (a ++ u ++ b) (a ++ v ++ b) :=
  (h.append_left a).append_right b

/-- Positive braid equivalence is preserved by adding a letter on the left. -/
theorem cons (h : PositiveBraidEquiv u v) (i : Fin (m - 1)) :
    PositiveBraidEquiv (i :: u) (i :: v) :=
  h.append_left [i]

/-- Positive braid equivalent words have equal length. -/
theorem length_eq (h : PositiveBraidEquiv u v) : u.length = v.length :=
  rec_on_steps (p := fun u v => u.length = v.length)
    ⟨fun _ => rfl, fun h => h.symm, fun h₁ h₂ => h₁.trans h₂⟩
    (fun _ _ hs => hs.length_eq) h

/-- Positive braid equivalent words have the same strand permutation. -/
theorem permutation_eq (h : PositiveBraidEquiv u v) : u.permutation = v.permutation :=
  rec_on_steps (p := fun u v => u.permutation = v.permutation)
    ⟨fun _ => rfl, fun h => h.symm, fun h₁ h₂ => h₁.trans h₂⟩
    (fun _ _ hs => hs.permutation_eq) h

/-- Positive braid equivalent words have the same letters. -/
theorem toFinset_eq (h : PositiveBraidEquiv u v) : u.toFinset = v.toFinset :=
  rec_on_steps (p := fun u v => u.toFinset = v.toFinset)
    ⟨fun _ => rfl, fun h => h.symm, fun h₁ h₂ => h₁.trans h₂⟩
    (fun _ _ hs => hs.toFinset_eq) h

/-- Positive braid equivalent words have the same generator indices. -/
theorem generatorIndices_eq (h : PositiveBraidEquiv u v) :
    u.toSigned.generatorIndices = v.toSigned.generatorIndices := by
  rw [PositiveAdjacentWord.toSigned_generatorIndices,
    PositiveAdjacentWord.toSigned_generatorIndices, h.toFinset_eq]

/-- Positive braid equivalent words have the same cycle count. -/
theorem cycleCount_eq (h : PositiveBraidEquiv u v) :
    u.toSigned.cycleCount = v.toSigned.cycleCount := by
  apply SignedAdjacentWord.cycleCount_eq_of_isConj
  change IsConj u.permutation v.permutation
  rw [h.permutation_eq]

/-- A letter moves to the left past a word all of whose letters are far from it. -/
theorem append_singleton_of_far (w : PositiveAdjacentWord m) (x : Fin (m - 1))
    (hw : ∀ y ∈ w, y.val + 2 ≤ x.val ∨ x.val + 2 ≤ y.val) :
    PositiveBraidEquiv (w ++ [x]) (x :: w) := by
  induction w with
  | nil => exact refl _
  | cons y w ih =>
    have h₁ : PositiveBraidEquiv (y :: (w ++ [x])) (y :: x :: w) :=
      (ih fun z hz => hw z (List.mem_cons_of_mem y hz)).cons y
    have h₂ : PositiveBraidEquiv (y :: x :: w) (x :: y :: w) :=
      far [] w y x (hw y List.mem_cons_self)
    exact h₁.trans h₂

end PositiveBraidEquiv

namespace PositiveWordConj

variable {m : ℕ} {u v w : PositiveAdjacentWord m}

/-- Conjugate positive words have equal length. -/
theorem length_eq (h : PositiveWordConj u v) : u.length = v.length := by
  induction h with
  | cyclic u i => simp
  | far u v i j _ => simp
  | braid u v i j _ => simp
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- The left word of a conjugate pair is nonempty. -/
theorem ne_nil_left (h : PositiveWordConj u v) : u ≠ [] := by
  induction h with
  | cyclic u i => simp
  | far u v i j _ => simp
  | braid u v i j _ => simp
  | symm h ih =>
    intro hv
    apply ih
    have hl := h.length_eq
    rw [hv, List.length_nil] at hl
    exact List.eq_nil_of_length_eq_zero hl
  | trans _ _ ih₁ _ => exact ih₁

/-- The right word of a conjugate pair is nonempty. -/
theorem ne_nil_right (h : PositiveWordConj u v) : v ≠ [] :=
  h.symm.ne_nil_left

/-- Every nonempty positive word is conjugate to itself. -/
theorem refl_of_ne_nil (hu : u ≠ []) : PositiveWordConj u u := by
  rcases List.eq_nil_or_concat u with h | ⟨u', i, rfl⟩
  · exact absurd h hu
  · rw [List.concat_eq_append]
    exact (cyclic u' i).trans (cyclic u' i).symm

/-- Rotation of a block: the words `α ++ β` and `β ++ α` are conjugate when `α ++ β` is
nonempty. -/
theorem append_comm (α β : PositiveAdjacentWord m) (hne : α ++ β ≠ []) :
    PositiveWordConj (α ++ β) (β ++ α) := by
  induction β generalizing α with
  | nil => simpa using refl_of_ne_nil (by simpa using hne)
  | cons b β ih =>
    have h₁ := ih (α ++ [b]) (by simp)
    have h₂ := cyclic (β ++ α) b
    simp only [List.append_assoc, List.cons_append, List.nil_append] at h₁ h₂ ⊢
    exact h₁.trans h₂

/-- Conjugate positive words have the same letters. -/
theorem toFinset_eq (h : PositiveWordConj u v) : u.toFinset = v.toFinset := by
  induction h with
  | cyclic u i => ext x; simp
  | far u v i j _ => ext x; simp; tauto
  | braid u v i j _ => ext x; simp; tauto
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- Conjugate positive words have the same generator indices. -/
theorem generatorIndices_eq (h : PositiveWordConj u v) :
    u.toSigned.generatorIndices = v.toSigned.generatorIndices := by
  rw [PositiveAdjacentWord.toSigned_generatorIndices,
    PositiveAdjacentWord.toSigned_generatorIndices, h.toFinset_eq]

/-- Conjugate positive words have conjugate strand permutations. -/
theorem isConj_permutation (h : PositiveWordConj u v) : IsConj u.permutation v.permutation := by
  induction h with
  | cyclic u i =>
    rw [isConj_iff]
    refine ⟨adjacentSwap i, ?_⟩
    rw [PositiveAdjacentWord.permutation_append_eq_mul, PositiveAdjacentWord.permutation_cons,
      PositiveAdjacentWord.permutation_cons, PositiveAdjacentWord.permutation_nil]
    group
  | far u v i j h => rw [(PositiveBraidStep.far u v i j h).permutation_eq]
  | braid u v i j h => rw [(PositiveBraidStep.braid u v i j h).permutation_eq]
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- Conjugate positive words have the same cycle count. -/
theorem cycleCount_eq (h : PositiveWordConj u v) :
    u.toSigned.cycleCount = v.toSigned.cycleCount :=
  SignedAdjacentWord.cycleCount_eq_of_isConj h.isConj_permutation

end PositiveWordConj

/-- The empty word is conjugate to no word. -/
theorem not_positiveWordConj_nil_left {m : ℕ} (v : PositiveAdjacentWord m) :
    ¬PositiveWordConj [] v :=
  fun h => h.ne_nil_left rfl

/-- No word is conjugate to the empty word. -/
theorem not_positiveWordConj_nil_right {m : ℕ} (u : PositiveAdjacentWord m) :
    ¬PositiveWordConj u [] :=
  fun h => h.ne_nil_right rfl

namespace PositiveBraidEquiv

variable {m : ℕ} {u v w : PositiveAdjacentWord m}

/-- Positive braid equivalence implies positive word conjugacy for nonempty words. The cyclic
constructor of `PositiveWordConj` is used only to obtain reflexivity on nonempty words. -/
theorem positiveWordConj (h : PositiveBraidEquiv u v) (hu : u ≠ []) : PositiveWordConj u v := by
  have key : u.length = v.length ∧ (u ≠ [] → PositiveWordConj u v) := by
    refine rec_on_steps
      (p := fun u v => u.length = v.length ∧ (u ≠ [] → PositiveWordConj u v))
      ⟨?_, ?_, ?_⟩ ?_ h
    · intro x
      exact ⟨rfl, PositiveWordConj.refl_of_ne_nil⟩
    · intro x y hxy
      refine ⟨hxy.1.symm, fun hy => (hxy.2 ?_).symm⟩
      intro hx
      apply hy
      have hl := hxy.1
      rw [hx, List.length_nil] at hl
      exact List.eq_nil_of_length_eq_zero hl.symm
    · intro x y z hxy hyz
      exact ⟨hxy.1.trans hyz.1, fun hx => (hxy.2 hx).trans (hyz.2 (hxy.2 hx).ne_nil_right)⟩
    · intro x y hs
      refine ⟨hs.length_eq, fun _ => ?_⟩
      cases hs with
      | far u v i j h => exact PositiveWordConj.far u v i j h
      | braid u v i j h => exact PositiveWordConj.braid u v i j h
  exact key.2 hu

/-- Positive braid equivalence inside a context implies positive word conjugacy when the
resulting word is nonempty. -/
theorem positiveWordConj_append_middle (h : PositiveBraidEquiv u v) (a b : PositiveAdjacentWord m)
    (hne : a ++ u ++ b ≠ []) : PositiveWordConj (a ++ u ++ b) (a ++ v ++ b) :=
  (h.append_middle a b).positiveWordConj hne

/-- Positive braid equivalence followed by positive word conjugacy is positive word
conjugacy. -/
theorem trans_positiveWordConj (h₁ : PositiveBraidEquiv u v) (h₂ : PositiveWordConj v w) :
    PositiveWordConj u w := by
  refine (h₁.positiveWordConj ?_).trans h₂
  intro hu
  apply h₂.ne_nil_left
  have hl := h₁.length_eq
  rw [hu, List.length_nil] at hl
  exact List.eq_nil_of_length_eq_zero hl.symm

end PositiveBraidEquiv

/-- Positive word conjugacy followed by positive braid equivalence is positive word
conjugacy. -/
theorem PositiveWordConj.trans_positiveBraidEquiv {m : ℕ} {u v w : PositiveAdjacentWord m}
    (h₁ : PositiveWordConj u v) (h₂ : PositiveBraidEquiv v w) : PositiveWordConj u w :=
  h₁.trans (h₂.positiveWordConj h₁.ne_nil_right)

end OnLeConjecture.KnotTheory
