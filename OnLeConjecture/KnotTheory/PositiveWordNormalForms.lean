module

public import OnLeConjecture.KnotTheory.PositiveBraidGridSelectedRepresentative
import all OnLeConjecture.KnotTheory.BraidPermutationCycles

/-! # Positive word normal forms

This module fixes the Coxeter word, the torus words, the full-twist word, the
selected grid of a positive word, and positive word conjugacy (job J02 of the
dependency audit). The permutation of the Coxeter word on `m` strands is the
rotation `i ↦ i + 1`, so the full-twist word acts trivially on strands.

The selected grid of a word satisfies the incidence equation `X = O ∘ matching`
and preserves the strict order of the unperturbed arc rows. These two equations
are consequences of the fields of `PositiveRoundedWordRepresentativeData`.
-/

@[expose] public noncomputable section

namespace OnLeConjecture.KnotTheory

open Equiv

/-- The Coxeter word `σ₀ σ₁ ⋯ σ_{m-2}` on `m` strands. -/
def coxeterWord (m : ℕ) : PositiveAdjacentWord m := List.finRange (m - 1)

/-- The word `(σ₀ σ₁ ⋯ σ_{m-2})^N`, whose closure is the torus link `T(m, N)`. -/
def torusWord (m N : ℕ) : PositiveAdjacentWord m := (List.replicate N (coxeterWord m)).flatten

/-- The positive full twist `Δ² = (σ₀ σ₁ ⋯ σ_{m-2})^m`. -/
def fullTwistWord (m : ℕ) : PositiveAdjacentWord m := torusWord m m

/-- The grid diagram selected for a positive word. -/
def wordGrid {m : ℕ} (w : PositiveAdjacentWord m) : TauCeti.GridDiagram (w.length * 3) :=
  (positiveRoundedWordSelectedData w).grid

/-- Conjugacy of positive words generated by cyclic rotation, far commutation, and the
positive braid relation. No inverse letters occur. -/
inductive PositiveWordConj {m : ℕ} : PositiveAdjacentWord m → PositiveAdjacentWord m → Prop
  | cyclic (u : PositiveAdjacentWord m) (i : Fin (m - 1)) : PositiveWordConj (u ++ [i]) (i :: u)
  | far (u v : PositiveAdjacentWord m) (i j : Fin (m - 1))
      (h : i.val + 2 ≤ j.val ∨ j.val + 2 ≤ i.val) :
      PositiveWordConj (u ++ i :: j :: v) (u ++ j :: i :: v)
  | braid (u v : PositiveAdjacentWord m) (i j : Fin (m - 1)) (h : j.val = i.val + 1) :
      PositiveWordConj (u ++ [i, j, i] ++ v) (u ++ [j, i, j] ++ v)
  | symm {u v} : PositiveWordConj u v → PositiveWordConj v u
  | trans {u v x} : PositiveWordConj u v → PositiveWordConj v x → PositiveWordConj u x

theorem torusWord_length (m N : ℕ) : (torusWord m N).length = N * (m - 1) := by
  simp [torusWord, coxeterWord, List.length_flatten, List.map_replicate, List.sum_replicate]

theorem torusWord_succ (m N : ℕ) : torusWord m (N + 1) = torusWord m N ++ coxeterWord m := by
  simp [torusWord, List.replicate_succ', List.flatten_append]

/-- The permutation of a positive word is the product of its adjacent transpositions. -/
theorem PositiveAdjacentWord.permutation_eq_prod {m : ℕ} (w : PositiveAdjacentWord m) :
    w.permutation = (w.map adjacentSwap).prod := by
  induction w with
  | nil => simp
  | cons i w ih => simp [ih]

private theorem adjacentSwap_val {m : ℕ} (i : Fin (m - 1)) (y : Fin m) :
    (adjacentSwap i y).val =
      if y.val = i.val then i.val + 1 else if y.val = i.val + 1 then i.val else y.val := by
  simp only [adjacentSwap, Equiv.swap_apply_def, Fin.ext_iff]
  split_ifs <;> simp_all

/-- The product `σ₀ ⋯ σ_{k-1}` of the first `k` adjacent transpositions sends `x < k` to
`x + 1`, sends `k` to `0`, and fixes every `x > k`. -/
private theorem prefixProduct_val {m : ℕ} (k : ℕ) (hk : k ≤ m - 1) (x : Fin m) :
    ((((List.finRange (m - 1)).take k).map adjacentSwap).prod x).val =
      if x.val < k then x.val + 1 else if x.val = k then 0 else x.val := by
  induction k generalizing x with
  | zero =>
    simp only [List.take_zero, List.map_nil, List.prod_nil, Perm.coe_one, id_eq]
    split_ifs <;> omega
  | succ k ih =>
    have hk' : k < (List.finRange (m - 1)).length := by simp; omega
    rw [List.take_add_one, List.getElem?_eq_getElem hk', List.map_append, List.prod_append,
      Perm.mul_apply]
    simp only [Option.toList_some, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil,
      mul_one, List.getElem_finRange]
    have hswap : ∀ y : Fin m, (adjacentSwap (Fin.cast List.length_finRange ⟨k, hk'⟩ :
        Fin (m - 1)) y).val = if y.val = k then k + 1 else if y.val = k + 1 then k else y.val := by
      intro y
      rw [adjacentSwap_val]
      rfl
    have ih' := ih (by omega)
    set y := adjacentSwap (Fin.cast List.length_finRange ⟨k, hk'⟩ : Fin (m - 1)) x with hy
    have hyv := hswap x
    rw [← hy] at hyv
    rw [ih' y]
    split_ifs at hyv ⊢ <;> omega

/-- The Coxeter word permutes the strands by the rotation `i ↦ i + 1`. -/
theorem coxeterWord_permutation (m : ℕ) : (coxeterWord m).permutation = finRotate m := by
  rcases Nat.eq_zero_or_pos m with rfl | hm
  · exact Subsingleton.elim _ _
  obtain ⟨n, rfl⟩ : ∃ n, m = n + 1 := ⟨m - 1, by omega⟩
  ext x
  have h := prefixProduct_val (m := n + 1) (n + 1 - 1) le_rfl x
  rw [List.take_of_length_le (by simp)] at h
  rw [PositiveAdjacentWord.permutation_eq_prod, coxeterWord, h, coe_finRotate]
  have hx := x.isLt
  by_cases hl : x = Fin.last n
  · subst hl
    simp
  · have hlt : x.val < n := Fin.val_lt_last hl
    rw [if_neg hl, if_pos (by omega)]

/-- The rotation of `m` strands has order dividing `m`. -/
theorem finRotate_pow_self (m : ℕ) : (finRotate m) ^ m = 1 := by
  rcases lt_or_ge m 2 with hm | hm
  · interval_cases m <;> exact Subsingleton.elim _ _
  · have h := Equiv.Perm.lcm_cycleType (finRotate m)
    rw [cycleType_finRotate_of_le hm] at h
    simp only [Multiset.lcm_singleton, normalize_eq] at h
    calc (finRotate m) ^ m = (finRotate m) ^ orderOf (finRotate m) := by rw [← h]
      _ = 1 := pow_orderOf_eq_one _

theorem torusWord_permutation (m N : ℕ) : (torusWord m N).permutation = (finRotate m) ^ N := by
  induction N with
  | zero => simp [torusWord]
  | succ N ih =>
    rw [torusWord_succ, PositiveAdjacentWord.permutation_eq_prod, List.map_append,
      List.prod_append, ← PositiveAdjacentWord.permutation_eq_prod,
      ← PositiveAdjacentWord.permutation_eq_prod, ih, coxeterWord_permutation, pow_succ]

/-- The full twist acts trivially on strands. -/
theorem fullTwistWord_permutation (m : ℕ) : (fullTwistWord m).toSigned.permutation = 1 := by
  change (torusWord m m).permutation = 1
  rw [torusWord_permutation, finRotate_pow_self]

/-- Every adjacent generator occurs in the full twist. -/
theorem fullTwistWord_generatorIndices (m : ℕ) :
    (fullTwistWord m).toSigned.generatorIndices = Finset.univ := by
  ext i
  simp only [Finset.mem_univ, iff_true]
  have hm : 0 < m := by have := i.isLt; omega
  simp only [SignedAdjacentWord.generatorIndices, PositiveAdjacentWord.toSigned, List.map_map,
    List.mem_toFinset, List.mem_map, Function.comp_apply]
  refine ⟨i, ?_, rfl⟩
  simp only [fullTwistWord, torusWord, List.mem_flatten, List.mem_replicate]
  exact ⟨coxeterWord m, ⟨by omega, rfl⟩, List.mem_finRange i⟩

/-- The selected grid satisfies the incidence equation `X = O ∘ matching⁻¹` of the
rectilinear word grid. -/
theorem wordGrid_X_eq {m : ℕ} (w : PositiveAdjacentWord m) (a : Fin w.length × Fin 3) :
    (wordGrid w).X (finProdFinEquiv a) =
      (wordGrid w).O (finProdFinEquiv ((positiveRectilinearWordMatching w).symm a)) := by
  let d := positiveRoundedWordSelectedData w
  apply d.row_strictMono.injective
  change d.row (d.grid.X (finProdFinEquiv a)) =
    d.row (d.grid.O (finProdFinEquiv ((positiveRectilinearWordMatching w).symm a)))
  rw [d.row_X, d.row_O]

/-- The selected grid preserves the strict order of the unperturbed arc rows. -/
theorem wordGrid_O_lt_of_arcRow_lt {m : ℕ} (w : PositiveAdjacentWord m)
    {a b : Fin w.length × Fin 3}
    (h : positiveRectilinearWordArcRow w a < positiveRectilinearWordArcRow w b) :
    (wordGrid w).O (finProdFinEquiv a) < (wordGrid w).O (finProdFinEquiv b) := by
  let d := positiveRoundedWordSelectedData w
  have hg := d.g_order a b h
  rw [← d.row_O, ← d.row_O] at hg
  exact d.row_strictMono.lt_iff_lt.mp hg

end OnLeConjecture.KnotTheory
