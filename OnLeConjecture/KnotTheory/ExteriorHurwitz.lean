/-! # Hurwitz moves that make every entry move a common point

This module formalizes Lemmas `commonStrandHurwitz` and `orderedCommonStrandHurwitz` of the
written proof of Statement E (statement_E_complete_proof.tex, Section 9).

Let `G` be a group and let `φ : G →* Equiv.Perm α` be a homomorphism to the permutations of a
finite type `α`. Fix a point `o : α`. A labelled tuple is a list `l : List (ι × G)` of pairs formed
by a label and a group element. The Hurwitz move `HurwitzMove` replaces two consecutive entries
`(p, a) (q, b)` by `(q, a * b * a⁻¹) (p, a)`, and `HurwitzEquiv` is the equivalence relation that
these moves generate. The ordered product of the elements is invariant (`HurwitzEquiv.prod_eq`),
and the list of pairs formed by a label and the conjugacy class of its element is invariant up to
permutation (`HurwitzEquiv.perm_conjClasses`).

* `exists_hurwitzEquiv_forall_moves` (Lemma `commonStrandHurwitz`): if `φ` sends every element
  of `l` to a cycle and every point of `α` is the image of `o` under an element of the subgroup
  generated by these cycles, then `l` is Hurwitz equivalent to a tuple in which every element is
  sent to a permutation moving `o`.
* `exists_hurwitzEquiv_labels_of_perm` (Lemma `orderedCommonStrandHurwitz`): if every element of
  `l` is sent to a permutation moving `o`, then every rearrangement of the labels of `l` is realized
  by a Hurwitz equivalent tuple in which every element is sent to a permutation moving `o`.
* `exists_hurwitzEquiv_ordered_commonStrand` combines the two lemmas, and the theorems with the
  suffix `_invariants` add the invariance of the product and of the labelled conjugacy classes.

The proofs follow the written argument. Write `H` for the Hurwitz move at one adjacent pair
`(p, g) (q, c)` and `P = g * c`. The closed formulas `hurwitzEquiv_conj_pow`,
`hurwitzEquiv_exchange_pow` and `hurwitzEquiv_inv_conj_pow` compute `H ^ (2 * k)`,
`H ^ (2 * k + 1)` and `H ^ (-2 * k)`.

For Lemma `commonStrandHurwitz`, assume that some entry fixes `o`. Suppose that no image of an
entry moving `o` shares a moved point with the image of an entry fixing `o`. Then the set formed
by `o` and the points moved by the images of the entries moving `o` is invariant under the
generated subgroup. By transitivity this set contains every point, although the image of an entry
fixing `o` is a cycle and moves points outside this set. Hence some entry `g` moving `o` and some
entry `c` fixing `o` have images that move a common point (`exists_moving_fixing_support_meet`).
The entry `c` is moved next to `g` by `hurwitzEquiv_moveLeft` or `hurwitzEquiv_moveRight`, which
do not change which entries move `o`. When `c` precedes `g`, one further Hurwitz move replaces the
pair `c g` by the pair formed by `c * g * c⁻¹` and `c`. The forward orbit of `o` under `φ P`
provides the exponent in `hurwitzEquiv_inv_conj_pow` (`exists_forward_orbit_mem`), so that the
number of entries fixing `o` decreases strictly (`exists_hurwitzEquiv_countP_lt`).

For Lemma `orderedCommonStrandHurwitz`, the backward orbit of `o` under `φ P` provides the
exponent in `hurwitzEquiv_exchange_pow` (`exists_backward_orbit_mem`), which exchanges two adjacent
entries. An induction on `List.Perm` reduces every rearrangement of the labels to such exchanges.

The main theorems assume `Finite α` in place of `Fintype α` and do not assume `DecidableEq α`,
since decidability of equality is used only inside their proofs.
-/

@[expose] public section

namespace OnLeConjecture.KnotTheory

variable {ι G α : Type*} [Group G]

/-- One Hurwitz move at an adjacent pair of a labelled tuple. The move replaces two consecutive
entries `(p, a) (q, b)` by `(q, a * b * a⁻¹) (p, a)` and leaves the entries before and after them
unchanged. -/
inductive HurwitzMove : List (ι × G) → List (ι × G) → Prop
  | mk (pre post : List (ι × G)) (a b : ι × G) :
      HurwitzMove (pre ++ a :: b :: post) (pre ++ (b.1, a.2 * b.2 * a.2⁻¹) :: a :: post)

/-- The equivalence relation on labelled tuples generated by Hurwitz moves. Two tuples are related
when one is obtained from the other by finitely many Hurwitz moves and inverse Hurwitz moves. -/
def HurwitzEquiv : List (ι × G) → List (ι × G) → Prop := Relation.EqvGen HurwitzMove

namespace HurwitzEquiv

/-- Every labelled tuple is Hurwitz equivalent to itself. -/
theorem refl (l : List (ι × G)) : HurwitzEquiv l l := Relation.EqvGen.refl l

/-- Hurwitz equivalence is symmetric. -/
theorem symm {l l' : List (ι × G)} (h : HurwitzEquiv l l') : HurwitzEquiv l' l :=
  Relation.EqvGen.symm _ _ h

/-- Hurwitz equivalence is transitive. -/
theorem trans {l l' l'' : List (ι × G)} (h : HurwitzEquiv l l') (h' : HurwitzEquiv l' l'') :
    HurwitzEquiv l l'' :=
  Relation.EqvGen.trans _ _ _ h h'

/-- Two tuples related by one Hurwitz move are Hurwitz equivalent. -/
theorem of_move {l l' : List (ι × G)} (h : HurwitzMove l l') : HurwitzEquiv l l' :=
  Relation.EqvGen.rel _ _ h

end HurwitzEquiv

/-- A Hurwitz move preserves the ordered product of the group elements of a labelled tuple. -/
theorem HurwitzMove.prod_eq {l l' : List (ι × G)} (h : HurwitzMove l l') :
    (l.map Prod.snd).prod = (l'.map Prod.snd).prod := by
  obtain ⟨pre, post, a, b⟩ := h
  simp only [List.map_append, List.map_cons, List.prod_append, List.prod_cons]
  group

/-- Hurwitz equivalent tuples have the same ordered product of group elements. -/
theorem HurwitzEquiv.prod_eq {l l' : List (ι × G)} (h : HurwitzEquiv l l') :
    (l.map Prod.snd).prod = (l'.map Prod.snd).prod := by
  induction h with
  | rel _ _ h => exact h.prod_eq
  | refl => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih ih' => exact ih.trans ih'

/-- After a Hurwitz move, the list of pairs formed by a label and the conjugacy class of its
element is a permutation of the corresponding list before the move. -/
theorem HurwitzMove.perm_conjClasses {l l' : List (ι × G)} (h : HurwitzMove l l') :
    (l.map fun p => (p.1, ConjClasses.mk p.2)).Perm
      (l'.map fun p => (p.1, ConjClasses.mk p.2)) := by
  obtain ⟨pre, post, a, b⟩ := h
  have hb : ConjClasses.mk (a.2 * b.2 * a.2⁻¹) = ConjClasses.mk b.2 :=
    ConjClasses.mk_eq_mk_iff_isConj.mpr (isConj_iff.mpr ⟨a.2⁻¹, by group⟩)
  simp only [List.map_append, List.map_cons, hb]
  exact List.Perm.append_left _ (List.Perm.swap _ _ _)

/-- For Hurwitz equivalent tuples, the lists of pairs formed by a label and the conjugacy class of
its element are permutations of each other. In particular, the labels keep elements in the same
conjugacy classes. -/
theorem HurwitzEquiv.perm_conjClasses {l l' : List (ι × G)} (h : HurwitzEquiv l l') :
    (l.map fun p => (p.1, ConjClasses.mk p.2)).Perm
      (l'.map fun p => (p.1, ConjClasses.mk p.2)) := by
  induction h with
  | rel _ _ h => exact h.perm_conjClasses
  | refl => exact List.Perm.refl _
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih ih' => exact ih.trans ih'

/-! ### Lifting Hurwitz moves to a larger tuple -/

/-- A Hurwitz move remains a Hurwitz move after a list `A` of entries is placed in front of both
tuples. -/
theorem HurwitzMove.append_left (A : List (ι × G)) {l l' : List (ι × G)} (h : HurwitzMove l l') :
    HurwitzMove (A ++ l) (A ++ l') := by
  obtain ⟨pre, post, a, b⟩ := h
  simpa only [List.append_assoc] using HurwitzMove.mk (A ++ pre) post a b

/-- A Hurwitz move remains a Hurwitz move after a list `C` of entries is appended to both tuples. -/
theorem HurwitzMove.append_right (C : List (ι × G)) {l l' : List (ι × G)} (h : HurwitzMove l l') :
    HurwitzMove (l ++ C) (l' ++ C) := by
  obtain ⟨pre, post, a, b⟩ := h
  simpa only [List.append_assoc, List.cons_append] using HurwitzMove.mk pre (post ++ C) a b

/-- If a map of labelled tuples sends every Hurwitz move to a Hurwitz move, then it sends Hurwitz
equivalent tuples to Hurwitz equivalent tuples. -/
theorem HurwitzEquiv.of_map {f : List (ι × G) → List (ι × G)}
    (hf : ∀ l l', HurwitzMove l l' → HurwitzMove (f l) (f l')) {l l' : List (ι × G)}
    (h : HurwitzEquiv l l') : HurwitzEquiv (f l) (f l') := by
  induction h with
  | rel _ _ h => exact .of_move (hf _ _ h)
  | refl => exact .refl _
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih ih' => exact ih.trans ih'

/-- Hurwitz equivalence is preserved when a list `A` of entries is placed in front of both
tuples. -/
theorem HurwitzEquiv.append_left (A : List (ι × G)) {l l' : List (ι × G)}
    (h : HurwitzEquiv l l') : HurwitzEquiv (A ++ l) (A ++ l') :=
  h.of_map (f := (A ++ ·)) fun _ _ hm => hm.append_left A

/-- Hurwitz equivalence is preserved when a list `C` of entries is appended to both tuples. -/
theorem HurwitzEquiv.append_right (C : List (ι × G)) {l l' : List (ι × G)}
    (h : HurwitzEquiv l l') : HurwitzEquiv (l ++ C) (l' ++ C) :=
  h.of_map (f := (· ++ C)) fun _ _ hm => hm.append_right C

/-- Hurwitz equivalence is preserved when an entry `a` is placed in front of both tuples. -/
theorem HurwitzEquiv.cons (a : ι × G) {l l' : List (ι × G)} (h : HurwitzEquiv l l') :
    HurwitzEquiv (a :: l) (a :: l') :=
  h.append_left [a]

/-! ### Iterated Hurwitz moves at one adjacent pair -/

/-- The Hurwitz move at the pair `(p, x) (q, y)` that follows the prefix `pre`. -/
theorem hurwitzEquiv_move (pre post : List (ι × G)) (p q : ι) (x y : G) :
    HurwitzEquiv (pre ++ (p, x) :: (q, y) :: post) (pre ++ (q, x * y * x⁻¹) :: (p, x) :: post) :=
  .of_move (HurwitzMove.mk pre post (p, x) (q, y))

/-- The inverse Hurwitz move at the pair `(p, x) (q, y)`. The right entry moves to the left
unchanged, and the left entry moves to the right with its element conjugated by `y⁻¹`. -/
theorem hurwitzEquiv_move_inv (pre post : List (ι × G)) (p q : ι) (x y : G) :
    HurwitzEquiv (pre ++ (p, x) :: (q, y) :: post) (pre ++ (q, y) :: (p, y⁻¹ * x * y) :: post) := by
  have h := hurwitzEquiv_move pre post q p y (y⁻¹ * x * y)
  rw [show y * (y⁻¹ * x * y) * y⁻¹ = x by group] at h
  exact h.symm

/-- Two Hurwitz moves at the pair `(p, x) (q, y)` conjugate both elements by `x * y` and restore
the order of the labels. -/
theorem hurwitzEquiv_two_moves (pre post : List (ι × G)) (p q : ι) (x y : G) :
    HurwitzEquiv (pre ++ (p, x) :: (q, y) :: post)
      (pre ++ (p, x * y * x * (x * y)⁻¹) :: (q, x * y * y * (x * y)⁻¹) :: post) := by
  have h := (hurwitzEquiv_move pre post p q x y).trans
    (hurwitzEquiv_move pre post q p (x * y * x⁻¹) x)
  rwa [show x * y * x⁻¹ * x * (x * y * x⁻¹)⁻¹ = x * y * x * (x * y)⁻¹ by group,
    show x * y * x⁻¹ = x * y * y * (x * y)⁻¹ by group] at h

/-- Conjugating `P ^ k * x * (P ^ k)⁻¹` by `P` gives `P ^ (k + 1) * x * (P ^ (k + 1))⁻¹`. -/
theorem conj_pow_succ (P x : G) (k : ℕ) :
    P * (P ^ k * x * (P ^ k)⁻¹) * P⁻¹ = P ^ (k + 1) * x * (P ^ (k + 1))⁻¹ := by
  rw [pow_succ']
  group

/-- Conjugation by `P ^ k` is multiplicative. -/
theorem conj_pow_mul_conj_pow (P x y : G) (k : ℕ) :
    P ^ k * x * (P ^ k)⁻¹ * (P ^ k * y * (P ^ k)⁻¹) = P ^ k * (x * y) * (P ^ k)⁻¹ := by
  group

/-- Closed formula for the iterated Hurwitz move `H ^ (2 * k)` at the pair `(p, g) (q, c)`. Write
`P = g * c`. Then the pair becomes `(p, P ^ k * g * (P ^ k)⁻¹) (q, P ^ k * c * (P ^ k)⁻¹)`. -/
theorem hurwitzEquiv_conj_pow (pre post : List (ι × G)) (p q : ι) (g c : G) (k : ℕ) :
    HurwitzEquiv (pre ++ (p, g) :: (q, c) :: post)
      (pre ++ (p, (g * c) ^ k * g * ((g * c) ^ k)⁻¹) ::
        (q, (g * c) ^ k * c * ((g * c) ^ k)⁻¹) :: post) := by
  induction k with
  | zero => simpa using HurwitzEquiv.refl _
  | succ k ih =>
    refine ih.trans ?_
    have hP : (g * c) ^ k * g * ((g * c) ^ k)⁻¹ * ((g * c) ^ k * c * ((g * c) ^ k)⁻¹) = g * c := by
      rw [conj_pow_mul_conj_pow, ← pow_succ, pow_succ', mul_inv_cancel_right]
    have h := hurwitzEquiv_two_moves pre post p q ((g * c) ^ k * g * ((g * c) ^ k)⁻¹)
      ((g * c) ^ k * c * ((g * c) ^ k)⁻¹)
    rwa [hP, conj_pow_succ, conj_pow_succ] at h

/-- Conjugation by `P ^ k` commutes with the operation `(x, y) ↦ x * y * x⁻¹`. -/
theorem conj_pow_mul_conj_pow_inv (P x y : G) (k : ℕ) :
    P ^ k * x * (P ^ k)⁻¹ * (P ^ k * y * (P ^ k)⁻¹) * (P ^ k * x * (P ^ k)⁻¹)⁻¹ =
      P ^ k * (x * y * x⁻¹) * (P ^ k)⁻¹ := by
  group

/-- Closed formula for the iterated Hurwitz move `H ^ (2 * k + 1)` at the pair `(p, g) (q, c)`.
Write `P = g * c`. Then the pair becomes
`(q, P ^ k * (g * c * g⁻¹) * (P ^ k)⁻¹) (p, P ^ k * g * (P ^ k)⁻¹)`, so the two labels are
exchanged. -/
theorem hurwitzEquiv_exchange_pow (pre post : List (ι × G)) (p q : ι) (g c : G) (k : ℕ) :
    HurwitzEquiv (pre ++ (p, g) :: (q, c) :: post)
      (pre ++ (q, (g * c) ^ k * (g * c * g⁻¹) * ((g * c) ^ k)⁻¹) ::
        (p, (g * c) ^ k * g * ((g * c) ^ k)⁻¹) :: post) := by
  have h := (hurwitzEquiv_conj_pow pre post p q g c k).trans
    (hurwitzEquiv_move pre post p q ((g * c) ^ k * g * ((g * c) ^ k)⁻¹)
      ((g * c) ^ k * c * ((g * c) ^ k)⁻¹))
  rwa [conj_pow_mul_conj_pow_inv] at h

/-- Conjugation by `(P ^ k)⁻¹` is multiplicative. -/
theorem inv_conj_pow_mul_inv_conj_pow (P x y : G) (k : ℕ) :
    (P ^ k)⁻¹ * x * P ^ k * ((P ^ k)⁻¹ * y * P ^ k) = (P ^ k)⁻¹ * (x * y) * P ^ k := by
  group

/-- Conjugation by `(P ^ k)⁻¹` fixes `P`. -/
theorem inv_conj_pow_self (P : G) (k : ℕ) : (P ^ k)⁻¹ * P * P ^ k = P := by
  group

/-- Conjugation by `P ^ k` undoes conjugation by `(P ^ k)⁻¹`. -/
theorem conj_pow_inv_conj_pow (P x : G) (k : ℕ) :
    P ^ k * ((P ^ k)⁻¹ * x * P ^ k) * (P ^ k)⁻¹ = x := by
  group

/-- Closed formula for the inverse iterated Hurwitz move `H ^ (-2 * k)` at the pair
`(p, g) (q, c)`. Write `P = g * c`. Then the pair becomes
`(p, (P ^ k)⁻¹ * g * P ^ k) (q, (P ^ k)⁻¹ * c * P ^ k)`. -/
theorem hurwitzEquiv_inv_conj_pow (pre post : List (ι × G)) (p q : ι) (g c : G) (k : ℕ) :
    HurwitzEquiv (pre ++ (p, g) :: (q, c) :: post)
      (pre ++ (p, ((g * c) ^ k)⁻¹ * g * (g * c) ^ k) ::
        (q, ((g * c) ^ k)⁻¹ * c * (g * c) ^ k) :: post) := by
  have h := hurwitzEquiv_conj_pow pre post p q (((g * c) ^ k)⁻¹ * g * (g * c) ^ k)
    (((g * c) ^ k)⁻¹ * c * (g * c) ^ k) k
  rw [inv_conj_pow_mul_inv_conj_pow, inv_conj_pow_self, conj_pow_inv_conj_pow,
    conj_pow_inv_conj_pow] at h
  exact h.symm

/-! ### Moving one entry across a block of entries -/

/-- The entry `e` moves to the left across the block `B` by inverse Hurwitz moves. The entry `e` is
unchanged, and every element of `B` is conjugated by `e⁻¹` and keeps its label. -/
theorem hurwitzEquiv_moveLeft (A B C : List (ι × G)) (e : ι × G) :
    HurwitzEquiv (A ++ B ++ e :: C)
      (A ++ e :: (B.map (fun p => (p.1, e.2⁻¹ * p.2 * e.2)) ++ C)) := by
  induction B generalizing A with
  | nil => simpa using HurwitzEquiv.refl _
  | cons b B ih =>
    have h1 := ih (A ++ [b])
    have h2 := hurwitzEquiv_move_inv A (B.map (fun p => (p.1, e.2⁻¹ * p.2 * e.2)) ++ C) b.1 e.1
      b.2 e.2
    simp only [List.append_assoc, List.cons_append, List.map_cons, Prod.mk.eta] at h1 h2 ⊢
    exact h1.trans h2

/-- The entry `e` moves to the right across the block `B` by Hurwitz moves. The entry `e` is
unchanged, and every element of `B` is conjugated by `e` and keeps its label. -/
theorem hurwitzEquiv_moveRight (A B C : List (ι × G)) (e : ι × G) :
    HurwitzEquiv (A ++ e :: (B ++ C))
      (A ++ B.map (fun p => (p.1, e.2 * p.2 * e.2⁻¹)) ++ e :: C) := by
  induction B generalizing A with
  | nil => simpa using HurwitzEquiv.refl _
  | cons b B ih =>
    have h1 := hurwitzEquiv_move A (B ++ C) e.1 b.1 e.2 b.2
    have h2 := ih (A ++ [(b.1, e.2 * b.2 * e.2⁻¹)])
    simp only [List.append_assoc, List.cons_append, List.map_cons, Prod.mk.eta] at h1 h2 ⊢
    exact h1.trans h2

/-! ### Moving a point -/

/-- The permutation `σ * τ * σ⁻¹` moves `z` exactly when `τ` moves `σ⁻¹ z`. -/
theorem perm_conj_apply_ne_iff (σ τ : Equiv.Perm α) (z : α) :
    (σ * τ * σ⁻¹) z ≠ z ↔ τ (σ⁻¹ z) ≠ σ⁻¹ z := by
  rw [ne_eq, ne_eq, Equiv.Perm.eq_inv_iff_eq, Equiv.Perm.mul_apply, Equiv.Perm.mul_apply]

/-- The permutation `φ (h * x * h⁻¹)` moves `z` exactly when `φ x` moves `(φ h)⁻¹ z`. -/
theorem moves_conj_iff (φ : G →* Equiv.Perm α) (h x : G) (z : α) :
    φ (h * x * h⁻¹) z ≠ z ↔ φ x ((φ h)⁻¹ z) ≠ (φ h)⁻¹ z := by
  rw [map_mul, map_mul, map_inv]
  exact perm_conj_apply_ne_iff _ _ _

/-- The permutation `φ (h⁻¹ * x * h)` moves `z` exactly when `φ x` moves `φ h z`. -/
theorem moves_inv_conj_iff (φ : G →* Equiv.Perm α) (h x : G) (z : α) :
    φ (h⁻¹ * x * h) z ≠ z ↔ φ x (φ h z) ≠ φ h z := by
  have := moves_conj_iff φ h⁻¹ x z
  rwa [inv_inv, map_inv, inv_inv] at this

/-- If `φ h` fixes `o`, then `φ (h * x * h⁻¹)` fixes `o` exactly when `φ x` fixes `o`. -/
theorem fixes_conj_iff (φ : G →* Equiv.Perm α) {o : α} {h : G} (hh : φ h o = o) (x : G) :
    φ (h * x * h⁻¹) o = o ↔ φ x o = o := by
  have hinv : (φ h)⁻¹ o = o := Equiv.Perm.inv_eq_iff_eq.mpr hh.symm
  have := moves_conj_iff φ h x o
  rw [hinv] at this
  exact not_iff_not.mp this

/-- If `φ h` fixes `o`, then `φ (h⁻¹ * x * h)` fixes `o` exactly when `φ x` fixes `o`. -/
theorem fixes_inv_conj_iff (φ : G →* Equiv.Perm α) {o : α} {h : G} (hh : φ h o = o) (x : G) :
    φ (h⁻¹ * x * h) o = o ↔ φ x o = o := by
  have := moves_inv_conj_iff φ h x o
  rw [hh] at this
  exact not_iff_not.mp this

/-- If `σ` commutes with `ρ` and moves `z`, then `σ` moves `ρ z`. -/
theorem perm_apply_ne_self_of_commute {σ ρ : Equiv.Perm α} (h : Commute σ ρ) {z : α}
    (hz : σ z ≠ z) : σ (ρ z) ≠ ρ z := by
  rw [← Equiv.Perm.mul_apply, h.eq, Equiv.Perm.mul_apply]
  exact ρ.injective.ne hz


/-! ### Further invariants of Hurwitz equivalence -/

/-- The label lists of Hurwitz equivalent tuples are permutations of each other. -/
theorem HurwitzEquiv.perm_labels {l l' : List (ι × G)} (h : HurwitzEquiv l l') :
    (l.map Prod.fst).Perm (l'.map Prod.fst) := by
  have := h.perm_conjClasses.map Prod.fst
  rw [List.map_map, List.map_map] at this
  exact this

/-- Every entry of a tuple Hurwitz equivalent to `l` has the label of some entry of `l` and an
element conjugate to the element of that entry. -/
theorem HurwitzEquiv.exists_isConj {l l' : List (ι × G)} (h : HurwitzEquiv l l')
    {p : ι × G} (hp : p ∈ l') : ∃ q ∈ l, q.1 = p.1 ∧ IsConj q.2 p.2 := by
  have hmem : (p.1, ConjClasses.mk p.2) ∈ l.map fun p => (p.1, ConjClasses.mk p.2) :=
    h.perm_conjClasses.mem_iff.mpr (List.mem_map_of_mem hp)
  obtain ⟨q, hq, hqp⟩ := List.mem_map.mp hmem
  simp only [Prod.mk.injEq] at hqp
  exact ⟨q, hq, hqp.1, ConjClasses.mk_eq_mk_iff_isConj.mp hqp.2⟩

/-- If `φ` sends every element of `l` to a cycle, then it sends every element of each tuple Hurwitz
equivalent to `l` to a cycle. -/
theorem HurwitzEquiv.forall_isCycle (φ : G →* Equiv.Perm α) {l l' : List (ι × G)}
    (h : HurwitzEquiv l l') (hcyc : ∀ p ∈ l, (φ p.2).IsCycle) : ∀ p ∈ l', (φ p.2).IsCycle := by
  intro p hp
  obtain ⟨q, hq, -, hconj⟩ := h.exists_isConj hp
  obtain ⟨c, hc⟩ := isConj_iff.mp hconj
  rw [← hc, map_mul, map_mul, map_inv]
  exact (hcyc q hq).conj

/-- A Hurwitz move preserves the subgroup generated by the images under `φ` of the elements of a
tuple. -/
theorem HurwitzMove.closure_eq {H : Type*} [Group H] (φ : G →* H) {l l' : List (ι × G)}
    (h : HurwitzMove l l') :
    Subgroup.closure {σ | ∃ p ∈ l, φ p.2 = σ} = Subgroup.closure {σ | ∃ p ∈ l', φ p.2 = σ} := by
  obtain ⟨pre, post, a, b⟩ := h
  apply le_antisymm
  · rw [Subgroup.closure_le]
    rintro _ ⟨p, hp, rfl⟩
    simp only [List.mem_append, List.mem_cons] at hp
    rcases hp with hp | hp | hp | hp
    · exact Subgroup.subset_closure ⟨p, by simp [hp], rfl⟩
    · rw [hp]
      exact Subgroup.subset_closure ⟨a, by simp, rfl⟩
    · have heq : φ b.2 = (φ a.2)⁻¹ * φ (a.2 * b.2 * a.2⁻¹) * φ a.2 := by
        rw [map_mul, map_mul, map_inv]
        group
      rw [hp, heq]
      refine mul_mem (mul_mem (inv_mem ?_) ?_) ?_
      · exact Subgroup.subset_closure ⟨a, by simp, rfl⟩
      · exact Subgroup.subset_closure ⟨(b.1, a.2 * b.2 * a.2⁻¹), by simp, rfl⟩
      · exact Subgroup.subset_closure ⟨a, by simp, rfl⟩
    · exact Subgroup.subset_closure ⟨p, by simp [hp], rfl⟩
  · rw [Subgroup.closure_le]
    rintro _ ⟨p, hp, rfl⟩
    simp only [List.mem_append, List.mem_cons] at hp
    rcases hp with hp | hp | hp | hp
    · exact Subgroup.subset_closure ⟨p, by simp [hp], rfl⟩
    · rw [hp, map_mul, map_mul, map_inv]
      refine mul_mem (mul_mem ?_ ?_) (inv_mem ?_)
      · exact Subgroup.subset_closure ⟨a, by simp, rfl⟩
      · exact Subgroup.subset_closure ⟨b, by simp, rfl⟩
      · exact Subgroup.subset_closure ⟨a, by simp, rfl⟩
    · rw [hp]
      exact Subgroup.subset_closure ⟨a, by simp, rfl⟩
    · exact Subgroup.subset_closure ⟨p, by simp [hp], rfl⟩

/-- Hurwitz equivalent tuples have the same subgroup generated by the images under `φ` of their
elements. -/
theorem HurwitzEquiv.closure_eq {H : Type*} [Group H] (φ : G →* H) {l l' : List (ι × G)}
    (h : HurwitzEquiv l l') :
    Subgroup.closure {σ | ∃ p ∈ l, φ p.2 = σ} = Subgroup.closure {σ | ∃ p ∈ l', φ p.2 = σ} := by
  induction h with
  | rel _ _ h => exact h.closure_eq φ
  | refl => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih ih' => exact ih.trans ih'


/-! ### Exchange of two adjacent entries that move the base point -/

/-- Let `σ` move `o` and write `x k = ((σ * τ) ^ k)⁻¹ o`. For every `n`, either some `k < n`
satisfies `σ (x k) ≠ x k` and `τ (σ⁻¹ (x k)) ≠ σ⁻¹ (x k)`, or `x n = (σ ^ n)⁻¹ o`. -/
theorem backward_orbit_dichotomy (σ τ : Equiv.Perm α) (o : α) (hσ : σ o ≠ o) (n : ℕ) :
    (∃ k < n, σ (((σ * τ) ^ k)⁻¹ o) ≠ ((σ * τ) ^ k)⁻¹ o ∧
        τ (σ⁻¹ (((σ * τ) ^ k)⁻¹ o)) ≠ σ⁻¹ (((σ * τ) ^ k)⁻¹ o)) ∨
      ((σ * τ) ^ n)⁻¹ o = (σ ^ n)⁻¹ o := by
  induction n with
  | zero =>
    right
    simp
  | succ n ih =>
    rcases ih with ⟨k, hk, hc⟩ | hn
    · exact Or.inl ⟨k, by omega, hc⟩
    · by_cases hc : σ (((σ * τ) ^ n)⁻¹ o) ≠ ((σ * τ) ^ n)⁻¹ o ∧
          τ (σ⁻¹ (((σ * τ) ^ n)⁻¹ o)) ≠ σ⁻¹ (((σ * τ) ^ n)⁻¹ o)
      · exact Or.inl ⟨n, by omega, hc⟩
      · right
        have hmove : σ (((σ * τ) ^ n)⁻¹ o) ≠ ((σ * τ) ^ n)⁻¹ o := by
          rw [hn]
          exact perm_apply_ne_self_of_commute (Commute.self_pow σ n).inv_right hσ
        have hfix : τ (σ⁻¹ (((σ * τ) ^ n)⁻¹ o)) = σ⁻¹ (((σ * τ) ^ n)⁻¹ o) := by
          by_contra hne
          exact hc ⟨hmove, hne⟩
        rw [pow_succ, mul_inv_rev, mul_inv_rev, Equiv.Perm.mul_apply, Equiv.Perm.mul_apply,
          Equiv.Perm.inv_eq_iff_eq.mpr hfix.symm, hn, pow_succ, mul_inv_rev, Equiv.Perm.mul_apply]

/-- Let `σ` and `τ` be permutations of a finite type that move `o`. Then some point
`x = ((σ * τ) ^ k)⁻¹ o` satisfies `σ x ≠ x` and `τ (σ⁻¹ x) ≠ σ⁻¹ x`. Equivalently, `x` lies in
the support of `σ` and in the image under `σ` of the support of `τ`. -/
theorem exists_backward_orbit_mem [Finite α] (σ τ : Equiv.Perm α) (o : α) (hσ : σ o ≠ o)
    (hτ : τ o ≠ o) :
    ∃ k : ℕ, σ (((σ * τ) ^ k)⁻¹ o) ≠ ((σ * τ) ^ k)⁻¹ o ∧
      τ (σ⁻¹ (((σ * τ) ^ k)⁻¹ o)) ≠ σ⁻¹ (((σ * τ) ^ k)⁻¹ o) := by
  have hpos := orderOf_pos σ
  have hσm : (σ ^ (orderOf σ - 1))⁻¹ = σ := by
    apply inv_eq_of_mul_eq_one_right
    rw [← pow_succ, Nat.sub_add_cancel hpos, pow_orderOf_eq_one]
  rcases backward_orbit_dichotomy σ τ o hσ (orderOf σ - 1) with ⟨k, -, hk⟩ | hn
  · exact ⟨k, hk⟩
  · refine ⟨orderOf σ - 1, ?_⟩
    have hinv : σ⁻¹ (σ o) = o := Equiv.Perm.inv_eq_iff_eq.mpr rfl
    rw [hn, hσm, hinv]
    exact ⟨σ.injective.ne hσ, hτ⟩

/-- Exchange of two adjacent entries whose elements move `o`. The pair `(p, g) (q, c)` is Hurwitz
equivalent to a pair `(q, c') (p, g')` in which `φ c'` and `φ g'` move `o`, and the other
entries are unchanged. -/
theorem exists_hurwitzEquiv_exchange [Finite α] (φ : G →* Equiv.Perm α) (o : α)
    (pre post : List (ι × G)) (p q : ι) (g c : G) (hg : φ g o ≠ o) (hc : φ c o ≠ o) :
    ∃ c' g' : G, HurwitzEquiv (pre ++ (p, g) :: (q, c) :: post)
      (pre ++ (q, c') :: (p, g') :: post) ∧
      φ c' o ≠ o ∧ φ g' o ≠ o := by
  obtain ⟨k, hk₁, hk₂⟩ := exists_backward_orbit_mem (φ g) (φ c) o hg hc
  refine ⟨_, _, hurwitzEquiv_exchange_pow pre post p q g c k, ?_, ?_⟩
  · rw [moves_conj_iff, moves_conj_iff, map_pow, map_mul]
    exact hk₂
  · rw [moves_conj_iff, map_pow, map_mul]
    exact hk₁

/-- Lemma `orderedCommonStrandHurwitz`. If `φ` sends every element of `l` to a permutation moving
`o`, then every rearrangement `L` of the labels of `l` is the label list of a tuple Hurwitz
equivalent to `l` in which every element is sent to a permutation moving `o`. -/
theorem exists_hurwitzEquiv_labels_of_perm [Finite α] (φ : G →* Equiv.Perm α) (o : α)
    (l : List (ι × G)) (hmove : ∀ p ∈ l, φ p.2 o ≠ o) {L : List ι}
    (hL : (l.map Prod.fst).Perm L) :
    ∃ l', HurwitzEquiv l l' ∧ l'.map Prod.fst = L ∧ ∀ p ∈ l', φ p.2 o ≠ o := by
  suffices H : ∀ {L₁ L₂ : List ι}, L₁.Perm L₂ → ∀ l : List (ι × G), l.map Prod.fst = L₁ →
      (∀ p ∈ l, φ p.2 o ≠ o) →
      ∃ l', HurwitzEquiv l l' ∧ l'.map Prod.fst = L₂ ∧ ∀ p ∈ l', φ p.2 o ≠ o from
    H hL l rfl hmove
  intro L₁ L₂ hperm
  induction hperm with
  | nil =>
    intro l hl hm
    exact ⟨l, .refl l, hl, hm⟩
  | cons x _ ih =>
    intro l hl hm
    cases l with
    | nil => simp at hl
    | cons a t =>
      simp only [List.map_cons, List.cons.injEq] at hl
      obtain ⟨t', ht, ht₁, ht₂⟩ := ih t hl.2 fun p hp => hm p (List.mem_cons_of_mem a hp)
      refine ⟨a :: t', ht.cons a, by simp [ht₁, hl.1], ?_⟩
      intro p hp
      rcases List.mem_cons.mp hp with rfl | hp
      · exact hm p List.mem_cons_self
      · exact ht₂ p hp
  | swap x y L₀ =>
    intro l hl hm
    rcases l with _ | ⟨a, _ | ⟨b, t⟩⟩
    · simp at hl
    · simp at hl
    · simp only [List.map_cons, List.cons.injEq] at hl
      obtain ⟨c', g', h, hc', hg'⟩ := exists_hurwitzEquiv_exchange φ o [] t a.1 b.1 a.2 b.2
        (hm a (by simp)) (hm b (by simp))
      refine ⟨(b.1, c') :: (a.1, g') :: t, by simpa using h, by simp [hl.1, hl.2.1, hl.2.2], ?_⟩
      intro p hp
      simp only [List.mem_cons] at hp
      rcases hp with rfl | rfl | hp
      · exact hc'
      · exact hg'
      · exact hm p (by simp [hp])
  | trans _ _ ih₁ ih₂ =>
    intro l hl hm
    obtain ⟨l₁, h₁, hl₁, hm₁⟩ := ih₁ l hl hm
    obtain ⟨l₂, h₂, hl₂, hm₂⟩ := ih₂ l₁ hl₁ hm₁
    exact ⟨l₂, h₁.trans h₂, hl₂, hm₂⟩


/-! ### Making every entry move the base point -/

/-- Let the set of points moved by `σ` be contained in `U` or disjoint from `U`. Then `σ x ∈ U`
exactly when `x ∈ U`. -/
theorem perm_apply_mem_iff_of_support {σ : Equiv.Perm α} {U : Set α}
    (h : (∀ z, σ z ≠ z → z ∈ U) ∨ (∀ z, σ z ≠ z → z ∉ U)) (x : α) : σ x ∈ U ↔ x ∈ U := by
  by_cases hx : σ x = x
  · rw [hx]
  · have hσx : σ (σ x) ≠ σ x := fun h' => hx (σ.injective h')
    rcases h with h | h
    · exact iff_of_true (h _ hσx) (h _ hx)
    · exact iff_of_false (h _ hσx) (h _ hx)

/-- Assume that every point is the image of `o` under an element of the subgroup generated by the
images of the elements of `l`. If `φ c₀` is nontrivial and fixes `o` for an entry `c₀` of `l`,
then there are entries `g` and `c` of `l` such that `φ g` moves `o`, `φ c` fixes `o`, and some
point is moved by both `φ g` and `φ c`. -/
theorem exists_moving_fixing_support_meet (φ : G →* Equiv.Perm α) (o : α) (l : List (ι × G))
    (htrans : ∀ x : α, ∃ g ∈ Subgroup.closure {σ | ∃ p ∈ l, φ p.2 = σ}, g o = x)
    {c₀ : ι × G} (hc₀ : c₀ ∈ l) (hc₀o : φ c₀.2 o = o) (hne : φ c₀.2 ≠ 1) :
    ∃ g ∈ l, ∃ c ∈ l, φ g.2 o ≠ o ∧ φ c.2 o = o ∧ ∃ y, φ g.2 y ≠ y ∧ φ c.2 y ≠ y := by
  by_contra hcon
  push Not at hcon
  set U : Set α := {x | x = o ∨ ∃ g ∈ l, φ g.2 o ≠ o ∧ φ g.2 x ≠ x} with hU
  have key : ∀ τ ∈ Subgroup.closure {σ | ∃ p ∈ l, φ p.2 = σ}, ∀ x, τ x ∈ U ↔ x ∈ U := by
    intro τ hτ
    induction hτ using Subgroup.closure_induction with
    | mem σ hσ =>
      obtain ⟨p, hp, rfl⟩ := hσ
      apply perm_apply_mem_iff_of_support
      by_cases hpo : φ p.2 o = o
      · right
        intro z hz hzU
        rcases hzU with hzo | ⟨g, hg, hgo, hgz⟩
        · exact hz (hzo ▸ hpo)
        · exact hz (hcon g hg p hp hgo hpo z hgz)
      · left
        intro z hz
        exact Or.inr ⟨p, hp, hpo, hz⟩
    | one =>
      intro x
      rfl
    | mul τ₁ τ₂ _ _ h₁ h₂ =>
      intro x
      rw [Equiv.Perm.mul_apply, h₁, h₂]
    | inv τ _ h =>
      intro x
      rw [← h (τ⁻¹ x), Equiv.Perm.eq_inv_iff_eq.mp rfl]
  obtain ⟨x₀, hx₀⟩ : ∃ x, φ c₀.2 x ≠ x := by
    by_contra h
    push Not at h
    exact hne (Equiv.ext h)
  obtain ⟨τ, hτ, hτo⟩ := htrans x₀
  have hx₀U : x₀ ∈ U := by
    rw [← hτo]
    exact (key τ hτ o).mpr (Or.inl rfl)
  rcases hx₀U with hx₀o | ⟨g, hg, hgo, hgx⟩
  · exact hx₀ (hx₀o ▸ hc₀o)
  · exact hx₀ (hcon g hg c₀ hc₀ hgo hc₀o x₀ hgx)

/-- Let `σ` move `o` and write `w k = (σ * τ) ^ k o`. For every `n`, either some `k < n` has `w k`
moved by both `σ` and `τ`, or `w n = σ ^ n o`. -/
theorem forward_orbit_dichotomy (σ τ : Equiv.Perm α) (o : α) (hσ : σ o ≠ o) (n : ℕ) :
    (∃ k < n, σ (((σ * τ) ^ k) o) ≠ ((σ * τ) ^ k) o ∧ τ (((σ * τ) ^ k) o) ≠ ((σ * τ) ^ k) o) ∨
      ((σ * τ) ^ n) o = (σ ^ n) o := by
  induction n with
  | zero =>
    right
    simp
  | succ n ih =>
    rcases ih with ⟨k, hk, hc⟩ | hn
    · exact Or.inl ⟨k, by omega, hc⟩
    · by_cases hc : σ (((σ * τ) ^ n) o) ≠ ((σ * τ) ^ n) o ∧ τ (((σ * τ) ^ n) o) ≠ ((σ * τ) ^ n) o
      · exact Or.inl ⟨n, by omega, hc⟩
      · right
        have hmove : σ (((σ * τ) ^ n) o) ≠ ((σ * τ) ^ n) o := by
          rw [hn]
          exact perm_apply_ne_self_of_commute (Commute.self_pow σ n) hσ
        have hfix : τ (((σ * τ) ^ n) o) = ((σ * τ) ^ n) o := by
          by_contra hne
          exact hc ⟨hmove, hne⟩
        rw [pow_succ', Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, hfix, hn, pow_succ',
          Equiv.Perm.mul_apply]

/-- Let `σ` be a cycle of a finite type that moves `o`, and let `y` be moved by both `σ` and `τ`.
Then some point `(σ * τ) ^ j o` is moved by both `σ` and `τ`. -/
theorem exists_forward_orbit_mem [Finite α] (σ τ : Equiv.Perm α) (o : α) (hσ : σ.IsCycle)
    (hσo : σ o ≠ o) {y : α} (hσy : σ y ≠ y) (hτy : τ y ≠ y) :
    ∃ j : ℕ, σ (((σ * τ) ^ j) o) ≠ ((σ * τ) ^ j) o ∧ τ (((σ * τ) ^ j) o) ≠ ((σ * τ) ^ j) o := by
  obtain ⟨i, hi⟩ := hσ.exists_pow_eq hσo hσy
  rcases forward_orbit_dichotomy σ τ o hσo i with ⟨k, -, hk⟩ | hn
  · exact ⟨k, hk⟩
  · refine ⟨i, ?_⟩
    rw [hn, hi]
    exact ⟨hσy, hτy⟩

/-- Let `φ g` be a cycle moving `o`, and let `φ g` and `φ c` move a common point. Then the pair
`(p, g) (q, c)` is Hurwitz equivalent to a pair `(p, g') (q, c')` in which `φ g'` and `φ c'` move
`o`, and the other entries are unchanged. -/
theorem exists_hurwitzEquiv_pair_moves [Finite α] (φ : G →* Equiv.Perm α) (o : α)
    (pre post : List (ι × G)) (p q : ι) (g c : G) (hcyc : (φ g).IsCycle) (hg : φ g o ≠ o)
    {y : α} (hgy : φ g y ≠ y) (hcy : φ c y ≠ y) :
    ∃ g' c' : G, HurwitzEquiv (pre ++ (p, g) :: (q, c) :: post)
      (pre ++ (p, g') :: (q, c') :: post) ∧
      φ g' o ≠ o ∧ φ c' o ≠ o := by
  obtain ⟨j, hj₁, hj₂⟩ := exists_forward_orbit_mem (φ g) (φ c) o hcyc hg hgy hcy
  refine ⟨_, _, hurwitzEquiv_inv_conj_pow pre post p q g c j, ?_, ?_⟩
  · rw [moves_inv_conj_iff, map_pow, map_mul]
    exact hj₁
  · rw [moves_inv_conj_iff, map_pow, map_mul]
    exact hj₂

/-- If `φ e` fixes `o`, then conjugating every element of `B` by `e` preserves the number of entries
whose element is sent to a permutation fixing `o`. -/
theorem countP_map_conj [DecidableEq α] (φ : G →* Equiv.Perm α) {o : α} {e : G} (he : φ e o = o)
    (B : List (ι × G)) :
    (B.map fun p => (p.1, e * p.2 * e⁻¹)).countP (fun p => φ p.2 o = o) =
      B.countP (fun p => φ p.2 o = o) := by
  rw [List.countP_map]
  apply List.countP_congr
  intro p _
  simp only [Function.comp_apply, decide_eq_true_eq]
  exact fixes_conj_iff φ he p.2

/-- If `φ e` fixes `o`, then conjugating every element of `B` by `e⁻¹` preserves the number of
entries whose element is sent to a permutation fixing `o`. -/
theorem countP_map_inv_conj [DecidableEq α] (φ : G →* Equiv.Perm α) {o : α} {e : G}
    (he : φ e o = o) (B : List (ι × G)) :
    (B.map fun p => (p.1, e⁻¹ * p.2 * e)).countP (fun p => φ p.2 o = o) =
      B.countP (fun p => φ p.2 o = o) := by
  rw [List.countP_map]
  apply List.countP_congr
  intro p _
  simp only [Function.comp_apply, decide_eq_true_eq]
  exact fixes_inv_conj_iff φ he p.2

/-- Inductive step of Lemma `commonStrandHurwitz`. Let `g` and `c` be entries of `l` such that
`φ g` is a cycle moving `o`, `φ c` fixes `o`, and `φ g` and `φ c` move a common point. Then some
tuple Hurwitz equivalent to `l` has fewer entries whose element is sent to a permutation fixing
`o`. -/
theorem exists_hurwitzEquiv_countP_lt [Finite α] [DecidableEq α] (φ : G →* Equiv.Perm α) (o : α)
    (l : List (ι × G)) {g c : ι × G} (hg : g ∈ l) (hc : c ∈ l) (hgcyc : (φ g.2).IsCycle)
    (hgo : φ g.2 o ≠ o) (hco : φ c.2 o = o) {y : α} (hgy : φ g.2 y ≠ y) (hcy : φ c.2 y ≠ y) :
    ∃ l', HurwitzEquiv l l' ∧
      l'.countP (fun p => φ p.2 o = o) < l.countP (fun p => φ p.2 o = o) := by
  obtain ⟨s, t, rfl⟩ := List.append_of_mem hg
  rw [List.mem_append, List.mem_cons] at hc
  rcases hc with hcs | hcg | hct
  · -- The fixing entry `c` precedes the moving entry `g`.
    obtain ⟨A, B, rfl⟩ := List.append_of_mem hcs
    have h₁ := hurwitzEquiv_moveRight A B (g :: t) c
    have h₂ := hurwitzEquiv_move (A ++ B.map fun p => (p.1, c.2 * p.2 * c.2⁻¹)) t c.1 g.1 c.2 g.2
    have hcyc' : (φ (c.2 * g.2 * c.2⁻¹)).IsCycle := by
      rw [map_mul, map_mul, map_inv]
      exact hgcyc.conj
    have hgo' : φ (c.2 * g.2 * c.2⁻¹) o ≠ o := fun h => hgo ((fixes_conj_iff φ hco g.2).mp h)
    have hgy' : φ (c.2 * g.2 * c.2⁻¹) (φ c.2 y) ≠ φ c.2 y := by
      have hinv : (φ c.2)⁻¹ (φ c.2 y) = y := Equiv.Perm.inv_eq_iff_eq.mpr rfl
      rw [moves_conj_iff, hinv]
      exact hgy
    have hcy' : φ c.2 (φ c.2 y) ≠ φ c.2 y := fun h => hcy ((φ c.2).injective h)
    obtain ⟨g', c', h₃, hg', hc'⟩ := exists_hurwitzEquiv_pair_moves φ o
      (A ++ B.map fun p => (p.1, c.2 * p.2 * c.2⁻¹)) t g.1 c.1 (c.2 * g.2 * c.2⁻¹) c.2 hcyc' hgo'
      hgy' hcy'
    refine ⟨A ++ B.map (fun p => (p.1, c.2 * p.2 * c.2⁻¹)) ++ (g.1, g') :: (c.1, c') :: t, ?_, ?_⟩
    · simp only [Prod.mk.eta, List.append_assoc, List.cons_append] at h₁ h₂ h₃ ⊢
      exact h₁.trans (h₂.trans h₃)
    · simp only [List.countP_append, List.countP_cons, countP_map_conj φ hco, hco, hgo, hg', hc',
        decide_true, decide_false, if_true, if_false, Bool.false_eq_true]
      omega
  · exact absurd (hcg ▸ hco) hgo
  · -- The fixing entry `c` follows the moving entry `g`.
    obtain ⟨B, C, rfl⟩ := List.append_of_mem hct
    have h₁ := hurwitzEquiv_moveLeft (s ++ [g]) B C c
    obtain ⟨g', c', h₂, hg', hc'⟩ := exists_hurwitzEquiv_pair_moves φ o s
      (B.map (fun p => (p.1, c.2⁻¹ * p.2 * c.2)) ++ C) g.1 c.1 g.2 c.2 hgcyc hgo hgy
      hcy
    refine ⟨s ++ (g.1, g') :: (c.1, c') :: (B.map (fun p => (p.1, c.2⁻¹ * p.2 * c.2)) ++ C), ?_,
      ?_⟩
    · simp only [Prod.mk.eta, List.append_assoc, List.cons_append] at h₁ h₂ ⊢
      exact h₁.trans h₂
    · simp only [List.countP_append, List.countP_cons, countP_map_inv_conj φ hco, hco, hgo, hg',
        hc', decide_true, decide_false, if_true, if_false, Bool.false_eq_true]
      omega

/-- Lemma `commonStrandHurwitz`. Let `φ` send every element of `l` to a cycle, and assume that every
point is the image of `o` under an element of the subgroup generated by these cycles. Then `l` is
Hurwitz equivalent to a tuple in which every element is sent to a permutation moving `o`. -/
theorem exists_hurwitzEquiv_forall_moves [Finite α] (φ : G →* Equiv.Perm α) (o : α)
    (l : List (ι × G)) (hcyc : ∀ p ∈ l, (φ p.2).IsCycle)
    (htrans : ∀ x : α, ∃ g ∈ Subgroup.closure {σ | ∃ p ∈ l, φ p.2 = σ}, g o = x) :
    ∃ l', HurwitzEquiv l l' ∧ ∀ p ∈ l', φ p.2 o ≠ o := by
  classical
  suffices H : ∀ n, ∀ l : List (ι × G), l.countP (fun p => φ p.2 o = o) = n →
      (∀ p ∈ l, (φ p.2).IsCycle) →
      (∀ x : α, ∃ g ∈ Subgroup.closure {σ | ∃ p ∈ l, φ p.2 = σ}, g o = x) →
      ∃ l', HurwitzEquiv l l' ∧ ∀ p ∈ l', φ p.2 o ≠ o from H _ l rfl hcyc htrans
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro l hn hcyc htrans
    by_cases hbad : ∃ c ∈ l, φ c.2 o = o
    · obtain ⟨c₀, hc₀, hc₀o⟩ := hbad
      obtain ⟨g, hg, c, hc, hgo, hco, y, hgy, hcy⟩ :=
        exists_moving_fixing_support_meet φ o l htrans hc₀ hc₀o (hcyc c₀ hc₀).ne_one
      obtain ⟨l₁, h₁, hlt⟩ := exists_hurwitzEquiv_countP_lt φ o l hg hc (hcyc g hg) hgo hco hgy hcy
      have htrans₁ : ∀ x : α, ∃ g ∈ Subgroup.closure {σ | ∃ p ∈ l₁, φ p.2 = σ}, g o = x := by
        intro x
        obtain ⟨τ, hτ, hτx⟩ := htrans x
        exact ⟨τ, h₁.closure_eq φ ▸ hτ, hτx⟩
      obtain ⟨l₂, h₂, hm⟩ := ih _ (hn ▸ hlt) l₁ rfl (h₁.forall_isCycle φ hcyc) htrans₁
      exact ⟨l₂, h₁.trans h₂, hm⟩
    · push Not at hbad
      exact ⟨l, .refl l, hbad⟩


/-! ### Common strand followed by a prescribed order of the labels -/

/-- Combination of Lemmas `commonStrandHurwitz` and `orderedCommonStrandHurwitz` used in
Statement E. Under the hypotheses of `exists_hurwitzEquiv_forall_moves`, every rearrangement `L`
of the labels of `l` is the label list of a tuple Hurwitz equivalent to `l` in which every element
is sent to a permutation moving `o`. -/
theorem exists_hurwitzEquiv_ordered_commonStrand [Finite α] (φ : G →* Equiv.Perm α) (o : α)
    (l : List (ι × G)) (hcyc : ∀ p ∈ l, (φ p.2).IsCycle)
    (htrans : ∀ x : α, ∃ g ∈ Subgroup.closure {σ | ∃ p ∈ l, φ p.2 = σ}, g o = x)
    {L : List ι} (hL : (l.map Prod.fst).Perm L) :
    ∃ l', HurwitzEquiv l l' ∧ l'.map Prod.fst = L ∧ ∀ p ∈ l', φ p.2 o ≠ o := by
  obtain ⟨l₁, h₁, hm₁⟩ := exists_hurwitzEquiv_forall_moves φ o l hcyc htrans
  obtain ⟨l₂, h₂, hl₂, hm₂⟩ :=
    exists_hurwitzEquiv_labels_of_perm φ o l₁ hm₁ (h₁.perm_labels.symm.trans hL)
  exact ⟨l₂, h₁.trans h₂, hl₂, hm₂⟩

/-- Lemma `commonStrandHurwitz` together with the invariants of the final tuple. The final tuple has
the same ordered product as `l`, and its labelled conjugacy classes are a permutation of those of
`l`. -/
theorem exists_hurwitzEquiv_forall_moves_invariants [Finite α] (φ : G →* Equiv.Perm α) (o : α)
    (l : List (ι × G)) (hcyc : ∀ p ∈ l, (φ p.2).IsCycle)
    (htrans : ∀ x : α, ∃ g ∈ Subgroup.closure {σ | ∃ p ∈ l, φ p.2 = σ}, g o = x) :
    ∃ l', HurwitzEquiv l l' ∧ (∀ p ∈ l', φ p.2 o ≠ o) ∧
      (l'.map Prod.snd).prod = (l.map Prod.snd).prod ∧
      (l'.map fun p => (p.1, ConjClasses.mk p.2)).Perm
        (l.map fun p => (p.1, ConjClasses.mk p.2)) := by
  obtain ⟨l', h, hm⟩ := exists_hurwitzEquiv_forall_moves φ o l hcyc htrans
  exact ⟨l', h, hm, h.prod_eq.symm, h.perm_conjClasses.symm⟩

/-- Lemma `orderedCommonStrandHurwitz` together with the invariants of the final tuple. The final
tuple has the same ordered product as `l`, and its labelled conjugacy classes are a permutation of
those of `l`. -/
theorem exists_hurwitzEquiv_labels_of_perm_invariants [Finite α] (φ : G →* Equiv.Perm α) (o : α)
    (l : List (ι × G)) (hmove : ∀ p ∈ l, φ p.2 o ≠ o) {L : List ι}
    (hL : (l.map Prod.fst).Perm L) :
    ∃ l', HurwitzEquiv l l' ∧ l'.map Prod.fst = L ∧ (∀ p ∈ l', φ p.2 o ≠ o) ∧
      (l'.map Prod.snd).prod = (l.map Prod.snd).prod ∧
      (l'.map fun p => (p.1, ConjClasses.mk p.2)).Perm
        (l.map fun p => (p.1, ConjClasses.mk p.2)) := by
  obtain ⟨l', h, hl', hm⟩ := exists_hurwitzEquiv_labels_of_perm φ o l hmove hL
  exact ⟨l', h, hl', hm, h.prod_eq.symm, h.perm_conjClasses.symm⟩

/-- The combination used in Statement E together with the invariants of the final tuple. The final
tuple has the same ordered product as `l`, and its labelled conjugacy classes are a permutation of
those of `l`. -/
theorem exists_hurwitzEquiv_ordered_commonStrand_invariants [Finite α] (φ : G →* Equiv.Perm α)
    (o : α) (l : List (ι × G)) (hcyc : ∀ p ∈ l, (φ p.2).IsCycle)
    (htrans : ∀ x : α, ∃ g ∈ Subgroup.closure {σ | ∃ p ∈ l, φ p.2 = σ}, g o = x)
    {L : List ι} (hL : (l.map Prod.fst).Perm L) :
    ∃ l', HurwitzEquiv l l' ∧ l'.map Prod.fst = L ∧ (∀ p ∈ l', φ p.2 o ≠ o) ∧
      (l'.map Prod.snd).prod = (l.map Prod.snd).prod ∧
      (l'.map fun p => (p.1, ConjClasses.mk p.2)).Perm
        (l.map fun p => (p.1, ConjClasses.mk p.2)) := by
  obtain ⟨l', h, hl', hm⟩ := exists_hurwitzEquiv_ordered_commonStrand φ o l hcyc htrans hL
  exact ⟨l', h, hl', hm, h.prod_eq.symm, h.perm_conjClasses.symm⟩

end OnLeConjecture.KnotTheory
