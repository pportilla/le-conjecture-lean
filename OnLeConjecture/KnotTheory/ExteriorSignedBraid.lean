module

public import OnLeConjecture.KnotTheory.PositiveWordBraidEquiv
public import Mathlib.Tactic.Ring
import all OnLeConjecture.KnotTheory.BraidPermutationCycles

/-!
# Signed braid words, braid equality and conjugacy

The written proof of Statement E (`statement_E_complete_proof.tex`, Lemma
`finiteProjectionEventFactorization` and Section 7) compares braid words by finite derivations.
This file fixes the relations used.

* `SignedBraidStep`: one elementary relation inside an arbitrary context, namely free
  cancellation `σ_i^e σ_i^{-e} → 1`, far commutation `σ_i^e σ_j^f ↔ σ_j^f σ_i^e` for
  `|i - j| ≥ 2`, and the positive braid relation `σ_i σ_{i+1} σ_i ↔ σ_{i+1} σ_i σ_{i+1}`.
* `SignedBraidEquiv`: the equivalence relation generated by these steps. Two words are related
  exactly when they represent the same element of the braid group, because the steps contain the
  defining relations of Artin's presentation and free cancellation.
* `SignedBraidConj`: the equivalence relation generated by the steps and cyclic rotation
  `w σ ↔ σ w`. Together with equality, cyclic rotation generates conjugacy in the braid group.
* `SignedAdjacentWord.inv`, the inverse word, `conjugateWord γ η = γ η γ⁻¹`, and
  `liftPositiveWord`, which places a positive word on `a` strands on the first `a` of `S ≥ a`
  strands.

Basic invariants: the permutation of a word is invariant under `SignedBraidEquiv`
(`SignedBraidEquiv.permutation_eq`), and the exponent sum is invariant under `SignedBraidConj`
(`SignedBraidConj.exponentSum_eq`).
-/

@[expose] public section

namespace OnLeConjecture.KnotTheory

namespace SignedAdjacentWord

variable {m : ℕ}

/-- The exponent sum of a signed word. -/
def letterSum (w : SignedAdjacentWord m) : ℤ :=
  (w.map fun a => (a.2 : ℤ)).sum

@[simp] theorem letterSum_nil : letterSum ([] : SignedAdjacentWord m) = 0 := rfl

@[simp] theorem letterSum_cons (a : Fin (m - 1) × ℤˣ) (w : SignedAdjacentWord m) :
    letterSum (a :: w) = a.2 + letterSum w := by
  simp [letterSum]

@[simp] theorem letterSum_append (u v : SignedAdjacentWord m) :
    letterSum (u ++ v) = letterSum u + letterSum v := by
  simp [letterSum]

/-- The inverse of a signed word: reverse the letters and change their signs. -/
def inv (w : SignedAdjacentWord m) : SignedAdjacentWord m :=
  (w.map fun a => (a.1, -a.2)).reverse

@[simp] theorem inv_nil : inv ([] : SignedAdjacentWord m) = [] := rfl

theorem inv_cons (a : Fin (m - 1) × ℤˣ) (w : SignedAdjacentWord m) :
    inv (a :: w) = inv w ++ [(a.1, -a.2)] := by
  simp [inv]

theorem letterSum_inv (w : SignedAdjacentWord m) : letterSum (inv w) = -letterSum w := by
  induction w with
  | nil => simp
  | cons a w ih =>
    rw [inv_cons, letterSum_append, ih, letterSum_cons, letterSum_cons, letterSum_nil]
    push_cast
    ring

theorem permutation_append (u v : SignedAdjacentWord m) :
    permutation (u ++ v) = permutation u * permutation v := by
  induction u with
  | nil => simp
  | cons a u ih => rw [List.cons_append, permutation_cons, permutation_cons, ih, mul_assoc]

theorem adjacentSwap_inv (i : Fin (m - 1)) : (adjacentSwap i)⁻¹ = adjacentSwap i := by
  unfold adjacentSwap
  exact Equiv.swap_inv _ _

theorem adjacentSwap_mul_self (i : Fin (m - 1)) : adjacentSwap i * adjacentSwap i = 1 := by
  unfold adjacentSwap
  exact Equiv.swap_mul_self _ _

theorem permutation_inv (w : SignedAdjacentWord m) : permutation (inv w) = (permutation w)⁻¹ := by
  induction w with
  | nil => simp
  | cons a w ih =>
    rw [inv_cons, permutation_append, ih, permutation_cons, permutation_cons, permutation_nil,
      mul_one, mul_inv_rev, adjacentSwap_inv]

end SignedAdjacentWord

open SignedAdjacentWord

variable {m : ℕ}

/-- One elementary relation of the braid group inside an arbitrary context. -/
inductive SignedBraidStep : SignedAdjacentWord m → SignedAdjacentWord m → Prop
  /-- Free cancellation `σ_i^e σ_i^{-e} → 1`. -/
  | cancel (u v : SignedAdjacentWord m) (i : Fin (m - 1)) (e : ℤˣ) :
      SignedBraidStep (u ++ (i, e) :: (i, -e) :: v) (u ++ v)
  /-- Far commutation `σ_i^e σ_j^f → σ_j^f σ_i^e` for `|i - j| ≥ 2`. -/
  | far (u v : SignedAdjacentWord m) (i j : Fin (m - 1)) (e f : ℤˣ)
      (h : i.val + 2 ≤ j.val ∨ j.val + 2 ≤ i.val) :
      SignedBraidStep (u ++ (i, e) :: (j, f) :: v) (u ++ (j, f) :: (i, e) :: v)
  /-- The positive braid relation `σ_i σ_{i+1} σ_i → σ_{i+1} σ_i σ_{i+1}`. -/
  | braid (u v : SignedAdjacentWord m) (i j : Fin (m - 1)) (h : j.val = i.val + 1) :
      SignedBraidStep (u ++ (i, 1) :: (j, 1) :: (i, 1) :: v) (u ++ (j, 1) :: (i, 1) :: (j, 1) :: v)

/-- Equality in the braid group: the equivalence relation generated by `SignedBraidStep`. -/
def SignedBraidEquiv (u v : SignedAdjacentWord m) : Prop :=
  Relation.EqvGen SignedBraidStep u v

/-- One step of the conjugacy calculus: an elementary relation or a cyclic rotation
`w σ → σ w`. -/
inductive SignedBraidConjStep : SignedAdjacentWord m → SignedAdjacentWord m → Prop
  | step {u v : SignedAdjacentWord m} (h : SignedBraidStep u v) : SignedBraidConjStep u v
  | rotate (w : SignedAdjacentWord m) (a : Fin (m - 1) × ℤˣ) :
      SignedBraidConjStep (w ++ [a]) (a :: w)

/-- Conjugacy in the braid group up to a finite signed-word derivation: the equivalence relation
generated by elementary relations and cyclic rotations. -/
def SignedBraidConj (u v : SignedAdjacentWord m) : Prop :=
  Relation.EqvGen SignedBraidConjStep u v

/-- The conjugate `γ η γ⁻¹` of a word. -/
def conjugateWord (γ η : SignedAdjacentWord m) : SignedAdjacentWord m :=
  γ ++ η ++ inv γ

/-- A positive word on `a` strands placed on the first `a` of `S` strands. -/
def liftPositiveWord {a S : ℕ} (h : a ≤ S) (w : PositiveAdjacentWord a) : SignedAdjacentWord S :=
  w.map fun i => (Fin.castLE (by omega) i, 1)

theorem SignedBraidStep.letterSum_eq {u v : SignedAdjacentWord m} (h : SignedBraidStep u v) :
    letterSum u = letterSum v := by
  cases h with
  | cancel u v i e =>
    simp only [letterSum_append, letterSum_cons, Units.val_neg]
    ring
  | far u v i j e f _ =>
    simp only [letterSum_append, letterSum_cons]
    ring
  | braid u v i j _ =>
    simp only [letterSum_append, letterSum_cons]

theorem SignedBraidConjStep.letterSum_eq {u v : SignedAdjacentWord m}
    (h : SignedBraidConjStep u v) : letterSum u = letterSum v := by
  cases h with
  | step h => exact h.letterSum_eq
  | rotate w a =>
    simp only [letterSum_append, letterSum_cons, letterSum_nil]
    ring

/-- The exponent sum is invariant under conjugacy derivations. -/
theorem SignedBraidConj.letterSum_eq {u v : SignedAdjacentWord m} (h : SignedBraidConj u v) :
    letterSum u = letterSum v := by
  induction h with
  | rel _ _ h => exact h.letterSum_eq
  | refl => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih ih' => exact ih.trans ih'

theorem letterSum_conjugateWord (γ η : SignedAdjacentWord m) :
    letterSum (conjugateWord γ η) = letterSum η := by
  rw [conjugateWord, letterSum_append, letterSum_append, letterSum_inv]
  ring

theorem letterSum_liftPositiveWord {a S : ℕ} (h : a ≤ S) (w : PositiveAdjacentWord a) :
    letterSum (liftPositiveWord h w) = w.length := by
  induction w with
  | nil => simp [liftPositiveWord]
  | cons i w ih =>
    simp only [liftPositiveWord, List.map_cons, letterSum_cons, List.length_cons] at ih ⊢
    rw [ih]
    push_cast
    ring

theorem letterSum_toSigned (w : PositiveAdjacentWord m) : letterSum w.toSigned = w.length := by
  induction w with
  | nil => simp [PositiveAdjacentWord.toSigned]
  | cons i w ih =>
    simp only [PositiveAdjacentWord.toSigned, List.map_cons, letterSum_cons,
      List.length_cons] at ih ⊢
    rw [ih]
    push_cast
    ring

theorem letterSum_flatten (l : List (SignedAdjacentWord m)) :
    letterSum l.flatten = (l.map letterSum).sum := by
  induction l with
  | nil => simp
  | cons w l ih => simp [ih]

theorem adjacentSwap_braid' {i j : Fin (m - 1)} (h : j.val = i.val + 1) (x : Equiv.Perm (Fin m)) :
    adjacentSwap i * (adjacentSwap j * (adjacentSwap i * x)) =
      adjacentSwap j * (adjacentSwap i * (adjacentSwap j * x)) := by
  rw [← mul_assoc, ← mul_assoc, adjacentSwap_braid h, mul_assoc, mul_assoc]

theorem SignedBraidStep.permutation_eq {u v : SignedAdjacentWord m} (h : SignedBraidStep u v) :
    permutation u = permutation v := by
  cases h with
  | cancel u v i e =>
    simp only [permutation_append, permutation_cons, ← mul_assoc, adjacentSwap_mul_self, one_mul]
  | far u v i j e f hij =>
    simp only [permutation_append, permutation_cons, ← mul_assoc,
      adjacentSwap_mul_comm_of_far hij]
  | braid u v i j hij =>
    simp only [permutation_append, permutation_cons]
    rw [adjacentSwap_braid' hij]

/-- Words representing the same braid have the same permutation. -/
theorem SignedBraidEquiv.permutation_eq {u v : SignedAdjacentWord m} (h : SignedBraidEquiv u v) :
    permutation u = permutation v := by
  induction h with
  | rel _ _ h => exact h.permutation_eq
  | refl => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih ih' => exact ih.trans ih'

theorem SignedBraidEquiv.toConj {u v : SignedAdjacentWord m} (h : SignedBraidEquiv u v) :
    SignedBraidConj u v := by
  induction h with
  | rel _ _ h => exact Relation.EqvGen.rel _ _ (SignedBraidConjStep.step h)
  | refl => exact Relation.EqvGen.refl _
  | symm _ _ _ ih => exact Relation.EqvGen.symm _ _ ih
  | trans _ _ _ _ _ ih ih' => exact Relation.EqvGen.trans _ _ _ ih ih'

end OnLeConjecture.KnotTheory
