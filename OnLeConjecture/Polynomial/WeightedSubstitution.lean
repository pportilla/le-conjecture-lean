module

public import OnLeConjecture.Analytic.TwoWeightMonomialIdeal

/-!
# Homogeneous preimages under weighted substitution

A polynomial in homogeneous generators which is itself homogeneous has a
homogeneous polynomial preimage of the same degree. No algebraic
independence hypothesis on the generators is needed.
-/

public section

namespace OnLeConjecture.Polynomial

open MvPolynomial

variable {R σ τ : Type*} [CommSemiring R]

/-- Substitution by homogeneous generators preserves their prescribed
weighted degrees. -/
theorem isWeightedHomogeneous_aeval
    (w : σ → ℕ) (v : τ → ℕ) (G : σ → MvPolynomial τ R)
    (hG : ∀ i, (G i).IsWeightedHomogeneous v (w i))
    {D : ℕ} {P : MvPolynomial σ R} (hP : P.IsWeightedHomogeneous w D) :
    (aeval G P).IsWeightedHomogeneous v D := by
  rw [aeval_eq_bind₁]
  simpa only [one_mul] using
    OnLeConjecture.Analytic.MvPolynomial.IsWeightedHomogeneous.bind₁_scaled
      (L := 1) hP G (fun i ↦ by simpa only [one_mul] using hG i)

/-- Weighted homogeneous projection commutes with substitution by
homogeneous generators. -/
theorem aeval_weightedHomogeneousComponent
    (w : σ → ℕ) (v : τ → ℕ) (G : σ → MvPolynomial τ R)
    (hG : ∀ i, (G i).IsWeightedHomogeneous v (w i))
    (D : ℕ) (P : MvPolynomial σ R) :
    aeval G (weightedHomogeneousComponent w D P) =
      weightedHomogeneousComponent v D (aeval G P) := by
  classical
  induction P using MvPolynomial.induction_on' with
  | monomial d c =>
      have hmono := isWeightedHomogeneous_monomial w d c rfl
      have heval := isWeightedHomogeneous_aeval w v G hG hmono
      by_cases hD : D = Finsupp.weight w d
      · subst D
        rw [hmono.weightedHomogeneousComponent_same,
          heval.weightedHomogeneousComponent_same]
      · rw [hmono.weightedHomogeneousComponent_ne D hD,
          heval.weightedHomogeneousComponent_ne D hD, map_zero]
  | add P Q hP hQ =>
      simp only [map_add, hP, hQ]

/-- A homogeneous polynomial in the algebra generated by `G` has a
homogeneous preimage, even if those generators satisfy relations. -/
theorem exists_homogeneous_preimage_of_mem_range
    (w : σ → ℕ) (v : τ → ℕ) (G : σ → MvPolynomial τ R)
    (hG : ∀ i, (G i).IsWeightedHomogeneous v (w i))
    {D : ℕ} {H : MvPolynomial τ R} (hH : H.IsWeightedHomogeneous v D)
    (hmem : H ∈ Set.range (aeval G :
      MvPolynomial σ R →ₐ[R] MvPolynomial τ R)) :
    ∃ P : MvPolynomial σ R,
      P.IsWeightedHomogeneous w D ∧ aeval G P = H := by
  obtain ⟨P, rfl⟩ := hmem
  refine ⟨weightedHomogeneousComponent w D P,
    weightedHomogeneousComponent_isWeightedHomogeneous D P, ?_⟩
  rw [aeval_weightedHomogeneousComponent w v G hG,
    hH.weightedHomogeneousComponent_same]

end OnLeConjecture.Polynomial
