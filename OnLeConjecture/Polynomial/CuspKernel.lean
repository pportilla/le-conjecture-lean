module

public import OnLeConjecture.Polynomial.WeightedSubstitution
public import Mathlib.Algebra.Polynomial.Degree.Operations

/-!
# The polynomial kernel of an odd cusp parametrization

The kernel of substitution `(S,T) ↦ (x²,xᵖ)` is generated by `T²-Sᵖ`
for odd `p`. A polynomial reduction in the exponent of `T` supplies a
remainder `A(S)+T B(S)`. Substitution at `x` and `-x` separates its terms.
-/

public section

namespace OnLeConjecture.Polynomial

open MvPolynomial

/-- The polynomial equation of the odd cusp. -/
@[expose] noncomputable def cuspRelation (p : ℕ) : MvPolynomial (Fin 2) ℂ :=
  X 1 ^ 2 - X 0 ^ p

/-- Reduction modulo the cusp equation leaves degree at most one in `T`. -/
theorem cusp_polynomial_decomposition (p : ℕ) (F : MvPolynomial (Fin 2) ℂ) :
    ∃ C : MvPolynomial (Fin 2) ℂ, ∃ A B : _root_.Polynomial ℂ,
      F = cuspRelation p * C + _root_.Polynomial.aeval (X 0) A +
        X 1 * _root_.Polynomial.aeval (X 0) B := by
  induction F using MvPolynomial.induction_on with
  | C c =>
      refine ⟨0, _root_.Polynomial.C c, 0, ?_⟩
      simp
  | add F G hF hG =>
      obtain ⟨C, A, B, rfl⟩ := hF
      obtain ⟨D, E, L, rfl⟩ := hG
      refine ⟨C + D, A + E, B + L, ?_⟩
      simp only [map_add]
      ring
  | mul_X F i hF =>
      obtain ⟨C, A, B, rfl⟩ := hF
      fin_cases i
      · refine ⟨C * X 0, A * _root_.Polynomial.X, B * _root_.Polynomial.X, ?_⟩
        change (cuspRelation p * C + _root_.Polynomial.aeval (X 0) A +
          X 1 * _root_.Polynomial.aeval (X 0) B) * X 0 = _
        simp only [map_mul, _root_.Polynomial.aeval_X]
        ring
      · refine ⟨C * X 1 + _root_.Polynomial.aeval (X 0) B,
          _root_.Polynomial.X ^ p * B, A, ?_⟩
        change (cuspRelation p * C + _root_.Polynomial.aeval (X 0) A +
          X 1 * _root_.Polynomial.aeval (X 0) B) * X 1 = _
        simp only [map_mul, map_pow, _root_.Polynomial.aeval_X, cuspRelation]
        ring

/-- Substitution of `x²` and `xᵖ` in two target variables. -/
@[expose] noncomputable def cuspParametrization (p : ℕ) :
    MvPolynomial (Fin 2) ℂ →ₐ[ℂ] _root_.Polynomial ℂ :=
  MvPolynomial.aeval ![_root_.Polynomial.X ^ 2, _root_.Polynomial.X ^ p]

@[simp] theorem cuspParametrization_relation (p : ℕ) :
    cuspParametrization p (cuspRelation p) = 0 := by
  simp [cuspParametrization, cuspRelation, ← pow_mul, mul_comm]

private theorem cuspParametrization_aeval (p : ℕ) (A : _root_.Polynomial ℂ) :
    cuspParametrization p (_root_.Polynomial.aeval (X 0) A) =
      A.comp (_root_.Polynomial.X ^ 2) := by
  rw [← _root_.Polynomial.aeval_algHom_apply]
  simp [cuspParametrization, _root_.Polynomial.comp_eq_aeval]

private theorem comp_X_sq_ne_zero {A : _root_.Polynomial ℂ} (hA : A ≠ 0) :
    A.comp (_root_.Polynomial.X ^ 2) ≠ 0 := by
  simp [_root_.Polynomial.comp_eq_zero_iff, hA]

/-- The odd cusp relation generates exactly the polynomial kernel. -/
theorem cuspParametrization_eq_zero_iff (p : ℕ) (hp : Odd p)
    (F : MvPolynomial (Fin 2) ℂ) :
    cuspParametrization p F = 0 ↔ cuspRelation p ∣ F := by
  constructor
  · intro hF
    obtain ⟨C, A, B, hdecomp⟩ := cusp_polynomial_decomposition p F
    have heq := congrArg (cuspParametrization p) hdecomp
    simp only [map_add, map_mul, cuspParametrization_relation, zero_mul, zero_add,
      cuspParametrization_aeval, hF] at heq
    have hT : cuspParametrization p (X 1) = _root_.Polynomial.X ^ p := by
      simp [cuspParametrization]
    rw [hT] at heq
    have hnegative := congrArg (fun Q : _root_.Polynomial ℂ =>
      Q.comp (-_root_.Polynomial.X)) heq
    have heven (L : _root_.Polynomial ℂ) :
        (L.comp (_root_.Polynomial.X ^ 2)).comp (-_root_.Polynomial.X) =
          L.comp (_root_.Polynomial.X ^ 2) := by
      rw [_root_.Polynomial.comp_assoc]
      simp
    simp only [_root_.Polynomial.zero_comp, _root_.Polynomial.add_comp,
      _root_.Polynomial.mul_comp, heven, _root_.Polynomial.pow_comp,
      _root_.Polynomial.X_comp, hp.neg_pow] at hnegative
    have hAzero : A.comp (_root_.Polynomial.X ^ 2) = 0 := by
      have htwo : (2 : _root_.Polynomial ℂ) * A.comp (_root_.Polynomial.X ^ 2) = 0 := by
        linear_combination -heq - hnegative
      exact (mul_eq_zero.mp htwo).resolve_left (by norm_num)
    have hA : A = 0 := by by_contra h; exact comp_X_sq_ne_zero h hAzero
    have hBzero : B.comp (_root_.Polynomial.X ^ 2) = 0 := by
      rw [hAzero, zero_add] at heq
      exact (mul_eq_zero.mp heq.symm).resolve_left
        (pow_ne_zero _ _root_.Polynomial.X_ne_zero)
    have hB : B = 0 := by by_contra h; exact comp_X_sq_ne_zero h hBzero
    refine ⟨C, ?_⟩
    simpa [hA, hB] using hdecomp
  · rintro ⟨C, rfl⟩
    simp

/-- The kernel ideal of the odd cusp parametrization is principal. -/
theorem ker_cuspParametrization (p : ℕ) (hp : Odd p) :
    RingHom.ker (cuspParametrization p).toRingHom = Ideal.span {cuspRelation p} := by
  ext F
  rw [RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
    Ideal.mem_span_singleton, cuspParametrization_eq_zero_iff p hp]

end OnLeConjecture.Polynomial
